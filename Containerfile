# SQ Builtin Node Library (programmatic: sq-builtin-node-library, version 1)
#
# Multi-app host image: one HTTP listener dispatches on the request's templateId.
# Runtime: Temurin JDK 21 (javac required for compile-on-miss) + python3 +
# Node 26 with global tsx + curl.
# This image does NOT include an OCI client. The daemon builds and runs
# test images; the emulator does not mount any engine socket.
#
# The process is a long-lived stateful listener (BYO contract).

# Base refs are FULLY QUALIFIED (docker.io/library/...): the daemon builds this on customer
# hosts whose /etc/containers/registries.conf may define no unqualified-search-registries
# (stock Ubuntu Podman refuses short names non-interactively).
FROM docker.io/library/maven:3.9-eclipse-temurin-26 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
COPY helper-src ./helper-src
COPY nodes ./nodes
# Produces target/app.jar (dispatcher) and target/sq-helper.jar (client helper).
RUN mvn -q -DskipTests package

# Copy the official Node binaries rather than using Debian's node 12/18. Pinned to an exact patch
# release (26.13.1) so a rebuild cannot reuse an unpatched layer; bump with every Node.js security
# release, together with the daemon's SandboxLanguage defaults.
FROM docker.io/library/node:26.13.1-bookworm-slim AS nodebin

FROM docker.io/library/eclipse-temurin:21-jdk-jammy
# python3: daemon helper broker + script-mode.
# curl: stateful launcher + helper UDS.
# ca-certificates: TLS if a node hits HTTPS.
# libatomic1: the copied Node 26 binary links libatomic.so.1 (without it `node` exits 127).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        curl \
        ca-certificates \
        libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Node + tsx for javascript / typescript script-mode.
COPY --from=nodebin /usr/local/bin/node /usr/local/bin/node
COPY --from=nodebin /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install -g tsx \
    && npm cache clean --force

WORKDIR /app
COPY --from=build /src/target/app.jar /app/app.jar
COPY --from=build /src/target/sq-helper.jar /app/sq-helper.jar
# Apache-2.0 §4(a)/(d): the licence and attribution notices travel with the image.
COPY LICENSE NOTICE.md /app/

ENV SQ_APP_PORT=8080
ENV SQ_APP_PATH=/invoke
ENV SQ_STATEFUL_RUNNER=true
# Must match nodes/node-test-emulator/node_definition.json _id — dispatcher self-route key.
ENV SQ_SELF_TEMPLATE_ID=17dcc655-08e2-4b45-b3a0-08d5aa608aed

# The app routes by request templateId. Each SQ_TEMPLATE_ID_<KEY> MUST match the
# corresponding nodes/<folder>/node_definition.json _id (or the runtime override).
