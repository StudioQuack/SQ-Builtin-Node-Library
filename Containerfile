# The in-image StudioQuackDispatch server is threaded and holds no cross-request mutable
# state: overlapping dispatches into the same stateful instance are safe. Without this
# label the daemon serializes every dispatch through a single-permit FIFO — and a node
# that invokes a function-port sub-PI on the same instance deadlocks against its parent.
LABEL studioquack.sqs.dispatch="1"

# No EXPOSE: the daemon reaches the listener via exec → localhost.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
