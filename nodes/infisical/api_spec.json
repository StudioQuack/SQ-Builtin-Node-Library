{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "get-secret": {
      "kind": "http",
      "method": "GET",
      "path": "{siteHost}/api/v4/secrets/{secretName}",
      "required": [
        "siteHost",
        "secretName"
      ],
      "queryFrom": [
        "projectId",
        "environment",
        "secretPath",
        "type",
        "version",
        "viewSecretValue"
      ]
    },
    "list-secrets": {
      "kind": "http",
      "method": "GET",
      "path": "{siteHost}/api/v4/secrets",
      "required": [
        "siteHost"
      ],
      "queryFrom": [
        "projectId",
        "environment",
        "secretPath",
        "recursive",
        "viewSecretValue"
      ]
    },
    "create-secret": {
      "kind": "http",
      "method": "POST",
      "path": "{siteHost}/api/v4/secrets/{secretName}",
      "required": [
        "siteHost",
        "secretName"
      ],
      "bodyFrom": [
        "projectId",
        "environment",
        "secretPath",
        "secretValue",
        "secretComment",
        "type",
        "skipMultilineEncoding"
      ]
    },
    "update-secret": {
      "kind": "http",
      "method": "PATCH",
      "path": "{siteHost}/api/v4/secrets/{secretName}",
      "required": [
        "siteHost",
        "secretName"
      ],
      "bodyFrom": [
        "projectId",
        "environment",
        "secretPath",
        "secretValue",
        "type",
        "secretComment",
        "skipMultilineEncoding"
      ]
    },
    "delete-secret": {
      "kind": "http",
      "method": "DELETE",
      "path": "{siteHost}/api/v4/secrets/{secretName}",
      "required": [
        "siteHost",
        "secretName"
      ],
      "bodyFrom": [
        "projectId",
        "environment",
        "secretPath",
        "type"
      ]
    },
    "list-folders": {
      "kind": "http",
      "method": "GET",
      "path": "{siteHost}/api/v2/folders",
      "required": [
        "siteHost"
      ],
      "queryFrom": [
        "projectId",
        "environment",
        "path",
        "recursive"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
