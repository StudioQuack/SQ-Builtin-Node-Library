{
  "baseUrl": "https://api.search.brave.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Subscription-Token",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "web_search": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/web/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "country",
        "search_lang",
        "freshness",
        "safesearch"
      ],
      "bodyFrom": []
    },
    "news_search": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/news/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "country",
        "freshness",
        "safesearch"
      ],
      "bodyFrom": []
    },
    "image_search": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/images/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "safesearch"
      ],
      "bodyFrom": []
    },
    "video_search": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/videos/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "safesearch"
      ],
      "bodyFrom": []
    },
    "suggest": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/suggest/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "country"
      ],
      "bodyFrom": []
    },
    "spellcheck": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/spellcheck/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "country"
      ],
      "bodyFrom": []
    },
    "llm_context": {
      "kind": "http",
      "method": "GET",
      "path": "/res/v1/llm/context",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "count",
        "country",
        "search_lang",
        "freshness"
      ],
      "bodyFrom": []
    }
  }
}
