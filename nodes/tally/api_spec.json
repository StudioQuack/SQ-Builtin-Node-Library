{
  "baseUrl": "https://api.tally.so",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms",
      "queryFrom": [
        "page",
        "limit"
      ],
      "required": []
    },
    "form.get": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}",
      "required": [
        "form_id"
      ]
    },
    "submission.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}/submissions",
      "queryFrom": [
        "page",
        "limit",
        "filter",
        "startDate",
        "endDate",
        "afterId"
      ],
      "required": [
        "form_id"
      ]
    },
    "submission.get": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}/submissions/{submission_id}",
      "required": [
        "form_id",
        "submission_id"
      ]
    },
    "webhook.create": {
      "kind": "http",
      "method": "POST",
      "path": "/webhooks",
      "required": [
        "form_id",
        "url",
        "eventTypes"
      ],
      "bodyFrom": [
        "form_id",
        "url",
        "signingSecret",
        "httpHeaders",
        "eventTypes",
        "externalSubscriber"
      ],
      "bodyMap": {
        "form_id": "formId"
      }
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
