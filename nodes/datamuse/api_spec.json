{
  "baseUrl": "https://api.datamuse.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "words": {
      "kind": "http",
      "method": "GET",
      "path": "/words",
      "required": [],
