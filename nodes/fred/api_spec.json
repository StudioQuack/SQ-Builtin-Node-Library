{
  "baseUrl": "https://api.stlouisfed.org/fred",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "series_search": {
      "kind": "http",
      "method": "GET",
      "path": "/series/search?file_type=json",
      "required": [
        "search_text"
      ],
      "queryFrom": [
        "search_text",
        "limit",
        "offset"
      ],
      "bodyFrom": []
    },
    "series_get": {
      "kind": "http",
      "method": "GET",
      "path": "/series?file_type=json",
      "required": [
        "series_id"
      ],
      "queryFrom": [
        "series_id"
      ],
      "bodyFrom": []
    },
    "series_observations": {
      "kind": "http",
      "method": "GET",
      "path": "/series/observations?file_type=json",
      "required": [
        "series_id"
      ],
      "queryFrom": [
        "series_id",
        "observation_start",
        "observation_end",
        "frequency",
        "units"
      ],
      "bodyFrom": []
    },
    "category_get": {
      "kind": "http",
      "method": "GET",
      "path": "/category?file_type=json",
      "required": [],
      "queryFrom": [
        "category_id"
      ],
      "bodyFrom": []
    },
    "release_get": {
      "kind": "http",
      "method": "GET",
      "path": "/release?file_type=json",
      "required": [
        "release_id"
      ],
      "queryFrom": [
        "release_id"
      ],
      "bodyFrom": []
    }
  }
}
