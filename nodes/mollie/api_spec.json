{
  "baseUrl": "https://api.mollie.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "operations": {
    "payment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/payments",
      "required": [
        "amount",
        "redirectUrl"
      ],
      "bodyFrom": [
        "amount",
        "description",
        "redirectUrl",
        "webhookUrl",
        "method",
        "profile_id"
      ],
      "bodyMap": {
        "profile_id": "profileId"
      }
    },
    "payment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/payments/{id}",
      "required": [
        "id"
      ]
    },
    "refund_create": {
      "kind": "http",
      "method": "POST",
      "path": "/payments/{id}/refunds",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "amount"
      ]
    },
    "customer_create": {
      "kind": "http",
      "method": "POST",
      "path": "/customers",
      "bodyFrom": [
        "name",
        "email"
      ]
    },
    "mandate_create": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/mandates",
      "required": [
        "customerId"
      ],
      "bodyFrom": [
        "method",
        "consumerName",
        "consumerAccount",
        "consumerBic"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
