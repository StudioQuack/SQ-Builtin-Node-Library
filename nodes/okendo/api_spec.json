{
  "baseUrl": "https://api.okendo.io/enterprise",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "userKey": "username"
  },
  "extraHeaders": {
    "okendo-api-version": "{api_version}"
  },
  "operations": {
    "review_list": {
      "kind": "http",
      "method": "GET",
      "path": "/reviews",
      "queryFrom": [
        "status",
        "limit",
        "lastEvaluated"
      ]
    },
    "review_create": {
      "kind": "http",
      "method": "POST",
      "path": "/reviews"
    },
    "survey_get": {
      "kind": "http",
      "method": "GET",
      "path": "/surveys/{surveyId}/responses",
      "required": [
        "surveyId"
      ]
    }
  }
}
