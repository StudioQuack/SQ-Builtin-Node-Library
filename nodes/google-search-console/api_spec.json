{
  "baseUrl": "https://",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "site.list": {
      "kind": "http",
      "method": "GET",
      "path": "www.googleapis.com/webmasters/v3/sites",
      "required": []
    },
    "site.add": {
      "kind": "http",
      "method": "PUT",
      "path": "www.googleapis.com/webmasters/v3/sites/{siteUrl}",
      "required": [
        "siteUrl"
      ],
      "bodyFrom": []
    },
    "searchAnalytics.query": {
      "kind": "http",
      "method": "POST",
      "path": "www.googleapis.com/webmasters/v3/sites/{siteUrl}/searchAnalytics/query",
      "required": [
        "siteUrl",
        "startDate",
        "endDate"
      ],
      "bodyFrom": [
        "startDate",
        "endDate",
        "dimensions",
        "type",
        "dimensionFilterGroups",
        "aggregationType",
        "rowLimit",
        "startRow",
        "dataState"
      ]
    },
    "sitemap.list": {
      "kind": "http",
      "method": "GET",
      "path": "www.googleapis.com/webmasters/v3/sites/{siteUrl}/sitemaps",
      "required": [
        "siteUrl"
      ],
      "queryFrom": [
        "sitemapIndex"
      ]
    },
    "sitemap.submit": {
      "kind": "http",
      "method": "PUT",
      "path": "www.googleapis.com/webmasters/v3/sites/{siteUrl}/sitemaps/{feedpath}",
      "required": [
        "siteUrl",
        "feedpath"
      ],
      "bodyFrom": []
    },
    "urlInspection.inspect": {
      "kind": "http",
      "method": "POST",
      "path": "searchconsole.googleapis.com/v1/urlInspection/index:inspect",
      "required": [
        "inspectionUrl",
        "siteUrl"
      ],
      "bodyFrom": [
        "inspectionUrl",
        "siteUrl",
        "languageCode"
      ]
    }
  }
}
