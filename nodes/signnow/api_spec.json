{
  "baseUrl": "https://api.signnow.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://docs.signnow.com/",
  "operations": {
    "document_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/document",
      "required": [
        "file"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "file"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "invite_send": {
      "kind": "http",
      "method": "POST",
      "path": "/document/{document_id}/invite",
      "required": [
        "document_id",
        "to"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "to",
        "from",
        "subject",
        "message",
        "cc"
      ],
      "contentType": "application/json"
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/document/{document_id}",
      "required": [
        "document_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_download": {
      "kind": "http",
      "method": "GET",
      "path": "/document/{document_id}/download",
      "required": [
        "document_id"
      ],
      "queryFrom": [
        "type"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_create": {
      "kind": "http",
      "method": "POST",
      "path": "/template",
      "required": [
        "document_id",
        "document_name"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "document_id",
        "document_name"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
