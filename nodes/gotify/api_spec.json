{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Gotify-Key",
    "prefix": "",
    "configKey": "app_token"
  },
  "operations": {
    "create-message": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/message",
      "contentType": "application/json",
      "required": [
        "message"
      ],
      "bodyFrom": [
        "title",
        "message",
        "priority",
        "extras"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/message",
      "contentType": "application/json",
      "queryFrom": [
        "limit",
        "since"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "DELETE",
      "path": "{host}/message/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    }
  }
}
