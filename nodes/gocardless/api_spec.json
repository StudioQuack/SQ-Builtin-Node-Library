{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "customer_create": {
      "kind": "http",
      "method": "POST",
      "path": "/customers",
      "bodyFrom": [
        "email",
        "given_name",
        "family_name",
        "company_name",
        "address_line1",
        "address_line2",
        "city",
        "region",
        "postal_code",
        "country_code",
        "phone_number",
        "metadata"
      ],
      "required": [],
      "bodyMap": {
        "email": "customers.email",
        "given_name": "customers.given_name",
        "family_name": "customers.family_name",
        "company_name": "customers.company_name",
        "address_line1": "customers.address_line1",
        "address_line2": "customers.address_line2",
        "city": "customers.city",
        "region": "customers.region",
        "postal_code": "customers.postal_code",
        "country_code": "customers.country_code",
        "phone_number": "customers.phone_number",
        "metadata": "customers.metadata"
      }
    },
    "mandate_create": {
      "kind": "http",
      "method": "POST",
      "path": "/mandates",
      "bodyFrom": [
        "scheme",
        "links",
        "metadata"
      ],
      "required": [],
      "bodyMap": {
        "scheme": "mandates.scheme",
        "links": "mandates.links",
        "metadata": "mandates.metadata"
      }
    },
    "payment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/payments",
      "bodyFrom": [
        "amount",
        "currency",
        "links",
        "description",
        "metadata",
        "charge_date"
      ],
      "required": [],
      "bodyMap": {
        "amount": "payments.amount",
        "currency": "payments.currency",
        "links": "payments.links",
        "description": "payments.description",
        "metadata": "payments.metadata",
        "charge_date": "payments.charge_date"
      }
    },
    "payout_list": {
      "kind": "http",
      "method": "GET",
      "path": "/payouts",
      "queryFrom": [
        "limit",
        "after",
        "before",
        "status"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "extraHeaders": {
    "GoCardless-Version": "2015-07-06",
    "Accept": "application/json"
  }
}
