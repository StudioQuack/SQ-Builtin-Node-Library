{
  "baseUrl": "http://localhost:9000",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "user",
    "configKey": "password"
  },
  "operations": {
    "execute.sql": {
      "kind": "http",
      "method": "GET",
      "path": "/exec",
      "queryFrom": ["query", "limit", "nm", "count", "timings"],
      "required": ["query"]
    },
    "import.csv": {
      "kind": "http",
      "method": "POST",
      "path": "/imp",
      "queryFrom": ["name", "timestamp", "partitionBy", "overwrite", "atomicity", "delimiter", "fmt", "forceHeader", "skipLev", "o3MaxLag", "maxUncommittedRows"],
      "required": ["data"],
      "bodyFormat": "multipart",
      "bodyFrom": ["data", "schema"]
    }
  }
}
