{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "consumer_secret",
    "userKey": "consumer_key"
  },
  "operations": {
    "customer_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/wp-json/wc/v3/customers",
      "required": [
        "email"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "username",
        "password",
        "billing",
        "shipping"
      ]
    },
    "customer_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/customers/{id}",
      "required": [
        "id"
      ]
    },
    "customer_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/customers",
      "queryFrom": [
        "page",
        "per_page",
        "search"
      ]
    },
    "customer_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/wp-json/wc/v3/customers/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "username",
        "password",
        "billing",
        "shipping"
      ]
    },
    "customer_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/wp-json/wc/v3/customers/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "force"
      ]
    },
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/wp-json/wc/v3/orders",
      "bodyFrom": [
        "status",
        "currency",
        "customer_id",
        "payment_method",
        "payment_method_title",
        "set_paid",
        "billing",
        "shipping",
        "line_items",
        "shipping_lines",
        "fee_lines",
        "coupon_lines",
        "customer_note"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/orders/{id}",
      "required": [
        "id"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/orders",
      "queryFrom": [
        "page",
        "per_page",
        "status"
      ]
    },
    "order_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/wp-json/wc/v3/orders/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "status",
        "currency",
        "customer_id",
        "payment_method",
        "payment_method_title",
        "set_paid",
        "billing",
        "shipping",
        "line_items",
        "shipping_lines",
        "fee_lines",
        "coupon_lines",
        "customer_note"
      ]
    },
    "order_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/wp-json/wc/v3/orders/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "force"
      ]
    },
    "product_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/wp-json/wc/v3/products",
      "bodyFrom": [
        "name",
        "type",
        "regular_price",
        "sale_price",
        "description",
        "short_description",
        "sku",
        "manage_stock",
        "stock_quantity",
        "stock_status",
        "categories",
        "images",
        "status"
      ]
    },
    "product_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/products/{id}",
      "required": [
        "id"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/wp-json/wc/v3/products",
      "queryFrom": [
        "page",
        "per_page",
        "search"
      ]
    },
    "product_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/wp-json/wc/v3/products/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "name",
        "type",
        "regular_price",
        "sale_price",
        "description",
        "short_description",
        "sku",
        "manage_stock",
        "stock_quantity",
        "stock_status",
        "categories",
        "images",
        "status"
      ]
    },
    "product_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/wp-json/wc/v3/products/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "force"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
