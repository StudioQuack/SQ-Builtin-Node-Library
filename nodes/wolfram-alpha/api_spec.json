{
  "baseUrl": "https://api.wolframalpha.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "appid"
  },
  "operations": {
    "query": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/query?output=json",
      "required": [
        "input"
      ],
      "queryFrom": [
        "input",
        "units",
        "format",
        "podstate",
        "assumption"
      ]
    },
    "spoken": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/spoken",
      "required": [
        "i"
      ],
      "queryFrom": [
        "i",
        "units"
      ]
    },
    "short_answer": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/result",
      "required": [
        "i"
      ],
      "queryFrom": [
        "i",
        "units"
      ]
    }
  }
}
