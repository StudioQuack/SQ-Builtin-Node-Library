{
  "baseUrl": "https://",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "report.run": {
      "kind": "http",
      "method": "POST",
      "path": "analyticsdata.googleapis.com/v1beta/properties/{propertyId}:runReport",
      "required": [
        "propertyId",
        "dateRanges",
        "metrics"
      ],
      "bodyFrom": [
        "dateRanges",
        "dimensions",
        "metrics",
        "dimensionFilter",
        "metricFilter",
        "limit",
        "offset",
        "orderBys",
        "keepEmptyRows",
        "returnPropertyQuota",
        "currencyCode",
        "metricAggregations",
        "cohortSpec",
        "comparisons"
      ]
    },
    "report.realtime": {
      "kind": "http",
      "method": "POST",
      "path": "analyticsdata.googleapis.com/v1beta/properties/{propertyId}:runRealtimeReport",
      "required": [
        "propertyId",
        "metrics"
      ],
      "bodyFrom": [
        "dimensions",
        "metrics",
        "minuteRanges",
        "limit",
        "returnPropertyQuota",
        "dimensionFilter",
        "metricFilter",
        "orderBys",
        "metricAggregations"
      ]
    },
    "metadata.get": {
      "kind": "http",
      "method": "GET",
      "path": "analyticsdata.googleapis.com/v1beta/properties/{propertyId}/metadata",
      "required": [
        "propertyId"
      ]
    },
    "property.list": {
      "kind": "http",
      "method": "GET",
      "path": "analyticsadmin.googleapis.com/v1beta/accountSummaries",
      "required": [],
      "queryFrom": [
        "pageSize",
        "pageToken"
      ]
    }
  }
}
