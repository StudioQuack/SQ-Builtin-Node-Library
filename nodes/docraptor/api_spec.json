{
  "baseUrl": "https://api.docraptor.com",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "Basic ",
    "configKey": "api_key",
    "userKey": "api_key"
  },
  "docs": "https://docraptor.com/documentation/api",
  "operations": {
    "html_to_pdf": {
      "kind": "http",
      "method": "POST",
      "path": "/docs",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "type",
        "document_content",
        "document_url",
        "name",
        "test",
        "pipeline",
        "prince_options",
        "javascript"
      ],
      "contentType": "application/json"
    },
    "html_to_xls": {
      "kind": "http",
      "method": "POST",
      "path": "/docs",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "type",
        "document_content",
        "document_url",
        "name",
        "test",
        "pipeline",
        "prince_options",
        "javascript"
      ],
      "contentType": "application/json"
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{status_id}",
      "required": [
        "status_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
