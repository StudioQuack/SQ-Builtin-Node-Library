{
  "baseUrl": "https://api.twilio.com/2010-04-01",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "auth_token",
    "userKey": "account_sid"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/Accounts/{account_sid}/Messages.json",
      "contentType": "application/json",
      "required": [
        "To",
        "Body"
      ],
      "bodyFrom": [
        "To",
        "From",
        "Body",
        "MessagingServiceSid",
        "StatusCallback"
      ]
    },
    "send-mms": {
      "kind": "http",
      "method": "POST",
      "path": "/Accounts/{account_sid}/Messages.json",
      "contentType": "application/json",
      "required": [
        "To"
      ],
      "bodyFrom": [
        "To",
        "From",
        "Body",
        "MediaUrl",
        "MessagingServiceSid"
      ]
    },
    "send-whatsapp": {
      "kind": "http",
      "method": "POST",
      "path": "/Accounts/{account_sid}/Messages.json",
      "contentType": "application/json",
      "required": [
        "To",
        "From"
      ],
      "bodyFrom": [
        "To",
        "From",
        "Body",
        "MediaUrl"
      ]
    },
    "make-call-tts": {
      "kind": "http",
      "method": "POST",
      "path": "/Accounts/{account_sid}/Calls.json",
      "contentType": "application/json",
      "required": [
        "To",
        "From",
        "Twiml"
      ],
      "bodyFrom": [
        "To",
        "From",
        "Twiml",
        "StatusCallback"
      ]
    },
    "get-message": {
      "kind": "http",
      "method": "GET",
      "path": "/Accounts/{account_sid}/Messages/{MessageSid}.json",
      "contentType": "application/json",
      "required": [
        "MessageSid"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/Accounts/{account_sid}/Messages.json",
      "contentType": "application/json",
      "queryFrom": [
        "To",
        "From",
        "DateSent",
        "PageSize"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "hmac_sha1_form",
      "header": "x-twilio-signature",
      "secretConfigKey": "auth_token",
      "urlConfigKey": "webhook_url"
    },
    "extract": {
      "idempotencyPath": "MessageSid",
      "fallbackIdempotencyPaths": [
        "SmsSid",
        "CallSid"
      ],
      "correlationKeyPath": "From",
      "fallbackCorrelationKeyPaths": [
        "To",
        "MessageSid"
      ],
      "eventTypePath": "MessageStatus",
      "fields": {
        "messageSid": "MessageSid",
        "accountSid": "AccountSid",
        "from": "From",
        "to": "To",
        "body": "Body",
        "messageStatus": "MessageStatus"
      }
    }
  }
}
