{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "APCA-API-KEY-ID",
    "prefix": "",
    "configKey": "api_key_id"
  },
  "extraHeaders": {
    "APCA-API-SECRET-KEY": "{api_secret}"
  },
  "operations": {
    "account_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/account"
    },
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/orders",
      "bodyFrom": [
        "symbol",
        "qty",
        "side",
        "type",
        "time_in_force"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/orders/{id}",
      "required": [
        "id"
      ]
    },
    "order_cancel": {
      "kind": "http",
      "method": "DELETE",
      "path": "/v2/orders/{id}",
      "required": [
        "id"
      ]
    },
    "position_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/positions"
    },
    "bars": {
      "kind": "http",
      "method": "GET",
      "baseUrl": "https://data.alpaca.markets",
      "path": "/v2/stocks/{symbol}/bars",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "timeframe",
        "limit"
      ]
    },
    "clock": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/clock"
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "placeholderDefaults": {
    "environment": "paper-api.alpaca.markets"
  }
}
