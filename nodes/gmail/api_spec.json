{
  "baseUrl": "https://gmail.googleapis.com/gmail/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "send-message": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/send",
      "contentType": "application/json",
      "required": [
        "raw"
      ],
      "bodyFrom": [
        "raw",
        "threadId"
      ],
      "mime": {
        "target": "raw",
        "encoding": "base64url"
      }
    },
    "reply-message": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/send",
      "contentType": "application/json",
      "required": [
        "raw",
        "threadId"
      ],
      "bodyFrom": [
        "raw",
        "threadId"
      ],
      "mime": {
        "target": "raw",
        "encoding": "base64url"
      }
    },
    "get-message": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/messages/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "queryFrom": [
        "format"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/messages",
      "contentType": "application/json",
      "queryFrom": [
        "q",
        "labelIds",
        "maxResults",
        "pageToken"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "DELETE",
      "path": "/users/{user_id}/messages/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "mark-read": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "addLabelIds",
        "removeLabelIds"
      ]
    },
    "mark-unread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "addLabelIds",
        "removeLabelIds"
      ]
    },
    "add-label-message": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "addLabelIds"
      ]
    },
    "remove-label-message": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "removeLabelIds"
      ]
    },
    "create-draft": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/drafts",
      "contentType": "application/json",
      "required": [
        "raw"
      ],
      "bodyFrom": [
        "raw",
        "threadId"
      ],
      "mime": {
        "target": "raw",
        "encoding": "base64url"
      },
      "bodyMap": {
        "raw": "message.raw",
        "threadId": "message.threadId"
      }
    },
    "get-draft": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/drafts/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "list-drafts": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/drafts",
      "contentType": "application/json",
      "queryFrom": [
        "maxResults",
        "pageToken",
        "q"
      ]
    },
    "delete-draft": {
      "kind": "http",
      "method": "DELETE",
      "path": "/users/{user_id}/drafts/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "create-label": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/labels",
      "contentType": "application/json",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "labelListVisibility",
        "messageListVisibility"
      ]
    },
    "get-label": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/labels/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "list-labels": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/labels",
      "contentType": "application/json"
    },
    "delete-label": {
      "kind": "http",
      "method": "DELETE",
      "path": "/users/{user_id}/labels/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "get-thread": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/threads/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "queryFrom": [
        "format"
      ]
    },
    "list-threads": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/threads",
      "contentType": "application/json",
      "queryFrom": [
        "q",
        "labelIds",
        "maxResults",
        "pageToken"
      ]
    },
    "reply-thread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/messages/send",
      "contentType": "application/json",
      "required": [
        "raw",
        "threadId"
      ],
      "bodyFrom": [
        "raw",
        "threadId"
      ],
      "mime": {
        "target": "raw",
        "encoding": "base64url"
      }
    },
    "trash-thread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/threads/{id}/trash",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "untrash-thread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/threads/{id}/untrash",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "delete-thread": {
      "kind": "http",
      "method": "DELETE",
      "path": "/users/{user_id}/threads/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "add-label-thread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/threads/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "addLabelIds"
      ]
    },
    "remove-label-thread": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}/threads/{id}/modify",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "removeLabelIds"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
