{
  "baseUrl": "https://api.parseur.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Token ",
    "configKey": "api_token"
  },
  "docs": "https://developer.parseur.com/",
  "operations": {
    "mailbox_create": {
      "kind": "http",
      "method": "POST",
      "path": "/parser",
      "required": [
        "name"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "name",
        "parser_type",
        "language"
      ],
      "contentType": "application/json"
    },
    "mailbox_get": {
      "kind": "http",
      "method": "GET",
      "path": "/parser/{mailbox_id}",
      "required": [
        "mailbox_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "mailbox_list": {
      "kind": "http",
      "method": "GET",
      "path": "/parser",
      "required": [],
      "queryFrom": [
        "offset",
        "limit"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "mailbox_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/parser/{mailbox_id}",
      "required": [
        "mailbox_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/document/{document_id}",
      "required": [
        "document_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/document/{document_id}",
      "required": [
        "document_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_reprocess": {
      "kind": "http",
      "method": "POST",
      "path": "/document/{document_id}/process",
      "required": [
        "document_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_search": {
      "kind": "http",
      "method": "GET",
      "path": "/document",
      "required": [],
      "queryFrom": [
        "search",
        "offset",
        "limit",
        "mailbox_id"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
