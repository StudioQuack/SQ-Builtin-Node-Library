{
  "baseUrl": "https://api.ideogram.ai",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "generate": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/ideogram-v4/generate",
      "required": [],
      "bodyFrom": [
        "prompt",
        "json_prompt",
        "resolution",
        "rendering_speed",
        "enable_copyright_detection"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "generate_async": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/ideogram-v4/async/generate",
      "queryFrom": [
        "webhook_url"
      ],
      "required": [],
      "bodyFrom": [
        "prompt",
        "json_prompt",
        "resolution",
        "rendering_speed",
        "enable_copyright_detection"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "get_task": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/generations/{generation_id}",
      "required": [
        "generation_id"
      ]
    },
    "remix": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/ideogram-v4/remix",
      "required": [
        "image",
        "prompt"
      ],
      "bodyFrom": [
        "image",
        "prompt",
        "image_weight",
        "resolution",
        "rendering_speed",
        "enable_copyright_detection"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "upscale": {
      "kind": "http",
      "method": "POST",
      "path": "/upscale",
      "required": [
        "image",
        "image_request"
      ],
      "bodyFrom": [
        "image",
        "image_request"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    }
  }
}
