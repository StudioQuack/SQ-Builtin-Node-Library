{
  "baseUrl": "https://api.stability.ai",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "generate": {
      "kind": "http",
      "method": "POST",
      "path": "/v2beta/stable-image/generate/{engine}",
      "required": [
        "prompt"
      ],
      "bodyFrom": [
        "prompt",
        "aspect_ratio",
        "negative_prompt",
        "seed",
        "style_preset",
        "output_format",
        "image"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "upscale": {
      "kind": "http",
      "method": "POST",
      "path": "/v2beta/stable-image/upscale/{upscale_mode}",
      "required": [
        "image",
        "prompt"
      ],
      "bodyFrom": [
        "image",
        "prompt",
        "negative_prompt",
        "seed",
        "output_format",
        "creativity"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "edit": {
      "kind": "http",
      "method": "POST",
      "path": "/v2beta/stable-image/edit/{edit_mode}",
      "required": [
        "image"
      ],
      "bodyFrom": [
        "image",
        "mask",
        "prompt",
        "search_prompt",
        "select_prompt",
        "negative_prompt",
        "seed",
        "output_format",
        "left",
        "right",
        "up",
        "down"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "control": {
      "kind": "http",
      "method": "POST",
      "path": "/v2beta/stable-image/control/{control_mode}",
      "required": [
        "image",
        "prompt"
      ],
      "bodyFrom": [
        "image",
        "prompt",
        "negative_prompt",
        "seed",
        "output_format",
        "control_strength",
        "style_strength",
        "style_image"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "get_result": {
      "kind": "http",
      "method": "GET",
      "path": "/v2beta/results/{id}",
      "required": [
        "id"
      ]
    }
  }
}
