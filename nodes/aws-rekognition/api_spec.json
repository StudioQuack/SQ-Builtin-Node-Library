{
    "baseUrl": "https://rekognition.{region}.amazonaws.com",
    "defaultTimeout": 60,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "rekognition",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "operations": {
        "detect_labels": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Image",
                "MaxLabels",
                "MinConfidence",
                "Features",
                "Settings"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "RekognitionService.DetectLabels"
            }
        },
        "detect_faces": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Image",
                "Attributes"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "RekognitionService.DetectFaces"
            }
        },
        "detect_text": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Image",
                "Filters"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "RekognitionService.DetectText"
            }
        },
        "compare_faces": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "SourceImage",
                "TargetImage",
                "SimilarityThreshold",
                "QualityFilter"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "RekognitionService.CompareFaces"
            }
        }
    }
}
