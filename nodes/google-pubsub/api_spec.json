{
  "baseUrl": "https://pubsub.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "oauth_access_token"
  },
  "operations": {
    "topic.publish": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/projects/{projectId}/topics/{topic}:publish",
      "required": [
        "projectId",
        "topic",
        "messages"
      ],
      "bodyFrom": [
        "messages"
      ]
    },
    "subscription.pull": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/projects/{projectId}/subscriptions/{subscription}:pull",
      "required": [
        "projectId",
        "subscription",
        "maxMessages"
      ],
      "bodyFrom": [
        "maxMessages",
        "returnImmediately"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "authorization",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
