{
  "baseUrl": "https://api.nexmo.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_secret",
    "userKey": "api_key"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/messages",
      "contentType": "application/json",
      "required": [
        "to",
        "from",
        "text"
      ],
      "bodyFrom": [
        "to",
        "from",
        "channel",
        "message_type",
        "text",
        "ttl",
        "webhook_url"
      ],
      "bodyDefaults": {
        "channel": "sms",
        "message_type": "text"
      }
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
