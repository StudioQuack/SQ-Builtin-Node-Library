{
  "baseUrl": "https://api.zoom.us/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-meeting": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{userId}/meetings",
      "contentType": "application/json",
      "required": [
        "userId"
      ],
      "bodyFrom": [
        "topic",
        "type",
        "start_time",
        "duration",
        "timezone",
        "agenda",
        "password",
        "settings"
      ]
    },
    "get-meeting": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "list-meetings": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{userId}/meetings",
      "contentType": "application/json",
      "required": [
        "userId"
      ],
      "queryFrom": [
        "type",
        "page_size",
        "next_page_token"
      ]
    },
    "update-meeting": {
      "kind": "http",
      "method": "PATCH",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ],
      "bodyFrom": [
        "topic",
        "start_time",
        "duration",
        "timezone",
        "agenda",
        "settings"
      ]
    },
    "delete-meeting": {
      "kind": "http",
      "method": "DELETE",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "list-registrants": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}/registrants",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ],
      "queryFrom": [
        "page_size",
        "next_page_token"
      ]
    },
    "add-registrant": {
      "kind": "http",
      "method": "POST",
      "path": "/meetings/{meetingId}/registrants",
      "contentType": "application/json",
      "required": [
        "meetingId",
        "email",
        "first_name"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "address",
        "city",
        "country",
        "zip",
        "state",
        "phone",
        "org",
        "job_title"
      ]
    },
    "list-recordings": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}/recordings",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "zoom_url_validation",
      "method": "POST",
      "secretConfigKey": "webhook_secret_token",
      "responseContentType": "application/json"
    },
    "verify": {
      "type": "hmac_sha256_timestamped",
      "signatureHeaderFormat": "zoom",
      "header": "x-zm-signature",
      "timestampHeader": "x-zm-request-timestamp",
      "prefix": "v0=",
      "timestampPrefix": "v0:",
      "timestampSeparator": ":",
      "timestampToleranceSeconds": 300,
      "secretConfigKey": "webhook_secret_token"
    },
    "extract": {
      "idempotencyPath": "event_ts",
      "correlationKeyPath": "payload.object.id",
      "eventTypePath": "event",
      "fields": {
        "event": "event",
        "eventTs": "event_ts",
        "objectId": "payload.object.id",
        "topic": "payload.object.topic"
      }
    }
  }
}
