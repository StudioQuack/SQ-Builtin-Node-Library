{
  "baseUrl": "https://api.zoom.us/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-meeting": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{userId}/meetings",
      "contentType": "application/json",
      "required": [
        "userId"
      ],
      "bodyFrom": [
        "topic",
        "type",
        "start_time",
        "duration",
        "timezone",
        "agenda",
        "password",
        "settings"
      ]
    },
    "get-meeting": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "list-meetings": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{userId}/meetings",
      "contentType": "application/json",
      "required": [
        "userId"
      ],
      "queryFrom": [
        "type",
        "page_size",
        "next_page_token"
      ]
    },
    "update-meeting": {
      "kind": "http",
      "method": "PATCH",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ],
      "bodyFrom": [
        "topic",
        "start_time",
        "duration",
        "timezone",
        "agenda",
        "settings"
      ]
    },
    "delete-meeting": {
      "kind": "http",
      "method": "DELETE",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "list-registrants": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}/registrants",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ],
      "queryFrom": [
        "page_size",
        "next_page_token"
      ]
    },
    "add-registrant": {
      "kind": "http",
      "method": "POST",
      "path": "/meetings/{meetingId}/registrants",
      "contentType": "application/json",
      "required": [
        "meetingId",
        "email",
        "first_name"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "address",
        "city",
        "country",
        "zip",
        "state",
        "phone",
        "org",
        "job_title"
      ]
    },
    "list-recordings": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}/recordings",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
