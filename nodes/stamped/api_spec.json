{
  "baseUrl": "https://stamped.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_secret",
    "userKey": "api_key"
  },
  "operations": {
    "review_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{store_hash}/dashboard/reviews",
      "queryFrom": [
        "search",
        "rating",
        "state",
        "page"
      ]
    },
    "review_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/reviews3",
      "queryFrom": [
        "apiKey",
        "sId"
      ],
      "required": [
        "email",
        "reviewRating",
        "reviewMessage"
      ],
      "bodyFrom": [
        "email",
        "author",
        "reviewRating",
        "reviewTitle",
        "reviewMessage",
        "productId",
        "productName",
        "productSKU",
        "location",
        "dateCreated"
      ],
      "contentType": "application/json"
    },
    "nps": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{store_hash}/dashboard/nps/"
    }
  }
}
