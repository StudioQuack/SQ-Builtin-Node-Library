{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "customer_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/rest/V1/customers",
      "bodyFrom": [
        "email",
        "firstname",
        "lastname",
        "password",
        "store_id",
        "website_id",
        "addresses"
      ],
      "bodyMap": {
        "email": "customer.email",
        "firstname": "customer.firstname",
        "lastname": "customer.lastname",
        "store_id": "customer.store_id",
        "website_id": "customer.website_id",
        "addresses": "customer.addresses"
      },
      "required": [
        "email",
        "firstname",
        "lastname"
      ]
    },
    "customer_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/customers/{id}",
      "required": [
        "id"
      ]
    },
    "customer_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/customers/search",
      "queryFrom": [
        "searchCriteria[pageSize]"
      ]
    },
    "customer_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/rest/V1/customers/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "customer",
        "email",
        "firstname",
        "lastname",
        "password",
        "store_id",
        "website_id",
        "addresses"
      ],
      "bodyMap": {
        "email": "customer.email",
        "firstname": "customer.firstname",
        "lastname": "customer.lastname",
        "store_id": "customer.store_id",
        "website_id": "customer.website_id",
        "addresses": "customer.addresses"
      }
    },
    "customer_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/rest/V1/customers/{id}",
      "required": [
        "id"
      ]
    },
    "invoice_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/rest/V1/order/{orderId}/invoice",
      "required": [
        "orderId"
      ]
    },
    "order_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/rest/V1/orders/{id}/cancel",
      "required": [
        "id"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/orders/{id}",
      "required": [
        "id"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/orders",
      "queryFrom": [
        "searchCriteria[pageSize]"
      ]
    },
    "order_ship": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/rest/V1/order/{orderId}/ship",
      "required": [
        "orderId"
      ]
    },
    "product_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/rest/V1/products",
      "bodyFrom": [
        "sku",
        "name",
        "price",
        "status",
        "type_id",
        "attribute_set_id",
        "weight"
      ],
      "bodyMap": {
        "sku": "product.sku",
        "name": "product.name",
        "price": "product.price",
        "status": "product.status",
        "type_id": "product.type_id",
        "attribute_set_id": "product.attribute_set_id",
        "weight": "product.weight"
      },
      "required": [
        "sku",
        "name"
      ]
    },
    "product_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/products/{sku}",
      "required": [
        "sku"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/rest/V1/products",
      "queryFrom": [
        "searchCriteria[pageSize]"
      ]
    },
    "product_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/rest/V1/products/{sku}",
      "required": [
        "sku"
      ],
      "bodyFrom": [
        "product",
        "sku",
        "name",
        "price",
        "status",
        "type_id",
        "attribute_set_id",
        "weight"
      ],
      "bodyMap": {
        "sku": "product.sku",
        "name": "product.name",
        "price": "product.price",
        "status": "product.status",
        "type_id": "product.type_id",
        "attribute_set_id": "product.attribute_set_id",
        "weight": "product.weight"
      }
    },
    "product_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/rest/V1/products/{sku}",
      "required": [
        "sku"
      ]
    }
  }
}
