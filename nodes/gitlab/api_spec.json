{
  "baseUrl": "https://gitlab.com/api/v4",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "PRIVATE-TOKEN",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{id}",
      "required": [
        "id"
      ]
    },
    "project_list": {
      "kind": "http",
      "method": "GET",
      "path": "/projects",
      "queryFrom": [
        "membership",
        "search",
        "page",
        "per_page"
      ]
    },
    "file_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{id}/repository/files/{file_path}",
      "required": [
        "id",
        "file_path"
      ],
      "queryFrom": [
        "ref"
      ]
    },
    "file_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/repository/files/{file_path}",
      "required": [
        "id",
        "file_path",
        "branch",
        "content",
        "commit_message"
      ],
      "bodyFrom": [
        "branch",
        "content",
        "commit_message",
        "encoding",
        "author_email",
        "author_name"
      ]
    },
    "file_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{id}/repository/files/{file_path}",
      "required": [
        "id",
        "file_path",
        "branch",
        "content",
        "commit_message"
      ],
      "bodyFrom": [
        "branch",
        "content",
        "commit_message",
        "encoding",
        "author_email",
        "author_name"
      ]
    },
    "file_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/projects/{id}/repository/files/{file_path}",
      "required": [
        "id",
        "file_path",
        "branch",
        "commit_message"
      ],
      "queryFrom": [
        "branch",
        "commit_message"
      ]
    },
    "issue_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/issues",
      "required": [
        "id",
        "title"
      ],
      "bodyFrom": [
        "title",
        "description",
        "labels",
        "assignee_id",
        "milestone_id",
        "confidential"
      ]
    },
    "issue_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{id}/issues/{iid}",
      "required": [
        "id",
        "iid"
      ]
    },
    "issue_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{id}/issues/{iid}",
      "required": [
        "id",
        "iid"
      ],
      "bodyFrom": [
        "title",
        "description",
        "state_event",
        "labels"
      ]
    },
    "issue_note": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/issues/{iid}/notes",
      "required": [
        "id",
        "iid",
        "body"
      ],
      "bodyFrom": [
        "body",
        "internal",
        "created_at"
      ]
    },
    "mr_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/merge_requests",
      "required": [
        "id",
        "source_branch",
        "target_branch",
        "title"
      ],
      "bodyFrom": [
        "source_branch",
        "target_branch",
        "title",
        "description"
      ]
    },
    "mr_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{id}/merge_requests/{iid}",
      "required": [
        "id",
        "iid"
      ]
    },
    "mr_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{id}/merge_requests/{iid}",
      "required": [
        "id",
        "iid"
      ],
      "bodyFrom": [
        "title",
        "description",
        "state_event"
      ]
    },
    "mr_accept": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{id}/merge_requests/{iid}/merge",
      "required": [
        "id",
        "iid"
      ]
    },
    "pipeline_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/pipeline",
      "required": [
        "id",
        "ref"
      ],
      "queryFrom": [
        "ref"
      ]
    },
    "pipeline_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{id}/pipelines/{pipeline_id}",
      "required": [
        "id",
        "pipeline_id"
      ]
    },
    "job_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/jobs/{job_id}/cancel",
      "required": [
        "id",
        "job_id"
      ]
    },
    "job_retry": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/jobs/{job_id}/retry",
      "required": [
        "id",
        "job_id"
      ]
    },
    "release_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/releases",
      "required": [
        "id",
        "tag_name"
      ],
      "bodyFrom": [
        "tag_name",
        "name",
        "description"
      ]
    },
    "branch_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/repository/branches",
      "required": [
        "id",
        "branch",
        "ref"
      ],
      "queryFrom": [
        "branch",
        "ref"
      ]
    },
    "tag_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{id}/repository/tags",
      "required": [
        "id",
        "tag_name",
        "ref"
      ],
      "queryFrom": [
        "tag_name",
        "ref",
        "message"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
