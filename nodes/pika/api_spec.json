{
  "baseUrl": "https://api.dev.pika.art",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-API-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "generate_video": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/media/{vendor}/{model}/{function}",
      "required": ["vendor", "model", "function"],
      "bodyFrom": ["prompt", "negative_prompt", "aspect_ratio", "resolution", "duration", "seed", "image", "video"]
    },
    "get_job": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/media/jobs/{request_id}",
      "required": ["request_id"]
    },
    "get_content": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/media/jobs/{request_id}/content",
      "required": ["request_id"]
    }
  }
}
