{
  "baseUrl": "https://chat.googleapis.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-message": {
      "kind": "http",
      "method": "POST",
      "path": "/{parent}/messages",
      "contentType": "application/json",
      "required": [
        "parent"
      ],
      "queryFrom": [
        "messageReplyOption",
        "messageId",
        "requestId"
      ],
      "bodyFrom": [
        "text",
        "cardsV2",
        "thread"
      ]
    },
    "get-message": {
      "kind": "http",
      "method": "GET",
      "path": "/{name}",
      "contentType": "application/json",
      "required": [
        "name"
      ]
    },
    "update-message": {
      "kind": "http",
      "method": "PATCH",
      "path": "/{name}",
      "contentType": "application/json",
      "required": [
        "name"
      ],
      "queryFrom": [
        "updateMask"
      ],
      "bodyFrom": [
        "text",
        "cardsV2"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{name}",
      "contentType": "application/json",
      "required": [
        "name"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/{parent}/messages",
      "contentType": "application/json",
      "required": [
        "parent"
      ],
      "queryFrom": [
        "pageSize",
        "pageToken",
        "filter",
        "showDeleted",
        "orderBy"
      ]
    },
    "get-membership": {
      "kind": "http",
      "method": "GET",
      "path": "/{name}",
      "contentType": "application/json",
      "required": [
        "name"
      ]
    },
    "list-memberships": {
      "kind": "http",
      "method": "GET",
      "path": "/{parent}/members",
      "contentType": "application/json",
      "required": [
        "parent"
      ],
      "queryFrom": [
        "pageSize",
        "pageToken",
        "filter",
        "showGroups",
        "showInvited"
      ]
    },
    "get-space": {
      "kind": "http",
      "method": "GET",
      "path": "/{name}",
      "contentType": "application/json",
      "required": [
        "name"
      ]
    },
    "list-spaces": {
      "kind": "http",
      "method": "GET",
      "path": "/spaces",
      "contentType": "application/json",
      "queryFrom": [
        "pageSize",
        "pageToken",
        "filter"
      ]
    },
    "send-and-wait": {
      "kind": "ingress"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
