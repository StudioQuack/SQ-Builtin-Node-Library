{
  "baseUrl": "https://example.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "auth_token"
  },
  "operations": {
    "import_spec": {
      "kind": "http",
      "method": "GET",
      "path": "/{spec_path}"
    },
    "list_operations": {
      "kind": "http",
      "method": "GET",
      "path": "/{spec_path}"
    },
    "invoke": {
      "kind": "http",
      "method": "GET",
      "path": "/{path}",
      "bodyFrom": [
        "body"
      ],
      "bodyMap": {
        "body": "$"
      }
    }
  }
}
