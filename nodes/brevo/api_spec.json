{
  "baseUrl": "https://api.brevo.com/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "contact.create": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts",
      "bodyFrom": [
        "email",
        "ext_id",
        "attributes",
        "listIds",
        "emailBlacklisted",
        "smsBlacklisted",
        "updateEnabled"
      ]
    },
    "contact.upsert": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts",
      "bodyFrom": [
        "email",
        "ext_id",
        "attributes",
        "listIds",
        "emailBlacklisted",
        "smsBlacklisted",
        "updateEnabled"
      ]
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts/{identifier}",
      "required": [
        "identifier"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts",
      "queryFrom": [
        "limit",
        "offset",
        "modifiedSince",
        "sort"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/contacts/{identifier}",
      "required": [
        "identifier"
      ],
      "bodyFrom": [
        "attributes",
        "listIds",
        "unlinkListIds",
        "emailBlacklisted",
        "smsBlacklisted"
      ]
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/contacts/{identifier}",
      "required": [
        "identifier"
      ]
    },
    "contactAttribute.create": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts/attributes/{attributeCategory}/{attributeName}",
      "required": [
        "attributeCategory",
        "attributeName"
      ],
      "bodyFrom": [
        "type",
        "enumeration",
        "value",
        "multiCategoryOptions"
      ]
    },
    "contactAttribute.getAll": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts/attributes"
    },
    "contactAttribute.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/contacts/attributes/{attributeCategory}/{attributeName}",
      "required": [
        "attributeCategory",
        "attributeName"
      ],
      "bodyFrom": [
        "value",
        "enumeration",
        "multiCategoryOptions"
      ]
    },
    "contactAttribute.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/contacts/attributes/{attributeCategory}/{attributeName}",
      "required": [
        "attributeCategory",
        "attributeName"
      ]
    },
    "email.send": {
      "kind": "http",
      "method": "POST",
      "path": "/smtp/email",
      "bodyFrom": [
        "sender",
        "to",
        "subject",
        "htmlContent",
        "textContent",
        "replyTo",
        "tags"
      ]
    },
    "email.sendTemplate": {
      "kind": "http",
      "method": "POST",
      "path": "/smtp/email",
      "bodyFrom": [
        "templateId",
        "to",
        "params",
        "sender"
      ]
    },
    "sender.create": {
      "kind": "http",
      "method": "POST",
      "path": "/senders",
      "bodyFrom": [
        "name",
        "email"
      ]
    },
    "sender.list": {
      "kind": "http",
      "method": "GET",
      "path": "/senders"
    },
    "sender.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/senders/{senderId}",
      "required": [
        "senderId"
      ]
    },
    "list.add": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts/lists/{listId}/contacts/add",
      "required": [
        "listId"
      ],
      "bodyFrom": [
        "emails",
        "ids"
      ]
    },
    "campaign.send": {
      "kind": "http",
      "method": "POST",
      "path": "/emailCampaigns/{campaignId}/sendNow",
      "required": [
        "campaignId"
      ],
      "bodyFrom": [
        "_empty"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
