{
  "baseUrl": "https://api.{shard}.adobesign.com/api/rest/v6",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://developer.adobe.com/acrobat-sign/docs/overview/developer_guide/apiusage",
  "operations": {
    "agreement_create": {
      "kind": "http",
      "method": "POST",
      "path": "/agreements",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "name",
        "fileInfos",
        "participantSetsInfo",
        "signatureType",
        "state"
      ],
      "contentType": "application/json"
    },
    "agreement_get": {
      "kind": "http",
      "method": "GET",
      "path": "/agreements/{agreement_id}",
      "required": [
        "agreement_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "agreement_cancel": {
      "kind": "http",
      "method": "PUT",
      "path": "/agreements/{agreement_id}/state",
      "required": [
        "agreement_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "state",
        "comment"
      ],
      "contentType": "application/json"
    },
    "agreement_documents": {
      "kind": "http",
      "method": "GET",
      "path": "/agreements/{agreement_id}/combinedDocument",
      "required": [
        "agreement_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "webhook_listen": {
      "kind": "ingress"
    },
    "group_get": {
      "kind": "http",
      "method": "GET",
      "path": "/groups/{group_id}",
      "required": [
        "group_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "workflow_get": {
      "kind": "http",
      "method": "GET",
      "path": "/workflows/{workflow_id}",
      "required": [
        "workflow_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "webform_get": {
      "kind": "http",
      "method": "GET",
      "path": "/widgets/{widget_id}",
      "required": [
        "widget_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "megasign_get": {
      "kind": "http",
      "method": "GET",
      "path": "/megaSigns/{megasign_id}",
      "required": [
        "megasign_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
