{
  "baseUrl": "https://api-v2.mindee.net",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "predict": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/products/extraction/enqueue",
      "required": ["model_id"],
      "bodyFrom": ["model_id", "url", "file", "file_base64", "filename", "alias", "raw_text", "polygon", "confidence", "rag", "text_context"]
    },
    "invoice": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/products/extraction/enqueue",
      "required": ["model_id"],
      "bodyFrom": ["model_id", "url", "file", "file_base64", "filename", "alias"]
    },
    "receipt": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/products/extraction/enqueue",
      "required": ["model_id"],
      "bodyFrom": ["model_id", "url", "file", "file_base64", "filename", "alias"]
    },
    "passport": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/products/extraction/enqueue",
      "required": ["model_id"],
      "bodyFrom": ["model_id", "url", "file", "file_base64", "filename", "alias"]
    },
    "get_job": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/jobs/{job_id}",
      "required": ["job_id"]
    },
    "get_result": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/products/extraction/results/{inference_id}",
      "required": ["inference_id"]
    }
  }
}
