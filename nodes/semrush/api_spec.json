{
  "baseUrl": "https://api.semrush.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "key"
  },
  "operations": {
    "domain.overview": {
      "kind": "http",
      "method": "GET",
      "path": "/?type=domain_rank",
      "queryFrom": ["domain", "database", "display_limit", "display_offset", "display_date", "export_columns", "display_sort", "display_filter"],
      "required": ["domain"]
    },
    "domain.organic": {
      "kind": "http",
      "method": "GET",
      "path": "/?type=domain_organic",
      "queryFrom": ["domain", "database", "display_limit", "display_offset", "display_date", "export_columns", "display_sort", "display_filter"],
      "required": ["domain"]
    },
    "domain.adwords": {
      "kind": "http",
      "method": "GET",
      "path": "/?type=domain_adwords",
      "queryFrom": ["domain", "database", "display_limit", "display_offset", "display_date", "export_columns", "display_sort", "display_filter"],
      "required": ["domain"]
    },
    "phrase.this": {
      "kind": "http",
      "method": "GET",
      "path": "/?type=phrase_this",
      "queryFrom": ["phrase", "database", "display_limit", "display_offset", "display_date", "export_columns", "display_sort", "display_filter"],
      "required": ["phrase"]
    },
    "backlinks.overview": {
      "kind": "http",
      "method": "GET",
      "path": "/apis/v4/backlinks/v1/overview",
      "queryFrom": ["target", "target_type", "export_columns"],
      "required": ["target", "target_type"]
    },
    "traffic.summary": {
      "kind": "http",
      "method": "GET",
      "path": "/analytics/ta/api/v3/summary",
      "queryFrom": ["targets", "display_date", "country", "export_columns"],
      "required": ["targets"]
    },
    "project.keyword.add": {
      "kind": "http",
      "method": "PUT",
      "path": "/management/v1/projects/{campaign_id}/keywords",
      "required": ["campaign_id"],
      "bodyFrom": ["phrase", "keywords", "database", "project_id"]
    },
    "project.positionTracking.enable": {
      "kind": "http",
      "method": "POST",
      "path": "/management/v1/projects/{project_id}/tracking/enable",
      "required": ["project_id"],
      "bodyFrom": ["url", "tracking_url_type", "location_id", "database", "phrase"]
    }
  }
}
