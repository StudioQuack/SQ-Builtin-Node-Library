{
    "baseUrl": "https://textract.{region}.amazonaws.com",
    "defaultTimeout": 60,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "textract",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "operations": {
        "detect_text": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Document"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "Textract.DetectDocumentText"
            }
        },
        "analyze_document": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Document",
                "FeatureTypes",
                "QueriesConfig",
                "AdaptersConfig"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "Textract.AnalyzeDocument"
            }
        },
        "analyze_expense": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "Document"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "Textract.AnalyzeExpense"
            }
        },
        "analyze_id": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "DocumentPages"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "Textract.AnalyzeID"
            }
        }
    }
}
