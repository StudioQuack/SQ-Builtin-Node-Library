{
  "baseUrl": "https://api.assemblyai.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "transcribe": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/transcript",
      "required": [
        "audio_url"
      ],
      "bodyFrom": [
        "audio_url",
        "speech_models",
        "language_code",
        "language_detection",
        "speaker_labels",
        "speakers_expected",
        "punctuate",
        "format_text",
        "webhook_url",
        "webhook_auth_header_name",
        "webhook_auth_header_value",
        "filter_profanity",
        "redact_pii",
        "redact_pii_policies",
        "auto_highlights",
        "summarization",
        "sentiment_analysis",
        "entity_detection"
      ]
    },
    "get_transcript": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/transcript/{transcript_id}",
      "required": [
        "transcript_id"
      ]
    },
    "upload": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/upload",
      "required": [
        "file"
      ],
      "bodyFrom": [],
      "contentType": "application/octet-stream",
      "bodyFormat": "raw",
      "bodyParam": "file",
      "fileBytes": true
    },
    "realtime": {
      "kind": "ingress"
    }
  }
}
