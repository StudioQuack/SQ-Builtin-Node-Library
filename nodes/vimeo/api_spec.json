{
    "baseUrl": "https://api.vimeo.com",
    "defaultTimeout": 60,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "access_token"
    },
    "extraHeaders": {
        "Accept": "application/vnd.vimeo.*+json;version=3.4"
    },
    "operations": {
        "video_get": {
            "kind": "http",
            "method": "GET",
            "path": "/videos/{video_id}",
            "required": [
                "video_id"
            ],
            "queryFrom": [
                "fields"
            ]
        },
        "video_list": {
            "kind": "http",
            "method": "GET",
            "path": "/me/videos",
            "queryFrom": [
                "page",
                "per_page",
                "query",
                "fields",
                "sort",
                "direction"
            ]
        },
        "video_upload": {
            "kind": "http",
            "method": "POST",
            "path": "/me/videos",
            "required": [
                "name"
            ],
            "bodyFrom": [
                "name",
                "description",
                "upload"
            ],
            "bodyMap": {}
        },
        "folder_list": {
            "kind": "http",
            "method": "GET",
            "path": "/me/projects",
            "queryFrom": [
                "page",
                "per_page",
                "fields"
            ]
        },
        "trigger": {
            "kind": "ingress"
        }
    }
}
