{
  "baseUrl": "https://firestore.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "oauth_access_token"
  },
  "operations": {
    "firestore.document.get": {
      "method": "GET",
      "path": "/v1/projects/{projectId}/databases/{databaseId}/documents/{collectionId}/{documentId}",
      "required": [
        "projectId",
        "databaseId",
        "collectionId",
        "documentId"
      ],
      "kind": "http",
      "queryFrom": [
        "mask"
      ],
      "queryMap": {
        "mask": "mask.fieldPaths"
      }
    },
    "firestore.document.create": {
      "method": "POST",
      "path": "/v1/projects/{projectId}/databases/{databaseId}/documents/{collectionId}",
      "bodyFrom": [
        "fields"
      ],
      "required": [
        "projectId",
        "databaseId",
        "collectionId",
        "fields"
      ],
      "kind": "http",
      "queryFrom": [
        "documentId",
        "mask"
      ],
      "queryMap": {
        "mask": "mask.fieldPaths",
        "documentId": "documentId"
      }
    },
    "firestore.document.delete": {
      "method": "DELETE",
      "path": "/v1/projects/{projectId}/databases/{databaseId}/documents/{collectionId}/{documentId}",
      "required": [
        "projectId",
        "databaseId",
        "collectionId",
        "documentId"
      ],
      "kind": "http"
    },
    "firestore.document.list": {
      "method": "GET",
      "path": "/v1/projects/{projectId}/databases/{databaseId}/documents/{collectionId}",
      "queryFrom": [
        "pageSize",
        "pageToken",
        "orderBy",
        "readTime",
        "showMissing"
      ],
      "required": [
        "projectId",
        "databaseId",
        "collectionId"
      ],
      "kind": "http"
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
