{
  "baseUrl": "https://api.unbounce.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "api_key",
    "configKey": "api_key"
  },
  "operations": {
    "page.list": {
      "kind": "http",
      "method": "GET",
      "path": "/pages",
      "queryFrom": ["limit", "offset", "sort_order", "with_stats", "from", "to"]
    },
    "page.get": {
      "kind": "http",
      "method": "GET",
      "path": "/pages/{page_id}",
      "required": ["page_id"]
    },
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/pages/{page_id}/form_fields",
      "required": ["page_id"],
      "queryFrom": ["include_sub_pages"]
    },
    "lead.list": {
      "kind": "http",
      "method": "GET",
      "path": "/pages/{page_id}/leads",
      "required": ["page_id"],
      "queryFrom": ["limit", "offset", "sort_order", "from", "to"]
    },
    "lead.get": {
      "kind": "http",
      "method": "GET",
      "path": "/pages/{page_id}/leads/{lead_id}",
      "required": ["page_id", "lead_id"]
    },
    "trigger.listen": { "kind": "ingress" }
  }
}
