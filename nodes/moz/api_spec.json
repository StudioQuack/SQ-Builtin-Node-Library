{
  "baseUrl": "https://api.moz.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-moz-token",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "urlMetrics.get": {
      "kind": "http",
      "method": "POST",
      "path": "/jsonrpc",
      "required": [
        "params"
      ],
      "bodyFrom": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "bodyDefaults": {
        "jsonrpc": "2.0",
        "method": "data.site.metrics.fetch.multiple"
      }
    },
    "links.list": {
      "kind": "http",
      "method": "POST",
      "path": "/jsonrpc",
      "required": [
        "params"
      ],
      "bodyFrom": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "bodyDefaults": {
        "jsonrpc": "2.0",
        "method": "data.site.link.list"
      }
    },
    "anchorText.list": {
      "kind": "http",
      "method": "POST",
      "path": "/jsonrpc",
      "required": [
        "params"
      ],
      "bodyFrom": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "bodyDefaults": {
        "jsonrpc": "2.0",
        "method": "data.site.anchor-text.list"
      }
    },
    "topPages.list": {
      "kind": "http",
      "method": "POST",
      "path": "/jsonrpc",
      "required": [
        "params"
      ],
      "bodyFrom": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "bodyDefaults": {
        "jsonrpc": "2.0",
        "method": "data.site.top-page.list"
      }
    }
  }
}
