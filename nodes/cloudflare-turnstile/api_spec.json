{
  "baseUrl": "https://challenges.cloudflare.com",
  "defaultTimeout": 15,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "secret"
  },
  "operations": {
    "verify": {
      "kind": "http",
      "method": "POST",
      "path": "/turnstile/v0/siteverify",
      "required": [
        "secret",
        "response"
      ],
      "bodyFrom": [
        "secret",
        "response",
        "remoteip",
        "idempotency_key"
      ],
      "contentType": "application/json"
    }
  }
}
