{
  "baseUrl": "https://www.alphavantage.co",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "apikey"
  },
  "operations": {
    "quote": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=GLOBAL_QUOTE",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "datatype"
      ],
      "bodyFrom": []
    },
    "time_series_intraday": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=TIME_SERIES_INTRADAY",
      "required": [
        "symbol",
        "interval"
      ],
      "queryFrom": [
        "symbol",
        "interval",
        "outputsize",
        "datatype"
      ],
      "bodyFrom": []
    },
    "time_series_daily": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=TIME_SERIES_DAILY",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "outputsize",
        "datatype"
      ],
      "bodyFrom": []
    },
    "time_series_weekly": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=TIME_SERIES_WEEKLY",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "datatype"
      ],
      "bodyFrom": []
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=SYMBOL_SEARCH",
      "required": [
        "keywords"
      ],
      "queryFrom": [
        "keywords"
      ],
      "bodyFrom": []
    },
    "fx_rate": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=CURRENCY_EXCHANGE_RATE",
      "required": [
        "from_currency",
        "to_currency"
      ],
      "queryFrom": [
        "from_currency",
        "to_currency"
      ],
      "bodyFrom": []
    },
    "crypto_daily": {
      "kind": "http",
      "method": "GET",
      "path": "/query?function=DIGITAL_CURRENCY_DAILY",
      "required": [
        "symbol",
        "market"
      ],
      "queryFrom": [
        "symbol",
        "market"
      ],
      "bodyFrom": []
    }
  }
}
