{
  "baseUrl": "https://api.pexels.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search_photos": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "orientation",
        "size",
        "color",
        "locale",
        "page",
        "per_page"
      ]
    },
    "search_videos": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/videos/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "orientation",
        "size",
        "locale",
        "page",
        "per_page"
      ]
    },
    "curated": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/curated",
      "required": [],
      "queryFrom": [
        "page",
        "per_page"
      ]
    },
    "photo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/photos/{id}",
      "required": [
        "id"
      ]
    }
  }
}
