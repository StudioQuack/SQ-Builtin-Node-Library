{
  "baseUrl": "https://openlibrary.org",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "limit",
        "page"
      ],
      "bodyFrom": []
    },
    "work_get": {
      "kind": "http",
      "method": "GET",
      "path": "/works/{work_id}.json",
      "required": [
        "work_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "edition_get": {
      "kind": "http",
      "method": "GET",
      "path": "/books/{edition_id}.json",
      "required": [
        "edition_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "author_get": {
      "kind": "http",
      "method": "GET",
      "path": "/authors/{author_id}.json",
      "required": [
        "author_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "isbn_get": {
      "kind": "http",
      "method": "GET",
      "path": "/isbn/{isbn}.json",
      "required": [
        "isbn"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
