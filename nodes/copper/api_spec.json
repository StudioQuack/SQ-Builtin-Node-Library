{
    "baseUrl": "https://api.copper.com/developer_api/v1",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "header",
        "header": "X-PW-AccessToken",
        "prefix": "",
        "configKey": "access_token"
    },
    "extraHeaders": {
        "X-PW-UserEmail": "{user_email}",
        "X-PW-Application": "developer_api"
    },
    "operations": {
        "company.create": {
            "kind": "http",
            "method": "POST",
            "path": "/companies",
            "bodyFrom": [
                "name",
                "email_domain",
                "phone_numbers",
                "address",
                "assignee_id",
                "details",
                "tags",
                "custom_fields"
            ]
        },
        "company.get": {
            "kind": "http",
            "method": "GET",
            "path": "/companies/{id}",
            "required": [
                "id"
            ]
        },
        "company.list": {
            "kind": "http",
            "method": "POST",
            "path": "/companies/search",
            "bodyFrom": [
                "page_size",
                "page_number",
                "sort_by",
                "sort_direction",
                "name",
                "assignee_ids",
                "tags"
            ]
        },
        "company.update": {
            "kind": "http",
            "method": "PUT",
            "path": "/companies/{id}",
            "required": [
                "id"
            ],
            "bodyFrom": [
                "name",
                "email_domain",
                "phone_numbers",
                "address",
                "assignee_id",
                "details",
                "tags",
                "custom_fields"
            ]
        },
        "company.delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/companies/{id}",
            "required": [
                "id"
            ]
        },
        "person.create": {
            "kind": "http",
            "method": "POST",
