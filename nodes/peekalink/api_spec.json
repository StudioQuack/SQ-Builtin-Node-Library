{
  "baseUrl": "https://api.peekalink.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "preview": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "link"
      ],
      "bodyFrom": [
        "link"
      ]
    }
  }
}
