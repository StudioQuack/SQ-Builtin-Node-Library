{
  "baseUrl": "https://api.imgur.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Client-ID ",
    "configKey": "client_id"
  },
  "operations": {
    "image_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/3/image",
      "required": [
        "image"
      ],
      "bodyFrom": [
        "image",
        "title",
        "description",
        "type"
      ]
    },
    "image_get": {
      "kind": "http",
      "method": "GET",
      "path": "/3/image/{id}",
      "required": [
        "id"
      ]
    },
    "album_get": {
      "kind": "http",
      "method": "GET",
      "path": "/3/album/{id}",
      "required": [
        "id"
      ]
    },
    "gallery_search": {
      "kind": "http",
      "method": "GET",
      "path": "/3/gallery/search/{sort}/{window}/{page}",
      "required": [
        "q",
        "sort",
        "window",
        "page"
      ],
      "queryFrom": [
        "q"
      ]
    }
  }
}
