{
  "baseUrl": "https://ntfy.sh",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "publish": {
      "kind": "http",
      "method": "POST",
      "path": "/{topic}",
      "contentType": "application/json",
      "required": [
        "topic"
      ],
      "bodyFrom": [
        "title",
        "message",
        "priority",
        "tags",
        "click",
        "attach"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
