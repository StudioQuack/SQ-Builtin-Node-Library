{
  "baseUrl": "https://api.humantic.ai",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "apikey"
  },
  "operations": {
    "create_profile": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/user-profile/create",
      "required": ["id"],
      "queryFrom": ["id", "firstname", "lastname", "persona", "stateless", "analysistype", "web_insights", "source", "enrichprofile"]
    },
    "get_profile": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/user-profile/",
      "required": ["id"],
      "queryFrom": ["id", "persona", "web_insights", "override", "source"]
    }
  }
}
