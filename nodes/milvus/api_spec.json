{
  "baseUrl": "http://localhost:19530",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "collection.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/vectordb/collections/create",
      "required": [
        "collectionName"
      ],
      "bodyFrom": [
        "collectionName",
        "dimension",
        "metricType",
        "schema",
        "indexParams"
      ]
    },
    "collection.insert": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/vectordb/entities/insert",
      "required": [
        "collectionName",
        "data"
      ],
      "bodyFrom": [
        "collectionName",
        "data",
        "dbName",
        "partitionName"
      ]
    },
    "collection.search": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/vectordb/entities/search",
      "required": [
        "collectionName",
        "data"
      ],
      "bodyFrom": [
        "collectionName",
        "data",
        "annsField",
        "filter",
        "limit",
        "outputFields",
        "searchParams",
        "dbName"
      ]
    },
    "collection.query": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/vectordb/entities/query",
      "required": [
        "collectionName",
        "filter"
      ],
      "bodyFrom": [
        "collectionName",
        "filter",
        "outputFields",
        "limit",
        "offset",
        "dbName"
      ]
    },
    "collection.delete": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/vectordb/entities/delete",
      "required": [
        "collectionName",
        "filter"
      ],
      "bodyFrom": [
        "collectionName",
        "filter",
        "dbName"
      ]
    }
  }
}
