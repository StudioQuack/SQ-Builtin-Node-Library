{
  "baseUrl": "https://api.airtable.com/v0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "create": {
      "kind": "http",
      "method": "POST",
      "path": "/{base_id}/{table_id}",
      "required": [
        "base_id",
        "table_id"
      ],
      "bodyFrom": [
        "fields",
        "typecast"
      ]
    },
    "list": {
      "kind": "http",
      "method": "GET",
      "path": "/{base_id}/{table_id}",
      "required": [
        "base_id",
        "table_id"
      ],
      "queryFrom": [
        "maxRecords",
        "offset",
        "filterByFormula",
        "view",
        "pageSize",
        "sort"
      ]
    },
    "get": {
      "kind": "http",
      "method": "GET",
      "path": "/{base_id}/{table_id}/{record_id}",
      "required": [
        "base_id",
        "table_id",
        "record_id"
      ]
    },
    "update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/{base_id}/{table_id}/{record_id}",
      "required": [
        "base_id",
        "table_id",
        "record_id"
      ],
      "bodyFrom": [
        "fields",
        "typecast"
      ]
    },
    "upsert": {
      "kind": "http",
      "method": "PATCH",
      "path": "/{base_id}/{table_id}",
      "required": [
        "base_id",
        "table_id"
      ],
      "bodyFrom": [
        "performUpsert",
        "records"
      ]
    },
    "delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{base_id}/{table_id}/{record_id}",
      "required": [
        "base_id",
        "table_id",
        "record_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
