{
  "baseUrl": "https://api.binance.{site}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-MBX-APIKEY",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "ticker": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/ticker/price",
      "queryFrom": [
        "symbol",
        "symbols"
      ]
    },
    "klines": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/klines",
      "required": [
        "symbol",
        "interval"
      ],
      "queryFrom": [
        "symbol",
        "interval",
        "limit",
        "startTime",
        "endTime"
      ]
    },
    "account": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/account",
      "queryFrom": [
        "timestamp",
        "signature",
        "recvWindow"
      ]
    },
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v3/order",
      "queryFrom": [
        "symbol",
        "side",
        "type",
        "quantity",
        "quoteOrderQty",
        "price",
        "timeInForce",
        "newClientOrderId",
        "stopPrice",
        "timestamp",
        "signature",
        "recvWindow"
      ]
    },
    "order_cancel": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v3/order",
      "queryFrom": [
        "symbol",
        "orderId",
        "origClientOrderId",
        "timestamp",
        "signature",
        "recvWindow"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/order",
      "queryFrom": [
        "symbol",
        "orderId",
        "origClientOrderId",
        "timestamp",
        "signature",
        "recvWindow"
      ]
    },
    "listen_key": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v3/userDataStream"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
