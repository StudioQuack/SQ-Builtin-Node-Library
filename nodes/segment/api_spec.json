{
  "baseUrl": "{data_plane_url}/v1",
  "defaultTimeout": 15,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "write_key",
    "configKey": "write_key"
  },
  "operations": {
    "identify": {
      "kind": "http",
      "method": "POST",
      "path": "/identify",
      "required": [],
      "bodyFrom": ["userId", "anonymousId", "traits", "timestamp", "context", "integrations", "messageId"]
    },
    "track": {
      "kind": "http",
      "method": "POST",
      "path": "/track",
      "required": ["event"],
      "bodyFrom": ["userId", "anonymousId", "event", "properties", "timestamp", "context", "integrations", "messageId"]
    },
    "page": {
      "kind": "http",
      "method": "POST",
      "path": "/page",
      "required": [],
      "bodyFrom": ["userId", "anonymousId", "name", "properties", "timestamp", "context", "integrations", "messageId"]
    },
    "screen": {
      "kind": "http",
      "method": "POST",
      "path": "/screen",
      "required": [],
      "bodyFrom": ["userId", "anonymousId", "name", "properties", "timestamp", "context", "integrations", "messageId"]
    },
    "group": {
      "kind": "http",
      "method": "POST",
      "path": "/group",
      "required": ["groupId"],
      "bodyFrom": ["userId", "anonymousId", "groupId", "traits", "timestamp", "context", "integrations", "messageId"]
    },
    "alias": {
      "kind": "http",
      "method": "POST",
      "path": "/alias",
      "required": ["userId", "previousId"],
      "bodyFrom": ["userId", "previousId", "timestamp", "context", "integrations", "messageId"]
    }
  }
}
