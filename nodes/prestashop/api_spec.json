{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "userKey": "",
    "basicKeyPosition": "username"
  },
  "operations": {
    "resource_list": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/api/{resource}",
      "required": [
        "resource"
      ],
      "queryFrom": [
        "output_format",
        "display",
        "filter",
        "limit",
        "sort",
        "date"
      ]
    },
    "resource_get": {
      "kind": "http",
      "method": "GET",
      "path": "{store_host}/api/{resource}/{id}",
      "required": [
        "resource",
        "id"
      ],
      "queryFrom": [
        "output_format",
        "display"
      ]
    },
    "resource_create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/api/{resource}",
      "required": [
        "resource",
        "xml"
      ],
      "contentType": "text/xml",
      "bodyFormat": "raw",
      "bodyParam": "xml"
    },
    "resource_update": {
      "kind": "http",
      "method": "PUT",
      "path": "{store_host}/api/{resource}/{id}",
      "required": [
        "resource",
        "id",
        "xml"
      ],
      "contentType": "text/xml",
      "bodyFormat": "raw",
      "bodyParam": "xml"
    },
    "resource_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{store_host}/api/{resource}/{id}",
      "required": [
        "resource",
        "id"
      ]
    }
  }
}
