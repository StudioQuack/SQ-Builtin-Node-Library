{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Plaid-Secret",
    "prefix": "",
    "configKey": "secret"
  },
  "operations": {
    "link_token_create": {
      "kind": "http",
      "method": "POST",
      "path": "/link/token/create",
      "bodyFrom": [
        "client_id",
        "secret",
        "user",
        "client_name",
        "products",
        "country_codes",
        "language"
      ]
    },
    "item_public_token_exchange": {
      "kind": "http",
      "method": "POST",
      "path": "/item/public_token/exchange",
      "required": [
        "public_token"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "public_token"
      ]
    },
    "accounts_get": {
      "kind": "http",
      "method": "POST",
      "path": "/accounts/get",
      "required": [
        "access_token"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "access_token"
      ]
    },
    "transactions_sync": {
      "kind": "http",
      "method": "POST",
      "path": "/transactions/sync",
      "required": [
        "access_token"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "access_token",
        "cursor"
      ]
    },
    "auth_get": {
      "kind": "http",
      "method": "POST",
      "path": "/auth/get",
      "required": [
        "access_token"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "access_token"
      ]
    },
    "identity_get": {
      "kind": "http",
      "method": "POST",
      "path": "/identity/get",
      "required": [
        "access_token"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "access_token"
      ]
    },
    "processor_token_create": {
      "kind": "http",
      "method": "POST",
      "path": "/processor/token/create",
      "required": [
        "access_token",
        "account_id",
        "processor"
      ],
      "bodyFrom": [
        "client_id",
        "secret",
        "access_token",
        "account_id",
        "processor"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
