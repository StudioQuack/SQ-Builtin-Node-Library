{
  "baseUrl": "https://finnhub.io/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "token"
  },
  "operations": {
    "quote": {
      "kind": "http",
      "method": "GET",
      "path": "/quote",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol"
      ],
      "bodyFrom": []
    },
    "candle": {
      "kind": "http",
      "method": "GET",
      "path": "/stock/candle",
      "required": [
        "symbol",
        "resolution",
        "from",
        "to"
      ],
      "queryFrom": [
        "symbol",
        "resolution",
        "from",
        "to"
      ],
      "bodyFrom": []
    },
    "company_profile": {
      "kind": "http",
      "method": "GET",
      "path": "/stock/profile2",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol"
      ],
      "bodyFrom": []
    },
    "news": {
      "kind": "http",
      "method": "GET",
      "path": "/company-news",
      "required": [
        "symbol",
        "from",
        "to"
      ],
      "queryFrom": [
        "symbol",
        "from",
        "to"
      ],
      "bodyFrom": []
    },
    "forex_rate": {
      "kind": "http",
      "method": "GET",
      "path": "/forex/rates",
      "required": [],
      "queryFrom": [
        "base",
        "date"
      ],
      "bodyFrom": []
    }
  }
}
