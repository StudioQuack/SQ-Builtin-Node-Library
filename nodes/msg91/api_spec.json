{
  "baseUrl": "https://control.msg91.com/api/v5",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "authkey",
    "prefix": "",
    "configKey": "authkey"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/flow",
      "contentType": "application/json",
      "required": [
        "template_id",
        "recipients"
      ],
      "bodyFrom": [
        "template_id",
        "short_url",
        "realTimeResponse",
        "recipients"
      ]
    }
  }
}
