{
  "baseUrl": "https://api.beehiiv.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "operations": {
    "subscription.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/publications/{publicationId}/subscriptions",
      "required": [
        "publicationId",
        "email"
      ],
      "bodyFrom": [
        "email",
        "reactivate_existing",
        "send_welcome_email",
        "utm_source",
        "custom_fields",
        "double_opt_override",
        "tier"
      ],
      "contentType": "application/json"
    },
    "subscription.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/publications/{publicationId}/subscriptions/{subscriptionId}",
      "required": [
        "publicationId",
        "subscriptionId"
      ],
      "queryFrom": [
        "expand"
      ]
    },
    "subscription.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/v2/publications/{publicationId}/subscriptions/{subscriptionId}",
      "required": [
        "publicationId",
        "subscriptionId"
      ],
      "bodyFrom": [
        "email",
        "tier",
        "premium_tier_ids",
        "custom_fields"
      ],
      "contentType": "application/json"
    },
    "subscription.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/v2/publications/{publicationId}/subscriptions/{subscriptionId}",
      "required": [
        "publicationId",
        "subscriptionId"
      ]
    },
    "post.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/publications/{publicationId}/posts",
      "required": [
        "publicationId"
      ],
      "queryFrom": [
        "limit",
        "page",
        "cursor",
        "status",
        "platform",
        "order_by",
        "expand"
      ]
    },
    "post.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/publications/{publicationId}/posts/{postId}",
      "required": [
        "publicationId",
        "postId"
      ],
      "queryFrom": [
        "expand"
      ]
    },
    "publication.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/publications/{publicationId}",
      "required": [
        "publicationId"
      ],
      "queryFrom": [
        "expand"
      ]
    },
    "webhook.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/publications/{publicationId}/webhooks",
      "required": [
        "publicationId"
      ],
      "bodyFrom": [
        "url",
        "event_types",
        "description"
      ],
      "contentType": "application/json"
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
