{
  "baseUrl": "http://localhost:4200",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "username",
    "configKey": "password"
  },
  "operations": {
    "execute.sql": {
      "kind": "http",
      "method": "POST",
      "path": "/_sql",
      "required": ["stmt"],
      "bodyFrom": ["stmt", "args"]
    },
    "table.insert": {
      "kind": "http",
      "method": "POST",
      "path": "/_sql",
      "required": ["stmt"],
      "bodyFrom": ["stmt", "args", "bulk_args"]
    }
  }
}
