{
  "baseUrl": "https://api.deepl.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "DeepL-Auth-Key ",
    "configKey": "auth_key"
  },
  "operations": {
    "translate": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/translate",
      "required": ["text", "target_lang"],
      "bodyFrom": ["text", "target_lang", "source_lang", "formality", "glossary_id", "preserve_formatting", "split_sentences", "tag_handling", "context", "show_billed_characters"]
    },
    "glossary_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/glossaries",
      "required": ["name"],
      "bodyFrom": ["name", "dictionaries", "source_lang", "target_lang", "entries", "entries_format"]
    },
    "glossary_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/glossaries",
      "required": []
    },
    "languages": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/languages",
      "queryFrom": ["resource", "include"],
      "required": []
    }
  }
}
