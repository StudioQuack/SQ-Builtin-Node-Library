{
  "baseUrl": "https://sellingpartnerapi-{region}.amazon.com",
  "placeholderDefaults": {
    "region": "na"
  },
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-amz-access-token",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/orders/2026-01-01/orders",
      "queryFrom": [
        "marketplaceIds",
        "createdAfter",
        "createdBefore",
        "lastUpdatedAfter",
        "lastUpdatedBefore",
        "fulfillmentStatuses",
        "maxResultsPerPage",
        "paginationToken",
        "includedData",
        "MarketplaceIds",
        "CreatedAfter",
        "LastUpdatedAfter",
        "OrderStatuses"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/orders/2026-01-01/orders/{orderId}",
      "required": [
        "orderId"
      ]
    },
    "catalog_get": {
      "kind": "http",
      "method": "GET",
      "path": "/catalog/2022-04-01/items/{asin}",
      "required": [
        "asin"
      ],
      "queryFrom": [
        "marketplaceIds",
        "includedData"
      ]
    },
    "inventory_get": {
      "kind": "http",
      "method": "GET",
      "path": "/fba/inventory/v1/summaries",
      "queryFrom": [
        "marketplaceIds",
        "granularityType",
        "granularityId"
      ]
    },
    "feed_create": {
      "kind": "http",
      "method": "POST",
      "path": "/feeds/2021-06-30/feeds"
    },
    "report_get": {
      "kind": "http",
      "method": "GET",
      "path": "/reports/2021-06-30/reports/{reportId}",
      "required": [
        "reportId"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
