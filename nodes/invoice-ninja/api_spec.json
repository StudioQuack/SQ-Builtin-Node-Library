{
  "baseUrl": "{base_url}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-API-TOKEN",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "client_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/clients",
      "bodyFrom": [
        "name",
        "contacts",
        "website",
        "vat_number",
        "address1",
        "city",
        "state",
        "postal_code",
        "country_id"
      ]
    },
    "client_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/clients/{id}",
      "required": [
        "id"
      ]
    },
    "client_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/clients/{id}",
      "required": [
        "id"
      ]
    },
    "client_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/clients",
      "queryFrom": [
        "per_page",
        "page"
      ]
    },
    "expense_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/expenses",
      "bodyFrom": [
        "amount",
        "client_id",
        "date",
        "public_notes",
        "category_id"
      ]
    },
    "expense_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/expenses/{id}",
      "required": [
        "id"
      ]
    },
    "expense_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/expenses/{id}",
      "required": [
        "id"
      ]
    },
    "expense_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/expenses",
      "queryFrom": [
        "per_page"
      ]
    },
    "invoice_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/invoices",
      "bodyFrom": [
        "client_id",
        "line_items",
        "number",
        "due_date",
        "discount",
        "po_number",
        "public_notes",
        "status_id"
      ]
    },
    "invoice_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/invoices/{id}",
      "required": [
        "id"
      ]
    },
    "invoice_email": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/emails",
      "bodyFrom": [
        "entity",
        "entity_id",
        "template"
      ]
    },
    "invoice_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/invoices/{id}",
      "required": [
        "id"
      ]
    },
    "invoice_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/invoices",
      "queryFrom": [
        "per_page"
      ]
    },
    "payment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/payments",
      "bodyFrom": [
        "client_id",
        "amount",
        "invoices",
        "date",
        "type_id"
      ]
    },
    "payment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/payments/{id}",
      "required": [
        "id"
      ]
    },
    "payment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/payments/{id}",
      "required": [
        "id"
      ]
    },
    "payment_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/payments",
      "queryFrom": [
        "per_page"
      ]
    },
    "quote_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/quotes",
      "bodyFrom": [
        "client_id",
        "line_items",
        "number",
        "due_date",
        "discount",
        "public_notes"
      ]
    },
    "quote_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/quotes/{id}",
      "required": [
        "id"
      ]
    },
    "quote_email": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/emails",
      "bodyFrom": [
        "entity",
        "entity_id",
        "template"
      ]
    },
    "quote_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/quotes/{id}",
      "required": [
        "id"
      ]
    },
    "quote_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/quotes",
      "queryFrom": [
        "per_page"
      ]
    },
    "task_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/tasks",
      "bodyFrom": [
        "description",
        "client_id",
        "time_log",
        "rate"
      ]
    },
    "task_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/v1/tasks/{id}",
      "required": [
        "id"
      ]
    },
    "task_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/tasks/{id}",
      "required": [
        "id"
      ]
    },
    "task_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/tasks",
      "queryFrom": [
        "per_page"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "extraHeaders": {
    "X-Requested-With": "{x_requested_with}"
  },
  "placeholderDefaults": {
    "x_requested_with": "XMLHttpRequest",
    "base_url": "https://invoicing.co"
  }
}
