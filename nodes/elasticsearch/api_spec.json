{
  "baseUrl": "{base_url}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "ApiKey ",
    "configKey": "api_key"
  },
  "operations": {
    "document.create": {
      "method": "PUT",
      "path": "/{index}/_doc/{id}",
      "required": [
        "index",
        "id",
        "document"
      ],
      "kind": "http",
      "queryFrom": [
        "refresh",
        "routing",
        "op_type",
        "pipeline"
      ],
      "bodyFrom": [
        "document"
      ],
      "bodyMap": {
        "document": "$"
      }
    },
    "document.get": {
      "method": "GET",
      "path": "/{index}/_doc/{id}",
      "required": [
        "index",
        "id"
      ],
      "kind": "http",
      "queryFrom": [
        "_source",
        "routing"
      ]
    },
    "document.update": {
      "method": "POST",
      "path": "/{index}/_update/{id}",
      "bodyFrom": [
        "doc",
        "doc_as_upsert",
        "script",
        "upsert"
      ],
      "required": [
        "index",
        "id"
      ],
      "kind": "http"
    },
    "document.delete": {
      "method": "DELETE",
      "path": "/{index}/_doc/{id}",
      "required": [
        "index",
        "id"
      ],
      "kind": "http"
    },
    "document.search": {
      "method": "POST",
      "path": "/{index}/_search",
      "bodyFrom": [
        "query",
        "size",
        "from",
        "sort",
        "_source",
        "aggs"
      ],
      "required": [
        "index"
      ],
      "kind": "http"
    }
  }
}
