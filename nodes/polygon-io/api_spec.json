{
  "baseUrl": "https://api.polygon.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "aggregates": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/aggs/ticker/{ticker}/range/{multiplier}/{timespan}/{from}/{to}",
      "required": [
        "ticker",
        "multiplier",
        "timespan",
        "from",
        "to"
      ],
      "queryFrom": [
        "adjusted",
        "limit"
      ],
      "bodyFrom": []
    },
    "ticker_details": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/reference/tickers/{ticker}",
      "required": [
        "ticker"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "snapshot": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/snapshot/locale/us/markets/stocks/tickers/{ticker}",
      "required": [
        "ticker"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "news": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/reference/news",
      "required": [],
      "queryFrom": [
        "ticker",
        "limit"
      ],
      "bodyFrom": []
    }
  }
}
