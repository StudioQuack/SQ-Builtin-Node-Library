{
  "baseUrl": "https://api.lemonsqueezy.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "operations": {
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/orders/{id}",
      "required": [
        "id"
      ]
    },
    "subscription_get": {
      "kind": "http",
      "method": "GET",
      "path": "/subscriptions/{id}",
      "required": [
        "id"
      ]
    },
    "subscription_cancel": {
      "kind": "http",
      "method": "DELETE",
      "path": "/subscriptions/{id}",
      "required": [
        "id"
      ]
    },
    "customer_get": {
      "kind": "http",
      "method": "GET",
      "path": "/customers/{id}",
      "required": [
        "id"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
