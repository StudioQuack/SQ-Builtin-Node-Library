{
  "baseUrl": "https://openrouter.ai/api/v1",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "prompt", "models", "provider", "tools", "tool_choice", "temperature", "top_p", "top_k", "max_tokens", "stop", "stream", "seed", "frequency_penalty", "presence_penalty", "repetition_penalty", "response_format", "plugins", "modalities", "user", "route"],
      "stream": {
        "format": "openai-sse"
      }
    },
    "list_models": {
      "kind": "http",
      "method": "GET",
      "path": "/models",
      "queryFrom": ["offset", "limit", "q", "sort", "output_modalities", "input_modalities", "supported_parameters", "model_authors", "region"],
      "required": []
    }
  },
  "extraHeaders": {
    "HTTP-Referer": "{http_referer}",
    "X-OpenRouter-Title": "{title}"
  }
}
