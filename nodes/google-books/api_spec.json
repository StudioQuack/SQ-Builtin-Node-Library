{
  "baseUrl": "https://www.googleapis.com/books/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "key"
  },
  "operations": {
    "volume_get": {
      "kind": "http",
      "method": "GET",
      "path": "/volumes/{volume_id}",
      "required": [
        "volume_id"
      ],
      "queryFrom": [
        "projection"
      ],
      "bodyFrom": []
    },
    "bookshelf_list": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/bookshelves",
      "required": [
        "user_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "bookshelf_get": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}/bookshelves/{shelf_id}",
      "required": [
        "user_id",
        "shelf_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "volume_search": {
      "kind": "http",
      "method": "GET",
      "path": "/volumes",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "maxResults",
        "startIndex",
        "langRestrict",
        "printType",
        "orderBy",
        "filter",
        "projection",
        "download"
      ],
      "bodyFrom": []
    }
  }
}
