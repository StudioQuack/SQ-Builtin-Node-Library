{
  "baseUrl": "https://api.census.gov/data",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "key"
  },
  "operations": {
    "census_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{vintage}/{dataset}",
      "required": [
        "vintage",
        "dataset",
        "get",
        "for"
      ],
      "queryFrom": [
        "get",
        "for",
        "in"
      ],
      "bodyFrom": []
    },
    "geography_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{vintage}/{dataset}/geography.json",
      "required": [
        "vintage",
        "dataset"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
