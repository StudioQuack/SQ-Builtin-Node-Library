{
    "baseUrl": "https://iam.amazonaws.com",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "iam",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "operations": {
        "create-user": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=CreateUser&Version=2010-05-08",
            "required": [
                "UserName"
            ],
            "bodyFrom": [
                "UserName",
                "Path",
                "PermissionsBoundary"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "get-user": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=GetUser&Version=2010-05-08",
            "bodyFrom": [
                "UserName"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "list-users": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=ListUsers&Version=2010-05-08",
            "bodyFrom": [
                "PathPrefix",
                "MaxItems",
                "Marker"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "update-user": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=UpdateUser&Version=2010-05-08",
            "required": [
                "UserName"
            ],
            "bodyFrom": [
                "UserName",
                "NewUserName",
                "NewPath"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "delete-user": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=DeleteUser&Version=2010-05-08",
            "required": [
                "UserName"
            ],
            "bodyFrom": [
                "UserName"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "add-user-to-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=AddUserToGroup&Version=2010-05-08",
            "required": [
                "GroupName",
                "UserName"
            ],
            "bodyFrom": [
                "GroupName",
                "UserName"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "remove-user-from-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=RemoveUserFromGroup&Version=2010-05-08",
            "required": [
                "GroupName",
                "UserName"
            ],
            "bodyFrom": [
                "GroupName",
                "UserName"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "create-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=CreateGroup&Version=2010-05-08",
            "required": [
                "GroupName"
            ],
            "bodyFrom": [
                "GroupName",
                "Path"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "get-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=GetGroup&Version=2010-05-08",
            "required": [
                "GroupName"
            ],
            "bodyFrom": [
                "GroupName",
                "MaxItems",
                "Marker"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "list-groups": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=ListGroups&Version=2010-05-08",
            "bodyFrom": [
                "PathPrefix",
                "MaxItems",
                "Marker"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "update-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=UpdateGroup&Version=2010-05-08",
            "required": [
                "GroupName"
            ],
            "bodyFrom": [
                "GroupName",
                "NewGroupName",
                "NewPath"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "delete-group": {
            "kind": "http",
            "method": "POST",
            "path": "/?Action=DeleteGroup&Version=2010-05-08",
            "required": [
                "GroupName"
            ],
            "bodyFrom": [
                "GroupName"
            ],
            "bodyFormat": "form",
            "contentType": "application/x-www-form-urlencoded"
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
