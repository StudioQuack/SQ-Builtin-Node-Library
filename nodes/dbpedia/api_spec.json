{
  "baseUrl": "https://",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "sparql_query": {
      "kind": "http",
      "method": "GET",
      "path": "dbpedia.org/sparql",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "format",
        "timeout"
      ],
      "bodyFrom": []
    },
    "lookup": {
      "kind": "http",
      "method": "GET",
      "path": "lookup.dbpedia.org/api/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "maxResults",
        "format"
      ],
      "bodyFrom": []
    },
    "spotlight_annotate": {
      "kind": "http",
      "method": "GET",
      "path": "api.dbpedia-spotlight.org/en/annotate",
      "required": [
        "text"
      ],
      "queryFrom": [
        "text",
        "confidence"
      ],
      "bodyFrom": []
    }
  }
}
