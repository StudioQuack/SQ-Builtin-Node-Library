{
  "baseUrl": "{jenkins_url}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token",
    "userKey": "user"
  },
  "operations": {
    "job_build": {
      "kind": "http",
      "method": "POST",
      "path": "/job/{jobPath}/build",
      "queryFrom": [
        "token",
        "delay"
      ],
      "required": [
        "jobPath"
      ]
    },
    "job_build_wait": {
      "kind": "http",
      "method": "POST",
      "path": "/job/{jobPath}/build",
      "queryFrom": [
        "token",
        "delay"
      ],
      "required": [
        "jobPath"
      ]
    },
    "job_get": {
      "kind": "http",
      "method": "GET",
      "path": "/job/{jobPath}/api/json",
      "required": [
        "jobPath"
      ]
    },
    "job_copy": {
      "kind": "http",
      "method": "POST",
      "path": "/createItem",
      "queryFrom": [
        "name",
        "mode",
        "from"
      ],
      "required": [
        "name",
        "from"
      ]
    },
    "job_create": {
      "kind": "http",
      "method": "POST",
      "path": "/createItem",
      "queryFrom": [
        "name"
      ],
      "required": [
        "name",
        "configXml"
      ],
      "bodyFormat": "raw",
      "bodyParam": "configXml",
      "contentType": "application/xml"
    },
    "build_list": {
      "kind": "http",
      "method": "GET",
      "path": "/job/{jobPath}/api/json",
      "required": [
        "jobPath"
      ],
      "queryFrom": [
        "tree"
      ]
    },
    "queue_get": {
      "kind": "http",
      "method": "GET",
      "path": "/queue/api/json"
    },
    "queue_item_get": {
      "kind": "http",
      "method": "GET",
      "path": "/queue/item/{queue_id}/api/json",
      "required": [
        "queue_id"
      ]
    },
    "quiet_down": {
      "kind": "http",
      "method": "POST",
      "path": "/quietDown"
    },
    "restart": {
      "kind": "http",
      "method": "POST",
      "path": "/safeRestart"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
