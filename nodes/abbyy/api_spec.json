{
  "baseUrl": "https://{endpoint}",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "Basic ",
    "configKey": "password",
    "userKey": "application_id"
  },
  "docs": "https://support.abbyy.com/hc/en-us/articles/360017269420-API-reference",
  "operations": {
    "process_image": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/processImage",
      "required": [],
      "queryFrom": [
        "language",
        "exportFormat"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "process_document": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/processDocument",
      "required": [
        "task_id"
      ],
      "queryFrom": [
        "task_id"
      ],
      "bodyFrom": [],
      "contentType": "application/json",
      "queryMap": {
        "task_id": "taskId"
      }
    },
    "get_task": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/getTaskStatus",
      "required": [
        "task_id"
      ],
      "queryFrom": [
        "task_id"
      ],
      "bodyFrom": [],
      "contentType": "application/json",
      "queryMap": {
        "task_id": "taskId"
      }
    },
    "get_result": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/getTaskStatus",
      "required": [
        "task_id"
      ],
      "queryFrom": [
        "task_id"
      ],
      "bodyFrom": [],
      "contentType": "application/json",
      "queryMap": {
        "task_id": "taskId"
      }
    }
  }
}
