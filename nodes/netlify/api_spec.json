{
  "baseUrl": "https://api.netlify.com/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "deploy_create": {
      "kind": "http",
      "method": "POST",
      "path": "/sites/{site_id}/deploys",
      "required": [
        "site_id"
      ],
      "bodyFrom": [
        "files",
        "draft"
      ]
    },
    "deploy_get": {
      "kind": "http",
      "method": "GET",
      "path": "/deploys/{deploy_id}",
      "required": [
        "deploy_id"
      ]
    },
    "deploy_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/deploys",
      "required": [
        "site_id"
      ]
    },
    "deploy_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "/deploys/{deploy_id}/cancel",
      "required": [
        "deploy_id"
      ]
    },
    "site_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}",
      "required": [
        "site_id"
      ]
    },
    "site_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites"
    },
    "site_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/sites/{site_id}",
      "required": [
        "site_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
