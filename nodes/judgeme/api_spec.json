{
  "baseUrl": "https://api.judge.me/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Token",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "review_list": {
      "kind": "http",
      "method": "GET",
      "path": "/reviews",
      "queryFrom": [
        "shop_domain",
        "api_token",
        "page",
        "per_page"
      ]
    },
    "review_create": {
      "kind": "http",
      "method": "POST",
      "path": "/reviews",
      "queryFrom": [
        "shop_domain",
        "api_token"
      ],
      "required": [
        "email",
        "name",
        "rating",
        "body"
      ],
      "bodyFrom": [
        "email",
        "name",
        "rating",
        "title",
        "body",
        "product_id",
        "product_handle",
        "product_external_id",
        "id",
        "platform",
        "ip_addr"
      ]
    }
  }
}
