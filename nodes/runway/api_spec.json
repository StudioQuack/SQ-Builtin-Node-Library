{
  "baseUrl": "https://api.dev.runwayml.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "X-Runway-Version": "2024-11-06"
  },
  "operations": {
    "generate_video": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/text_to_video",
      "required": [
        "model",
        "promptText"
      ],
      "bodyFrom": [
        "model",
        "promptText",
        "ratio",
        "duration",
        "seed",
        "audio",
        "negativePrompt",
        "contentModeration",
        "outputFormat",
        "proresProfile"
      ]
    },
    "image_to_video": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/image_to_video",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "model",
        "promptText",
        "promptImage",
        "ratio",
        "duration",
        "seed",
        "audio",
        "negativePrompt",
        "contentModeration",
        "outputFormat"
      ]
    },
    "get_task": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "required": [
        "id"
      ]
    }
  }
}
