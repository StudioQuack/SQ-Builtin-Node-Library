{
  "baseUrl": "http://localhost:8000",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Chroma-Token",
    "prefix": "",
    "configKey": "token"
  },
  "operations": {
    "collection.add": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v2/tenants/{tenant}/databases/{database}/collections/{collection_id}/add",
      "required": [
        "collection_id",
        "ids",
        "embeddings"
      ],
      "bodyFrom": [
        "ids",
        "embeddings",
        "documents",
        "metadatas",
        "uris"
      ]
    },
    "collection.query": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v2/tenants/{tenant}/databases/{database}/collections/{collection_id}/query",
      "required": [
        "collection_id",
        "query_embeddings"
      ],
      "bodyFrom": [
        "query_embeddings",
        "n_results",
        "where",
        "where_document",
        "include"
      ]
    },
    "collection.get": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v2/tenants/{tenant}/databases/{database}/collections/{collection_id}/get",
      "required": [
        "collection_id"
      ],
      "bodyFrom": [
        "ids",
        "where",
        "where_document",
        "include",
        "limit",
        "offset"
      ]
    },
    "collection.update": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v2/tenants/{tenant}/databases/{database}/collections/{collection_id}/update",
      "required": [
        "collection_id",
        "ids"
      ],
      "bodyFrom": [
        "ids",
        "embeddings",
        "documents",
        "metadatas",
        "uris"
      ]
    },
    "collection.delete": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v2/tenants/{tenant}/databases/{database}/collections/{collection_id}/delete",
      "required": [
        "collection_id"
      ],
      "bodyFrom": [
        "ids",
        "where",
        "where_document"
      ]
    }
  }
}
