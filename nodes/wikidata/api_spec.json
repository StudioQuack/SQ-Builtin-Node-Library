{
  "baseUrl": "https://www.wikidata.org",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/w/api.php?action=wbsearchentities&format=json",
      "required": [
        "search"
      ],
      "queryFrom": [
        "search",
        "language",
        "limit",
        "type"
      ]
    },
    "entity_get": {
      "kind": "http",
      "method": "GET",
      "path": "/w/api.php?action=wbgetentities&format=json",
      "required": [
        "ids"
      ],
      "queryFrom": [
        "ids",
        "languages",
        "props"
      ]
    }
  }
}
