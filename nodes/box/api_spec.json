{
  "baseUrl": "https://api.box.com/2.0",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://developer.box.com/reference/",
  "operations": {
    "copy_file": {
      "kind": "http",
      "method": "POST",
      "path": "/files/{file_id}/copy",
      "required": [
        "file_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "parent",
        "name"
      ],
      "contentType": "application/json"
    },
    "delete_file": {
      "kind": "http",
      "method": "DELETE",
      "path": "/files/{file_id}",
      "required": [
        "file_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "download": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{file_id}/content",
      "required": [
        "file_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "get_file": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{file_id}",
      "required": [
        "file_id"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "limit",
        "offset"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "share_file": {
      "kind": "http",
      "method": "PUT",
      "path": "/files/{file_id}",
      "required": [
        "file_id"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": [
        "shared_link"
      ],
      "contentType": "application/json"
    },
    "upload": {
      "kind": "http",
      "method": "POST",
      "path": "/files/content",
      "required": [
        "file"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "attributes",
        "file"
      ],
      "contentType": "multipart/form-data",
      "baseUrl": "https://upload.box.com/api/2.0",
      "bodyFormat": "multipart"
    },
    "create_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/folders",
      "required": [
        "name"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "parent",
        "name"
      ],
      "contentType": "application/json"
    },
    "get_folder": {
      "kind": "http",
      "method": "GET",
      "path": "/folders/{folder_id}",
      "required": [
        "folder_id"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "delete_folder": {
      "kind": "http",
      "method": "DELETE",
      "path": "/folders/{folder_id}",
      "required": [
        "folder_id"
      ],
      "queryFrom": [
        "recursive"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "share_folder": {
      "kind": "http",
      "method": "PUT",
      "path": "/folders/{folder_id}",
      "required": [
        "folder_id"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": [
        "shared_link"
      ],
      "contentType": "application/json"
    },
    "update_folder": {
      "kind": "http",
      "method": "PUT",
      "path": "/folders/{folder_id}",
      "required": [
        "folder_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "parent",
        "name"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
