{
  "baseUrl": "https://api.x.ai",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/chat/completions",
      "required": [
        "messages"
      ],
      "bodyFrom": [
        "model",
        "messages",
        "tools",
        "tool_choice",
        "temperature",
        "top_p",
        "max_completion_tokens",
        "n",
        "stop",
        "stream",
        "stream_options",
        "presence_penalty",
        "frequency_penalty",
        "seed",
        "response_format",
        "reasoning_effort",
        "search_parameters",
        "parallel_tool_calls",
        "prompt_cache_key",
        "user"
      ],
      "stream": {
        "format": "openai-sse"
      }
    },
    "image_gen": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/images/generations",
      "required": [
        "prompt"
      ],
      "bodyFrom": [
        "model",
        "prompt",
        "n",
        "aspect_ratio",
        "resolution",
        "response_format",
        "quality",
        "user"
      ]
    }
  }
}
