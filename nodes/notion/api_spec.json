{
    "baseUrl": "https://api.notion.com/v1",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "integration_token"
    },
    "extraHeaders": {
        "Notion-Version": "2026-03-11"
    },
    "operations": {
        "page_create": {
            "kind": "http",
            "method": "POST",
            "path": "/pages",
            "bodyFrom": [
                "parent",
                "properties",
                "children",
                "icon",
                "cover"
            ]
        },
        "page_archive": {
            "kind": "http",
            "method": "PATCH",
            "path": "/pages/{page_id}",
            "required": [
                "page_id"
            ],
            "bodyFrom": [
                "in_trash"
            ]
        },
        "page_get": {
            "kind": "http",
            "method": "GET",
            "path": "/pages/{page_id}",
            "required": [
                "page_id"
            ]
        },
        "page_update": {
            "kind": "http",
            "method": "PATCH",
            "path": "/pages/{page_id}",
            "required": [
                "page_id"
            ],
            "bodyFrom": [
                "properties",
                "icon",
                "cover",
                "in_trash"
            ]
        },
        "page_search": {
            "kind": "http",
            "method": "POST",
            "path": "/search",
            "bodyFrom": [
                "query",
                "filter",
                "sort"
            ]
        },
        "database_get": {
            "kind": "http",
            "method": "GET",
            "path": "/databases/{database_id}",
            "required": [
                "database_id"
            ]
        },
        "database_page_create": {
            "kind": "http",
            "method": "POST",
            "path": "/pages",
            "bodyFrom": [
                "parent",
                "properties",
                "icon",
                "cover"
            ]
        },
        "database_page_get": {
            "kind": "http",
            "method": "GET",
            "path": "/pages/{page_id}",
            "required": [
                "page_id"
            ]
        },
        "database_page_list": {
            "kind": "http",
            "method": "POST",
            "path": "/data_sources/{data_source_id}/query",
            "required": [
                "data_source_id"
            ],
            "bodyFrom": [
                "filter",
                "sorts",
                "start_cursor",
                "page_size"
            ]
        },
        "database_page_update": {
            "kind": "http",
            "method": "PATCH",
            "path": "/pages/{page_id}",
            "required": [
                "page_id"
            ],
            "bodyFrom": [
                "properties",
                "icon",
                "cover",
                "in_trash"
            ]
        },
        "block_append": {
            "kind": "http",
            "method": "PATCH",
            "path": "/blocks/{block_id}/children",
            "required": [
                "block_id"
            ],
            "bodyFrom": [
                "children",
                "position"
            ]
        },
        "block_list": {
            "kind": "http",
            "method": "GET",
            "path": "/blocks/{block_id}/children",
            "required": [
                "block_id"
            ],
            "queryFrom": [
                "start_cursor",
                "page_size"
            ]
        },
        "block_get": {
            "kind": "http",
            "method": "GET",
            "path": "/blocks/{block_id}",
            "required": [
                "block_id"
            ]
        },
        "user_get": {
            "kind": "http",
            "method": "GET",
            "path": "/users/{user_id}",
            "required": [
                "user_id"
            ]
        },
        "user_list": {
            "kind": "http",
            "method": "GET",
            "path": "/users",
            "queryFrom": [
                "start_cursor",
                "page_size"
            ]
        },
        "data_source_get": {
            "kind": "http",
            "method": "GET",
            "path": "/data_sources/{data_source_id}",
            "required": [
                "data_source_id"
            ]
        },
        "data_source_search": {
            "kind": "http",
            "method": "POST",
            "path": "/search",
            "bodyFrom": [
                "query",
                "filter"
            ]
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
