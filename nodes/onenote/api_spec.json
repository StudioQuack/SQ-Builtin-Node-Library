{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "notebook_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/onenote/notebooks",
      "bodyFrom": [
        "displayName"
      ]
    },
    "notebook_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/onenote/notebooks/{notebook_id}",
      "required": [
        "notebook_id"
      ]
    },
    "section_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/onenote/notebooks/{notebook_id}/sections",
      "required": [
        "notebook_id"
      ],
      "bodyFrom": [
        "displayName"
      ]
    },
    "section_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/onenote/sections/{section_id}",
      "required": [
        "section_id"
      ]
    },
    "page_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/onenote/sections/{section_id}/pages",
      "required": [
        "section_id",
        "html"
      ],
      "bodyFrom": [
        "html"
      ],
      "bodyFormat": "raw",
      "bodyParam": "html",
      "contentType": "text/html"
    },
    "page_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/onenote/pages/{page_id}",
      "required": [
        "page_id"
      ]
    },
    "page_copy": {
      "kind": "http",
      "method": "POST",
      "path": "/me/onenote/pages/{page_id}/copyToSection",
      "required": [
        "page_id"
      ],
      "bodyFrom": [
        "id"
      ]
    },
    "page_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/onenote/pages/{page_id}",
      "required": [
        "page_id"
      ]
    },
    "page_content": {
      "kind": "http",
      "method": "GET",
      "path": "/me/onenote/pages/{page_id}/content",
      "required": [
        "page_id"
      ]
    },
    "file_download": {
      "kind": "http",
      "method": "GET",
      "path": "/me/onenote/pages/{page_id}/content",
      "required": [
        "page_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
