{
  "baseUrl": "https://api.hunter.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-API-KEY",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "domain.search": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/domain-search",
      "required": [],
      "queryFrom": ["domain", "company", "limit", "offset", "type", "seniority", "department", "required_field"]
    },
    "email.finder": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/email-finder",
      "required": [],
      "queryFrom": ["domain", "company", "first_name", "last_name", "full_name", "linkedin_handle"]
    },
    "email.verifier": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/email-verifier",
      "required": ["email"],
      "queryFrom": ["email"]
    }
  }
}
