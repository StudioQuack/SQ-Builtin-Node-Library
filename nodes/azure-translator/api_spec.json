{
  "baseUrl": "https://api.cognitive.microsofttranslator.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Ocp-Apim-Subscription-Key",
    "prefix": "",
    "configKey": "subscription_key"
  },
  "extraHeaders": {
    "Ocp-Apim-Subscription-Region": "{region}"
  },
  "operations": {
    "translate": {
      "kind": "http",
      "method": "POST",
      "path": "/translate?api-version=2026-06-06",
      "required": [
        "inputs"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "inputs"
      ]
    },
    "transliterate": {
      "kind": "http",
      "method": "POST",
      "path": "/transliterate?api-version=2026-06-06",
      "required": [
        "language",
        "fromScript",
        "toScript",
        "inputs"
      ],
      "queryFrom": [
        "language",
        "fromScript",
        "toScript"
      ],
      "bodyFrom": [
        "inputs"
      ]
    }
  }
}
