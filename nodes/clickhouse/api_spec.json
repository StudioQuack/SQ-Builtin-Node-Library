{
  "baseUrl": "http://localhost:8123",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "user",
    "configKey": "password"
  },
  "operations": {
    "execute.sql": {
      "kind": "http",
      "method": "GET",
      "path": "/",
      "queryFrom": [
        "query",
        "database",
        "query_id",
        "session_id",
        "wait_end_of_query",
        "default_format"
      ],
      "required": [
        "query"
      ]
    },
    "insert.rows": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "queryFrom": [
        "query",
        "database",
        "query_id",
        "session_id",
        "wait_end_of_query",
        "default_format"
      ],
      "required": [
        "query",
        "rows"
      ],
      "bodyFormat": "raw",
      "bodyParam": "rows",
      "contentType": "application/x-ndjson"
    },
    "ping": {
      "kind": "http",
      "method": "GET",
      "path": "/ping",
      "required": []
    }
  }
}
