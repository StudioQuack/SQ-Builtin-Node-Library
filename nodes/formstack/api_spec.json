{
  "baseUrl": "https://www.formstack.com/api/v2025",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "personalAccessToken"
  },
  "operations": {
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms",
      "required": [],
      "queryFrom": ["pageNumber", "pageSize", "search", "orderBy", "order", "folder"]
    },
    "form.get": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{formId}",
      "required": ["formId"]
    },
    "submission.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{formId}/submissions",
      "required": ["formId"],
      "queryFrom": ["pageNumber", "pageSize", "minTime", "maxTime", "search", "sort"]
    },
    "submission.get": {
      "kind": "http",
      "method": "GET",
      "path": "/submissions/{submissionId}",
      "required": ["submissionId"]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
