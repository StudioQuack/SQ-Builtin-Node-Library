{
  "baseUrl": "https://api.abuseipdb.com/api/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "check": {
      "kind": "http",
      "method": "GET",
      "path": "/check",
      "required": [
        "ipAddress"
      ],
      "queryFrom": [
        "ipAddress",
        "maxAgeInDays",
        "verbose"
      ]
    },
    "report": {
      "kind": "http",
      "method": "POST",
      "path": "/report",
      "required": [
        "ip",
        "categories"
      ],
      "bodyFrom": [
        "ip",
        "categories",
        "comment",
        "timestamp"
      ],
      "contentType": "application/x-www-form-urlencoded",
      "bodyFormat": "form"
    },
    "blacklist": {
      "kind": "http",
      "method": "GET",
      "path": "/blacklist",
      "queryFrom": [
        "confidenceMinimum",
        "limit",
        "onlyCountries",
        "exceptCountries",
        "ipVersion"
      ]
    },
    "check-block": {
      "kind": "http",
      "method": "GET",
      "path": "/check-block",
      "required": [
        "network"
      ],
      "queryFrom": [
        "network",
        "maxAgeInDays"
      ]
    }
  }
}
