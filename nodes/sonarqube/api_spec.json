{
  "baseUrl": "{base_url}/api",
  "placeholderDefaults": {
    "base_url": "https://sonarcloud.io"
  },
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/components/show",
      "queryFrom": [
        "component"
      ]
    },
    "project_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/create",
      "required": [
        "organization",
        "name",
        "project"
      ],
      "queryFrom": [
        "organization",
        "name",
        "project",
        "visibility",
        "mainBranch"
      ]
    },
    "issue_search": {
      "kind": "http",
      "method": "GET",
      "path": "/issues/search",
      "queryFrom": [
        "organization",
        "projects",
        "projectKeys",
        "componentKeys",
        "assignees",
        "issues",
        "severities",
        "impactSeverities",
        "ps",
        "p"
      ]
    },
    "measures_get": {
      "kind": "http",
      "method": "GET",
      "path": "/measures/component",
      "queryFrom": [
        "component",
        "metricKeys"
      ]
    },
    "qualitygate_get": {
      "kind": "http",
      "method": "GET",
      "path": "/qualitygates/show",
      "queryFrom": [
        "id",
        "name"
      ]
    },
    "qualitygate_status": {
      "kind": "http",
      "method": "GET",
      "path": "/qualitygates/project_status",
      "queryFrom": [
        "analysisId",
        "projectId",
        "projectKey",
        "branch"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
