  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "access_key"
  },
  "operations": {
    "validate": {
      "kind": "http",
      "method": "GET",
      "path": "/validate",
      "required": [
