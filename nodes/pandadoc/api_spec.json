{
  "baseUrl": "https://api.pandadoc.com/public/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "API-Key ",
    "configKey": "api_key"
  },
  "docs": "https://developers.pandadoc.com/",
  "operations": {
    "document_create_from_template": {
      "kind": "http",
      "method": "POST",
      "path": "/documents",
      "required": [
        "name",
        "template_uuid",
        "recipients"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "name",
        "template_uuid",
        "recipients",
        "tokens",
        "fields",
        "metadata",
        "folder_uuid",
        "tags",
        "pricing_tables"
      ],
      "contentType": "application/json"
    },
    "document_create_from_file": {
      "kind": "http",
      "method": "POST",
      "path": "/documents",
      "required": [
        "name",
        "url"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "name",
        "recipients",
        "url",
        "parse_form_fields"
      ],
      "contentType": "application/json"
    },
    "document_send": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/{id}/send",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "silent",
        "subject",
        "message",
        "sender"
      ],
      "contentType": "application/json"
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_list": {
      "kind": "http",
      "method": "GET",
      "path": "/documents",
      "required": [],
      "queryFrom": [
        "count",
        "page",
        "q"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_download": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{id}/download",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/documents/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_list": {
      "kind": "http",
      "method": "GET",
      "path": "/templates",
      "required": [],
      "queryFrom": [
        "count",
        "page"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "session_create": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/{id}/session",
      "required": [
        "id",
        "recipient"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "recipient",
        "lifetime"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
