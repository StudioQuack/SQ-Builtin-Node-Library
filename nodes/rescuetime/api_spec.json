{
  "baseUrl": "https://www.rescuetime.com/anapi",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "analytic_data": {
      "kind": "http",
      "method": "GET",
      "path": "/data",
      "queryFrom": [
        "perspective",
        "resolution_time",
        "restrict_begin",
        "restrict_end",
        "restrict_kind",
        "format"
      ]
    },
    "daily_summary": {
      "kind": "http",
      "method": "GET",
      "path": "/daily_summary_feed",
      "queryFrom": [
        "format"
      ]
    },
    "alerts_list": {
      "kind": "http",
      "method": "GET",
      "path": "/alerts_feed",
      "queryFrom": [
        "format",
        "op"
      ]
    },
    "highlights_list": {
      "kind": "http",
      "method": "GET",
      "path": "/highlights_feed",
      "queryFrom": [
        "format"
      ]
    }
  }
}
