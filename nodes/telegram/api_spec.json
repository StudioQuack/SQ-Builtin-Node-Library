{
  "baseUrl": "https://api.telegram.org",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "bot_token"
  },
  "operations": {
    "send-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendMessage",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "text"
      ],
      "bodyFrom": [
        "chat_id",
        "text",
        "parse_mode",
        "reply_to_message_id"
      ]
    },
    "send-photo": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendPhoto",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "photo",
        "caption"
      ]
    },
    "send-document": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendDocument",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "document",
        "caption"
      ]
    },
    "send-audio": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendAudio",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "audio",
        "caption"
      ]
    },
    "send-video": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendVideo",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "video",
        "caption"
      ]
    },
    "send-animation": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendAnimation",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "animation",
        "caption"
      ]
    },
    "send-sticker": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendSticker",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "sticker"
      ]
    },
    "send-location": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendLocation",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "latitude",
        "longitude"
      ],
      "bodyFrom": [
        "chat_id",
        "latitude",
        "longitude"
      ]
    },
    "send-media-group": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendMediaGroup",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "media"
      ],
      "bodyFrom": [
        "chat_id",
        "media"
      ]
    },
    "send-chat-action": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/sendChatAction",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "action"
      ],
      "bodyFrom": [
        "chat_id",
        "action"
      ]
    },
    "edit-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/editMessageText",
      "contentType": "application/json",
      "required": [
        "text"
      ],
      "bodyFrom": [
        "chat_id",
        "message_id",
        "inline_message_id",
        "text",
        "parse_mode"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/deleteMessage",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "message_id"
      ],
      "bodyFrom": [
        "chat_id",
        "message_id"
      ]
    },
    "pin-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/pinChatMessage",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "message_id"
      ],
      "bodyFrom": [
        "chat_id",
        "message_id"
      ]
    },
    "unpin-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/unpinChatMessage",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "message_id"
      ]
    },
    "get-file": {
      "kind": "http",
      "method": "GET",
      "path": "/bot{bot_token}/getFile",
      "contentType": "application/json",
      "required": [
        "file_id"
      ],
      "queryFrom": [
        "file_id"
      ]
    },
    "get-chat": {
      "kind": "http",
      "method": "GET",
      "path": "/bot{bot_token}/getChat",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "queryFrom": [
        "chat_id"
      ]
    },
    "get-chat-administrators": {
      "kind": "http",
      "method": "GET",
      "path": "/bot{bot_token}/getChatAdministrators",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "queryFrom": [
        "chat_id"
      ]
    },
    "get-chat-member": {
      "kind": "http",
      "method": "GET",
      "path": "/bot{bot_token}/getChatMember",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "user_id"
      ],
      "queryFrom": [
        "chat_id",
        "user_id"
      ]
    },
    "leave-chat": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/leaveChat",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id"
      ]
    },
    "set-chat-title": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/setChatTitle",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "title"
      ],
      "bodyFrom": [
        "chat_id",
        "title"
      ]
    },
    "set-chat-description": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/setChatDescription",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "bodyFrom": [
        "chat_id",
        "description"
      ]
    },
    "answer-callback-query": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/answerCallbackQuery",
      "contentType": "application/json",
      "required": [
        "callback_query_id"
      ],
      "bodyFrom": [
        "callback_query_id",
        "text",
        "show_alert"
      ]
    },
    "answer-inline-query": {
      "kind": "http",
      "method": "POST",
      "path": "/bot{bot_token}/answerInlineQuery",
      "contentType": "application/json",
      "required": [
        "inline_query_id",
        "results"
      ],
      "bodyFrom": [
        "inline_query_id",
        "results"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "x-telegram-bot-api-secret-token",
      "secretConfigKey": "secret_token"
    },
    "extract": {
      "idempotencyPath": "update_id",
      "correlationKeyPath": "message.chat.id",
      "fallbackCorrelationKeyPaths": [
        "callback_query.message.chat.id",
        "edited_message.chat.id",
        "channel_post.chat.id"
      ],
      "fields": {
        "updateId": "update_id",
        "chatId": "message.chat.id",
        "fromId": "message.from.id",
        "username": "message.from.username",
        "text": "message.text",
        "messageId": "message.message_id"
      }
    }
  }
}
