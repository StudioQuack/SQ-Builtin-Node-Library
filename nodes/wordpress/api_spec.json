{
  "baseUrl": "https://public-api.wordpress.com/wp/v2/sites/{site}",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "post_create": {
      "kind": "http",
      "method": "POST",
      "path": "/posts",
      "required": [
        "title"
      ],
      "bodyFrom": [
        "title",
        "content",
        "excerpt",
        "status",
        "slug",
        "author",
        "featured_media",
        "categories",
        "tags",
        "comment_status"
      ]
    },
    "post_get": {
      "kind": "http",
      "method": "GET",
      "path": "/posts/{post_id}",
      "required": [
        "post_id"
      ],
      "queryFrom": [
        "context",
        "password"
      ]
    },
    "post_list": {
      "kind": "http",
      "method": "GET",
      "path": "/posts",
      "required": [],
      "queryFrom": [
        "per_page",
        "page",
        "search",
        "status",
        "after",
        "modified_after",
        "author",
        "order",
        "orderby",
        "slug"
      ]
    },
    "post_update": {
      "kind": "http",
      "method": "POST",
      "path": "/posts/{post_id}",
      "required": [
        "post_id"
      ],
      "bodyFrom": [
        "title",
        "content",
        "excerpt",
        "status",
        "slug",
        "author",
        "featured_media",
        "categories",
        "tags",
        "comment_status"
      ]
    },
    "page_create": {
      "kind": "http",
      "method": "POST",
      "path": "/pages",
      "required": [
        "title"
      ],
      "bodyFrom": [
        "title",
        "content",
        "excerpt",
        "status",
        "slug",
        "author",
        "featured_media",
        "parent",
        "comment_status"
      ]
    },
    "page_get": {
      "kind": "http",
      "method": "GET",
      "path": "/pages/{page_id}",
      "required": [
        "page_id"
      ],
      "queryFrom": [
        "context",
        "password"
      ]
    },
    "page_list": {
      "kind": "http",
      "method": "GET",
      "path": "/pages",
      "required": [],
      "queryFrom": [
        "per_page",
        "page",
        "search",
        "status",
        "after",
        "modified_after",
        "author",
        "order",
        "orderby",
        "slug"
      ]
    },
    "page_update": {
      "kind": "http",
      "method": "POST",
      "path": "/pages/{page_id}",
      "required": [
        "page_id"
      ],
      "bodyFrom": [
        "title",
        "content",
        "excerpt",
        "status",
        "slug",
        "author",
        "featured_media",
        "parent",
        "comment_status"
      ]
    },
    "user_create": {
      "kind": "http",
      "method": "POST",
      "path": "/users",
      "required": [
        "username",
        "email",
        "password"
      ],
      "bodyFrom": [
        "username",
        "email",
        "password",
        "name",
        "roles"
      ]
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_id}",
      "required": [
        "user_id"
      ],
      "queryFrom": [
        "context"
      ]
    },
    "user_list": {
      "kind": "http",
      "method": "GET",
      "path": "/users",
      "required": [],
      "queryFrom": [
        "per_page",
        "page",
        "search",
        "roles"
      ]
    },
    "user_update": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{user_id}",
      "required": [
        "user_id"
      ],
      "bodyFrom": [
        "email",
        "name",
        "password",
        "roles"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
