{
  "baseUrl": "https://content.guardianapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api-key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [],
      "queryFrom": [
        "q",
        "section",
        "from-date",
        "to-date",
        "page",
        "page-size",
        "order-by"
      ],
      "bodyFrom": []
    },
    "tags": {
      "kind": "http",
      "method": "GET",
      "path": "/tags",
      "required": [],
      "queryFrom": [
        "q",
        "page"
      ],
      "bodyFrom": []
    },
    "sections": {
      "kind": "http",
      "method": "GET",
      "path": "/sections",
      "required": [],
      "queryFrom": [
        "q"
      ],
      "bodyFrom": []
    },
    "editions": {
      "kind": "http",
      "method": "GET",
      "path": "/editions",
      "required": [],
      "queryFrom": [
        "q"
      ],
      "bodyFrom": []
    },
    "item_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{item_id}",
      "required": [
        "item_id"
      ],
      "queryFrom": [
        "show-fields",
        "show-tags"
      ],
      "bodyFrom": []
    }
  }
}
