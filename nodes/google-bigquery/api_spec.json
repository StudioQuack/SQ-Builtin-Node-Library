{
  "baseUrl": "https://bigquery.googleapis.com",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "oauth_access_token"
  },
  "operations": {
    "execute.sql": {
      "kind": "http",
      "method": "POST",
      "path": "/bigquery/v2/projects/{projectId}/queries",
      "required": [
        "projectId",
        "query"
      ],
      "bodyFrom": [
        "query",
        "useLegacySql",
        "maxResults",
        "defaultDataset",
        "location",
        "timeoutMs",
        "dryRun",
        "useQueryCache",
        "labels"
      ]
    },
    "table.insert": {
      "kind": "http",
      "method": "POST",
      "path": "/bigquery/v2/projects/{projectId}/datasets/{datasetId}/tables/{tableId}/insertAll",
      "required": [
        "projectId",
        "datasetId",
        "tableId",
        "rows"
      ],
      "bodyFrom": [
        "rows",
        "skipInvalidRows",
        "ignoreUnknownValues",
        "templateSuffix"
      ]
    }
  }
}
