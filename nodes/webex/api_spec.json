{
  "baseUrl": "https://webexapis.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-message": {
      "kind": "http",
      "method": "POST",
      "path": "/messages",
      "contentType": "application/json",
      "bodyFrom": [
        "roomId",
        "toPersonEmail",
        "toPersonId",
        "text",
        "markdown",
        "files"
      ]
    },
    "get-message": {
      "kind": "http",
      "method": "GET",
      "path": "/messages/{messageId}",
      "contentType": "application/json",
      "required": [
        "messageId"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/messages",
      "contentType": "application/json",
      "queryFrom": [
        "roomId",
        "max"
      ]
    },
    "update-message": {
      "kind": "http",
      "method": "PUT",
      "path": "/messages/{messageId}",
      "contentType": "application/json",
      "required": [
        "messageId",
        "roomId"
      ],
      "bodyFrom": [
        "roomId",
        "text",
        "markdown"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "DELETE",
      "path": "/messages/{messageId}",
      "contentType": "application/json",
      "required": [
        "messageId"
      ]
    },
    "create-meeting": {
      "kind": "http",
      "method": "POST",
      "path": "/meetings",
      "contentType": "application/json",
      "required": [
        "title",
        "start",
        "end"
      ],
      "bodyFrom": [
        "title",
        "start",
        "end",
        "timezone"
      ]
    },
    "get-meeting": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "list-meetings": {
      "kind": "http",
      "method": "GET",
      "path": "/meetings",
      "contentType": "application/json",
      "queryFrom": [
        "from",
        "to",
        "max"
      ]
    },
    "update-meeting": {
      "kind": "http",
      "method": "PUT",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ],
      "bodyFrom": [
        "title",
        "start",
        "end"
      ]
    },
    "delete-meeting": {
      "kind": "http",
      "method": "DELETE",
      "path": "/meetings/{meetingId}",
      "contentType": "application/json",
      "required": [
        "meetingId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
