{
  "baseUrl": "https://api.vercel.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "deploy_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v13/deployments",
      "queryFrom": [
        "teamId"
      ],
      "bodyFrom": [
        "name",
        "project",
        "gitSource",
        "files",
        "target",
        "regions"
      ],
      "required": [
        "name"
      ]
    },
    "deploy_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v13/deployments/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "teamId"
      ]
    },
    "deploy_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v7/deployments",
      "queryFrom": [
        "teamId",
        "projectId",
        "limit"
      ]
    },
    "deploy_cancel": {
      "kind": "http",
      "method": "PATCH",
      "path": "/v12/deployments/{id}/cancel",
      "required": [
        "id"
      ],
      "queryFrom": [
        "teamId"
      ]
    },
    "deploy_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/v13/deployments/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "teamId"
      ]
    },
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v9/projects/{idOrName}",
      "required": [
        "idOrName"
      ],
      "queryFrom": [
        "teamId"
      ]
    },
    "project_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v11/projects",
      "queryFrom": [
        "teamId"
      ],
      "bodyFrom": [
        "name",
        "framework"
      ],
      "required": [
        "name"
      ]
    },
    "env_set": {
      "kind": "http",
      "method": "POST",
      "path": "/v10/projects/{idOrName}/env",
      "required": [
        "idOrName",
        "key",
        "value",
        "type",
        "target"
      ],
      "queryFrom": [
        "teamId"
      ],
      "bodyFrom": [
        "key",
        "value",
        "type",
        "target",
        "gitBranch"
      ]
    },
    "domain_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v5/domains/{domain}",
      "required": [
        "domain"
      ],
      "queryFrom": [
        "teamId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
