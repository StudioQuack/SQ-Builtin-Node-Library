{
  "baseUrl": "https://vision.googleapis.com/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://cloud.google.com/vision/docs/ocr",
  "operations": {
    "text_detection": {
      "kind": "http",
      "method": "POST",
      "path": "/images:annotate",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "requests",
        "content",
        "imageUri",
        "type"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "requests": "requests[0]",
        "content": "requests[0].image.content",
        "imageUri": "requests[0].image.source.imageUri",
        "type": "requests[0].features[0].type"
      }
    },
