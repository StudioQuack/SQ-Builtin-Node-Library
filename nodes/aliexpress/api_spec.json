{
  "baseUrl": "https://api.taobao.com/router/rest",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "access_token"
  },
  "operations": {
    "product_query": {
      "kind": "http",
      "method": "POST",
      "path": "",
      "queryFrom": [
        "method",
        "app_key",
        "timestamp",
        "sign",
        "sign_method",
        "v",
        "format",
        "session",
        "product_id"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "POST",
      "path": "",
      "queryFrom": [
        "method",
        "app_key",
        "timestamp",
        "sign",
        "sign_method",
        "v",
        "format",
        "session"
      ]
    },
    "affiliate_link": {
      "kind": "http",
      "method": "POST",
      "path": "",
      "queryFrom": [
        "method",
        "app_key",
        "timestamp",
        "sign",
        "sign_method",
        "v",
        "format",
        "session"
      ]
    },
    "tracking": {
      "kind": "http",
      "method": "POST",
      "path": "",
      "queryFrom": [
        "method",
        "app_key",
        "timestamp",
        "sign",
        "sign_method",
        "v",
        "format",
        "session",
        "logistics_no"
      ]
    }
  }
}
