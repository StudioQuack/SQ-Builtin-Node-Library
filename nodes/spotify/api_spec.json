{
  "baseUrl": "https://api.spotify.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "queryFrom": [
        "q",
        "type",
        "limit",
        "offset",
        "market"
      ],
      "required": [
        "q",
        "type"
      ]
    },
    "track_get": {
      "kind": "http",
      "method": "GET",
      "path": "/tracks/{track_id}",
      "required": [
        "track_id"
      ]
    },
    "playlist_get": {
      "kind": "http",
      "method": "GET",
      "path": "/playlists/{playlist_id}",
      "required": [
        "playlist_id"
      ]
    },
    "playlist_add": {
      "kind": "http",
      "method": "POST",
      "path": "/playlists/{playlist_id}/items",
      "required": [
        "playlist_id",
        "uris"
      ],
      "bodyFrom": [
        "uris",
        "position"
      ]
    },
    "player_state": {
      "kind": "http",
      "method": "GET",
      "path": "/me/player",
      "required": []
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
