{
  "baseUrl": "https://{rest_endpoint}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "user.track": {
      "kind": "http",
      "method": "POST",
      "path": "/users/track",
      "required": [],
      "bodyFrom": [
        "attributes",
        "events",
        "purchases"
      ],
      "contentType": "application/json"
    },
    "user.delete": {
      "kind": "http",
      "method": "POST",
      "path": "/users/delete",
      "required": [],
      "bodyFrom": [
        "external_ids",
        "user_aliases",
        "braze_ids",
        "email_addresses",
        "phone_numbers"
      ],
      "contentType": "application/json"
    },
    "user.export": {
      "kind": "http",
      "method": "POST",
      "path": "/users/export/ids",
      "required": [],
      "bodyFrom": [
        "external_ids",
        "user_aliases",
        "braze_id",
        "email_address",
        "phone",
        "fields_to_export"
      ],
      "contentType": "application/json"
    },
    "campaign.trigger": {
      "kind": "http",
      "method": "POST",
      "path": "/campaigns/trigger/send",
      "required": [
        "campaign_id"
      ],
      "bodyFrom": [
        "campaign_id",
        "send_id",
        "trigger_properties",
        "broadcast",
        "audience",
        "recipients"
      ],
      "contentType": "application/json"
    },
    "canvas.trigger": {
      "kind": "http",
      "method": "POST",
      "path": "/canvas/trigger/send",
      "required": [
        "canvas_id"
      ],
      "bodyFrom": [
        "canvas_id",
        "context",
        "broadcast",
        "audience",
        "recipients"
      ],
      "contentType": "application/json"
    },
    "subscription.set": {
      "kind": "http",
      "method": "POST",
      "path": "/subscription/status/set",
      "required": [
        "subscription_group_id",
        "subscription_state"
      ],
      "bodyFrom": [
        "subscription_group_id",
        "subscription_state",
        "external_id",
        "email",
        "phone",
        "use_double_opt_in_logic"
      ],
      "contentType": "application/json"
    },
    "catalog.upsert": {
      "kind": "http",
      "method": "PUT",
      "path": "/catalogs/{catalog_name}/items",
      "required": [
        "catalog_name",
        "items"
      ],
      "bodyFrom": [
        "items"
      ],
      "contentType": "application/json"
    },
    "message.send": {
      "kind": "http",
      "method": "POST",
      "path": "/messages/send",
      "required": [],
      "bodyFrom": [
        "external_user_ids",
        "user_aliases",
        "segment_id",
        "audience",
        "campaign_id",
        "messages",
        "broadcast"
      ],
      "contentType": "application/json"
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  },
  "placeholderDefaults": {
    "rest_endpoint": "rest.iad-01.braze.com"
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "x-braze-webhook-token",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
