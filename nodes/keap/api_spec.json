{
  "baseUrl": "https://api.infusionsoft.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "contact.upsert": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/contacts",
      "required": [
        "email"
      ],
      "bodyFrom": [
        "given_name",
        "family_name",
        "email",
        "email_field",
        "email_addresses",
        "phone",
        "phone_field",
        "phone_numbers",
        "company_id",
        "custom_fields"
      ],
      "bodyMap": {
        "email_addresses": "email_addresses[0]",
        "email": "email_addresses[0].email",
        "email_field": "email_addresses[0].field",
        "phone_numbers": "phone_numbers[0]",
        "phone": "phone_numbers[0].number",
        "phone_field": "phone_numbers[0].field"
      }
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/contacts/{contact_id}",
      "required": [
        "contact_id"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/contacts",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/crm/rest/v2/contacts/{contact_id}",
      "required": [
        "contact_id"
      ]
    },
    "company.create": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/companies",
      "required": [
        "company_name"
      ],
      "bodyFrom": [
        "company_name",
        "email"
      ]
    },
    "company.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/companies",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "contactNote.create": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/contacts/{contact_id}/notes",
      "required": [
        "contact_id",
        "body"
      ],
      "bodyFrom": [
        "title",
        "body"
      ]
    },
    "contactNote.get": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/contacts/{contact_id}/notes/{note_id}",
      "required": [
        "contact_id",
        "note_id"
      ]
    },
    "contactNote.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/contacts/{contact_id}/notes",
      "queryFrom": [
        "page_size",
        "page_token"
      ],
      "required": [
        "contact_id"
      ]
    },
    "contactNote.update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/crm/rest/v2/contacts/{contact_id}/notes/{note_id}",
      "required": [
        "contact_id",
        "note_id"
      ],
      "bodyFrom": [
        "title",
        "body"
      ]
    },
    "contactNote.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/crm/rest/v2/contacts/{contact_id}/notes/{note_id}",
      "required": [
        "contact_id",
        "note_id"
      ]
    },
    "contactTag.add": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/tags/{tag_id}/contacts:applyTags",
      "required": [
        "tag_id",
        "contact_ids"
      ],
      "bodyFrom": [
        "contact_ids"
      ]
    },
    "contactTag.remove": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/tags/{tag_id}/contacts:removeTags",
      "required": [
        "tag_id",
        "contact_ids"
      ],
      "bodyFrom": [
        "contact_ids"
      ]
    },
    "contactTag.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/tags/{tag_id}/contacts",
      "queryFrom": [
        "page_size",
        "page_token"
      ],
      "required": [
        "tag_id"
      ]
    },
    "ecommerce.order.create": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/orders",
      "required": [
        "contact_id",
        "order_items"
      ],
      "bodyFrom": [
        "contact_id",
        "order_date",
        "order_items",
        "order_title",
        "order_type"
      ]
    },
    "ecommerce.order.get": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/orders/{order_id}",
      "required": [
        "order_id"
      ]
    },
    "ecommerce.order.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/orders",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "ecommerce.order.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/crm/rest/v2/orders/{order_id}",
      "required": [
        "order_id"
      ]
    },
    "ecommerce.product.create": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/products",
      "required": [
        "product_name"
      ],
      "bodyFrom": [
        "product_name",
        "product_price",
        "product_short_desc"
      ]
    },
    "ecommerce.product.get": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/products/{product_id}",
      "required": [
        "product_id"
      ]
    },
    "ecommerce.product.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/products",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "ecommerce.product.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/crm/rest/v2/products/{product_id}",
      "required": [
        "product_id"
      ]
    },
    "email.send": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/emails:send",
      "required": [
        "contact_ids",
        "subject",
        "html_body"
      ],
      "bodyFrom": [
        "contact_ids",
        "subject",
        "html_body",
        "plain_text_body",
        "user_id"
      ]
    },
    "email.listSent": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/emails",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "email.record": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/emails",
      "required": [
        "contact_id"
      ],
      "bodyFrom": [
        "contact_id",
        "subject",
        "html_body"
      ]
    },
    "file.upload": {
      "kind": "http",
      "method": "POST",
      "path": "/crm/rest/v2/files",
      "required": [
        "file",
        "file_name",
        "file_association"
      ],
      "bodyFrom": [
        "file",
        "file_name",
        "file_association",
        "contact_id",
        "is_public"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "file.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/rest/v2/files",
      "queryFrom": [
        "page_size",
        "page_token",
        "filter"
      ],
      "required": []
    },
    "file.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/crm/rest/v2/files/{file_id}",
      "required": [
        "file_id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
