{
  "baseUrl": "https://gnews.io/api/v4",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "lang",
        "country",
        "max",
        "in",
        "nullable",
        "from",
        "to",
        "sortby",
        "page",
        "truncate"
      ]
    },
    "top_headlines": {
      "kind": "http",
      "method": "GET",
      "path": "/top-headlines",
      "required": [],
      "queryFrom": [
        "q",
        "category",
        "lang",
        "country",
        "max",
        "nullable",
        "from",
        "to",
        "page",
        "truncate"
      ]
    }
  }
}
