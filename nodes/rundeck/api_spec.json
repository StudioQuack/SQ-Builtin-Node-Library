{
  "baseUrl": "{base_url}/api/59",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Rundeck-Auth-Token",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "job_run": {
      "kind": "http",
      "method": "POST",
      "path": "/job/{id}/run",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "options",
        "argString",
        "filter",
        "asUser"
      ]
    },
    "job_get": {
      "kind": "http",
      "method": "GET",
      "path": "/job/{id}",
      "required": [
        "id"
      ]
    },
    "execution_get": {
      "kind": "http",
      "method": "GET",
      "path": "/execution/{id}",
      "required": [
        "id"
      ]
    },
    "execution_list": {
      "kind": "http",
      "method": "GET",
      "path": "/project/{project}/executions",
      "required": [
        "project"
      ],
      "queryFrom": [
        "max",
        "offset",
        "status",
        "jobIdFilter"
      ]
    }
  }
}
