{
  "baseUrl": "https://api.squarespace.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "operations": {
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/1.0/commerce/orders",
      "queryFrom": [
        "cursor",
        "modifiedAfter",
        "modifiedBefore"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/1.0/commerce/orders/{id}",
      "required": [
        "id"
      ]
    },
    "inventory_get": {
      "kind": "http",
      "method": "GET",
      "path": "/1.0/commerce/inventory",
      "queryFrom": [
        "cursor"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/commerce/products",
      "queryFrom": [
        "cursor"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
