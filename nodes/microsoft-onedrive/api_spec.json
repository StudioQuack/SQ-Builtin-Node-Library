{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "copy": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/copy",
      "required": [
        "item_id"
      ],
      "bodyFrom": [
        "parentReference",
        "name"
      ]
    },
    "delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/drive/items/{item_id}",
      "required": [
        "item_id"
      ]
    },
    "download": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/content",
      "required": [
        "item_id"
      ]
    },
    "get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}",
      "required": [
        "item_id"
      ]
    },
    "rename": {
      "kind": "http",
      "method": "PATCH",
      "path": "/me/drive/items/{item_id}",
      "required": [
        "item_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/root/search(q='{q}')",
      "required": [
        "q"
      ]
    },
    "share": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/createLink",
      "required": [
        "item_id"
      ],
      "bodyFrom": [
        "type",
        "scope"
      ]
    },
    "upload": {
      "kind": "http",
      "method": "PUT",
      "path": "/me/drive/root:/{filename}:/content",
      "required": [
        "filename",
        "file"
      ],
      "bodyFormat": "raw",
      "bodyParam": "file"
    },
    "create_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{parent_id}/children",
      "required": [
        "parent_id"
      ],
      "bodyFrom": [
        "name",
        "folder",
        "@microsoft.graph.conflictBehavior"
      ]
    },
    "list_children": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/children",
      "required": [
        "item_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "query_challenge",
      "method": "ANY",
      "challengeParam": "validationToken",
      "responseContentType": "text/plain"
    },
    "verify": {
      "type": "body_field_secret",
      "bodyPath": "value[*].clientState",
      "secretConfigKey": "client_state"
    },
    "extract": {
      "itemsPath": "value[*]",
      "idempotencyPath": "subscriptionId",
      "correlationKeyPath": "resource",
      "eventTypePath": "changeType",
      "maxItems": 100
    }
  }
}
