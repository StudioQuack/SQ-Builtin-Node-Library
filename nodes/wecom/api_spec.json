{
  "baseUrl": "https://qyapi.weixin.qq.com/cgi-bin",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "send-app-message": {
      "kind": "http",
      "method": "POST",
      "path": "/message/send",
      "contentType": "application/json",
      "queryFrom": [
        "access_token"
      ],
      "bodyFrom": [
        "touser",
        "toparty",
        "totag",
        "msgtype",
        "agentid",
        "text",
        "content"
      ],
      "bodyMap": {
        "content": "text.content"
      }
    },
    "send-group-robot": {
      "kind": "http",
      "method": "POST",
      "path": "/webhook/send",
      "contentType": "application/json",
      "queryFrom": [
        "key"
      ],
      "bodyFrom": [
        "msgtype",
        "text",
        "markdown",
        "content"
      ],
      "bodyMap": {
        "content": "text.content"
      }
    },
    "get-user": {
      "kind": "http",
      "method": "GET",
      "path": "/user/get",
      "contentType": "application/json",
      "queryFrom": [
        "userid"
      ]
    },
    "list-users": {
      "kind": "http",
      "method": "GET",
      "path": "/user/simplelist",
      "contentType": "application/json",
      "queryFrom": [
        "department_id",
        "fetch_child"
      ]
    },
    "create-user": {
      "kind": "http",
      "method": "POST",
      "path": "/user/create",
      "contentType": "application/json",
      "required": [
        "userid",
        "name"
      ],
      "bodyFrom": [
        "userid",
        "name",
        "department",
        "mobile",
        "email"
      ]
    },
    "update-user": {
      "kind": "http",
      "method": "POST",
      "path": "/user/update",
      "contentType": "application/json",
      "required": [
        "userid"
      ],
      "bodyFrom": [
        "userid",
        "name",
        "department",
        "mobile",
        "email"
      ]
    },
    "delete-user": {
      "kind": "http",
      "method": "GET",
      "path": "/user/delete",
      "contentType": "application/json",
      "queryFrom": [
        "userid"
      ]
    },
    "list-departments": {
      "kind": "http",
      "method": "GET",
      "path": "/department/list",
      "contentType": "application/json",
      "queryFrom": [
        "id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
