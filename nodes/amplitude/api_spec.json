{
    "baseUrl": "https://api2.amplitude.com",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "query",
        "header": "Authorization",
        "prefix": "",
        "configKey": "api_key"
    },
    "operations": {
        "event.track": {
            "kind": "http",
            "method": "POST",
            "path": "/2/httpapi",
            "required": [
                "events"
            ],
            "bodyFrom": [
                "api_key",
                "events",
                "options"
            ],
            "contentType": "application/json"
        },
        "identify": {
            "kind": "http",
            "method": "POST",
            "path": "/identify",
            "required": [
                "identification"
            ],
            "bodyFormat": "form",
            "bodyFrom": [
                "api_key",
                "identification"
            ],
            "contentType": "application/x-www-form-urlencoded"
        },
        "group.identify": {
            "kind": "http",
            "method": "POST",
            "path": "/groupidentify",
            "required": [
                "identification"
            ],
            "bodyFormat": "form",
            "bodyFrom": [
                "api_key",
                "identification"
            ],
            "contentType": "application/x-www-form-urlencoded"
        },
        "event.batch": {
            "kind": "http",
            "method": "POST",
            "path": "/batch",
            "required": [
                "events"
            ],
            "bodyFrom": [
                "api_key",
                "events",
                "options"
            ],
            "contentType": "application/json"
        },
        "export.download": {
            "kind": "http",
            "method": "GET",
            "path": "/api/2/export",
            "required": [
                "start",
                "end"
            ],
            "queryFrom": [
                "start",
                "end"
            ],
            "baseUrl": "https://amplitude.com",
            "extraHeaders": {
                "Authorization": "Basic {basic_token}"
            }
        },
        "taxonomy.list": {
            "kind": "http",
            "method": "GET",
            "path": "/api/2/taxonomy/event",
            "required": [],
            "queryFrom": [
                "showDeleted"
            ],
            "baseUrl": "https://amplitude.com",
            "extraHeaders": {
                "Authorization": "Basic {basic_token}"
            }
        }
    }
}
