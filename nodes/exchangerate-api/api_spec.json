{
  "baseUrl": "https://v6.exchangerate-api.com",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "latest": {
      "kind": "http",
      "method": "GET",
      "path": "/v6/{api_key}/latest/{base_code}",
      "required": [
        "api_key",
        "base_code"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "historical": {
      "kind": "http",
      "method": "GET",
      "path": "/v6/{api_key}/history/{base_code}/{year}/{month}/{day}",
      "required": [
        "api_key",
        "base_code",
        "year",
        "month",
        "day"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "convert": {
      "kind": "http",
      "method": "GET",
      "path": "/v6/{api_key}/pair/{base_code}/{target_code}/{amount}",
      "required": [
        "api_key",
        "base_code",
        "target_code"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "quota": {
      "kind": "http",
      "method": "GET",
      "path": "/v6/{api_key}/quota",
      "required": [
        "api_key"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
