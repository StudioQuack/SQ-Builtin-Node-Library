{
  "baseUrl": "{base_url}",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "Authorization": "Bearer {api_key}"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "temperature", "top_p", "top_k", "max_tokens", "stream", "stop", "presence_penalty", "frequency_penalty", "logit_bias", "repeat_penalty", "seed"],
      "stream": {
        "format": "openai-sse"
      }
    },
    "list_models": {
      "kind": "http",
      "method": "GET",
      "path": "/models",
      "required": []
    }
  }
}
