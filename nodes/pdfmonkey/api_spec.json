{
  "baseUrl": "https://api.pdfmonkey.io/api/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "docs": "https://pdfmonkey.io/docs/api/",
  "operations": {
    "document_generate": {
      "kind": "http",
      "method": "POST",
      "path": "/documents",
      "required": [
        "document_template_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "document_template_id",
        "payload",
        "status",
        "meta"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "document_template_id": "document.document_template_id",
        "payload": "document.payload",
        "status": "document.status",
        "meta": "document.meta"
      }
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_list": {
      "kind": "http",
      "method": "GET",
      "path": "/documents",
      "required": [],
      "queryFrom": [
        "page",
        "q"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "document_download": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{id}/download",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_list": {
      "kind": "http",
      "method": "GET",
      "path": "/document_template_cards",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
