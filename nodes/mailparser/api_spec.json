{
  "baseUrl": "https://api.mailparser.io/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "docs": "https://app.mailparser.io/mailparser-api",
  "operations": {
    "inbox_list": {
      "kind": "http",
      "method": "GET",
      "path": "/inboxes",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "webhook_listen": {
      "kind": "ingress"
    },
    "parsed_mail_get": {
      "kind": "http",
      "method": "GET",
      "path": "/inbox/{inbox_id}/parsed_mails/{parsed_email_id}",
      "required": [
        "inbox_id",
        "parsed_email_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "parsed_mail_list": {
      "kind": "http",
      "method": "GET",
      "path": "/inbox/{inbox_id}/parsed_mails",
      "required": [
        "inbox_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
