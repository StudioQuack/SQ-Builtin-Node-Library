{
  "baseUrl": "https://serpapi.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "google": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "location",
        "gl",
        "hl",
        "start",
        "num",
        "google_domain",
        "safe",
        "device",
        "tbs"
      ],
      "bodyFrom": []
    },
    "google_news": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google_news&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "gl",
        "hl"
      ],
      "bodyFrom": []
    },
    "google_images": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google_images&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "gl",
        "hl"
      ],
      "bodyFrom": []
    },
    "google_scholar": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google_scholar&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "hl"
      ],
      "bodyFrom": []
    },
    "google_maps": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google_maps&type=search&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "ll"
      ],
      "bodyFrom": []
    },
    "google_shopping": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=google_shopping&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "gl",
        "hl"
      ],
      "bodyFrom": []
    },
    "bing": {
      "kind": "http",
      "method": "GET",
      "path": "/search?engine=bing&output=json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "cc",
        "mkt",
        "first",
        "count"
      ],
      "bodyFrom": []
    }
  }
}
