{
  "baseUrl": "https://api.nytimes.com/svc",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api-key"
  },
  "operations": {
    "article_search": {
      "kind": "http",
      "method": "GET",
      "path": "/search/v2/articlesearch.json",
      "required": [],
      "queryFrom": [
        "q",
        "fq",
        "begin_date",
        "end_date",
        "page",
        "sort"
      ],
      "bodyFrom": []
    },
    "top_stories": {
      "kind": "http",
      "method": "GET",
      "path": "/topstories/v2/{section}.json",
      "required": [
        "section"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "most_popular": {
      "kind": "http",
      "method": "GET",
      "path": "/mostpopular/v2/{type}/{period}.json",
      "required": [
        "type",
        "period"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "archive": {
      "kind": "http",
      "method": "GET",
      "path": "/archive/v1/{year}/{month}.json",
      "required": [
        "year",
        "month"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "books_list": {
      "kind": "http",
      "method": "GET",
      "path": "/books/v3/lists.json",
      "required": [
        "list"
      ],
      "queryFrom": [
        "list",
        "bestsellers-date",
        "published-date",
        "offset"
      ]
    }
  }
}
