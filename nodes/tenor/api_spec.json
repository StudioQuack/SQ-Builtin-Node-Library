{
  "baseUrl": "https://tenor.googleapis.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "client_key",
        "limit",
        "pos",
        "locale",
        "country",
        "contentfilter",
        "media_filter"
      ]
    },
    "featured": {
      "kind": "http",
      "method": "GET",
      "path": "/featured",
      "required": [],
      "queryFrom": [
        "client_key",
        "limit",
        "pos",
        "locale",
        "contentfilter"
      ]
    },
    "register_share": {
      "kind": "http",
      "method": "GET",
      "path": "/registershare",
      "required": [
        "id"
      ],
      "queryFrom": [
        "id",
        "client_key",
        "q"
      ]
    },
    "gif_get": {
      "kind": "http",
      "method": "GET",
      "path": "/posts",
      "required": [
        "ids"
      ],
      "queryFrom": [
        "ids",
        "client_key"
      ]
    }
  }
}
