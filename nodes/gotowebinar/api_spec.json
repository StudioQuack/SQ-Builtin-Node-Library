{
  "baseUrl": "https://api.getgo.com/G2W/rest/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "webinar.create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars",
      "required": [
        "organizerKey",
        "subject",
        "times",
        "timeZone"
      ],
      "bodyFrom": [
        "subject",
        "description",
        "times",
        "timeZone",
        "type",
        "isPasswordProtected",
        "experienceType",
        "isOndemand"
      ]
    },
    "webinar.get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}",
      "required": [
        "organizerKey",
        "webinarKey"
      ]
    },
    "webinar.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars",
      "required": [
        "organizerKey"
      ],
      "queryFrom": [
        "fromTime",
        "toTime",
        "page",
        "size"
      ]
    },
    "webinar.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}",
      "required": [
        "organizerKey",
        "webinarKey"
      ],
      "bodyFrom": [
        "subject",
        "description",
        "times",
        "timeZone"
      ]
    },
    "session.get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions/{sessionKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "sessionKey"
      ]
    },
    "session.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions",
      "required": [
        "organizerKey",
        "webinarKey"
      ]
    },
    "session.details": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions/{sessionKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "sessionKey"
      ]
    },
    "registrant.create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/registrants",
      "required": [
        "organizerKey",
        "webinarKey",
        "firstName",
        "lastName",
        "email"
      ],
      "bodyFrom": [
        "firstName",
        "lastName",
        "email",
        "organization",
        "jobTitle",
        "phone",
        "industry"
      ],
      "queryFrom": [
        "resendConfirmation"
      ]
    },
    "registrant.get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/registrants/{registrantKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "registrantKey"
      ]
    },
    "registrant.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/registrants",
      "required": [
        "organizerKey",
        "webinarKey"
      ]
    },
    "registrant.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/registrants/{registrantKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "registrantKey"
      ]
    },
    "attendee.get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions/{sessionKey}/attendees/{registrantKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "sessionKey",
        "registrantKey"
      ]
    },
    "attendee.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions/{sessionKey}/attendees",
      "required": [
        "organizerKey",
        "webinarKey",
        "sessionKey"
      ]
    },
    "attendee.details": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/sessions/{sessionKey}/attendees/{registrantKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "sessionKey",
        "registrantKey"
      ]
    },
    "panelist.create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/panelists",
      "required": [
        "organizerKey",
        "webinarKey",
        "panelists"
      ],
      "bodyFrom": [
        "panelists"
      ]
    },
    "panelist.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/panelists",
      "required": [
        "organizerKey",
        "webinarKey"
      ]
    },
    "panelist.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/panelists/{panelistKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "panelistKey"
      ]
    },
    "panelist.reinvite": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/panelists/{panelistKey}/resendInvitation",
      "required": [
        "organizerKey",
        "webinarKey",
        "panelistKey"
      ],
      "bodyFrom": []
    },
    "coOrganizer.create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/coorganizers",
      "required": [
        "organizerKey",
        "webinarKey",
        "coOrganizers"
      ],
      "bodyFrom": [
        "coOrganizers"
      ]
    },
    "coOrganizer.list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/coorganizers",
      "required": [
        "organizerKey",
        "webinarKey"
      ]
    },
    "coOrganizer.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/coorganizers/{coorganizerKey}",
      "required": [
        "organizerKey",
        "webinarKey",
        "coorganizerKey"
      ],
      "queryFrom": [
        "external"
      ]
    },
    "coOrganizer.reinvite": {
      "kind": "http",
      "method": "POST",
      "path": "/organizers/{organizerKey}/webinars/{webinarKey}/coorganizers/{coorganizerKey}/resendInvitation",
      "required": [
        "organizerKey",
        "webinarKey",
        "coorganizerKey"
      ],
      "queryFrom": [
        "external"
      ],
      "bodyFrom": []
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
