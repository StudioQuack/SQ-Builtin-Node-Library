{
  "baseUrl": "https://api.xero.com/api.xro/2.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "Xero-Tenant-Id": "{tenant_id}"
  },
  "operations": {
    "contact_create": {
      "kind": "http",
      "method": "POST",
      "path": "/Contacts",
      "bodyFrom": [
        "Name",
        "EmailAddress",
        "FirstName",
        "LastName",
        "Phones",
        "Addresses",
        "IsCustomer",
        "IsSupplier"
      ]
    },
    "contact_get": {
      "kind": "http",
      "method": "GET",
      "path": "/Contacts/{ContactID}",
      "required": [
        "ContactID"
      ]
    },
    "contact_list": {
      "kind": "http",
      "method": "GET",
      "path": "/Contacts",
      "queryFrom": [
        "where",
        "order",
        "page"
      ]
    },
    "contact_update": {
      "kind": "http",
      "method": "POST",
      "path": "/Contacts",
      "bodyFrom": [
        "ContactID",
        "Name"
      ]
    },
    "invoice_create": {
      "kind": "http",
      "method": "POST",
      "path": "/Invoices",
      "bodyFrom": [
        "Type",
        "Contact",
        "LineItems",
        "Date",
        "DueDate",
        "LineAmountTypes",
        "InvoiceNumber",
        "Reference",
        "Status",
        "CurrencyCode"
      ]
    },
    "invoice_get": {
      "kind": "http",
      "method": "GET",
      "path": "/Invoices/{InvoiceID}",
      "required": [
        "InvoiceID"
      ]
    },
    "invoice_list": {
      "kind": "http",
      "method": "GET",
      "path": "/Invoices",
      "queryFrom": [
        "where",
        "Statuses",
        "page"
      ]
    },
    "invoice_update": {
      "kind": "http",
      "method": "POST",
      "path": "/Invoices",
      "bodyFrom": [
        "InvoiceID",
        "Status",
        "Type",
        "Contact",
        "LineItems",
        "Date",
        "DueDate"
      ]
    },
    "payment_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/Payments",
      "bodyFrom": [
        "Invoice",
        "Account",
        "Amount",
        "Date",
        "Reference"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
