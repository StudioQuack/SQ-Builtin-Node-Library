{
  "baseUrl": "https://api.codecov.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "repo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{service}/{owner}/repos/{repo}/",
      "required": [
        "service",
        "owner",
        "repo"
      ]
    },
    "commit_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{service}/{owner}/repos/{repo}/commits/{sha}/",
      "required": [
        "service",
        "owner",
        "repo",
        "sha"
      ]
    },
    "coverage_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{service}/{owner}/repos/{repo}/commits/{sha}/",
      "required": [
        "service",
        "owner",
        "repo",
        "sha"
      ]
    },
    "flag_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{service}/{owner}/repos/{repo}/flags/",
      "required": [
        "service",
        "owner",
        "repo"
      ]
    },
    "compare": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/{service}/{owner}/repos/{repo}/compare/",
      "required": [
        "service",
        "owner",
        "repo"
      ],
      "queryFrom": [
        "base",
        "head",
        "pullid"
      ]
    }
  }
}
