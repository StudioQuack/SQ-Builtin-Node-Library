{
  "baseUrl": "https://api.atlassian.com/ex/jira",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token",
    "userKey": "email"
  },
  "operations": {
    "issue_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{cloud_id}/rest/api/3/issue",
      "required": [
        "cloud_id"
      ],
      "bodyFrom": [
        "fields",
        "summary",
        "project_key",
        "project_id",
        "issuetype",
        "issuetype_id",
        "description",
        "assignee_account_id",
        "reporter_account_id",
        "priority",
        "labels",
        "parent_key",
        "duedate",
        "components"
      ],
      "bodyMap": {
        "summary": "fields.summary",
        "project_key": "fields.project.key",
        "project_id": "fields.project.id",
        "issuetype": "fields.issuetype.name",
        "issuetype_id": "fields.issuetype.id",
        "description": "fields.description",
        "assignee_account_id": "fields.assignee.accountId",
        "reporter_account_id": "fields.reporter.accountId",
        "priority": "fields.priority.name",
        "labels": "fields.labels",
        "parent_key": "fields.parent.key",
        "duedate": "fields.duedate",
        "components": "fields.components"
      }
    },
    "issue_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ],
      "queryFrom": [
        "fieldsQuery",
        "expand"
      ],
      "queryMap": {
        "fieldsQuery": "fields"
      }
    },
    "issue_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/search/jql",
      "required": [
        "cloud_id"
      ],
      "queryFrom": [
        "jql",
        "maxResults",
        "nextPageToken",
        "fieldsQuery"
      ],
      "queryMap": {
        "fieldsQuery": "fields"
      }
    },
    "issue_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ],
      "bodyFrom": [
        "fields",
        "update",
        "summary",
        "project_key",
        "project_id",
        "issuetype",
        "issuetype_id",
        "description",
        "assignee_account_id",
        "reporter_account_id",
        "priority",
        "labels",
        "parent_key",
        "duedate",
        "components"
      ],
      "bodyMap": {
        "summary": "fields.summary",
        "project_key": "fields.project.key",
        "project_id": "fields.project.id",
        "issuetype": "fields.issuetype.name",
        "issuetype_id": "fields.issuetype.id",
        "description": "fields.description",
        "assignee_account_id": "fields.assignee.accountId",
        "reporter_account_id": "fields.reporter.accountId",
        "priority": "fields.priority.name",
        "labels": "fields.labels",
        "parent_key": "fields.parent.key",
        "duedate": "fields.duedate",
        "components": "fields.components"
      }
    },
    "issue_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ]
    },
    "issue_changelog": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/changelog",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ]
    },
    "issue_notify": {
      "kind": "http",
      "method": "POST",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/notify",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ],
      "bodyFrom": [
        "subject",
        "textBody",
        "htmlBody"
      ]
    },
    "issue_transitions": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/transitions",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ]
    },
    "comment_add": {
      "kind": "http",
      "method": "POST",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/comment",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ],
      "bodyFrom": [
        "body",
        "visibility_type",
        "visibility_value"
      ],
      "bodyMap": {
        "visibility_type": "visibility.type",
        "visibility_value": "visibility.value"
      }
    },
    "comment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/comment/{id}",
      "required": [
        "cloud_id",
        "issueIdOrKey",
        "id"
      ]
    },
    "comment_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/comment",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ]
    },
    "comment_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/comment/{id}",
      "required": [
        "cloud_id",
        "issueIdOrKey",
        "id"
      ],
      "bodyFrom": [
        "body",
        "visibility_type",
        "visibility_value"
      ],
      "bodyMap": {
        "visibility_type": "visibility.type",
        "visibility_value": "visibility.value"
      }
    },
    "comment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/comment/{id}",
      "required": [
        "cloud_id",
        "issueIdOrKey",
        "id"
      ]
    },
    "attachment_add": {
      "kind": "http",
      "method": "POST",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}/attachments",
      "required": [
        "cloud_id",
        "issueIdOrKey",
        "file"
      ],
      "bodyFrom": [
        "file"
      ],
      "bodyFormat": "multipart",
      "extraHeaders": {
        "X-Atlassian-Token": "no-check"
      }
    },
    "attachment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/attachment/{id}",
      "required": [
        "cloud_id",
        "id"
      ]
    },
    "attachment_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/issue/{issueIdOrKey}",
      "required": [
        "cloud_id",
        "issueIdOrKey"
      ],
      "queryFrom": [
        "fieldsQuery"
      ],
      "queryMap": {
        "fieldsQuery": "fields"
      }
    },
    "attachment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{cloud_id}/rest/api/3/attachment/{id}",
      "required": [
        "cloud_id",
        "id"
      ]
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{cloud_id}/rest/api/3/user",
      "required": [
        "cloud_id"
      ],
      "queryFrom": [
        "accountId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
