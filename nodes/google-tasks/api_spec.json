{
  "baseUrl": "https://tasks.googleapis.com/tasks/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "add_task": {
      "kind": "http",
      "method": "POST",
      "path": "/lists/{tasklist}/tasks",
      "required": [
        "tasklist"
      ],
      "bodyFrom": [
        "title",
        "notes",
        "due",
        "status",
        "completed",
        "deleted",
        "parent"
      ],
      "queryFrom": [
        "parent",
        "previous"
      ]
    },
    "get_task": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/{tasklist}/tasks/{task}",
      "required": [
        "tasklist",
        "task"
      ]
    },
    "list_tasks": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/{tasklist}/tasks",
      "required": [
        "tasklist"
      ],
      "queryFrom": [
        "maxResults",
        "pageToken",
        "showCompleted",
        "showDeleted",
        "showHidden",
        "dueMin",
        "dueMax",
        "completedMin",
        "completedMax",
        "updatedMin"
      ]
    },
    "update_task": {
      "kind": "http",
      "method": "PATCH",
      "path": "/lists/{tasklist}/tasks/{task}",
      "required": [
        "tasklist",
        "task"
      ],
      "bodyFrom": [
        "title",
        "notes",
        "due",
        "status",
        "completed",
        "deleted"
      ]
    },
    "delete_task": {
      "kind": "http",
      "method": "DELETE",
      "path": "/lists/{tasklist}/tasks/{task}",
      "required": [
        "tasklist",
        "task"
      ]
    },
    "list_tasklists": {
      "kind": "http",
      "method": "GET",
      "path": "/users/@me/lists",
      "queryFrom": [
        "maxResults",
        "pageToken"
      ]
    },
    "create_tasklist": {
      "kind": "http",
      "method": "POST",
      "path": "/users/@me/lists",
      "bodyFrom": [
        "title"
      ]
    }
  }
}
