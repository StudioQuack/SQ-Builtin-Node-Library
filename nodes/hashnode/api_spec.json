{
  "baseUrl": "https://gql.hashnode.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "personal_access_token"
  },
  "extraHeaders": {
    "Accept": "application/json"
  },
  "operations": {
    "post_publish": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "publicationId",
        "title",
        "contentMarkdown",
        "subtitle",
        "slug",
        "tags"
      ],
      "bodyMap": {
        "publicationId": "variables.input.publicationId",
        "title": "variables.input.title",
        "contentMarkdown": "variables.input.contentMarkdown",
        "subtitle": "variables.input.subtitle",
        "slug": "variables.input.slug",
        "tags": "variables.input.tags"
      }
    },
    "post_get": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "id",
        "host",
        "slug"
      ],
      "bodyMap": {
        "id": "variables.id",
        "host": "variables.host",
        "slug": "variables.slug"
      }
    },
    "draft_create": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "publicationId",
        "title",
        "contentMarkdown",
        "subtitle",
        "slug",
        "tags"
      ],
      "bodyMap": {
        "publicationId": "variables.input.publicationId",
        "title": "variables.input.title",
        "contentMarkdown": "variables.input.contentMarkdown",
        "subtitle": "variables.input.subtitle",
        "slug": "variables.input.slug",
        "tags": "variables.input.tags"
      }
    },
    "publication_get": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "host",
        "id"
      ],
      "bodyMap": {
        "host": "variables.host",
        "id": "variables.id"
      }
    }
  }
}
