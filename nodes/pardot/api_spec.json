{
  "baseUrl": "https://pi.pardot.com/api/v5",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "prospect.create": {
      "kind": "http",
      "method": "POST",
      "path": "/objects/prospects",
      "required": [
        "email"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "campaign_id",
        "company",
        "jobTitle",
        "phone",
        "website",
        "city",
        "state",
        "zip",
        "country",
        "source",
        "score",
        "addressOne",
        "addressTwo",
        "annualRevenue",
        "comments",
        "department",
        "employees",
        "fax",
        "industry",
        "isDoNotCall",
        "isDoNotEmail",
        "isReviewed",
        "isStarred",
        "notes",
        "optedOut",
        "prospectAccountId",
        "salesforceId",
        "salesforceOwnerId",
        "salutation",
        "territory",
        "userId",
        "yearsInBusiness",
        "profileId",
        "fields"
      ]
    },
    "prospect.upsert": {
      "kind": "http",
      "method": "POST",
      "path": "/objects/prospects/do/upsertLatestByEmail",
      "required": [
        "email"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name",
        "campaign_id",
        "company",
        "jobTitle",
        "phone",
        "website",
        "city",
        "state",
        "zip",
        "country",
        "source",
        "score",
        "addressOne",
        "addressTwo",
        "annualRevenue",
        "comments",
        "department",
        "employees",
        "fax",
        "industry",
        "isDoNotCall",
        "isDoNotEmail",
        "isReviewed",
        "isStarred",
        "notes",
        "optedOut",
        "prospectAccountId",
        "salesforceId",
        "salesforceOwnerId",
        "salutation",
        "territory",
        "userId",
        "yearsInBusiness",
        "profileId",
        "fields",
        "secondaryDeletedSearch",
        "secondary_deleted_search"
      ]
    },
    "prospect.get": {
      "kind": "http",
      "method": "GET",
      "path": "/objects/prospects/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "fields"
      ]
    },
    "prospect.update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/objects/prospects/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "first_name",
        "last_name",
        "campaign_id",
        "company",
        "jobTitle",
        "phone",
        "website",
        "city",
        "state",
        "zip",
        "country",
        "source",
        "score",
        "addressOne",
        "addressTwo",
        "annualRevenue",
        "comments",
        "department",
        "employees",
        "fax",
        "industry",
        "isDoNotCall",
        "isDoNotEmail",
        "isReviewed",
        "isStarred",
        "notes",
        "optedOut",
        "prospectAccountId",
        "salesforceId",
        "salesforceOwnerId",
        "salutation",
        "territory",
        "userId",
        "yearsInBusiness",
        "profileId",
        "fields",
        "email"
      ]
    },
    "prospect.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/objects/prospects/{id}",
      "required": [
        "id"
      ]
    },
    "list.membership.add": {
      "kind": "http",
      "method": "POST",
      "path": "/objects/list-memberships",
      "required": [
        "list_id",
        "prospect_id"
      ],
      "bodyFrom": [
        "list_id",
        "prospect_id"
      ]
    },
    "list.membership.remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/objects/list-memberships/{membership_id}",
      "required": [
        "membership_id"
      ]
    },
    "campaign.list": {
      "kind": "http",
      "method": "GET",
      "path": "/objects/campaigns",
      "required": [],
      "queryFrom": [
        "fields",
        "limit",
        "offset"
      ]
    },
    "email.send": {
      "kind": "http",
      "method": "POST",
      "path": "/objects/emails",
      "required": [
        "campaign_id",
        "prospect_id",
        "name",
        "subject"
      ],
      "bodyFrom": [
        "name",
        "subject",
        "textMessage",
        "campaign_id",
        "prospect_id",
        "html_message",
        "senderOptions"
      ]
    },
    "visitor.get": {
      "kind": "http",
      "method": "GET",
      "path": "/objects/visitors/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "fields"
      ]
    },
    "form.get": {
      "kind": "http",
      "method": "GET",
      "path": "/objects/forms/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "fields"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  },
  "extraHeaders": {
    "Pardot-Business-Unit-Id": "{business_unit_id}"
  }
}
