{
  "baseUrl": "https://docs.googleapis.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create": {
      "kind": "http",
      "method": "POST",
      "path": "/documents",
      "bodyFrom": [
        "title"
      ]
    },
    "get": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{documentId}",
      "required": [
        "documentId"
      ],
      "queryFrom": [
        "includeTabsContent",
        "suggestionsViewMode"
      ]
    },
    "batch_update": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/{documentId}:batchUpdate",
      "required": [
        "documentId"
      ],
      "bodyFrom": [
        "requests"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
