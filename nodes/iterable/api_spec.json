{
  "baseUrl": "https://{region}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "user.upsert": {
      "kind": "http",
      "method": "POST",
      "path": "/api/users/update",
      "required": [],
      "bodyFrom": ["email", "userId", "dataFields", "preferUserId"]
    },
    "user.get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/users/{email}",
      "required": ["email"]
    },
    "user.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/users/{email}",
      "required": ["email"]
    },
    "event.track": {
      "kind": "http",
      "method": "POST",
      "path": "/api/events/track",
      "required": ["eventName"],
      "bodyFrom": ["eventName", "email", "userId", "dataFields", "createdAt", "campaignId"]
    },
    "list.add": {
      "kind": "http",
      "method": "POST",
      "path": "/api/lists/subscribe",
      "required": ["listId", "subscribers"],
      "bodyFrom": ["listId", "subscribers"]
    },
    "list.remove": {
      "kind": "http",
      "method": "POST",
      "path": "/api/lists/unsubscribe",
      "required": ["listId", "subscribers"],
      "bodyFrom": ["listId", "subscribers"]
    },
    "catalog.upsert": {
      "kind": "http",
      "method": "PUT",
      "path": "/api/catalogs/{catalogName}/items/{itemId}",
      "required": ["catalogName", "itemId"],
      "bodyFrom": ["update"]
    },
    "campaign.trigger": {
      "kind": "http",
      "method": "POST",
      "path": "/api/campaigns/trigger",
      "required": ["campaignId", "recipients"],
      "bodyFrom": ["campaignId", "recipients", "allowRepeatMarketingSends"]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
