{
  "baseUrl": "https://api.docparser.com/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "api_key",
    "prefix": "",
    "configKey": "api_key"
  },
  "docs": "https://docparser.com/api/",
  "operations": {
    "document_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/document/upload/{parser_id}",
      "required": [
        "parser_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "file",
        "url",
        "remote_id",
        "filename"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/document/status/{parser_id}/{document_id}",
      "required": [
        "parser_id",
        "document_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "parsed_data_get": {
      "kind": "http",
      "method": "GET",
      "path": "/results/{parser_id}/{document_id}",
      "required": [
        "parser_id",
        "document_id"
      ],
      "queryFrom": [
        "format",
        "include_children"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "parser_list": {
      "kind": "http",
      "method": "GET",
      "path": "/parsers",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
