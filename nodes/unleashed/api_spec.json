{
  "baseUrl": "https://api.unleashedsoftware.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "api-auth-id",
    "prefix": "",
    "configKey": "api_id"
  },
  "extraHeaders": {
    "client-type": "{client_type}"
  },
  "operations": {
    "product_get": {
      "kind": "http",
      "method": "GET",
      "path": "/Products/{productGuid}",
      "required": [
        "productGuid"
      ]
    },
    "sales_order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/SalesOrders/{orderGuid}",
      "required": [
        "orderGuid"
      ]
    },
    "purchase_order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/PurchaseOrders/{orderGuid}",
      "required": [
        "orderGuid"
      ]
    },
    "stock_on_hand": {
      "kind": "http",
      "method": "GET",
      "path": "/StockOnHand",
      "queryFrom": [
        "warehouseCode",
        "asAtDate"
      ]
    }
  }
}
