{
  "baseUrl": "https://en.wikipedia.org",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/w/api.php?action=query&list=search&format=json",
      "required": [
        "srsearch"
      ],
      "queryFrom": [
        "srsearch",
        "srlimit",
        "sroffset"
      ]
    },
    "get_page": {
      "kind": "http",
      "method": "GET",
      "path": "/w/api.php?action=query&prop=revisions&rvslots=main&rvprop=content&format=json",
      "required": [
        "titles"
      ],
      "queryFrom": [
        "titles"
      ]
    },
    "get_summary": {
      "kind": "http",
      "method": "GET",
      "path": "/api/rest_v1/page/summary/{title}",
      "required": [
        "title"
      ]
    },
    "get_extract": {
      "kind": "http",
      "method": "GET",
      "path": "/w/api.php?action=query&prop=extracts&exintro=1&explaintext=1&format=json",
      "required": [
        "titles"
      ],
      "queryFrom": [
        "titles"
      ]
    }
  }
}
