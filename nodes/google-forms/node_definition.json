          "required": false,
          "value": "form.get",
          "description": "Overrides config operation when non-blank. EXACT: 'form.get' | 'form.create' | 'form.update' | 'question.list' | 'response.list' | 'response.get' | 'watch.responses' | 'trigger.listen'. trigger.listen never opens a socket.",
          "children": []
        },
        {
