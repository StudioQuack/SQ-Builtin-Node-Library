          "label": "info",
          "type": "object",
          "required": false,
          "value": "{}",
          "description": "form.create: { title } (and documentTitle if used). Create is title-only; add questions with form.update.",
          "children": []
        },
        {
          "shortCode": "requests",
          "label": "requests",
          "type": "list",
          "required": false,
          "value": "[]",
          "description": "form.update batchUpdate requests (createItem, updateItem, …). Cap length. Each request needs a known oneof key.",
