{
  "baseUrl": "https://api.ebay.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "offer_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sell/inventory/v1/offer/{offerId}",
      "required": [
        "offerId"
      ]
    },
    "inventory_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/sell/inventory/v1/inventory_item/{sku}",
      "required": [
        "sku"
      ],
      "bodyFrom": [
        "product",
        "availability",
        "condition",
        "conditionDescription",
        "packageWeightAndSize",
        "locale"
      ],
      "extraHeaders": {
        "Content-Language": "{content_language}"
      }
    },
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sell/fulfillment/v1/order",
      "queryFrom": [
        "filter",
        "limit",
        "offset",
        "orderIds"
      ]
    },
    "fulfillment": {
      "kind": "http",
      "method": "POST",
      "path": "/sell/fulfillment/v1/order/{orderId}/shipping_fulfillment",
      "required": [
        "orderId"
      ],
      "bodyFrom": [
        "lineItems",
        "shippedDate",
        "shippingCarrierCode",
        "trackingNumber"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "extraHeaders": {
    "X-EBAY-C-MARKETPLACE-ID": "{marketplace_id}"
  }
}
