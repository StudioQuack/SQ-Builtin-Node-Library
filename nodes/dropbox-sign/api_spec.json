{
  "baseUrl": "https://api.hellosign.com/v3",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "userKey": "",
    "basicKeyPosition": "username"
  },
  "docs": "https://developers.hellosign.com/api/reference/overview/",
  "operations": {
    "signature_request_send": {
      "kind": "http",
      "method": "POST",
      "path": "/signature_request/send",
      "required": [
        "signers"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "title",
        "subject",
        "message",
        "signers",
        "file_urls",
        "cc_email_addresses",
        "test_mode",
        "signing_redirect_url",
        "metadata",
        "client_id",
        "use_text_tags",
        "hide_text_tags"
      ],
      "contentType": "application/x-www-form-urlencoded",
      "bodyFormat": "form"
    },
    "signature_request_get": {
      "kind": "http",
      "method": "GET",
      "path": "/signature_request/{signature_request_id}",
      "required": [
        "signature_request_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "signature_request_list": {
      "kind": "http",
      "method": "GET",
      "path": "/signature_request/list",
      "required": [],
      "queryFrom": [
        "page",
        "page_size"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "signature_request_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "/signature_request/cancel/{signature_request_id}",
      "required": [
        "signature_request_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "signature_request_files": {
      "kind": "http",
      "method": "GET",
      "path": "/signature_request/files/{signature_request_id}",
      "required": [
        "signature_request_id"
      ],
      "queryFrom": [
        "file_type"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_get": {
      "kind": "http",
      "method": "GET",
      "path": "/template/{template_id}",
      "required": [
        "template_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_list": {
      "kind": "http",
      "method": "GET",
      "path": "/template/list",
      "required": [],
      "queryFrom": [
        "page",
        "page_size"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "template_delete": {
      "kind": "http",
      "method": "POST",
      "path": "/template/delete/{template_id}",
      "required": [
        "template_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
