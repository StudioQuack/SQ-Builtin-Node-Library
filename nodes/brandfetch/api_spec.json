{
  "baseUrl": "https://api.brandfetch.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "brand_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/brands/domain/{domain}",
      "required": [
        "domain"
      ]
    },
    "logo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/brands/domain/{domain}",
      "required": [
        "domain"
      ]
    },
    "color_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/brands/domain/{domain}",
      "required": [
        "domain"
      ]
    }
  }
}
