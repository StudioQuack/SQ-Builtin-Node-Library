{
  "baseUrl": "https://newsdata.io/api/1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-ACCESS-KEY",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "latest": {
      "kind": "http",
      "method": "GET",
      "path": "/latest",
      "required": [],
      "queryFrom": [
        "q",
        "language",
        "country",
        "category",
        "domain",
        "page",
        "size"
      ]
    },
    "crypto": {
      "kind": "http",
      "method": "GET",
      "path": "/crypto",
      "required": [],
      "queryFrom": [
        "q",
        "coin",
        "language",
        "domainurl",
        "page",
        "size"
      ]
    },
    "sources": {
      "kind": "http",
      "method": "GET",
      "path": "/sources",
      "required": [],
      "queryFrom": [
        "country",
        "category",
        "language"
      ]
    },
    "archive": {
      "kind": "http",
      "method": "GET",
      "path": "/archive",
      "required": [
        "from_date"
      ],
      "queryFrom": [
        "q",
        "from_date",
        "to_date",
        "language",
        "country",
        "category",
        "page",
        "size"
      ]
    }
  }
}
