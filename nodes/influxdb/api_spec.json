{
  "baseUrl": "http://localhost:8181",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "query.sql": {
      "method": "POST",
      "path": "/api/v3/query_sql",
      "bodyFrom": [
        "db",
        "q",
        "params",
        "format"
      ],
      "required": [
        "db",
        "q"
      ],
      "kind": "http"
    },
    "query.influxql": {
      "method": "POST",
      "path": "/api/v3/query_influxql",
      "bodyFrom": [
        "db",
        "q",
        "params",
        "format"
      ],
      "required": [
        "db",
        "q"
      ],
      "kind": "http"
    }
  }
}
