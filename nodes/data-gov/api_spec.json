{
  "baseUrl": "https://api.gsa.gov/technology/datagov/v4",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [],
      "queryFrom": [
        "q",
        "sort",
        "per_page",
        "org_slug",
        "org_type",
        "keyword",
        "spatial_filter",
        "spatial_geometry",
        "spatial_within",
        "after"
      ],
      "bodyFrom": []
    },
    "keywords": {
      "kind": "http",
      "method": "GET",
      "path": "/keywords",
      "required": [],
      "queryFrom": [
        "size",
        "min_count"
      ],
      "bodyFrom": []
    },
    "organizations": {
      "kind": "http",
      "method": "GET",
      "path": "/organizations",
      "required": [],
      "queryFrom": [],
      "bodyFrom": []
    },
    "locations_search": {
      "kind": "http",
      "method": "GET",
      "path": "/locations/search",
      "required": [],
      "queryFrom": [
        "q",
        "size"
      ],
      "bodyFrom": []
    },
    "location_get": {
      "kind": "http",
      "method": "GET",
      "path": "/location/{location_id}",
      "required": [
        "location_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "harvest_record": {
      "kind": "http",
      "method": "GET",
      "path": "/harvest_record/{record_id}",
      "required": [
        "record_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "harvest_record_raw": {
      "kind": "http",
      "method": "GET",
      "path": "/harvest_record/{record_id}/raw",
      "required": [
        "record_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "harvest_record_transformed": {
      "kind": "http",
      "method": "GET",
      "path": "/harvest_record/{record_id}/transformed",
      "required": [
        "record_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
