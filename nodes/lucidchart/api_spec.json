{
  "baseUrl": "https://api.lucid.co/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "document_create": {
      "kind": "http",
      "method": "POST",
      "path": "/documents",
      "bodyFrom": [
        "title",
        "product"
      ]
    },
    "document_get": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{documentId}",
      "required": [
        "documentId"
      ]
    },
    "document_search": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/search",
      "bodyFrom": [
        "keywords"
      ]
    },
    "document_trash": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/{documentId}/trash",
      "required": [
        "documentId"
      ]
    },
    "folder_list": {
      "kind": "http",
      "method": "GET",
      "path": "/folders",
      "queryFrom": [
        "parent"
      ]
    },
    "collaborator_add": {
      "kind": "http",
      "method": "POST",
      "path": "/documents/{documentId}/collaborators",
      "required": [
        "documentId"
      ],
      "bodyFrom": [
        "role"
      ]
    },
    "collaborator_remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/documents/{documentId}/collaborators/{collaboratorId}",
      "required": [
        "documentId",
        "collaboratorId"
      ]
    },
    "embed_get": {
      "kind": "http",
      "method": "GET",
      "path": "/documents/{documentId}/embed",
      "required": [
        "documentId"
      ]
    }
  }
}
