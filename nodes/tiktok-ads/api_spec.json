{
  "baseUrl": "https://business-api.tiktok.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Access-Token",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "advertiser.list": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/oauth2/advertiser/get/",
      "queryFrom": [
        "app_id",
        "secret"
      ]
    },
    "campaign.create": {
      "kind": "http",
      "method": "POST",
      "path": "/open_api/v1.3/campaign/create/",
      "required": [
        "advertiser_id",
        "campaign_name",
        "objective_type"
      ],
      "bodyFrom": [
        "advertiser_id",
        "campaign_name",
        "objective_type",
        "budget_mode",
        "budget",
        "operation_status"
      ]
    },
    "campaign.get": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/campaign/get/",
      "required": [
        "advertiser_id"
      ],
      "queryFrom": [
        "advertiser_id",
        "filtering",
        "fields",
        "page",
        "page_size"
      ]
    },
    "campaign.list": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/campaign/get/",
      "required": [
        "advertiser_id"
      ],
      "queryFrom": [
        "advertiser_id",
        "filtering",
        "fields",
        "page",
        "page_size"
      ]
    },
    "adgroup.create": {
      "kind": "http",
      "method": "POST",
      "path": "/open_api/v1.3/adgroup/create/",
      "required": [
        "advertiser_id",
        "campaign_id",
        "adgroup_name"
      ],
      "bodyFrom": [
        "advertiser_id",
        "campaign_id",
        "adgroup_name",
        "placement_type",
        "budget",
        "bid_type",
        "optimization_goal",
        "location_ids",
        "billing_event",
        "schedule_type",
        "schedule_start_time"
      ]
    },
    "adgroup.list": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/adgroup/get/",
      "required": [
        "advertiser_id"
      ],
      "queryFrom": [
        "advertiser_id",
        "filtering",
        "fields",
        "page",
        "page_size"
      ]
    },
    "ad.create": {
      "kind": "http",
      "method": "POST",
      "path": "/open_api/v1.3/ad/create/",
      "required": [
        "advertiser_id",
        "adgroup_id",
        "ad_name",
        "creatives"
      ],
      "bodyFrom": [
        "advertiser_id",
        "adgroup_id",
        "ad_name",
        "creatives",
        "tracking_pixel_id"
      ]
    },
    "ad.list": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/ad/get/",
      "required": [
        "advertiser_id"
      ],
      "queryFrom": [
        "advertiser_id",
        "filtering",
        "fields",
        "page",
        "page_size"
      ]
    },
    "report.get": {
      "kind": "http",
      "method": "GET",
      "path": "/open_api/v1.3/report/integrated/get/",
      "required": [
        "advertiser_id",
        "report_type",
        "data_level",
        "dimensions",
        "metrics",
        "start_date",
        "end_date"
      ],
      "queryFrom": [
        "advertiser_id",
        "report_type",
        "data_level",
        "dimensions",
        "metrics",
        "start_date",
        "end_date",
        "page",
        "page_size"
      ]
    },
    "pixel.track": {
      "kind": "http",
      "method": "POST",
      "path": "/open_api/v1.3/event/track/",
      "required": [
        "event_source",
        "event_source_id",
        "event"
      ],
      "bodyFrom": [
        "event_source",
        "event_source_id",
        "data",
        "test_event_code",
        "partner_name",
        "event",
        "event_time",
        "event_id",
        "user",
        "properties",
        "page"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "data": "data[0]",
        "event": "data[0].event",
        "event_time": "data[0].event_time",
        "event_id": "data[0].event_id",
        "user": "data[0].user",
        "properties": "data[0].properties",
        "page": "data[0].page"
      }
    },
    "lead.list": {
      "kind": "http",
      "method": "POST",
      "path": "/open_api/v1.3/page/lead/task/",
      "required": [
        "advertiser_id"
      ],
      "bodyFrom": [
        "advertiser_id",
        "library_id",
        "ad_id",
        "page_id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
