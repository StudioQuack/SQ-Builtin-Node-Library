{
  "baseUrl": "https://api.tapfiliate.com/1.6",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "affiliate_create": {
      "kind": "http",
      "method": "POST",
      "path": "/affiliates/",
      "bodyFrom": [
        "firstname",
        "lastname",
        "email",
        "company",
        "address"
      ],
      "required": [
        "firstname",
        "lastname",
        "email"
      ],
      "contentType": "application/json"
    },
    "click_create": {
      "kind": "http",
      "method": "POST",
      "path": "/clicks/",
      "bodyFrom": [
        "referral_code",
        "source_id",
        "referrer"
      ],
      "required": [
        "referral_code"
      ],
      "contentType": "application/json"
    },
    "conversion_create": {
      "kind": "http",
      "method": "POST",
      "path": "/conversions/",
      "required": [
        "external_id"
      ],
      "bodyFrom": [
        "click_id",
        "referral_code",
        "coupon",
        "external_id",
        "amount",
        "currency",
        "commission_type",
        "customer_id",
        "meta_data"
      ],
      "contentType": "application/json"
    },
    "program_list": {
      "kind": "http",
      "method": "GET",
      "path": "/programs/",
      "queryFrom": [
        "asset_id"
      ]
    }
  }
}
