{
  "baseUrl": "https://api.dropboxapi.com/2",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://www.dropbox.com/developers/documentation/http/documentation",
  "operations": {
    "copy_file": {
      "kind": "http",
      "method": "POST",
      "path": "/files/copy_v2",
      "required": [
        "from_path",
        "to_path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "from_path",
        "to_path",
        "autorename"
      ],
      "contentType": "application/json"
    },
    "delete_file": {
      "kind": "http",
      "method": "POST",
      "path": "/files/delete_v2",
      "required": [
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "path"
      ],
      "contentType": "application/json"
    },
    "download": {
      "kind": "http",
      "method": "POST",
      "path": "/files/download",
      "required": [
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/octet-stream",
      "baseUrl": "https://content.dropboxapi.com/2",
      "extraHeaders": {
        "Dropbox-API-Arg": "{\"path\":\"{path}\"}"
      }
    },
    "move_file": {
      "kind": "http",
      "method": "POST",
      "path": "/files/move_v2",
      "required": [
        "from_path",
        "to_path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "from_path",
        "to_path",
        "autorename"
      ],
      "contentType": "application/json"
    },
    "upload": {
      "kind": "http",
      "method": "POST",
      "path": "/files/upload",
      "required": [
        "path",
        "file"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/octet-stream",
      "baseUrl": "https://content.dropboxapi.com/2",
      "bodyFormat": "raw",
      "bodyParam": "file",
      "extraHeaders": {
        "Dropbox-API-Arg": "{\"path\":\"{path}\"}"
      }
    },
    "copy_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/copy_v2",
      "required": [
        "from_path",
        "to_path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "from_path",
        "to_path"
      ],
      "contentType": "application/json"
    },
    "create_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/create_folder_v2",
      "required": [
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "path",
        "autorename"
      ],
      "contentType": "application/json"
    },
    "delete_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/delete_v2",
      "required": [
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "path"
      ],
      "contentType": "application/json"
    },
    "list_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/list_folder",
      "required": [
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "path",
        "recursive",
        "limit",
        "include_media_info",
        "include_deleted",
        "include_non_downloadable_files",
        "cursor"
      ],
      "contentType": "application/json"
    },
    "move_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/move_v2",
      "required": [
        "from_path",
        "to_path"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "from_path",
        "to_path"
      ],
      "contentType": "application/json"
    },
    "search": {
      "kind": "http",
      "method": "POST",
      "path": "/files/search_v2",
      "required": [
        "query"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "query",
        "options"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
