{
  "baseUrl": "https://api.lumalabs.ai/dream-machine/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "generate_video": {
      "kind": "http",
      "method": "POST",
      "path": "/generations",
      "required": ["prompt"],
      "bodyFrom": ["prompt", "model", "resolution", "duration", "aspect_ratio", "loop", "keyframes", "concepts", "callback_url"]
    },
    "get_generation": {
      "kind": "http",
      "method": "GET",
      "path": "/generations/{id}",
      "required": ["id"]
    }
  }
}
