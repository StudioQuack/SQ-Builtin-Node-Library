{
  "baseUrl": "https://api.kraken.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "API-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "ticker": {
      "kind": "http",
      "method": "GET",
      "path": "/0/public/Ticker",
      "queryFrom": [
        "pair"
      ]
    },
    "ohlc": {
      "kind": "http",
      "method": "GET",
      "path": "/0/public/OHLC",
      "queryFrom": [
        "pair",
        "interval"
      ]
    },
    "balance": {
      "kind": "http",
      "method": "POST",
      "path": "/0/private/Balance",
      "bodyFrom": [
        "nonce"
      ]
    },
    "add_order": {
      "kind": "http",
      "method": "POST",
      "path": "/0/private/AddOrder",
      "bodyFrom": [
        "nonce",
        "ordertype",
        "type",
        "volume",
        "pair"
      ]
    },
    "cancel_order": {
      "kind": "http",
      "method": "POST",
      "path": "/0/private/CancelOrder",
      "bodyFrom": [
        "nonce",
        "txid"
      ]
    },
    "ledgers": {
      "kind": "http",
      "method": "POST",
      "path": "/0/private/Ledgers",
      "bodyFrom": [
        "nonce"
      ]
    }
  }
}
