{
  "baseUrl": "https://api.aircall.io/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token",
    "userKey": "api_id"
  },
  "operations": {
    "start-call": {
      "kind": "http",
      "method": "POST",
      "path": "/users/{id}/calls",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "number_id",
        "to"
      ]
    },
    "transfer-call": {
      "kind": "http",
      "method": "POST",
      "path": "/calls/{id}/transfers",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "user_id",
        "team_id",
        "number",
        "dispatching_strategy"
      ]
    },
    "comment-call": {
      "kind": "http",
      "method": "POST",
      "path": "/calls/{id}/comments",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "content"
      ]
    },
    "tag-call": {
      "kind": "http",
      "method": "POST",
      "path": "/calls/{id}/tags",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "tags"
      ]
    },
    "archive-call": {
      "kind": "http",
      "method": "PUT",
      "path": "/calls/{id}/archive",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "get-call": {
      "kind": "http",
      "method": "GET",
      "path": "/calls/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "search-calls": {
      "kind": "http",
      "method": "GET",
      "path": "/calls",
      "contentType": "application/json",
      "queryFrom": [
        "from",
        "to",
        "phone_number",
        "per_page",
        "page"
      ]
    },
    "create-contact": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts",
      "contentType": "application/json",
      "required": [
        "phone_numbers"
      ],
      "bodyFrom": [
        "first_name",
        "last_name",
        "phone_numbers"
      ]
    },
    "update-contact": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "first_name",
        "last_name",
        "phone_numbers"
      ]
    },
    "delete-contact": {
      "kind": "http",
      "method": "DELETE",
      "path": "/contacts/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "send-message": {
      "kind": "http",
      "method": "POST",
      "path": "/numbers/{id}/messages/send",
      "contentType": "application/json",
      "required": [
        "id",
        "to"
      ],
      "bodyFrom": [
        "to",
        "body",
        "mediaUrl"
      ]
    },
    "create-user": {
      "kind": "http",
      "method": "POST",
      "path": "/users",
      "contentType": "application/json",
      "required": [
        "email",
        "first_name",
        "last_name"
      ],
      "bodyFrom": [
        "email",
        "first_name",
        "last_name"
      ]
    },
    "update-user": {
      "kind": "http",
      "method": "PUT",
      "path": "/users/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "first_name",
        "last_name"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
