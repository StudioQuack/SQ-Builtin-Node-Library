{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "X-Odoo-Database": "{db}"
  },
  "operations": {
    "search_read": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/json/2/{model}/search_read",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "domain",
        "fields",
        "limit",
        "offset",
        "order",
        "context"
      ]
    },
    "create": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/json/2/{model}/create",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "vals_list",
        "context"
      ]
    },
    "write": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/json/2/{model}/write",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "ids",
        "vals",
        "context"
      ]
    },
    "unlink": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/json/2/{model}/unlink",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "ids",
        "context"
      ]
    },
    "call_kw": {
      "kind": "http",
      "method": "POST",
      "path": "{store_host}/json/2/{model}/{method}",
      "required": [
        "model",
        "method"
      ],
      "bodyFrom": [
        "ids",
        "context",
        "domain",
        "fields",
        "vals_list",
        "vals"
      ]
    }
  }
}
