{
  "baseUrl": "https://gql.waveapps.com/graphql",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "customer_create": {
      "kind": "http",
      "method": "POST",
      "path": "/public",
      "bodyFrom": [
        "query",
        "businessId",
        "name",
        "firstName",
        "lastName",
        "email",
        "currency",
        "phone",
        "mobile",
        "website"
      ],
      "bodyMap": {
        "businessId": "variables.input.businessId",
        "name": "variables.input.name",
        "firstName": "variables.input.firstName",
        "lastName": "variables.input.lastName",
        "email": "variables.input.email",
        "currency": "variables.input.currency",
        "phone": "variables.input.phone",
        "mobile": "variables.input.mobile",
        "website": "variables.input.website"
      }
    },
    "invoice_create": {
      "kind": "http",
      "method": "POST",
      "path": "/public",
      "bodyFrom": [
        "query",
        "businessId",
        "customerId",
        "items",
        "invoiceNumber",
        "invoiceDate",
        "dueDate",
        "currency",
        "memo"
      ],
      "bodyMap": {
        "businessId": "variables.input.businessId",
        "customerId": "variables.input.customerId",
        "items": "variables.input.items",
        "invoiceNumber": "variables.input.invoiceNumber",
        "invoiceDate": "variables.input.invoiceDate",
        "dueDate": "variables.input.dueDate",
        "currency": "variables.input.currency",
        "memo": "variables.input.memo"
      }
    },
    "invoice_list": {
      "kind": "http",
      "method": "POST",
      "path": "/public",
      "bodyFrom": [
        "query",
        "businessId",
        "page",
        "pageSize"
      ],
      "bodyMap": {
        "businessId": "variables.businessId",
        "page": "variables.page",
        "pageSize": "variables.pageSize"
      }
    },
    "transaction_list": {
      "kind": "http",
      "method": "POST",
      "path": "/public",
      "bodyFrom": [
        "query",
        "businessId",
        "page",
        "pageSize"
      ],
      "bodyMap": {
        "businessId": "variables.businessId",
        "page": "variables.page",
        "pageSize": "variables.pageSize"
      }
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
