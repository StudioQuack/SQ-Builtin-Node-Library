{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "get-secret": {
      "kind": "http",
      "method": "GET",
      "path": "{vaultHost}/secrets/{secretName}",
      "required": [
        "vaultHost",
        "secretName"
      ],
      "queryFrom": [
        "api-version"
      ]
    },
    "set-secret": {
      "kind": "http",
      "method": "PUT",
      "path": "{vaultHost}/secrets/{secretName}",
      "required": [
        "vaultHost",
        "secretName"
      ],
      "queryFrom": [
        "api-version"
      ],
      "bodyFrom": [
        "value",
        "contentType",
        "tags",
        "attributes"
      ]
    },
    "delete-secret": {
      "kind": "http",
      "method": "DELETE",
      "path": "{vaultHost}/secrets/{secretName}",
      "required": [
        "vaultHost",
        "secretName"
      ],
      "queryFrom": [
        "api-version"
      ]
    },
    "list-secrets": {
      "kind": "http",
      "method": "GET",
      "path": "{vaultHost}/secrets",
      "required": [
        "vaultHost"
      ],
      "queryFrom": [
        "api-version",
        "maxresults"
      ]
    },
    "get-key": {
      "kind": "http",
      "method": "GET",
      "path": "{vaultHost}/keys/{keyName}",
      "required": [
        "vaultHost",
        "keyName"
      ],
      "queryFrom": [
        "api-version"
      ]
    },
    "encrypt": {
      "kind": "http",
      "method": "POST",
      "path": "{vaultHost}/keys/{keyName}/{keyVersion}/encrypt",
      "required": [
        "vaultHost",
        "keyName",
        "keyVersion"
      ],
      "queryFrom": [
        "api-version"
      ],
      "bodyFrom": [
        "alg",
        "value",
        "iv",
        "aad"
      ]
    },
    "decrypt": {
      "kind": "http",
      "method": "POST",
      "path": "{vaultHost}/keys/{keyName}/{keyVersion}/decrypt",
      "required": [
        "vaultHost",
        "keyName",
        "keyVersion"
      ],
      "queryFrom": [
        "api-version"
      ],
      "bodyFrom": [
        "alg",
        "value",
        "iv",
        "aad",
        "tag"
      ]
    },
    "get-certificate": {
      "kind": "http",
      "method": "GET",
      "path": "{vaultHost}/certificates/{certificateName}",
      "required": [
        "vaultHost",
        "certificateName"
      ],
      "queryFrom": [
        "api-version"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
