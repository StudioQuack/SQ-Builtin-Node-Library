{
  "baseUrl": "https://api.unsplash.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Client-ID ",
    "configKey": "access_key"
  },
  "operations": {
    "search_photos": {
      "kind": "http",
      "method": "GET",
      "path": "/search/photos",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "page",
        "per_page",
        "orientation",
        "color",
        "order_by"
      ]
    },
    "photo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/photos/{id}",
      "required": [
        "id"
      ]
    },
    "random": {
      "kind": "http",
      "method": "GET",
      "path": "/photos/random",
      "required": [],
      "queryFrom": [
        "query",
        "count",
        "orientation"
      ]
    },
    "download_trigger": {
      "kind": "http",
      "method": "GET",
      "path": "/photos/{id}/download",
      "required": [
        "id"
      ]
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{username}",
      "required": [
        "username"
      ]
    }
  }
}
