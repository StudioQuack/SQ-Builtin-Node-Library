{
  "baseUrl": "https://data.nasdaq.com/api/v3",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "dataset_get": {
      "kind": "http",
      "method": "GET",
      "path": "/datasets/{database_code}/{dataset_code}.json",
      "required": [
        "database_code",
        "dataset_code"
      ],
      "queryFrom": [
        "start_date",
        "end_date",
        "limit",
        "collapse",
        "order"
      ],
      "bodyFrom": []
    },
    "datatable_get": {
      "kind": "http",
      "method": "GET",
      "path": "/datatables/{publisher}/{table}.json",
      "required": [
        "publisher",
        "table"
      ],
      "queryFrom": [
        "qopts.per_page",
        "qopts.cursor_id"
      ],
      "bodyFrom": []
    },
    "metadata_get": {
      "kind": "http",
      "method": "GET",
      "path": "/datasets/{database_code}/{dataset_code}/metadata.json",
      "required": [
        "database_code",
        "dataset_code"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
