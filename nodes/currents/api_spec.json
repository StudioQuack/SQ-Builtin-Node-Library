{
  "baseUrl": "https://api.currentsapi.services/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [],
      "queryFrom": [
        "keywords",
        "language",
        "country",
        "category",
        "start_date",
        "end_date"
      ]
    },
    "latest": {
      "kind": "http",
      "method": "GET",
      "path": "/latest-news",
      "required": [],
      "queryFrom": [
        "language",
        "country",
        "category"
      ]
    },
    "available": {
      "kind": "http",
      "method": "GET",
      "path": "/available/{catalog}",
      "required": [
        "catalog"
      ]
    }
  }
}
