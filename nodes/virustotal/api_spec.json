{
  "baseUrl": "https://www.virustotal.com/api/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-apikey",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "scan-url": {
      "kind": "http",
      "method": "POST",
      "path": "/urls",
      "required": [
        "url"
      ],
      "bodyFrom": [
        "url"
      ],
      "contentType": "application/x-www-form-urlencoded",
      "bodyFormat": "form"
    },
    "scan-file": {
      "kind": "http",
      "method": "POST",
      "path": "/files",
      "required": [
        "file"
      ],
      "bodyFrom": [
        "file"
      ],
      "bodyFormat": "multipart"
    },
    "get-file-report": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{id}",
      "required": [
        "id"
      ]
    },
    "get-url-report": {
      "kind": "http",
      "method": "GET",
      "path": "/urls/{id}",
      "required": [
        "id"
      ]
    },
    "get-ip-report": {
      "kind": "http",
      "method": "GET",
      "path": "/ip_addresses/{ip}",
      "required": [
        "ip"
      ]
    },
    "get-domain-report": {
      "kind": "http",
      "method": "GET",
      "path": "/domains/{domain}",
      "required": [
        "domain"
      ]
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query"
      ]
    }
  }
}
