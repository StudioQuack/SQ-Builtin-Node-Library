{
  "baseUrl": "https://api.postman.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-API-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "collection_get": {
      "kind": "http",
      "method": "GET",
      "path": "/collections/{collection_uid}",
      "required": [
        "collection_uid"
      ]
    },
    "collection_run": {
      "kind": "http",
      "method": "GET",
      "path": "/collections/{collection_uid}/runs",
      "required": [
        "collection_uid"
      ]
    },
    "environment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/environments/{environment_uid}",
      "required": [
        "environment_uid"
      ]
    },
    "environment_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/environments/{environment_uid}",
      "required": [
        "environment_uid"
      ],
      "bodyFrom": [
        "environment",
        "name",
        "values"
      ],
      "bodyMap": {
        "name": "environment.name",
        "values": "environment.values"
      }
    },
    "monitor_run": {
      "kind": "http",
      "method": "POST",
      "path": "/monitors/{monitor_uid}/run",
      "required": [
        "monitor_uid"
      ]
    },
    "mock_get": {
      "kind": "http",
      "method": "GET",
      "path": "/mocks/{mock_uid}",
      "required": [
        "mock_uid"
      ]
    }
  }
}
