{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "list-collections": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/collections",
      "required": [
        "apiHost"
      ],
      "queryFrom": [
        "continuationToken"
      ]
    },
    "get-collection": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/collections/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "update-collection": {
      "kind": "http",
      "method": "PUT",
      "path": "{apiHost}/public/collections/{id}",
      "required": [
        "apiHost",
        "id"
      ],
      "bodyFrom": [
        "externalId",
        "groups"
      ]
    },
    "delete-collection": {
      "kind": "http",
      "method": "DELETE",
      "path": "{apiHost}/public/collections/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "list-events": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/events",
      "required": [
        "apiHost"
      ],
      "queryFrom": [
        "continuationToken",
        "start",
        "end"
      ]
    },
    "create-group": {
      "kind": "http",
      "method": "POST",
      "path": "{apiHost}/public/groups",
      "required": [
        "apiHost"
      ],
      "bodyFrom": [
        "name",
        "externalId",
        "collections"
      ]
    },
    "get-group": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/groups/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "list-groups": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/groups",
      "required": [
        "apiHost"
      ],
      "queryFrom": [
        "continuationToken"
      ]
    },
    "update-group": {
      "kind": "http",
      "method": "PUT",
      "path": "{apiHost}/public/groups/{id}",
      "required": [
        "apiHost",
        "id"
      ],
      "bodyFrom": [
        "name",
        "externalId",
        "collections"
      ]
    },
    "delete-group": {
      "kind": "http",
      "method": "DELETE",
      "path": "{apiHost}/public/groups/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "get-group-members": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/groups/{id}/member-ids",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "update-group-members": {
      "kind": "http",
      "method": "PUT",
      "path": "{apiHost}/public/groups/{id}/member-ids",
      "required": [
        "apiHost",
        "id"
      ],
      "bodyFrom": [
        "memberIds"
      ]
    },
    "create-member": {
      "kind": "http",
      "method": "POST",
      "path": "{apiHost}/public/members",
      "required": [
        "apiHost"
      ],
      "bodyFrom": [
        "email",
        "type",
        "accessAll",
        "collections",
        "groups",
        "externalId"
      ]
    },
    "get-member": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/members/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "list-members": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/members",
      "required": [
        "apiHost"
      ],
      "queryFrom": [
        "continuationToken"
      ]
    },
    "update-member": {
      "kind": "http",
      "method": "PUT",
      "path": "{apiHost}/public/members/{id}",
      "required": [
        "apiHost",
        "id"
      ],
      "bodyFrom": [
        "type",
        "accessAll",
        "collections",
        "externalId"
      ]
    },
    "delete-member": {
      "kind": "http",
      "method": "DELETE",
      "path": "{apiHost}/public/members/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "get-member-groups": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/public/members/{id}/group-ids",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "update-member-groups": {
      "kind": "http",
      "method": "PUT",
      "path": "{apiHost}/public/members/{id}/group-ids",
      "required": [
        "apiHost",
        "id"
      ],
      "bodyFrom": [
        "groupIds"
      ]
    },
    "get-secret": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/secrets/{id}",
      "required": [
        "apiHost",
        "id"
      ]
    },
    "list-secrets": {
      "kind": "http",
      "method": "GET",
      "path": "{apiHost}/organizations/{organizationId}/secrets",
      "required": [
        "apiHost",
        "organizationId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
