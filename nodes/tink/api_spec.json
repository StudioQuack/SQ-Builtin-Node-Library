{
  "baseUrl": "https://api.tink.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "authorize": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/oauth/token",
      "bodyFrom": [
        "client_id",
        "client_secret",
        "grant_type",
        "scope"
      ],
      "required": [
        "grant_type"
      ],
      "contentType": "application/x-www-form-urlencoded",
      "bodyFormat": "form"
    },
    "accounts_list": {
      "kind": "http",
      "method": "GET",
      "path": "/data/v2/accounts"
    },
    "transactions_list": {
      "kind": "http",
      "method": "GET",
      "path": "/data/v2/transactions",
      "queryFrom": [
        "accountIdIn",
        "bookedDateGte",
        "pageSize",
        "pageToken"
      ]
    },
    "identity_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/user"
    }
  }
}
