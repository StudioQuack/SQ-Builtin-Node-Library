{
  "baseUrl": "https://{sandbox}.cloudconvert.com/v2",
  "placeholderDefaults": {
    "sandbox": "api"
  },
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "docs": "https://cloudconvert.com/docs/getting-started/introduction",
  "operations": {
    "convert": {
      "kind": "http",
      "method": "POST",
      "path": "/convert",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "input",
        "input_format",
        "output_format",
        "filename",
        "engine"
      ],
      "contentType": "application/json"
    },
    "capture_website": {
      "kind": "http",
      "method": "POST",
      "path": "/capture-website",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "output_format",
        "pages",
        "zoom"
      ],
      "contentType": "application/json"
    },
    "archive_create": {
      "kind": "http",
      "method": "POST",
      "path": "/archive",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "input",
        "output_format"
      ],
      "contentType": "application/json"
    },
    "job_create": {
      "kind": "http",
      "method": "POST",
      "path": "/jobs",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "tasks"
      ],
      "contentType": "application/json"
    },
    "job_get": {
      "kind": "http",
      "method": "GET",
      "path": "/jobs/{job_id}",
      "required": [
        "job_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "job_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/jobs/{job_id}",
      "required": [
        "job_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "task_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_id}/cancel",
      "required": [
        "task_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "task_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/tasks/{task_id}",
      "required": [
        "task_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "file_download": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
