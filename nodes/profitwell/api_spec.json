{
  "baseUrl": "https://api.profitwell.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "metric_get": {
      "kind": "http",
      "method": "GET",
      "path": "/metrics/",
      "queryFrom": [
        "day"
      ]
    },
    "plan_list": {
      "kind": "http",
      "method": "GET",
      "path": "/metrics/plans/"
    },
    "transaction_list": {
      "kind": "http",
      "method": "GET",
      "path": "/metrics/transactions/",
      "queryFrom": [
        "start_date"
      ]
    }
  }
}
