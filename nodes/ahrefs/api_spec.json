{
  "baseUrl": "https://api.ahrefs.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "operations": {
    "siteExplorer.overview": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/site-explorer/metrics",
      "required": [
        "target",
        "date"
      ],
      "queryFrom": [
        "target",
        "date",
        "mode",
        "protocol",
        "country",
        "volume_mode",
        "traffic_mode",
        "output"
      ]
    },
    "siteExplorer.backlinks": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/site-explorer/all-backlinks",
      "required": [
        "target",
        "select"
      ],
      "queryFrom": [
        "target",
        "mode",
        "protocol",
        "select",
        "limit",
        "where",
        "order_by",
        "output"
      ]
    },
    "keywordsExplorer.overview": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/keywords-explorer/overview",
      "required": [
        "country",
        "select"
      ],
      "queryFrom": [
        "keywords",
        "keyword",
        "country",
        "select",
        "limit",
        "output"
      ]
    },
    "rankTracker.overview": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/rank-tracker/overview",
      "required": [
        "project_id",
        "select",
        "date",
        "device"
      ],
      "queryFrom": [
        "project_id",
        "select",
        "date",
        "device",
        "output"
      ]
    },
    "serpOverview": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/serp-overview/serp-overview",
      "required": [
        "keyword",
        "country",
        "select"
      ],
      "queryFrom": [
        "keyword",
        "country",
        "select",
        "limit",
        "output"
      ]
    },
    "batchAnalysis": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/batch-analysis/batch-analysis",
      "required": [
        "targets",
        "select"
      ],
      "bodyFrom": [
        "targets",
        "select",
        "order_by",
        "country",
        "volume_mode",
        "top_countries",
        "output"
      ]
    }
  }
}
