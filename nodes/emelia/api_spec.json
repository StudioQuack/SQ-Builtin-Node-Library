{
  "baseUrl": "https://api.emelia.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "campaign.create": {
      "kind": "http",
      "method": "POST",
      "path": "/advanced/campaigns",
      "bodyFrom": [
        "name",
        "recipients",
        "sequence",
        "sender",
        "settings"
      ],
      "required": [
        "name"
      ]
    },
    "campaign.get": {
      "kind": "http",
      "method": "GET",
      "path": "/advanced/campaigns/{campaignId}",
      "required": [
        "campaignId"
      ]
    },
    "campaign.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/advanced/campaigns/{campaignId}",
      "required": [
        "campaignId"
      ]
    },
    "campaign.list": {
      "kind": "http",
      "method": "GET",
      "path": "/advanced/campaigns"
    },
    "campaign.start": {
      "kind": "http",
      "method": "POST",
      "path": "/advanced/campaigns/{campaignId}/start",
      "required": [
        "campaignId"
      ],
      "bodyFrom": [
        "_empty"
      ]
    },
    "campaign.pause": {
      "kind": "http",
      "method": "POST",
      "path": "/advanced/campaigns/{campaignId}/pause",
      "required": [
        "campaignId"
      ],
      "bodyFrom": [
        "_empty"
      ]
    },
    "campaign.addContact": {
      "kind": "http",
      "method": "POST",
      "path": "/advanced/campaign/contacts",
      "bodyFrom": [
        "campaignId",
        "email",
        "firstName",
        "lastName",
        "phone",
        "customVariables"
      ],
      "required": [
        "campaignId",
        "email"
      ]
    },
    "contactList.add": {
      "kind": "http",
      "method": "POST",
      "path": "/lists/list/{listId}/contacts",
      "required": [
        "listId",
        "email"
      ],
      "queryFrom": [
        "updateIfExists"
      ],
      "bodyFrom": [
        "email",
        "firstName",
        "lastName",
        "phone",
        "linkedinUrlProfile",
        "companyName"
      ]
    },
    "contactList.list": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/list",
      "queryFrom": [
        "page",
        "limit"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
