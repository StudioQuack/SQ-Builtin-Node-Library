{
  "baseUrl": "https://api.weatherapi.com/v1",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "key"
  },
  "operations": {
    "current": {
      "kind": "http",
      "method": "GET",
      "path": "/current.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "aqi",
        "lang"
      ],
      "bodyFrom": []
    },
    "forecast": {
      "kind": "http",
      "method": "GET",
      "path": "/forecast.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "days",
        "aqi",
        "alerts",
        "hour",
        "lang"
      ],
      "bodyFrom": []
    },
    "history": {
      "kind": "http",
      "method": "GET",
      "path": "/history.json",
      "required": [
        "q",
        "dt"
      ],
      "queryFrom": [
        "q",
        "dt",
        "hour",
        "lang"
      ],
      "bodyFrom": []
    },
    "astronomy": {
      "kind": "http",
      "method": "GET",
      "path": "/astronomy.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "dt"
      ],
      "bodyFrom": []
    },
    "timezone": {
      "kind": "http",
      "method": "GET",
      "path": "/timezone.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q"
      ],
      "bodyFrom": []
    },
    "sports": {
      "kind": "http",
      "method": "GET",
      "path": "/sports.json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q"
      ],
      "bodyFrom": []
    }
  }
}
