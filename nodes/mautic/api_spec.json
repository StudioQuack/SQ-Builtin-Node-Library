{
    "baseUrl": "https://{instance_host}/api/v2",
    "defaultTimeout": 30,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "oauth_access_token"
    },
    "operations": {
        "contact.create": {
            "kind": "http",
            "method": "POST",
            "path": "/contacts",
            "required": [
                "instance_host",
                "email"
            ],
            "bodyFrom": [
                "email",
                "firstname",
                "lastname",
                "ip",
                "overwriteWithBlank",
                "fields"
            ]
        },
        "contact.get": {
            "kind": "http",
            "method": "GET",
            "path": "/contacts/{contact_id}",
            "required": [
                "instance_host",
                "contact_id"
            ]
        },
        "contact.list": {
            "kind": "http",
            "method": "GET",
            "path": "/contacts",
            "queryFrom": [
                "search",
                "start",
                "limit",
                "orderBy",
                "orderByDir",
                "publishedOnly",
                "minimal"
            ],
            "required": [
                "instance_host"
            ]
        },
        "contact.update": {
            "kind": "http",
            "method": "PATCH",
            "path": "/contacts/{contact_id}",
            "required": [
                "instance_host",
                "contact_id"
            ],
            "bodyFrom": [
                "email",
                "firstname",
                "lastname",
                "overwriteWithBlank",
                "fields"
            ]
        },
        "contact.delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/contacts/{contact_id}",
            "required": [
                "instance_host",
                "contact_id"
            ]
        },
        "contact.points": {
            "kind": "http",
            "method": "POST",
            "path": "/contacts/{contact_id}/points/{direction}/{delta}",
            "required": [
                "instance_host",
                "contact_id",
                "direction",
                "delta"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "contact.dnc": {
            "kind": "http",
            "method": "POST",
            "path": "/contacts/{contact_id}/dnc/{channel}/{action}",
            "required": [
                "instance_host",
                "contact_id",
                "channel",
                "action"
            ],
            "bodyFrom": [
                "reason",
                "comments"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "contact.sendEmail": {
            "kind": "http",
            "method": "POST",
            "path": "/emails/{email_id}/contact/{contact_id}/send",
            "required": [
                "instance_host",
                "email_id",
                "contact_id"
            ],
            "bodyFrom": [
                "tokens"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "company.create": {
            "kind": "http",
            "method": "POST",
            "path": "/companies",
            "required": [
                "instance_host",
                "companyname"
            ],
            "bodyFrom": [
                "companyname",
                "fields"
            ]
        },
        "company.get": {
            "kind": "http",
            "method": "GET",
            "path": "/companies/{company_id}",
            "required": [
                "instance_host",
                "company_id"
            ]
        },
        "company.list": {
            "kind": "http",
            "method": "GET",
            "path": "/companies",
            "queryFrom": [
                "search",
                "start",
                "limit",
                "orderBy",
                "orderByDir"
            ],
            "required": [
                "instance_host"
            ]
        },
        "company.update": {
            "kind": "http",
            "method": "PATCH",
            "path": "/companies/{company_id}",
            "required": [
                "instance_host",
                "company_id"
            ],
            "bodyFrom": [
                "companyname",
                "fields"
            ]
        },
        "company.delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/companies/{company_id}",
            "required": [
                "instance_host",
                "company_id"
            ]
        },
        "companyContact.add": {
            "kind": "http",
            "method": "POST",
            "path": "/companies/{company_id}/contact/{contact_id}/add",
            "required": [
                "instance_host",
                "company_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "companyContact.remove": {
            "kind": "http",
            "method": "POST",
            "path": "/companies/{company_id}/contact/{contact_id}/remove",
            "required": [
                "instance_host",
                "company_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "campaignContact.add": {
            "kind": "http",
            "method": "POST",
            "path": "/campaigns/{campaign_id}/contact/{contact_id}/add",
            "required": [
                "instance_host",
                "campaign_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "campaignContact.remove": {
            "kind": "http",
            "method": "POST",
            "path": "/campaigns/{campaign_id}/contact/{contact_id}/remove",
            "required": [
                "instance_host",
                "campaign_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "segmentContact.add": {
            "kind": "http",
            "method": "POST",
            "path": "/segments/{segment_id}/contact/{contact_id}/add",
            "required": [
                "instance_host",
                "segment_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "segmentContact.remove": {
            "kind": "http",
            "method": "POST",
            "path": "/segments/{segment_id}/contact/{contact_id}/remove",
            "required": [
                "instance_host",
                "segment_id",
                "contact_id"
            ],
            "bodyFrom": [
                "__omit"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "segmentEmail.send": {
            "kind": "http",
            "method": "POST",
            "path": "/emails/{email_id}/send",
            "required": [
                "instance_host",
                "email_id"
            ],
            "bodyFrom": [
                "tokens"
            ],
            "baseUrl": "https://{instance_host}/api"
        },
        "trigger.listen": {
            "kind": "ingress"
        }
    }
}
