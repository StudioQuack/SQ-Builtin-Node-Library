{
  "baseUrl": "https://data.fixer.io/api",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "access_key"
  },
  "operations": {
    "fixer_latest": {
      "kind": "http",
      "method": "GET",
      "path": "/latest",
      "required": [],
      "queryFrom": [
        "base",
        "symbols",
        "spread"
      ],
      "bodyFrom": []
    },
    "fixer_convert": {
      "kind": "http",
      "method": "GET",
      "path": "/convert",
      "required": [
        "from",
        "to",
        "amount"
      ],
      "queryFrom": [
        "from",
        "to",
        "amount",
        "date"
      ],
      "bodyFrom": []
    },
    "fixer_historical": {
      "kind": "http",
      "method": "GET",
      "path": "/{date}",
      "required": [
        "date"
      ],
      "queryFrom": [
        "base",
        "symbols",
        "spread"
      ],
      "bodyFrom": []
    },
    "fixer_timeseries": {
      "kind": "http",
      "method": "GET",
      "path": "/timeseries",
      "required": [
        "start_date",
        "end_date"
      ],
      "queryFrom": [
        "start_date",
        "end_date",
        "base",
        "symbols",
        "spread"
      ],
      "bodyFrom": []
    },
    "fixer_fluctuation": {
      "kind": "http",
      "method": "GET",
      "path": "/fluctuation",
      "required": [
        "start_date",
        "end_date"
      ],
      "queryFrom": [
        "start_date",
        "end_date",
        "base",
        "symbols"
      ],
      "bodyFrom": []
    },
    "fixer_symbols": {
      "kind": "http",
      "method": "GET",
      "path": "/symbols",
      "required": [],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
