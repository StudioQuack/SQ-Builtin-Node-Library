{
  "baseUrl": "https://slack.com/api",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "bot_token"
  },
  "operations": {
    "send-message": {
      "kind": "http",
      "method": "POST",
      "path": "/chat.postMessage",
      "contentType": "application/json",
      "bodyFrom": [
        "channel",
        "text",
        "blocks",
        "thread_ts",
        "mrkdwn"
      ]
    },
    "update-message": {
      "kind": "http",
      "method": "POST",
      "path": "/chat.update",
      "contentType": "application/json",
      "required": [
        "channel",
        "ts"
      ],
      "bodyFrom": [
        "channel",
        "ts",
        "text",
        "blocks"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "POST",
      "path": "/chat.delete",
      "contentType": "application/json",
      "required": [
        "channel",
        "ts"
      ],
      "bodyFrom": [
        "channel",
        "ts"
      ]
    },
    "get-permalink": {
      "kind": "http",
      "method": "GET",
      "path": "/chat.getPermalink",
      "contentType": "application/json",
      "required": [
        "channel",
        "message_ts"
      ],
      "queryFrom": [
        "channel",
        "message_ts"
      ]
    },
    "search-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/search.messages",
      "contentType": "application/json",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "count",
        "page"
      ]
    },
    "archive-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.archive",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel"
      ]
    },
    "close-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.close",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel"
      ]
    },
    "create-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.create",
      "contentType": "application/json",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "is_private"
      ]
    },
    "get-channel": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations.info",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "queryFrom": [
        "channel"
      ]
    },
    "list-channels": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations.list",
      "contentType": "application/json",
      "queryFrom": [
        "types",
        "limit",
        "cursor",
        "exclude_archived"
      ]
    },
    "channel-history": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations.history",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "queryFrom": [
        "channel",
        "latest",
        "oldest",
        "limit",
        "cursor"
      ]
    },
    "invite-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.invite",
      "contentType": "application/json",
      "required": [
        "channel",
        "users"
      ],
      "bodyFrom": [
        "channel",
        "users"
      ]
    },
    "join-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.join",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel"
      ]
    },
    "kick-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.kick",
      "contentType": "application/json",
      "required": [
        "channel",
        "user"
      ],
      "bodyFrom": [
        "channel",
        "user"
      ]
    },
    "leave-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.leave",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel"
      ]
    },
    "list-channel-members": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations.members",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "queryFrom": [
        "channel",
        "limit",
        "cursor"
      ]
    },
    "open-dm": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.open",
      "contentType": "application/json",
      "bodyFrom": [
        "users"
      ]
    },
    "rename-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.rename",
      "contentType": "application/json",
      "required": [
        "channel",
        "name"
      ],
      "bodyFrom": [
        "channel",
        "name"
      ]
    },
    "get-replies": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations.replies",
      "contentType": "application/json",
      "required": [
        "channel",
        "ts"
      ],
      "queryFrom": [
        "channel",
        "ts",
        "limit",
        "cursor"
      ]
    },
    "set-purpose": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.setPurpose",
      "contentType": "application/json",
      "required": [
        "channel",
        "purpose"
      ],
      "bodyFrom": [
        "channel",
        "purpose"
      ]
    },
    "set-topic": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.setTopic",
      "contentType": "application/json",
      "required": [
        "channel",
        "topic"
      ],
      "bodyFrom": [
        "channel",
        "topic"
      ]
    },
    "unarchive-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations.unarchive",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel"
      ]
    },
    "upload-file": {
      "kind": "http",
      "method": "POST",
      "path": "/files.getUploadURLExternal",
      "contentType": "application/json",
      "required": [
        "filename",
        "length"
      ],
      "bodyFrom": [
        "filename",
        "length",
        "alt_txt"
      ]
    },
    "get-file": {
      "kind": "http",
      "method": "GET",
      "path": "/files.info",
      "contentType": "application/json",
      "required": [
        "file_id"
      ],
      "queryFrom": [
        "file_id"
      ],
      "queryMap": {
        "file_id": "file"
      }
    },
    "list-files": {
      "kind": "http",
      "method": "GET",
      "path": "/files.list",
      "contentType": "application/json",
      "queryFrom": [
        "channel",
        "user",
        "count",
        "page"
      ]
    },
    "add-reaction": {
      "kind": "http",
      "method": "POST",
      "path": "/reactions.add",
      "contentType": "application/json",
      "required": [
        "channel",
        "timestamp",
        "name"
      ],
      "bodyFrom": [
        "channel",
        "timestamp",
        "name"
      ]
    },
    "remove-reaction": {
      "kind": "http",
      "method": "POST",
      "path": "/reactions.remove",
      "contentType": "application/json",
      "required": [
        "channel",
        "timestamp",
        "name"
      ],
      "bodyFrom": [
        "channel",
        "timestamp",
        "name"
      ]
    },
    "list-reactions": {
      "kind": "http",
      "method": "GET",
      "path": "/reactions.list",
      "contentType": "application/json",
      "queryFrom": [
        "user",
        "count",
        "page"
      ]
    },
    "add-star": {
      "kind": "http",
      "method": "POST",
      "path": "/stars.add",
      "contentType": "application/json",
      "bodyFrom": [
        "channel",
        "timestamp",
        "file_id"
      ],
      "bodyMap": {
        "file_id": "file"
      }
    },
    "remove-star": {
      "kind": "http",
      "method": "POST",
      "path": "/stars.remove",
      "contentType": "application/json",
      "bodyFrom": [
        "channel",
        "timestamp",
        "file_id"
      ],
      "bodyMap": {
        "file_id": "file"
      }
    },
    "list-stars": {
      "kind": "http",
      "method": "GET",
      "path": "/stars.list",
      "contentType": "application/json",
      "queryFrom": [
        "count",
        "page"
      ]
    },
    "get-user": {
      "kind": "http",
      "method": "GET",
      "path": "/users.info",
      "contentType": "application/json",
      "required": [
        "user"
      ],
      "queryFrom": [
        "user"
      ]
    },
    "list-users": {
      "kind": "http",
      "method": "GET",
      "path": "/users.list",
      "contentType": "application/json",
      "queryFrom": [
        "limit",
        "cursor"
      ]
    },
    "update-user-profile": {
      "kind": "http",
      "method": "POST",
      "path": "/users.profile.set",
      "contentType": "application/json",
      "bodyFrom": [
        "profile",
        "user"
      ]
    },
    "create-usergroup": {
      "kind": "http",
      "method": "POST",
      "path": "/usergroups.create",
      "contentType": "application/json",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "handle",
        "channels"
      ]
    },
    "list-usergroups": {
      "kind": "http",
      "method": "GET",
      "path": "/usergroups.list",
      "contentType": "application/json",
      "queryFrom": [
        "include_users",
        "include_count"
      ]
    },
    "update-usergroup": {
      "kind": "http",
      "method": "POST",
      "path": "/usergroups.update",
      "contentType": "application/json",
      "required": [
        "usergroup"
      ],
      "bodyFrom": [
        "usergroup",
        "name",
        "handle",
        "channels"
      ]
    },
    "send-and-wait": {
      "kind": "ingress"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
