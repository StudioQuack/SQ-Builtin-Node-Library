{
  "baseUrl": "https://api.pdf.co/v1",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "docs": "https://docs.pdf.co/api-reference",
  "operations": {
    "pdf_merge": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/merge",
      "required": [
        "url"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "name",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration",
        "urls"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "urls": "url"
      }
    },
    "pdf_split": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/split",
      "required": [
        "url"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "pages",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    },
    "pdf_convert": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/convert/to/{target_format}",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "pages",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    },
    "pdf_add_text": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/edit/add",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "annotations",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    },
    "pdf_extract_text": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/convert/to/text",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    },
    "pdf_barcode": {
      "kind": "http",
      "method": "POST",
      "path": "/barcode/generate",
      "required": [
        "value"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "value",
        "type",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration",
        "barcode_type"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "barcode_type": "type"
      }
    },
    "html_to_pdf": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/convert/from/html",
      "required": [
        "html"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "html",
        "name",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    },
    "url_to_pdf": {
      "kind": "http",
      "method": "POST",
      "path": "/pdf/convert/from/url",
      "required": [
        "url"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "name",
        "async",
        "callback",
        "password",
        "httpusername",
        "httppassword",
        "expiration"
      ],
      "contentType": "application/json"
    }
  },
  "placeholderDefaults": {
    "target_format": "jpg"
  }
}
