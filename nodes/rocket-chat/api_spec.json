{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Auth-Token",
    "prefix": "",
    "configKey": "auth_token"
  },
  "extraHeaders": {
    "X-User-Id": "{user_id}"
  },
  "operations": {
    "post-message": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v1/chat.postMessage",
      "contentType": "application/json",
      "required": [
        "channel"
      ],
      "bodyFrom": [
        "channel",
        "text",
        "alias"
      ]
    },
    "send-dm": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v1/chat.postMessage",
      "contentType": "application/json",
      "required": [
        "roomId",
        "text"
      ],
      "bodyFrom": [
        "roomId",
        "text"
      ]
    },
    "list-channels": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v1/channels.list",
      "contentType": "application/json",
      "queryFrom": [
        "count",
        "offset"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "x-rocketchat-livechat-token",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
