{
  "baseUrl": "https://api.close.com/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "basicKeyPosition": "username"
  },
  "operations": {
    "lead.create": {
      "kind": "http",
      "method": "POST",
      "path": "/lead/",
      "bodyFrom": [
        "name",
        "url",
        "description",
        "status_id",
        "contacts"
      ]
    },
    "lead.get": {
      "kind": "http",
      "method": "GET",
      "path": "/lead/{id}/",
      "required": [
        "id"
      ],
      "queryFrom": [
        "_fields"
      ]
    },
    "lead.list": {
      "kind": "http",
      "method": "GET",
      "path": "/lead/",
      "queryFrom": [
        "query",
        "_skip",
        "_limit",
        "_fields"
      ]
    },
    "lead.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/lead/{id}/",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "name",
        "url",
        "description",
        "status_id"
      ]
    },
    "lead.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/lead/{id}/",
      "required": [
        "id"
      ]
    },
    "contact.create": {
      "kind": "http",
      "method": "POST",
      "path": "/contact/",
      "bodyFrom": [
        "lead_id",
        "name",
        "emails",
        "phones",
        "title"
      ]
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/contact/{id}/",
      "required": [
        "id"
      ],
      "queryFrom": [
        "_fields"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/contact/",
      "queryFrom": [
        "lead_id",
        "_skip",
        "_limit",
        "_fields"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/contact/{id}/",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "name",
        "emails",
        "phones",
        "title",
        "lead_id"
      ]
    },
    "opportunity.create": {
      "kind": "http",
      "method": "POST",
      "path": "/opportunity/",
      "bodyFrom": [
        "lead_id",
        "status_id",
        "value",
        "value_period",
        "note"
      ]
    },
    "opportunity.get": {
      "kind": "http",
      "method": "GET",
      "path": "/opportunity/{id}/",
      "required": [
        "id"
      ],
      "queryFrom": [
        "_fields"
      ]
    },
    "opportunity.list": {
      "kind": "http",
      "method": "GET",
      "path": "/opportunity/",
      "queryFrom": [
        "lead_id",
        "_skip",
        "_limit",
        "_fields"
      ]
    },
    "opportunity.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/opportunity/{id}/",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "status_id",
        "value",
        "value_period",
        "note"
      ]
    },
    "call.create": {
      "kind": "http",
      "method": "POST",
      "path": "/activity/call/",
      "bodyFrom": [
        "lead_id",
        "direction",
        "duration",
        "note",
        "phone"
      ]
    },
    "call.get": {
      "kind": "http",
      "method": "GET",
      "path": "/activity/call/{id}/",
      "required": [
        "id"
      ],
      "queryFrom": [
        "_fields"
      ]
    },
    "email.create": {
      "kind": "http",
      "method": "POST",
      "path": "/activity/email/",
      "bodyFrom": [
        "lead_id",
        "contact_id",
        "status",
        "sender",
        "subject",
        "body_text",
        "body_html",
        "to"
      ],
      "required": [
        "lead_id",
        "status"
      ]
    },
    "sms.create": {
      "kind": "http",
      "method": "POST",
      "path": "/activity/sms/",
      "bodyFrom": [
        "lead_id",
        "text",
        "status",
        "local_phone",
        "remote_phone"
      ],
      "required": [
        "status"
      ]
    },
    "task.create": {
      "kind": "http",
      "method": "POST",
      "path": "/task/",
      "bodyFrom": [
        "lead_id",
        "text",
        "date",
        "assigned_to"
      ]
    },
    "task.get": {
      "kind": "http",
      "method": "GET",
      "path": "/task/{id}/",
      "required": [
        "id"
      ]
    },
    "activity.list": {
      "kind": "http",
      "method": "GET",
      "path": "/activity/",
      "queryFrom": [
        "_type",
        "lead_id",
        "_skip",
        "_limit",
        "_fields"
      ]
    },
    "customActivity.create": {
      "kind": "http",
      "method": "POST",
      "path": "/activity/custom/",
      "bodyFrom": [
        "lead_id",
        "custom_activity_type_id",
        "custom_fields"
      ]
    },
    "customObject.create": {
      "kind": "http",
      "method": "POST",
      "path": "/custom_object/",
      "bodyFrom": [
        "custom_object_type_id",
        "lead_id",
        "name",
        "custom_fields"
      ],
      "required": [
        "custom_object_type_id",
        "lead_id",
        "name"
      ]
    },
    "customObject.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/custom_object/{id}/",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "custom_fields",
        "lead_id"
      ]
    },
    "membership.add": {
      "kind": "http",
      "method": "POST",
      "path": "/membership/",
      "bodyFrom": [
        "email",
        "role_id"
      ],
      "required": [
        "email",
        "role_id"
      ]
    },
    "membership.remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/membership/{id}/",
      "required": [
        "id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
