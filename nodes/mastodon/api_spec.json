{
  "baseUrl": "https://{instance_host}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "status_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/statuses",
      "bodyFrom": [
        "status",
        "visibility",
        "in_reply_to_id",
        "spoiler_text",
        "sensitive",
        "language",
        "media_ids"
      ],
      "required": []
    },
    "status_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/statuses/{status_id}",
      "required": [
        "status_id"
      ]
    },
    "timeline_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/timelines/home",
      "queryFrom": [
        "max_id",
        "limit"
      ],
      "required": []
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v2/search",
      "queryFrom": [
        "q",
        "type",
        "limit"
      ],
      "required": [
        "q"
      ]
    },
    "account_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v1/accounts/verify_credentials",
      "required": []
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
