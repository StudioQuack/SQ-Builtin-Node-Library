{
  "baseUrl": "https://discord.com/api/v10",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Bot ",
    "configKey": "bot_token"
  },
  "operations": {
    "send-message": {
      "kind": "http",
      "method": "POST",
      "path": "/channels/{channel_id}/messages",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ],
      "bodyFrom": [
        "content",
        "embeds",
        "sticker_ids",
        "message_reference",
        "tts",
        "flags",
        "nonce"
      ]
    },
    "send-webhook": {
      "kind": "http",
      "method": "POST",
      "path": "/webhooks/{webhook_id}/{webhook_token}",
      "contentType": "application/json",
      "required": [
        "webhook_id",
        "webhook_token"
      ],
      "bodyFrom": [
        "content",
        "username",
        "avatar_url",
        "embeds",
        "tts"
      ]
    },
    "get-message": {
      "kind": "http",
      "method": "GET",
      "path": "/channels/{channel_id}/messages/{message_id}",
      "contentType": "application/json",
      "required": [
        "channel_id",
        "message_id"
      ]
    },
    "list-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/channels/{channel_id}/messages",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ],
      "queryFrom": [
        "around",
        "before",
        "after",
        "limit"
      ]
    },
    "delete-message": {
      "kind": "http",
      "method": "DELETE",
      "path": "/channels/{channel_id}/messages/{message_id}",
      "contentType": "application/json",
      "required": [
        "channel_id",
        "message_id"
      ]
    },
    "add-reaction": {
      "kind": "http",
      "method": "PUT",
      "path": "/channels/{channel_id}/messages/{message_id}/reactions/{emoji}/@me",
      "contentType": "application/json",
      "required": [
        "channel_id",
        "message_id",
        "emoji"
      ]
    },
    "create-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/guilds/{guild_id}/channels",
      "contentType": "application/json",
      "required": [
        "guild_id",
        "name"
      ],
      "bodyFrom": [
        "name",
        "type",
        "parent_id",
        "topic"
      ]
    },
    "get-channel": {
      "kind": "http",
      "method": "GET",
      "path": "/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "list-channels": {
      "kind": "http",
      "method": "GET",
      "path": "/guilds/{guild_id}/channels",
      "contentType": "application/json",
      "required": [
        "guild_id"
      ]
    },
    "update-channel": {
      "kind": "http",
      "method": "PATCH",
      "path": "/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ],
      "bodyFrom": [
        "name",
        "topic",
        "parent_id"
      ]
    },
    "delete-channel": {
      "kind": "http",
      "method": "DELETE",
      "path": "/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "list-members": {
      "kind": "http",
      "method": "GET",
      "path": "/guilds/{guild_id}/members",
      "contentType": "application/json",
      "required": [
        "guild_id"
      ],
      "queryFrom": [
        "limit",
        "after"
      ]
    },
    "add-role": {
      "kind": "http",
      "method": "PUT",
      "path": "/guilds/{guild_id}/members/{user_id}/roles/{role_id}",
      "contentType": "application/json",
      "required": [
        "guild_id",
        "user_id",
        "role_id"
      ]
    },
    "remove-role": {
      "kind": "http",
      "method": "DELETE",
      "path": "/guilds/{guild_id}/members/{user_id}/roles/{role_id}",
      "contentType": "application/json",
      "required": [
        "guild_id",
        "user_id",
        "role_id"
      ]
    },
    "send-and-wait": {
      "kind": "ingress"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
