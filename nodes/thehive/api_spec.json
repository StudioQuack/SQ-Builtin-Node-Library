{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "create-alert": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/alert",
      "required": [
        "type",
        "source",
        "sourceRef",
        "title",
        "description"
      ],
      "bodyFrom": [
        "type",
        "source",
        "sourceRef",
        "title",
        "description",
        "severity",
        "date",
        "tags",
        "tlp",
        "pap",
        "flag",
        "customFields",
        "assignee",
        "observables"
      ],
      "contentType": "application/json"
    },
    "get-alert": {
      "kind": "http",
      "method": "GET",
      "path": "{thehiveHost}/api/v1/alert/{alertId}",
      "required": [
        "alertId"
      ]
    },
    "search-alerts": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "update-alert": {
      "kind": "http",
      "method": "PATCH",
      "path": "{thehiveHost}/api/v1/alert/{alertId}",
      "required": [
        "alertId"
      ],
      "bodyFrom": [
        "type",
        "source",
        "sourceRef",
        "title",
        "description",
        "severity",
        "date",
        "tags",
        "tlp",
        "pap",
        "flag",
        "customFields",
        "assignee",
        "observables"
      ],
      "contentType": "application/json"
    },
    "delete-alert": {
      "kind": "http",
      "method": "DELETE",
      "path": "{thehiveHost}/api/v1/alert/{alertId}",
      "required": [
        "alertId"
      ]
    },
    "promote-alert": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/alert/{alertId}/case",
      "required": [
        "alertId"
      ]
    },
    "merge-alert": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/alert/{alertId}/merge/{caseId}",
      "required": [
        "alertId",
        "caseId"
      ]
    },
    "create-case": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/case",
      "required": [
        "title",
        "description"
      ],
      "bodyFrom": [
        "title",
        "description",
        "severity",
        "date",
        "tags",
        "tlp",
        "pap",
        "flag",
        "status",
        "assignee",
        "customFields",
        "template"
      ],
      "contentType": "application/json"
    },
    "get-case": {
      "kind": "http",
      "method": "GET",
      "path": "{thehiveHost}/api/v1/case/{caseId}",
      "required": [
        "caseId"
      ]
    },
    "search-cases": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "update-case": {
      "kind": "http",
      "method": "PATCH",
      "path": "{thehiveHost}/api/v1/case/{caseId}",
      "required": [
        "caseId"
      ],
      "bodyFrom": [
        "title",
        "description",
        "severity",
        "date",
        "tags",
        "tlp",
        "pap",
        "flag",
        "status",
        "assignee",
        "customFields",
        "template"
      ],
      "contentType": "application/json"
    },
    "delete-case": {
      "kind": "http",
      "method": "DELETE",
      "path": "{thehiveHost}/api/v1/case/{caseId}",
      "required": [
        "caseId"
      ]
    },
    "get-timeline": {
      "kind": "http",
      "method": "GET",
      "path": "{thehiveHost}/api/v1/case/{caseId}/timeline",
      "required": [
        "caseId"
      ]
    },
    "add-case-attachment": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/case/{caseId}/attachments",
      "required": [
        "caseId"
      ],
      "bodyFrom": [
        "attachment"
      ]
    },
    "create-observable": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/case/{caseId}/observable",
      "required": [
        "caseId",
        "dataType"
      ],
      "bodyFrom": [
        "dataType",
        "data",
        "message",
        "tlp",
        "pap",
        "tags",
        "ioc",
        "sighted"
      ],
      "contentType": "application/json"
    },
    "get-observable": {
      "kind": "http",
      "method": "GET",
      "path": "{thehiveHost}/api/v1/observable/{observableId}",
      "required": [
        "observableId"
      ]
    },
    "search-observables": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "update-observable": {
      "kind": "http",
      "method": "PATCH",
      "path": "{thehiveHost}/api/v1/observable/{observableId}",
      "required": [
        "observableId"
      ],
      "bodyFrom": [
        "dataType",
        "data",
        "message",
        "tlp",
        "pap",
        "tags",
        "ioc",
        "sighted"
      ],
      "contentType": "application/json"
    },
    "delete-observable": {
      "kind": "http",
      "method": "DELETE",
      "path": "{thehiveHost}/api/v1/observable/{observableId}",
      "required": [
        "observableId"
      ]
    },
    "execute-analyzer": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/connector/cortex/job",
      "required": [
        "analyzerId",
        "artifactId"
      ],
      "bodyFrom": [
        "analyzerId",
        "cortexId",
        "artifactId",
        "parameters"
      ]
    },
    "create-task": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/case/{caseId}/task",
      "required": [
        "caseId",
        "title"
      ],
      "bodyFrom": [
        "title",
        "description",
        "status",
        "flag",
        "group",
        "assignee",
        "dueDate",
        "mandatory"
      ],
      "contentType": "application/json"
    },
    "get-task": {
      "kind": "http",
      "method": "GET",
      "path": "{thehiveHost}/api/v1/task/{taskId}",
      "required": [
        "taskId"
      ]
    },
    "search-tasks": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "update-task": {
      "kind": "http",
      "method": "PATCH",
      "path": "{thehiveHost}/api/v1/task/{taskId}",
      "required": [
        "taskId"
      ],
      "bodyFrom": [
        "title",
        "description",
        "status",
        "flag",
        "group",
        "assignee",
        "dueDate",
        "mandatory"
      ],
      "contentType": "application/json"
    },
    "delete-task": {
      "kind": "http",
      "method": "DELETE",
      "path": "{thehiveHost}/api/v1/task/{taskId}",
      "required": [
        "taskId"
      ]
    },
    "create-log": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/task/{taskId}/log",
      "required": [
        "taskId",
        "message"
      ],
      "bodyFrom": [
        "message",
        "startDate",
        "includeInTimeline"
      ],
      "contentType": "application/json"
    },
    "get-log": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "create-comment": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/case/{caseId}/comment",
      "required": [
        "caseId",
        "message"
      ],
      "bodyFrom": [
        "message",
        "isExternal"
      ],
      "contentType": "application/json"
    },
    "search-comments": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "execute-query": {
      "kind": "http",
      "method": "POST",
      "path": "{thehiveHost}/api/v1/query",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "authorization",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
