{
  "baseUrl": "https://{region}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "track": {
      "kind": "http",
      "method": "POST",
      "path": "/api/track",
      "required": ["app_id", "event"],
      "bodyFrom": ["app_id", "event", "identity", "user_id", "timestamp", "properties"]
    },
    "identify": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v1/identify",
      "required": ["app_id", "user_id", "identity"],
      "bodyFrom": ["app_id", "user_id", "identity", "timestamp"]
    },
    "addUserProperties": {
      "kind": "http",
      "method": "POST",
      "path": "/api/add_user_properties",
      "required": ["app_id", "identity", "properties"],
      "bodyFrom": ["app_id", "identity", "properties"]
    },
    "addAccountProperties": {
      "kind": "http",
      "method": "POST",
      "path": "/api/add_account_properties",
      "required": ["app_id"],
      "bodyFrom": ["app_id", "account_id", "properties", "accounts"]
    }
  }
}
