{
  "baseUrl": "https://api.shipstation.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "API-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/shipments",
      "queryFrom": [
        "page",
        "page_size",
        "shipment_status",
        "batch_id"
      ]
    },
    "shipment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/shipments",
      "required": [
        "shipments"
      ],
      "bodyFrom": [
        "shipments"
      ],
      "contentType": "application/json"
    },
    "label_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/labels",
      "bodyFrom": [
        "shipment",
        "rate_id",
        "shipment_id",
        "validate_address",
        "label_format",
        "label_layout"
      ],
      "contentType": "application/json"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
