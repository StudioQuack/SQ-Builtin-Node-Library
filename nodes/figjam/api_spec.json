{
  "baseUrl": "https://api.figma.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Figma-Token",
    "prefix": "",
    "configKey": "personal_access_token"
  },
  "operations": {
    "file_get": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{file_key}",
      "required": [
        "file_key"
      ],
      "queryFrom": [
        "ids",
        "depth"
      ]
    },
    "comments_list": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{file_key}/comments",
      "required": [
        "file_key"
      ]
    },
    "comment_post": {
      "kind": "http",
      "method": "POST",
      "path": "/files/{file_key}/comments",
      "required": [
        "file_key",
        "message"
      ],
      "bodyFrom": [
        "message",
        "client_meta",
        "comment_id"
      ]
    },
    "comment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/files/{file_key}/comments/{comment_id}",
      "required": [
        "file_key",
        "comment_id"
      ]
    },
    "project_files": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{project_id}/files",
      "required": [
        "project_id"
      ]
    },
    "webhook_listen": {
      "kind": "ingress"
    }
  }
}
