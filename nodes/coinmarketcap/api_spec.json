{
  "baseUrl": "https://pro-api.coinmarketcap.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-CMC_PRO_API_KEY",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "listings_latest": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/cryptocurrency/listings/latest",
      "required": [],
      "queryFrom": [
        "start",
        "limit",
        "convert"
      ],
      "bodyFrom": []
    },
    "quotes_latest": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/cryptocurrency/quotes/latest",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "convert"
      ],
      "bodyFrom": []
    },
    "info": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/cryptocurrency/info",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol"
      ],
      "bodyFrom": []
    },
    "global_metrics": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/global-metrics/quotes/latest",
      "required": [],
      "queryFrom": [
        "convert"
      ],
      "bodyFrom": []
    }
  }
}
