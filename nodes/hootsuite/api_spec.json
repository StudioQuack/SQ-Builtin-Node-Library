{
  "baseUrl": "https://platform.hootsuite.com/v1",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "message_schedule": {
      "kind": "http",
      "method": "POST",
      "path": "/messages",
      "bodyFrom": [
        "text",
        "scheduledSendTime",
        "socialProfileIds",
        "emailNotification"
      ],
      "required": [
        "text",
        "scheduledSendTime"
      ]
    },
    "message_list": {
      "kind": "http",
      "method": "GET",
      "path": "/messages",
      "queryFrom": [
        "startTime",
        "endTime",
        "state",
        "limit"
      ],
      "required": [
        "startTime",
        "endTime"
      ]
    },
    "analytics_get": {
      "kind": "http",
      "method": "POST",
      "path": "/analytics/posts",
      "bodyFrom": [
        "filters",
        "limit",
        "cursor"
      ],
      "required": [
        "filters"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
