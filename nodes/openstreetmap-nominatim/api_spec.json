{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "nominatim_search": {
      "kind": "http",
      "method": "GET",
      "path": "{nominatim_host}/search?format=jsonv2",
      "required": [
        "nominatim_host",
        "q"
      ],
      "queryFrom": [
        "q",
        "limit",
        "countrycodes",
        "addressdetails",
        "email"
      ],
      "bodyFrom": []
    },
    "nominatim_reverse": {
      "kind": "http",
      "method": "GET",
      "path": "{nominatim_host}/reverse?format=jsonv2",
      "required": [
        "nominatim_host",
        "lat",
        "lon"
      ],
      "queryFrom": [
        "lat",
        "lon",
        "zoom",
        "addressdetails",
        "email"
      ],
      "bodyFrom": []
    },
    "nominatim_lookup": {
      "kind": "http",
      "method": "GET",
      "path": "{nominatim_host}/lookup?format=jsonv2",
      "required": [
        "nominatim_host",
        "osm_ids"
      ],
      "queryFrom": [
        "osm_ids",
        "email"
      ],
      "bodyFrom": []
    }
  }
}
