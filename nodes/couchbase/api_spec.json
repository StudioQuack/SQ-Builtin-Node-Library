{
  "baseUrl": "http://localhost:8093",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "username",
    "configKey": "password"
  },
  "operations": {
    "query.n1ql": {
      "method": "POST",
      "path": "/query/service",
      "bodyFrom": [
        "statement",
        "args",
        "timeout",
        "scan_consistency",
        "query_context",
        "client_context_id",
        "readonly",
        "max_parallelism",
        "pretty",
        "metrics"
      ],
      "required": [
        "statement"
      ],
      "kind": "http"
    }
  }
}
