{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "get-secure-score": {
      "kind": "http",
      "method": "GET",
      "path": "/security/secureScores/{id}",
      "required": [
        "id"
      ]
    },
    "list-secure-scores": {
      "kind": "http",
      "method": "GET",
      "path": "/security/secureScores",
      "queryFrom": [
        "$top",
        "$skip",
        "$filter"
      ]
    },
    "get-control-profile": {
      "kind": "http",
      "method": "GET",
      "path": "/security/secureScoreControlProfiles/{id}",
      "required": [
        "id"
      ]
    },
    "list-control-profiles": {
      "kind": "http",
      "method": "GET",
      "path": "/security/secureScoreControlProfiles",
      "queryFrom": [
        "$top",
        "$skip",
        "$filter"
      ]
    },
    "update-control-profile": {
      "kind": "http",
      "method": "PATCH",
      "path": "/security/secureScoreControlProfiles/{id}",
      "required": [
        "id",
        "vendorInformation"
      ],
      "bodyFrom": [
        "vendorInformation"
      ]
    }
  }
}
