{
  "baseUrl": "https://api.mapbox.com",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "geocode": {
      "kind": "http",
      "method": "GET",
      "path": "/search/geocode/v6/forward",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "limit",
        "country",
        "proximity",
        "types",
        "language"
      ],
      "bodyFrom": []
    },
    "reverse": {
      "kind": "http",
      "method": "GET",
      "path": "/search/geocode/v6/reverse",
      "required": [
        "longitude",
        "latitude"
      ],
      "queryFrom": [
        "longitude",
        "latitude",
        "types",
        "language"
      ],
      "bodyFrom": []
    },
    "directions": {
      "kind": "http",
      "method": "GET",
      "path": "/directions/v5/mapbox/{profile}/{coordinates}",
      "required": [
        "profile",
        "coordinates"
      ],
      "queryFrom": [
        "geometries",
        "overview"
      ],
      "bodyFrom": []
    },
    "isochrone": {
      "kind": "http",
      "method": "GET",
      "path": "/isochrone/v1/mapbox/{profile}/{coordinates}",
      "required": [
        "profile",
        "coordinates",
        "contours_minutes"
      ],
      "queryFrom": [
        "contours_minutes"
      ],
      "bodyFrom": []
    },
    "tilequery": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/{tileset}/tilequery/{coordinates}.json",
      "required": [
        "tileset",
        "coordinates"
      ],
      "queryFrom": [
        "radius",
        "limit"
      ],
      "bodyFrom": []
    }
  }
}
