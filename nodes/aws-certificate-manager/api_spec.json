{
    "baseUrl": "https://acm.{region}.amazonaws.com",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "acm",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "operations": {
        "get-certificate": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "CertificateArn"
            ],
            "bodyFrom": [
                "CertificateArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "CertificateManager.GetCertificate"
            }
        },
        "list-certificates": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [],
            "bodyFrom": [
                "CertificateStatuses",
                "CertificateKeyPairOrigins",
                "Includes",
                "MaxItems",
                "NextToken",
                "SortBy",
                "SortOrder"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "CertificateManager.ListCertificates"
            }
        },
        "get-metadata": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "CertificateArn"
            ],
            "bodyFrom": [
                "CertificateArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "CertificateManager.DescribeCertificate"
            }
        },
        "renew-certificate": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "CertificateArn"
            ],
            "bodyFrom": [
                "CertificateArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "CertificateManager.RenewCertificate"
            }
        },
        "delete-certificate": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "CertificateArn"
            ],
            "bodyFrom": [
                "CertificateArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "CertificateManager.DeleteCertificate"
            }
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
