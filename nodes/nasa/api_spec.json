{
  "baseUrl": "https://api.nasa.gov",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api_key"
  },
  "operations": {
    "apod": {
      "kind": "http",
      "method": "GET",
      "path": "/planetary/apod",
      "required": [],
      "queryFrom": [
        "date",
        "start_date",
        "end_date"
      ],
      "bodyFrom": []
    },
    "neo_feed": {
      "kind": "http",
      "method": "GET",
      "path": "/neo/rest/v1/feed",
      "required": [],
      "queryFrom": [
        "start_date",
        "end_date"
      ],
      "bodyFrom": []
    },
    "neo_lookup": {
      "kind": "http",
      "method": "GET",
      "path": "/neo/rest/v1/neo/{asteroid_id}",
      "required": [
        "asteroid_id"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "neo_browse": {
      "kind": "http",
      "method": "GET",
      "path": "/neo/rest/v1/neo/browse",
      "required": [],
      "queryFrom": [
        "page",
        "size"
      ],
      "bodyFrom": []
    },
    "donki_cme": {
      "kind": "http",
      "method": "GET",
      "path": "/DONKI/CME",
      "required": [],
      "queryFrom": [
        "startDate",
        "endDate"
      ],
      "bodyFrom": []
    },
    "donki_flares": {
      "kind": "http",
      "method": "GET",
      "path": "/DONKI/FLR",
      "required": [],
      "queryFrom": [
        "startDate",
        "endDate"
      ],
      "bodyFrom": []
    },
    "donki_notifications": {
      "kind": "http",
      "method": "GET",
      "path": "/DONKI/notifications",
      "required": [],
      "queryFrom": [
        "startDate",
        "endDate",
        "type"
      ],
      "bodyFrom": []
    },
    "epic": {
      "kind": "http",
      "method": "GET",
      "path": "/EPIC/api/natural",
      "required": [],
      "queryFrom": [
        "date"
      ],
      "bodyFrom": []
    },
    "neo": {
      "kind": "http",
      "method": "GET",
      "path": "/neo/rest/v1/feed",
      "required": [],
      "queryFrom": [
        "start_date",
        "end_date"
      ],
      "bodyFrom": []
    },
    "donki": {
      "kind": "http",
      "method": "GET",
      "path": "/DONKI/notifications",
      "required": [],
      "queryFrom": [
        "startDate",
        "endDate",
        "type"
      ],
      "bodyFrom": []
    },
    "earth_imagery": {
      "kind": "http",
      "method": "GET",
      "path": "/EPIC/api/natural",
      "required": [],
      "queryFrom": [
        "date"
      ],
      "bodyFrom": []
    }
  }
}
