{
  "baseUrl": "https://api.sproutsocial.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "message_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/{customer_id}/publishing/posts",
      "required": [
        "group_id",
        "customer_profile_ids",
        "is_draft"
      ],
      "bodyFrom": [
        "group_id",
        "customer_profile_ids",
        "text",
        "is_draft",
        "scheduled_times",
        "delivery_type",
        "media_ids",
        "tag_ids",
        "media",
        "delivery"
      ]
    },
    "message_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/{customer_id}/publishing/posts/{publishing_post_id}",
      "required": [
        "publishing_post_id"
      ]
    },
    "analytics_get": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/{customer_id}/analytics/profiles",
      "required": [
        "filters"
      ],
      "bodyFrom": [
        "filters",
        "metrics"
      ]
    },
    "media_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/{customer_id}/media/",
      "required": [
        "media"
      ],
      "bodyFrom": [
        "media",
        "media_type"
      ],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    }
  }
}
