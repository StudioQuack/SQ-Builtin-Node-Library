{
  "baseUrl": "https://api.ipinfo.io",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "token"
  },
  "operations": {
    "lookup": {
      "kind": "http",
      "method": "GET",
      "path": "/lookup/{ip}",
      "required": [
        "ip"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "lite": {
      "kind": "http",
      "method": "GET",
      "path": "/lite/{ip}",
      "required": [
        "ip"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "me": {
      "kind": "http",
      "method": "GET",
      "path": "/lite/me",
      "required": [],
      "queryFrom": [],
      "bodyFrom": []
    },
    "batch": {
      "kind": "http",
      "method": "POST",
      "path": "/batch",
      "required": [
        "ips"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "ips"
      ],
      "bodyMap": {
        "ips": "$"
      }
    },
    "lookup_legacy": {
      "kind": "http",
      "method": "GET",
      "baseUrl": "https://ipinfo.io",
      "path": "/{ip}/json",
      "required": [
        "ip"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
