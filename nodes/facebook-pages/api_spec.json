{
  "baseUrl": "https://graph.facebook.com/v26.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "page_access_token"
  },
  "operations": {
    "graph_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{path}",
      "required": [
        "path"
      ]
    },
    "page_post_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{page_id}/feed",
      "required": [
        "page_id"
      ],
      "bodyFrom": [
        "message",
        "link",
        "published",
        "scheduled_publish_time"
      ]
    },
    "page_feed_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{page_id}/feed",
      "required": [
        "page_id"
      ],
      "queryFrom": [
        "limit"
      ]
    },
    "insights_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{page_id}/insights",
      "required": [
        "page_id",
        "metric"
      ],
      "queryFrom": [
        "metric",
        "period",
        "since",
        "until"
      ]
    },
    "lead_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{page_id}/leadgen_forms",
      "required": [
        "page_id"
      ]
    },
    "graph_post": {
      "kind": "http",
      "method": "POST",
      "path": "/{path}",
      "required": [
        "path"
      ],
      "bodyFrom": [
        "message",
        "link"
      ]
    },
    "graph_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{object_id}",
      "required": [
        "object_id"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "query_challenge",
      "method": "GET",
      "modeParam": "hub.mode",
      "modeValue": "subscribe",
      "tokenParam": "hub.verify_token",
      "tokenConfigKey": "verify_token",
      "challengeParam": "hub.challenge",
      "responseContentType": "text/plain"
    },
    "verify": {
      "type": "hmac_sha256_hex",
      "header": "x-hub-signature-256",
      "prefix": "sha256=",
      "secretConfigKey": "app_secret"
    },
    "extract": {
      "itemsPath": "entry[*].changes[*]",
      "correlationKeyPath": "field",
      "eventTypePath": "field",
      "maxItems": 100
    }
  }
}
