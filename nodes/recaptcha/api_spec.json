{
  "baseUrl": "https://www.google.com",
  "defaultTimeout": 15,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "secret"
  },
  "operations": {
    "verify": {
      "kind": "http",
      "method": "POST",
      "path": "/recaptcha/api/siteverify",
      "required": [
        "secret",
        "response"
      ],
      "bodyFrom": [
        "secret",
        "response",
        "remoteip"
      ],
      "contentType": "application/x-www-form-urlencoded"
    }
  }
}
