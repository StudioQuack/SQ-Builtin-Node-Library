{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "ApiKey ",
    "configKey": "api_key"
  },
  "operations": {
    "create-case": {
      "kind": "http",
      "method": "POST",
      "path": "{kibanaHost}/api/cases",
      "required": [
        "title",
        "description",
        "connector",
        "settings"
      ],
      "bodyFrom": [
        "title",
        "description",
        "owner",
        "tags",
        "severity",
        "connector",
        "settings",
        "assignees",
        "category",
        "customFields"
      ]
    },
    "get-case": {
      "kind": "http",
      "method": "GET",
      "path": "{kibanaHost}/api/cases/{caseId}",
      "required": [
        "caseId"
      ]
    },
    "list-cases": {
      "kind": "http",
      "method": "GET",
      "path": "{kibanaHost}/api/cases/_find",
      "queryFrom": [
        "page",
        "perPage",
        "search",
        "status",
        "severity",
        "tags",
        "owner",
        "sortField",
        "sortOrder"
      ]
    },
    "update-case": {
      "kind": "http",
      "method": "PATCH",
      "path": "{kibanaHost}/api/cases",
      "required": [
        "cases"
      ],
      "bodyFrom": [
        "cases"
      ]
    },
    "delete-case": {
      "kind": "http",
      "method": "DELETE",
      "path": "{kibanaHost}/api/cases",
      "queryFrom": [
        "ids"
      ]
    },
    "get-case-status": {
      "kind": "http",
      "method": "GET",
      "path": "{kibanaHost}/api/cases/_find",
      "queryFrom": [
        "owner",
        "perPage"
      ]
    },
    "add-comment": {
      "kind": "http",
      "method": "POST",
      "path": "{kibanaHost}/api/cases/{caseId}/comments",
      "required": [
        "caseId",
        "type",
        "comment"
      ],
      "bodyFrom": [
        "type",
        "comment",
        "owner",
        "alertId",
        "index",
        "rule"
      ]
    },
    "get-comment": {
      "kind": "http",
      "method": "GET",
      "path": "{kibanaHost}/api/cases/{caseId}/comments/{commentId}",
      "required": [
        "caseId",
        "commentId"
      ]
    },
    "list-comments": {
      "kind": "http",
      "method": "GET",
      "path": "{kibanaHost}/api/cases/{caseId}/comments/_find",
      "required": [
        "caseId"
      ],
      "queryFrom": [
        "page",
        "perPage",
        "sortOrder"
      ]
    },
    "update-comment": {
      "kind": "http",
      "method": "PATCH",
      "path": "{kibanaHost}/api/cases/{caseId}/comments",
      "required": [
        "caseId"
      ],
      "bodyFrom": [
        "id",
        "version",
        "type",
        "comment",
        "owner"
      ]
    },
    "remove-comment": {
      "kind": "http",
      "method": "DELETE",
      "path": "{kibanaHost}/api/cases/{caseId}/comments/{commentId}",
      "required": [
        "caseId",
        "commentId"
      ]
    },
    "add-tag": {
      "kind": "http",
      "method": "PATCH",
      "path": "{kibanaHost}/api/cases",
      "required": [
        "cases"
      ],
      "bodyFrom": [
        "cases"
      ]
    },
    "remove-tag": {
      "kind": "http",
      "method": "PATCH",
      "path": "{kibanaHost}/api/cases",
      "required": [
        "cases"
      ],
      "bodyFrom": [
        "cases"
      ]
    },
    "create-connector": {
      "kind": "http",
      "method": "POST",
      "path": "{kibanaHost}/api/actions/connector/{id}",
      "required": [
        "id",
        "name",
        "connector_type_id"
      ],
      "bodyFrom": [
        "name",
        "connector_type_id",
        "config",
        "secrets"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
