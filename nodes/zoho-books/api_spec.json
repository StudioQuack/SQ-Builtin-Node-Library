{
  "baseUrl": "https://www.zohoapis.{dc}/books/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Zoho-oauthtoken ",
    "configKey": "access_token"
  },
  "operations": {
    "contact_create": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts",
      "queryFrom": [
        "organization_id"
      ],
      "bodyFrom": [
        "contact_name",
        "contact_type",
        "company_name",
        "email",
        "phone",
        "billing_address",
        "shipping_address",
        "contact_persons",
        "payment_terms"
      ]
    },
    "invoice_create": {
      "kind": "http",
      "method": "POST",
      "path": "/invoices",
      "queryFrom": [
        "organization_id"
      ],
      "bodyFrom": [
        "customer_id",
        "line_items",
        "invoice_number",
        "date",
        "due_date",
        "payment_terms",
        "notes",
        "currency_id"
      ]
    },
    "invoice_get": {
      "kind": "http",
      "method": "GET",
      "path": "/invoices/{invoice_id}",
      "required": [
        "invoice_id"
      ],
      "queryFrom": [
        "organization_id"
      ]
    },
    "payment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/customerpayments",
      "queryFrom": [
        "organization_id"
      ],
      "bodyFrom": [
        "customer_id",
        "amount",
        "payment_mode",
        "date",
        "invoices",
        "reference_number",
        "description",
        "account_id"
      ]
    },
    "bill_create": {
      "kind": "http",
      "method": "POST",
      "path": "/bills",
      "queryFrom": [
        "organization_id"
      ],
      "bodyFrom": [
        "vendor_id",
        "line_items",
        "bill_number",
        "date",
        "due_date",
        "notes"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "x-zoho-webhook-token",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
