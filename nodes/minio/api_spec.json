{
  "baseUrl": "{endpoint}",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "aws-sigv4",
    "configKey": "access_key",
    "secretKeyConfigKey": "secret_key"
  },
  "docs": "https://min.io/docs/minio/linux/developers/minio-drivers.html",
  "operations": {
    "bucket_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_list": {
      "kind": "http",
      "method": "GET",
      "path": "/",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_put": {
      "kind": "http",
      "method": "PUT",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key",
        "file"
      ],
      "queryFrom": [],
      "contentType": "application/octet-stream",
      "bodyFormat": "raw",
      "bodyParam": "file"
    },
    "object_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [
        "list-type",
        "prefix",
        "delimiter",
        "continuation-token",
        "max-keys"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "presign": {
      "kind": "http",
      "method": "GET",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key"
      ],
      "queryFrom": [
        "X-Amz-Expires"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  },
  "sigv4": {
    "service": "s3",
    "regionConfigKey": "region"
  }
}
