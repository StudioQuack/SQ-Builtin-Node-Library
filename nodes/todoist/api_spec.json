{
  "baseUrl": "https://api.todoist.com/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "operations": {
    "create": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks",
      "bodyFrom": [
        "content",
        "description",
        "project_id",
        "section_id",
        "parent_id",
        "order",
        "labels",
        "priority",
        "assignee_id",
        "due_string",
        "due_date",
        "due_datetime",
        "due_lang",
        "duration",
        "duration_unit"
      ],
      "required": [
        "content"
      ],
      "contentType": "application/json"
    },
    "get": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks/{id}",
      "required": [
        "id"
      ]
    },
    "list": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks",
      "queryFrom": [
        "project_id",
        "section_id",
        "parent_id",
        "lang",
        "cursor",
        "limit"
      ]
    },
    "update": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "content",
        "description",
        "labels",
        "priority",
        "assignee_id",
        "due_string",
        "due_date",
        "due_datetime",
        "due_lang",
        "duration",
        "duration_unit"
      ],
      "contentType": "application/json"
    },
    "close": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{id}/close",
      "required": [
        "id"
      ]
    },
    "reopen": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{id}/reopen",
      "required": [
        "id"
      ]
    },
    "delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/tasks/{id}",
      "required": [
        "id"
      ]
    }
  }
}
