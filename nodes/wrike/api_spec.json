{
    "baseUrl": "https://{datacenter}/api/v4",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "access_token"
    },
    "operations": {
        "folder_create": {
            "kind": "http",
            "method": "POST",
            "path": "/folders/{folderId}/folders",
            "required": [
                "folderId"
            ],
            "bodyFrom": [
                "title"
            ]
        },
        "folder_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/folders/{folderId}",
            "required": [
                "folderId"
            ]
        },
        "task_create": {
            "kind": "http",
            "method": "POST",
            "path": "/folders/{folderId}/tasks",
            "required": [
                "folderId"
            ],
            "bodyFrom": [
                "title",
                "description",
                "status"
            ]
        },
        "task_get": {
            "kind": "http",
            "method": "GET",
            "path": "/tasks/{taskId}",
            "required": [
                "taskId"
            ]
        },
        "task_find": {
            "kind": "http",
            "method": "GET",
            "path": "/tasks",
            "queryFrom": [
                "title",
                "status",
                "responsibles"
            ]
        },
        "task_list_in_folder": {
            "kind": "http",
            "method": "GET",
            "path": "/folders/{folderId}/tasks",
            "required": [
                "folderId"
            ]
        },
        "task_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/tasks/{taskId}",
            "required": [
                "taskId"
            ]
        },
        "task_update": {
            "kind": "http",
            "method": "PUT",
            "path": "/tasks/{taskId}",
            "required": [
                "taskId"
            ],
            "bodyFrom": [
                "title",
                "description",
                "status"
            ]
        },
        "timelog_create": {
            "kind": "http",
            "method": "POST",
            "path": "/tasks/{taskId}/timelogs",
            "required": [
                "taskId"
            ],
            "bodyFrom": [
                "hours",
                "trackedDate"
            ]
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
