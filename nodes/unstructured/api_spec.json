{
  "baseUrl": "https://api.unstructuredapp.io",
  "defaultTimeout": 180,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "unstructured-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "partition": {
      "kind": "http",
      "method": "POST",
      "path": "/general/v0/general",
      "required": ["files"],
      "bodyFrom": ["files", "strategy", "content_type", "languages", "output_format", "coordinates", "include_page_breaks", "unique_element_ids", "skip_infer_table_types", "starting_page_number", "vlm_model", "vlm_model_provider", "xml_keep_tags"],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    },
    "chunk": {
      "kind": "http",
      "method": "POST",
      "path": "/general/v0/general",
      "required": ["files", "chunking_strategy"],
      "bodyFrom": ["files", "chunking_strategy", "strategy", "max_characters", "new_after_n_chars", "combine_under_n_chars", "overlap", "overlap_all", "multipage_sections", "include_orig_elements", "similarity_threshold", "content_type", "output_format"],
      "contentType": "multipart/form-data",
      "bodyFormat": "multipart"
    }
  }
}
