{
  "baseUrl": "https://maps.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "key"
  },
  "operations": {
    "geocode": {
      "kind": "http",
      "method": "GET",
      "path": "/maps/api/geocode/json",
      "required": [
        "address"
      ],
      "queryFrom": [
        "address",
        "region",
        "language",
        "components",
        "bounds"
      ],
      "bodyFrom": []
    },
    "reverse_geocode": {
      "kind": "http",
      "method": "GET",
      "path": "/maps/api/geocode/json",
      "required": [
        "latlng"
      ],
      "queryFrom": [
        "latlng",
        "language",
        "result_type",
        "location_type"
      ],
      "bodyFrom": []
    },
    "elevation": {
      "kind": "http",
      "method": "GET",
      "path": "/maps/api/elevation/json",
      "required": [
        "locations"
      ],
      "queryFrom": [
        "locations",
        "path",
        "samples"
      ],
      "bodyFrom": []
    },
    "timezone": {
      "kind": "http",
      "method": "GET",
      "path": "/maps/api/timezone/json",
      "required": [
        "location",
        "timestamp"
      ],
      "queryFrom": [
        "location",
        "timestamp",
        "language"
      ],
      "bodyFrom": []
    }
  }
}
