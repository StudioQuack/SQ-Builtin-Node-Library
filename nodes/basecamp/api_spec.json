{
  "baseUrl": "https://3.basecampapi.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "User-Agent": "{user_agent}"
  },
  "operations": {
    "project_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{account_id}/projects.json",
      "required": [
        "account_id"
      ]
    },
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{account_id}/projects/{project_id}.json",
      "required": [
        "account_id",
        "project_id"
      ]
    },
    "todo_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/todolists/{todolist_id}/todos.json",
      "required": [
        "account_id",
        "project_id",
        "todolist_id"
      ],
      "bodyFrom": [
        "content",
        "due_on"
      ]
    },
    "todo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{account_id}/buckets/{project_id}/todos/{todo_id}.json",
      "required": [
        "account_id",
        "project_id",
        "todo_id"
      ]
    },
    "todo_complete": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/todos/{todo_id}/completion.json",
      "required": [
        "account_id",
        "project_id",
        "todo_id"
      ]
    },
    "todo_list_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/todosets/{todoset_id}/todolists.json",
      "required": [
        "account_id",
        "project_id",
        "todoset_id"
      ],
      "bodyFrom": [
        "name",
        "description"
      ]
    },
    "message_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/message_boards/{message_board_id}/messages.json",
      "required": [
        "account_id",
        "project_id",
        "message_board_id"
      ],
      "bodyFrom": [
        "subject",
        "content"
      ]
    },
    "document_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/vaults/{vault_id}/documents.json",
      "required": [
        "account_id",
        "project_id",
        "vault_id"
      ],
      "bodyFrom": [
        "title",
        "content"
      ]
    },
    "comment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/recordings/{recording_id}/comments.json",
      "required": [
        "account_id",
        "project_id",
        "recording_id"
      ],
      "bodyFrom": [
        "content"
      ]
    },
    "person_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{account_id}/people.json",
      "required": [
        "account_id"
      ]
    },
    "campfire_line": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/chats/{chat_id}/lines.json",
      "required": [
        "account_id",
        "chat_id"
      ],
      "bodyFrom": [
        "content"
      ]
    },
    "schedule_entry": {
      "kind": "http",
      "method": "POST",
      "path": "/{account_id}/buckets/{project_id}/schedules/{schedule_id}/entries.json",
      "required": [
        "account_id",
        "project_id",
        "schedule_id"
      ],
      "bodyFrom": [
        "summary",
        "starts_at",
        "ends_at"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
