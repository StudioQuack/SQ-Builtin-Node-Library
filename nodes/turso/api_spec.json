{
  "baseUrl": "https://{database_name}-{organization_slug}.turso.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "auth_token"
  },
  "operations": {
    "execute.sql": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/pipeline",
      "required": [],
      "bodyFrom": ["requests"],
      "contentType": "application/json"
    },
    "database.health": {
      "kind": "http",
      "method": "GET",
      "path": "/health",
      "required": []
    }
  }
}
