{
  "baseUrl": "https://googleads.googleapis.com/v25",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "developer-token": "{developerToken}",
    "login-customer-id": "{loginCustomerId}"
  },
  "operations": {
    "customer.list": {
      "kind": "http",
      "method": "GET",
      "path": "/customers:listAccessibleCustomers",
      "required": []
    },
    "campaign.get": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/googleAds:search",
      "required": ["customerId", "query"],
      "bodyFrom": ["query", "pageSize", "pageToken"]
    },
    "campaign.list": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/googleAds:search",
      "required": ["customerId", "query"],
      "bodyFrom": ["query", "pageSize", "pageToken"]
    },
    "campaign.mutate": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/campaigns:mutate",
      "required": ["customerId", "operations"],
      "bodyFrom": ["operations", "partialFailure", "validateOnly"]
    },
    "adGroup.list": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/googleAds:search",
      "required": ["customerId", "query"],
      "bodyFrom": ["query", "pageSize", "pageToken"]
    },
    "ad.list": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/googleAds:search",
      "required": ["customerId", "query"],
      "bodyFrom": ["query", "pageSize", "pageToken"]
    },
    "report.query": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/googleAds:searchStream",
      "required": ["customerId", "query"],
      "bodyFrom": ["query", "pageSize"]
    },
    "conversion.upload": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}:uploadClickConversions",
      "required": ["customerId", "conversions"],
      "bodyFrom": ["conversions", "partialFailure", "validateOnly"]
    },
    "audience.mutate": {
      "kind": "http",
      "method": "POST",
      "path": "/customers/{customerId}/userLists:mutate",
      "required": ["customerId", "operations"],
      "bodyFrom": ["operations", "partialFailure"]
    }
  }
}
