{
  "baseUrl": "https://ai-gateway.vercel.sh/v1",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "tools", "tool_choice", "temperature", "top_p", "max_tokens", "stream", "stop", "seed", "response_format", "providerOptions"],
      "stream": {
        "format": "openai-sse"
      }
    }
  }
}
