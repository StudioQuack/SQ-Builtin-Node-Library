{
  "baseUrl": "https://api.easypost.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "userKey": "",
    "basicKeyPosition": "username"
  },
  "operations": {
    "address_create": {
      "kind": "http",
      "method": "POST",
      "path": "/addresses",
      "required": [],
      "bodyFrom": [
        "street1",
        "street2",
        "city",
        "state",
        "zip",
        "country",
        "name",
        "company",
        "phone",
        "email",
        "verify"
      ],
      "bodyMap": {
        "street1": "address.street1",
        "street2": "address.street2",
        "city": "address.city",
        "state": "address.state",
        "zip": "address.zip",
        "country": "address.country",
        "name": "address.name",
        "company": "address.company",
        "phone": "address.phone",
        "email": "address.email",
        "verify": "address.verify"
      }
    },
    "parcel_create": {
      "kind": "http",
      "method": "POST",
      "path": "/parcels",
      "required": [],
      "bodyFrom": [
        "length",
        "width",
        "height",
        "weight",
        "predefined_package"
      ],
      "bodyMap": {
        "length": "parcel.length",
        "width": "parcel.width",
        "height": "parcel.height",
        "weight": "parcel.weight",
        "predefined_package": "parcel.predefined_package"
      }
    },
    "shipment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/shipments",
      "required": [],
      "bodyFrom": [
        "to_address",
        "from_address",
        "return_address",
        "parcel",
        "customs_info",
        "carrier_accounts",
        "is_return"
      ],
      "bodyMap": {
        "to_address": "shipment.to_address",
        "from_address": "shipment.from_address",
        "return_address": "shipment.return_address",
        "parcel": "shipment.parcel",
        "customs_info": "shipment.customs_info",
        "carrier_accounts": "shipment.carrier_accounts",
        "is_return": "shipment.is_return"
      }
    },
    "buy": {
      "kind": "http",
      "method": "POST",
      "path": "/shipments/{id}/buy",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "rate",
        "insurance"
      ]
    },
    "tracker_create": {
      "kind": "http",
      "method": "POST",
      "path": "/trackers",
      "required": [],
      "bodyFrom": [
        "tracking_code",
        "carrier"
      ],
      "bodyMap": {
        "tracking_code": "tracker.tracking_code",
        "carrier": "tracker.carrier"
      }
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
