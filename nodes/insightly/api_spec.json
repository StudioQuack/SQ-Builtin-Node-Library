{
  "baseUrl": "https://api",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "api_key",
    "configKey": "api_key"
  },
  "operations": {
    "contact.create": {
      "kind": "http",
      "method": "POST",
      "path": ".{pod}.insightly.com/v3.1/Contacts",
      "required": [
        "pod",
        "FIRST_NAME"
      ],
      "bodyFrom": [
        "FIRST_NAME",
        "LAST_NAME",
        "EMAIL_ADDRESS",
        "PHONE",
        "TITLE",
        "ORGANISATION_ID",
        "BACKGROUND",
        "IMAGE_URL",
        "CUSTOMFIELDS"
      ]
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": ".{pod}.insightly.com/v3.1/Contacts/{id}",
      "required": [
        "pod",
        "id"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": ".{pod}.insightly.com/v3.1/Contacts",
      "required": [
        "pod"
      ],
      "queryFrom": [
        "top",
        "skip",
        "count_total",
        "field_name",
        "field_value",
        "updated_after_utc"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": ".{pod}.insightly.com/v3.1/Contacts/{id}",
      "required": [
        "pod",
        "id"
      ],
      "bodyFrom": [
        "FIRST_NAME",
        "LAST_NAME",
        "EMAIL_ADDRESS",
        "PHONE",
        "TITLE",
        "ORGANISATION_ID",
        "BACKGROUND",
        "IMAGE_URL",
        "CUSTOMFIELDS",
        "id"
      ],
      "bodyMap": {
        "id": "CONTACT_ID"
      }
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": ".{pod}.insightly.com/v3.1/Contacts/{id}",
      "required": [
        "pod",
        "id"
      ]
    },
