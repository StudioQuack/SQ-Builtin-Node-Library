{
  "baseUrl": "https://storage.googleapis.com/storage/v1",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://cloud.google.com/storage/docs/json_api",
  "operations": {
    "bucket_create": {
      "kind": "http",
      "method": "POST",
      "path": "/b",
      "required": [
        "project"
      ],
      "queryFrom": [
        "project"
      ],
      "bodyFrom": [
        "name",
        "location",
        "storageClass"
      ],
      "contentType": "application/json"
    },
    "bucket_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/b/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_get": {
      "kind": "http",
      "method": "GET",
      "path": "/b/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_list": {
      "kind": "http",
      "method": "GET",
      "path": "/b",
      "required": [
        "project"
      ],
      "queryFrom": [
        "project",
        "pageToken",
        "prefix",
        "maxResults"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/b/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "location",
        "storageClass",
        "iamConfiguration"
      ],
      "contentType": "application/json"
    },
    "object_create": {
      "kind": "http",
      "method": "POST",
      "path": "/b/{bucket}/o",
      "required": [
        "bucket",
        "name"
      ],
      "queryFrom": [
        "uploadType",
        "name",
        "contentType"
      ],
      "bodyFrom": [
        "name",
        "contentType",
        "metadata"
      ],
      "contentType": "application/json"
    },
    "object_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/b/{bucket}/o/{object}",
      "required": [
        "bucket",
        "object"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_get": {
      "kind": "http",
      "method": "GET",
      "path": "/b/{bucket}/o/{object}",
      "required": [
        "bucket",
        "object"
      ],
      "queryFrom": [
        "alt"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_list": {
      "kind": "http",
      "method": "GET",
      "path": "/b/{bucket}/o",
      "required": [
        "bucket"
      ],
      "queryFrom": [
        "prefix",
        "delimiter",
        "pageToken",
        "maxResults",
        "startOffset",
        "endOffset",
        "matchGlob"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/b/{bucket}/o/{object}",
      "required": [
        "bucket",
        "object"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "contentType",
        "metadata"
      ],
      "contentType": "application/json"
    }
  }
}
