{
    "baseUrl": "https://api.linkedin.com/rest",
    "defaultTimeout": 30,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "oauth_access_token"
    },
    "extraHeaders": {
        "Linkedin-Version": "202608",
        "X-Restli-Protocol-Version": "2.0.0"
    },
    "operations": {
        "account.list": {
            "kind": "http",
            "method": "GET",
            "path": "/adAccounts",
            "queryFrom": [
                "count",
                "start",
                "q"
            ],
            "required": []
        },
        "campaign.create": {
            "kind": "http",
            "method": "POST",
            "path": "/adAccounts/{ad_account_id}/adCampaigns",
            "required": [
                "ad_account_id",
                "name",
                "type",
                "campaignGroup",
                "costType",
                "runSchedule",
                "targetingCriteria"
            ],
            "bodyFrom": [
                "name",
                "type",
                "campaignGroup",
                "costType",
                "runSchedule",
                "targetingCriteria",
                "unitCost",
                "objectiveType",
                "locale"
            ]
        },
        "campaign.get": {
            "kind": "http",
            "method": "GET",
            "path": "/adAccounts/{ad_account_id}/adCampaigns/{campaign_id}",
            "required": [
                "ad_account_id",
                "campaign_id"
            ]
        },
        "campaign.list": {
            "kind": "http",
            "method": "GET",
            "path": "/adAccounts/{ad_account_id}/adCampaigns",
            "queryFrom": [
                "count",
                "start",
                "q"
            ],
            "required": [
                "ad_account_id"
            ]
        },
        "campaign.update": {
            "kind": "http",
            "method": "POST",
            "path": "/adAccounts/{ad_account_id}/adCampaigns/{campaign_id}",
            "required": [
                "ad_account_id",
                "campaign_id",
                "patch"
            ],
            "bodyFrom": [
                "patch"
            ]
        },
        "creative.create": {
            "kind": "http",
            "method": "POST",
            "path": "/adAccounts/{ad_account_id}/creatives",
            "required": [
                "ad_account_id",
                "campaign",
                "content"
            ],
            "bodyFrom": [
                "campaign",
                "status",
                "content"
            ],
            "bodyMap": {
                "status": "intendedStatus"
            }
        },
        "creative.list": {
            "kind": "http",
            "method": "GET",
            "path": "/adAccounts/{ad_account_id}/creatives",
            "queryFrom": [
                "count",
                "start"
            ],
            "required": [
                "ad_account_id"
            ]
        },
        "analytics.get": {
            "kind": "http",
            "method": "GET",
            "path": "/adAnalytics",
            "queryFrom": [
                "q",
                "pivot",
                "timeGranularity",
                "fields",
                "accounts",
                "campaigns",
                "dateRange"
            ],
            "required": [
                "q",
                "pivot",
                "timeGranularity"
            ]
        },
        "audience.create": {
            "kind": "http",
            "method": "POST",
            "path": "/dmpSegments",
            "required": [
                "name",
                "type",
                "account",
                "sourcePlatform"
            ],
            "bodyFrom": [
                "name",
                "type",
                "account",
                "sourcePlatform",
                "destinations"
            ]
        },
        "leadForm.list": {
            "kind": "http",
            "method": "GET",
            "path": "/leadForms",
            "queryFrom": [
                "q",
                "owner",
                "count",
                "start"
            ],
            "required": [
                "owner"
            ]
        },
        "lead.get": {
            "kind": "http",
            "method": "GET",
            "path": "/leadFormResponses",
            "queryFrom": [
                "q",
                "account",
                "form",
                "count",
                "start"
            ],
            "required": [
                "account"
            ]
        },
        "conversion.upload": {
            "kind": "http",
            "method": "POST",
            "path": "/conversionEvents",
            "required": [
                "conversion",
                "conversionHappenedAt",
                "user"
            ],
            "bodyFrom": [
                "conversion",
                "conversionHappenedAt",
                "user",
                "eventId"
            ]
        },
        "trigger.lead": {
            "kind": "ingress"
        }
    }
}
