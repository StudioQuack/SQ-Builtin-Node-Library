{
  "baseUrl": "https://www.dictionaryapi.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "key"
  },
  "operations": {
    "define": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/references/{ref}/json/{word}",
      "required": [
        "word"
      ]
    }
  }
}
