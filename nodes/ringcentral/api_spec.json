{
  "baseUrl": "https://platform.ringcentral.com/restapi/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/account/~/extension/~/sms",
      "contentType": "application/json",
      "bodyFrom": [
        "from",
        "to",
        "text"
      ],
      "required": [
        "from",
        "to",
        "text"
      ]
    },
    "send-fax": {
      "kind": "http",
      "method": "POST",
      "path": "/account/~/extension/~/fax",
      "contentType": "application/json",
      "bodyFrom": [
        "to",
        "coverIndex",
        "coverPageText"
      ]
    },
    "ringout": {
      "kind": "http",
      "method": "POST",
      "path": "/account/~/extension/~/ring-out",
      "contentType": "application/json",
      "bodyFrom": [
        "from",
        "to",
        "playPrompt"
      ]
    },
    "create-post": {
      "kind": "http",
      "method": "POST",
      "path": "/team-messaging/v1/chats/{chatId}/posts",
      "baseUrl": "https://platform.ringcentral.com",
      "contentType": "application/json",
      "required": [
        "chatId"
      ],
      "bodyFrom": [
        "text"
      ]
    },
    "create-contact": {
      "kind": "http",
      "method": "POST",
      "path": "/account/~/extension/~/address-book/contact",
      "contentType": "application/json",
      "bodyFrom": [
        "firstName",
        "lastName",
        "email",
        "homePhone",
        "mobilePhone",
        "company"
      ]
    },
    "update-contact": {
      "kind": "http",
      "method": "PUT",
      "path": "/account/~/extension/~/address-book/contact/{contactId}",
      "contentType": "application/json",
      "required": [
        "contactId"
      ],
      "bodyFrom": [
        "firstName",
        "lastName",
        "email",
        "homePhone",
        "mobilePhone",
        "company"
      ]
    },
    "find-contact": {
      "kind": "http",
      "method": "GET",
      "path": "/account/~/extension/~/address-book/contact",
      "contentType": "application/json",
      "queryFrom": [
        "startsWith",
        "phoneNumber"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
