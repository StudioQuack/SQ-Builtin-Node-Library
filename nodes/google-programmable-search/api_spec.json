{
  "baseUrl": "https://customsearch.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "key"
  },
  "operations": {
    "cse_list": {
      "kind": "http",
      "method": "GET",
      "path": "/customsearch/v1",
      "required": [
        "q",
        "cx"
      ],
      "queryFrom": [
        "q",
        "cx",
        "num",
        "start",
        "searchType",
        "lr",
        "safe",
        "gl",
        "cr",
        "dateRestrict",
        "exactTerms",
        "excludeTerms",
        "fileType",
        "filter",
        "orTerms",
        "siteSearch",
        "sort"
      ],
      "bodyFrom": []
    },
    "cse_siterestrict": {
      "kind": "http",
      "method": "GET",
      "path": "/customsearch/v1/siterestrict",
      "required": [
        "q",
        "cx"
      ],
      "queryFrom": [
        "q",
        "cx",
        "num",
        "start",
        "searchType",
        "lr",
        "safe",
        "gl",
        "cr",
        "dateRestrict",
        "exactTerms",
        "excludeTerms",
        "fileType",
        "filter",
        "orTerms",
        "siteSearch",
        "sort"
      ],
      "bodyFrom": []
    }
  }
}
