{
  "baseUrl": "https://ec.europa.eu/eurostat/api/dissemination",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "query": {
      "kind": "http",
      "method": "GET",
      "path": "/statistics/1.0/data/{datasetCode}?format=JSON",
      "required": [
        "datasetCode"
      ],
      "queryFrom": [
        "lang",
        "time",
        "sinceTimePeriod",
        "untilTimePeriod",
        "lastTimePeriod",
        "geo",
        "geoLevel",
        "precision"
      ],
      "bodyFrom": []
    },
    "metadata_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sdmx/2.1/dataflow/ESTAT/{datasetCode}?format=JSON",
      "required": [
        "datasetCode"
      ],
      "queryFrom": [
        "lang"
      ],
      "bodyFrom": []
    }
  }
}
