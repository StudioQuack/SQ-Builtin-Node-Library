{
  "baseUrl": "https://api.smartsheet.com/2.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "row_create": {
      "kind": "http",
      "method": "POST",
      "path": "/sheets/{sheetId}/rows",
      "required": [
        "sheetId"
      ],
      "bodyFrom": [
        "toBottom",
        "cells"
      ]
    },
    "row_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/sheets/{sheetId}/rows",
      "required": [
        "sheetId"
      ],
      "bodyFrom": [
        "id",
        "cells"
      ]
    },
    "row_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/sheets/{sheetId}/rows",
      "required": [
        "sheetId"
      ],
      "queryFrom": [
        "ids"
      ]
    },
    "sheet_create": {
      "kind": "http",
      "method": "POST",
      "path": "/sheets",
      "bodyFrom": [
        "name",
        "columns"
      ]
    },
    "sheet_copy": {
      "kind": "http",
      "method": "POST",
      "path": "/sheets/{sheetId}/copy",
      "required": [
        "sheetId"
      ],
      "bodyFrom": [
        "destinationType",
        "destinationId",
        "newName"
      ]
    },
    "sheet_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sheets/{sheetId}",
      "required": [
        "sheetId"
      ]
    },
    "folder_create": {
      "kind": "http",
      "method": "POST",
      "path": "/folders/{folderId}/folders",
      "required": [
        "folderId"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "folder_copy": {
      "kind": "http",
      "method": "POST",
      "path": "/folders/{folderId}/copy",
      "required": [
        "folderId"
      ],
      "bodyFrom": [
        "destinationType",
        "destinationId",
        "newName"
      ]
    },
    "workspace_copy": {
      "kind": "http",
      "method": "POST",
      "path": "/workspaces/{workspaceId}/copy",
      "required": [
        "workspaceId"
      ],
      "bodyFrom": [
        "newName"
      ]
    },
    "comment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/sheets/{sheetId}/discussions/{discussionId}/comments",
      "required": [
        "sheetId",
        "discussionId"
      ],
      "bodyFrom": [
        "text"
      ]
    },
    "user_add": {
      "kind": "http",
      "method": "POST",
      "path": "/users",
      "bodyFrom": [
        "email",
        "admin",
        "licensedSheetCreator"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
