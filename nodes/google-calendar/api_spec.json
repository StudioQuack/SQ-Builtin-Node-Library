{
  "baseUrl": "https://www.googleapis.com/calendar/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "availability": {
      "kind": "http",
      "method": "POST",
      "path": "/freeBusy",
      "bodyFrom": [
        "timeMin",
        "timeMax",
        "items",
        "timeZone",
        "calendarExpansionMax"
      ]
    },
    "create_event": {
      "kind": "http",
      "method": "POST",
      "path": "/calendars/{calendarId}/events",
      "required": [
        "calendarId"
      ],
      "bodyFrom": [
        "summary",
        "start",
        "end",
        "description",
        "attendees",
        "location",
        "reminders",
        "status",
        "visibility",
        "colorId",
        "recurrence",
        "conferenceData",
        "guestsCanModify",
        "transparency"
      ],
      "queryFrom": [
        "sendUpdates",
        "conferenceDataVersion"
      ]
    },
    "delete_event": {
      "kind": "http",
      "method": "DELETE",
      "path": "/calendars/{calendarId}/events/{eventId}",
      "required": [
        "calendarId",
        "eventId"
      ],
      "queryFrom": [
        "sendUpdates"
      ]
    },
    "get_event": {
      "kind": "http",
      "method": "GET",
      "path": "/calendars/{calendarId}/events/{eventId}",
      "required": [
        "calendarId",
        "eventId"
      ],
      "queryFrom": [
        "timeZone",
        "maxAttendees"
      ]
    },
    "list_events": {
      "kind": "http",
      "method": "GET",
      "path": "/calendars/{calendarId}/events",
      "required": [
        "calendarId"
      ],
      "queryFrom": [
        "timeMin",
        "timeMax",
        "q",
        "maxResults",
        "pageToken",
        "singleEvents",
        "orderBy",
        "timeZone",
        "updatedMin",
        "showDeleted",
        "maxAttendees"
      ]
    },
    "update_event": {
      "kind": "http",
      "method": "PATCH",
      "path": "/calendars/{calendarId}/events/{eventId}",
      "required": [
        "calendarId",
        "eventId"
      ],
      "bodyFrom": [
        "summary",
        "start",
        "end",
        "description",
        "attendees",
        "location",
        "reminders",
        "status",
        "visibility",
        "colorId",
        "recurrence",
        "conferenceData",
        "guestsCanModify",
        "transparency"
      ],
      "queryFrom": [
        "sendUpdates",
        "conferenceDataVersion"
      ]
    },
    "list_calendars": {
      "kind": "http",
      "method": "GET",
      "path": "/users/me/calendarList",
      "queryFrom": [
        "maxResults",
        "pageToken"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
