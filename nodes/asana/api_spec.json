{
  "baseUrl": "https://app.asana.com/api/1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "personal_access_token"
  },
  "operations": {
    "project_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects",
      "bodyFrom": [
        "data",
        "name",
        "notes",
        "html_notes",
        "color",
        "privacy_setting",
        "archived",
        "due_on",
        "start_on"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "name": "data.name",
        "notes": "data.notes",
        "html_notes": "data.html_notes",
        "color": "data.color",
        "privacy_setting": "data.privacy_setting",
        "archived": "data.archived",
        "due_on": "data.due_on",
        "start_on": "data.start_on"
      }
    },
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{project_gid}",
      "required": [
        "project_gid"
      ],
      "queryFrom": [
        "opt_fields"
      ]
    },
    "project_list": {
      "kind": "http",
      "method": "GET",
      "path": "/projects",
      "queryFrom": [
        "limit",
        "offset",
        "opt_fields"
      ]
    },
    "project_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{project_gid}",
      "required": [
        "project_gid"
      ],
      "bodyFrom": [
        "data",
        "name",
        "notes",
        "html_notes",
        "color",
        "privacy_setting",
        "archived",
        "due_on",
        "start_on"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "name": "data.name",
        "notes": "data.notes",
        "html_notes": "data.html_notes",
        "color": "data.color",
        "privacy_setting": "data.privacy_setting",
        "archived": "data.archived",
        "due_on": "data.due_on",
        "start_on": "data.start_on"
      }
    },
    "project_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/projects/{project_gid}",
      "required": [
        "project_gid"
      ]
    },
    "task_create": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks",
      "bodyFrom": [
        "data",
        "name",
        "notes",
        "html_notes",
        "due_on",
        "due_at",
        "start_on",
        "assignee",
        "completed"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "name": "data.name",
        "notes": "data.notes",
        "html_notes": "data.html_notes",
        "due_on": "data.due_on",
        "due_at": "data.due_at",
        "start_on": "data.start_on",
        "assignee": "data.assignee",
        "completed": "data.completed"
      }
    },
    "task_get": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks/{task_gid}",
      "required": [
        "task_gid"
      ],
      "queryFrom": [
        "opt_fields"
      ]
    },
    "task_list": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks",
      "queryFrom": [
        "project",
        "assignee",
        "limit",
        "offset"
      ]
    },
    "task_search": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces/{workspace_gid}/tasks/search",
      "required": [
        "workspace_gid"
      ],
      "queryFrom": [
        "text",
        "completed",
        "limit"
      ]
    },
    "task_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/tasks/{task_gid}",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "name",
        "notes",
        "html_notes",
        "due_on",
        "due_at",
        "start_on",
        "assignee",
        "completed"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "name": "data.name",
        "notes": "data.notes",
        "html_notes": "data.html_notes",
        "due_on": "data.due_on",
        "due_at": "data.due_at",
        "start_on": "data.start_on",
        "assignee": "data.assignee",
        "completed": "data.completed"
      }
    },
    "task_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/tasks/{task_gid}",
      "required": [
        "task_gid"
      ]
    },
    "task_move": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_gid}/addProject",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "project",
        "section",
        "insert_before",
        "insert_after"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "project": "data.project",
        "section": "data.section",
        "insert_before": "data.insert_before",
        "insert_after": "data.insert_after"
      }
    },
    "subtask_create": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_gid}/subtasks",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "name",
        "notes",
        "html_notes",
        "due_on",
        "due_at",
        "start_on",
        "assignee",
        "completed"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "name": "data.name",
        "notes": "data.notes",
        "html_notes": "data.html_notes",
        "due_on": "data.due_on",
        "due_at": "data.due_at",
        "start_on": "data.start_on",
        "assignee": "data.assignee",
        "completed": "data.completed"
      }
    },
    "subtask_list": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks/{task_gid}/subtasks",
      "required": [
        "task_gid"
      ]
    },
    "comment_add": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_gid}/stories",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "text",
        "html_text"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "text": "data.text",
        "html_text": "data.html_text"
      }
    },
    "comment_remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/stories/{story_gid}",
      "required": [
        "story_gid"
      ]
    },
    "tag_add": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_gid}/addTag",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "tag"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "tag": "data.tag"
      }
    },
    "tag_remove": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks/{task_gid}/removeTag",
      "required": [
        "task_gid"
      ],
      "bodyFrom": [
        "data",
        "tag"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "tag": "data.tag"
      }
    },
    "project_add_task": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{project_gid}/addTask",
      "required": [
        "project_gid"
      ],
      "bodyFrom": [
        "data",
        "task",
        "section",
        "insert_before",
        "insert_after"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "task": "data.task",
        "section": "data.section",
        "insert_before": "data.insert_before",
        "insert_after": "data.insert_after"
      }
    },
    "project_remove_task": {
      "kind": "http",
      "method": "POST",
      "path": "/projects/{project_gid}/removeTask",
      "required": [
        "project_gid"
      ],
      "bodyFrom": [
        "data",
        "task"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "task": "data.task"
      }
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{user_gid}",
      "required": [
        "user_gid"
      ]
    },
    "user_list": {
      "kind": "http",
      "method": "GET",
      "path": "/users",
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
