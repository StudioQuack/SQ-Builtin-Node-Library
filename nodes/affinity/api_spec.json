{
  "baseUrl": "https://api.affinity.co",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "X-Affinity-Api-Version": "{api_version}"
  },
  "operations": {
    "person.create": {
      "kind": "http",
      "method": "POST",
      "path": "/persons",
      "required": [
        "first_name",
        "last_name"
      ],
      "bodyFrom": [
        "first_name",
        "last_name",
        "emails",
        "organization_ids"
      ],
      "contentType": "application/json"
    },
    "person.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/persons/{personId}",
      "required": [
        "personId"
      ],
      "queryFrom": [
        "fieldIds",
        "fieldTypes"
      ]
    },
    "person.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/persons",
      "required": [],
      "queryFrom": [
        "cursor",
        "limit",
        "ids",
        "fieldIds",
        "fieldTypes"
      ]
    },
    "person.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/persons/{personId}",
      "required": [
        "personId"
      ],
      "bodyFrom": [
        "first_name",
        "last_name",
        "emails",
        "organization_ids"
      ],
      "contentType": "application/json"
    },
    "person.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/persons/{personId}",
      "required": [
        "personId"
      ]
    },
    "organization.create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizations",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "domain",
        "person_ids"
      ],
      "contentType": "application/json"
    },
    "organization.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/companies/{organizationId}",
      "required": [
        "organizationId"
      ],
      "queryFrom": [
        "fieldIds",
        "fieldTypes"
      ]
    },
    "organization.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/companies",
      "required": [],
      "queryFrom": [
        "cursor",
        "limit",
        "fieldIds",
        "fieldTypes"
      ]
    },
    "organization.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/organizations/{organizationId}",
      "required": [
        "organizationId"
      ],
      "bodyFrom": [
        "name",
        "domain",
        "person_ids"
      ],
      "contentType": "application/json"
    },
    "organization.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/organizations/{organizationId}",
      "required": [
        "organizationId"
      ]
    },
    "list.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/lists/{listId}",
      "required": [
        "listId"
      ]
    },
    "list.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/lists",
      "required": [],
      "queryFrom": [
        "cursor",
        "limit"
      ]
    },
    "listEntry.create": {
      "kind": "http",
      "method": "POST",
      "path": "/lists/{listId}/list-entries",
      "required": [
        "listId"
      ],
      "bodyFrom": [
        "entity_id"
      ],
      "contentType": "application/json"
    },
    "listEntry.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/lists/{listId}/list-entries/{listEntryId}",
      "required": [
        "listId",
        "listEntryId"
      ],
      "queryFrom": [
        "fieldIds"
      ]
    },
    "listEntry.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/lists/{listId}/list-entries",
      "required": [
        "listId"
      ],
      "queryFrom": [
        "cursor",
        "limit",
        "fieldIds"
      ]
    },
    "listEntry.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/lists/{listId}/list-entries/{listEntryId}",
      "required": [
        "listId",
        "listEntryId"
      ]
    }
  }
}
