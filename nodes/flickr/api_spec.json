{
  "baseUrl": "https://api.flickr.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api_key"
  },
  "operations": {
    "photo_search": {
      "kind": "http",
      "method": "GET",
      "path": "/services/rest?method=flickr.photos.search&format=json&nojsoncallback=1",
      "required": [],
      "queryFrom": [
        "text",
        "user_id",
        "tags",
        "license",
        "per_page",
        "page",
        "sort",
        "min_upload_date",
        "extras"
      ]
    },
    "photo_get": {
      "kind": "http",
      "method": "GET",
      "path": "/services/rest?method=flickr.photos.getInfo&format=json&nojsoncallback=1",
      "required": [
        "photo_id"
      ],
      "queryFrom": [
        "photo_id"
      ]
    },
    "people_get": {
      "kind": "http",
      "method": "GET",
      "path": "/services/rest?method=flickr.people.getInfo&format=json&nojsoncallback=1",
      "required": [
        "user_id"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
