{
  "baseUrl": "https://router.huggingface.co",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/chat/completions",
      "required": [
        "messages"
      ],
      "bodyFrom": [
        "model",
        "messages",
        "tools",
        "tool_choice",
        "temperature",
        "top_p",
        "max_tokens",
        "frequency_penalty",
        "presence_penalty",
        "stream",
        "stop",
        "seed",
        "response_format",
        "logprobs",
        "top_logprobs"
      ],
      "stream": {
        "format": "openai-sse"
      }
    },
    "embeddings": {
      "kind": "http",
      "method": "POST",
      "path": "/{provider}/models/{model}",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "inputs",
        "input",
        "normalize",
        "prompt_name",
        "truncate",
        "truncation_direction"
      ]
    },
    "inference": {
      "kind": "http",
      "method": "POST",
      "path": "/{provider}/models/{model}",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "inputs",
        "parameters"
      ]
    },
    "models_search": {
      "kind": "http",
      "method": "GET",
      "path": "/api/models",
      "queryFrom": [
        "search",
        "author",
        "filter",
        "sort",
        "direction",
        "limit",
        "full"
      ],
      "required": []
    },
    "datasets_search": {
      "kind": "http",
      "method": "GET",
      "path": "/api/datasets",
      "queryFrom": [
        "search",
        "author",
        "filter",
        "sort",
        "direction",
        "limit",
        "full"
      ],
      "required": []
    }
  }
}
