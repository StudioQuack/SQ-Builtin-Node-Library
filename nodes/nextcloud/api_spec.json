{
  "baseUrl": "{base_url}",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "Basic ",
    "configKey": "app_password",
    "userKey": "username"
  },
  "docs": "https://docs.nextcloud.com/server/stable/developer_manual/client_apis/WebDAV/index.html",
  "operations": {
    "copy_file": {
      "kind": "http",
      "method": "COPY",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path",
        "destination"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json",
      "extraHeaders": {
        "Destination": "{destination}"
      }
    },
    "delete_file": {
      "kind": "http",
      "method": "DELETE",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "download": {
      "kind": "http",
      "method": "GET",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "move_file": {
      "kind": "http",
      "method": "MOVE",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path",
        "destination"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json",
      "extraHeaders": {
        "Destination": "{destination}"
      }
    },
    "share_file": {
      "kind": "http",
      "method": "POST",
      "path": "/ocs/v2.php/apps/files_sharing/api/v1/shares",
      "required": [],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [
        "path",
        "shareType",
        "shareWith",
        "permissions",
        "share_type",
        "share_with"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "share_type": "shareType",
        "share_with": "shareWith"
      }
    },
    "upload": {
      "kind": "http",
      "method": "PUT",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path",
        "file"
      ],
      "queryFrom": [],
      "contentType": "application/octet-stream",
      "bodyFormat": "raw",
      "bodyParam": "file"
    },
    "copy_folder": {
      "kind": "http",
      "method": "COPY",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path",
        "destination"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json",
      "extraHeaders": {
        "Destination": "{destination}"
      }
    },
    "create_folder": {
      "kind": "http",
      "method": "MKCOL",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "delete_folder": {
      "kind": "http",
      "method": "DELETE",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "list_folder": {
      "kind": "http",
      "method": "PROPFIND",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "move_folder": {
      "kind": "http",
      "method": "MOVE",
      "path": "/remote.php/dav/files/{username}/{path}",
      "required": [
        "username",
        "path",
        "destination"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json",
      "extraHeaders": {
        "Destination": "{destination}"
      }
    },
    "share_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/ocs/v2.php/apps/files_sharing/api/v1/shares",
      "required": [],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [
        "path",
        "shareType",
        "shareWith",
        "share_type",
        "share_with"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "share_type": "shareType",
        "share_with": "shareWith"
      }
    },
    "user_invite": {
      "kind": "http",
      "method": "POST",
      "path": "/ocs/v1.php/cloud/users",
      "required": [],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [
        "userid",
        "password",
        "displayName",
        "email",
        "user_id"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "user_id": "userid"
      }
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/ocs/v1.php/cloud/users/{user_id}",
      "required": [
        "user_id"
      ],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "user_list": {
      "kind": "http",
      "method": "GET",
      "path": "/ocs/v1.php/cloud/users",
      "required": [],
      "queryFrom": [
        "format",
        "search"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "user_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/ocs/v1.php/cloud/users/{user_id}",
      "required": [
        "user_id"
      ],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [
        "key",
        "value"
      ],
      "contentType": "application/json"
    },
    "user_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/ocs/v1.php/cloud/users/{user_id}",
      "required": [
        "user_id"
      ],
      "queryFrom": [
        "format"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
