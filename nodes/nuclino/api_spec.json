{
  "baseUrl": "https://api.nuclino.com/v0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "item_create": {
      "kind": "http",
      "method": "POST",
      "path": "/items",
      "bodyFrom": [
        "workspaceId",
        "parentId",
        "title",
        "content"
      ]
    },
    "item_get": {
      "kind": "http",
      "method": "GET",
      "path": "/items/{itemId}",
      "required": [
        "itemId"
      ]
    },
    "item_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/items/{itemId}",
      "required": [
        "itemId"
      ],
      "bodyFrom": [
        "title",
        "content"
      ]
    },
    "item_list": {
      "kind": "http",
      "method": "GET",
      "path": "/items",
      "queryFrom": [
        "workspaceId",
        "limit",
        "after"
      ]
    },
    "item_search": {
      "kind": "http",
      "method": "GET",
      "path": "/items",
      "queryFrom": [
        "workspaceId",
        "search"
      ]
    },
    "collection_list": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces"
    },
    "user_list": {
      "kind": "http",
      "method": "GET",
      "path": "/users/{userId}",
      "required": [
        "userId"
      ]
    }
  }
}
