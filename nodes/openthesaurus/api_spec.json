{
  "baseUrl": "https://www.openthesaurus.de",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "synonyms": {
      "kind": "http",
      "method": "GET",
      "path": "/synonyme/search?format=application/json",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "similar",
        "substring"
      ]
    }
  }
}
