      "kind": "http",
      "method": "POST",
      "path": "/crm/sales/api/contacts",
      "required": [
        "bundleAlias",
        "contact"
      ],
      "bodyFrom": [
        "contact"
      ]
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/sales/api/contacts/{id}",
      "required": [
        "bundleAlias",
        "id"
      ],
      "queryFrom": [
        "include"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/crm/sales/api/contacts/view/{view_id}",
      "required": [
        "bundleAlias",
        "view_id"
      ],
      "queryFrom": [
        "page"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/crm/sales/api/contacts/{id}",
      "required": [
