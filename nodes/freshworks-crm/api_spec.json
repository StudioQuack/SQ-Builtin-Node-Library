{
  "baseUrl": "https://{bundleAlias}.{hostSuffix}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Token token=",
    "configKey": "apiKey"
  },
