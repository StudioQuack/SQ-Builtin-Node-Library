{
  "baseUrl": "{base_url}",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "tools", "tool_choice", "temperature", "top_p", "n", "max_completion_tokens", "presence_penalty", "frequency_penalty", "stop", "stream", "response_format", "thinking", "reasoning_effort"],
      "stream": {
        "format": "openai-sse"
      }
    },
    "analyze_image": {
      "kind": "http",
      "method": "POST",
      "path": "/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "max_completion_tokens", "stream", "thinking", "reasoning_effort"]
    },
    "list_models": {
      "kind": "http",
      "method": "GET",
      "path": "/models",
      "required": []
    }
  }
}
