{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "create-attribute": {
      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/attributes/add/{eventId}",
      "required": [
        "eventId"
      ],
      "bodyFrom": [
        "Attribute"
      ]
    },
    "get-attribute": {
      "kind": "http",
      "method": "GET",
      "path": "{mispHost}/attributes/view/{attributeId}",
      "required": [
        "attributeId"
      ]
    },
    "list-attributes": {
      "kind": "http",
      "method": "GET",
      "path": "{mispHost}/attributes"
    },
    "search-attributes": {
      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/attributes/restSearch"
    },
    "update-attribute": {
      "kind": "http",
      "method": "PUT",
      "path": "{mispHost}/attributes/edit/{attributeId}",
      "required": [
        "attributeId"
      ],
      "bodyFrom": [
        "Attribute"
      ]
    },
    "delete-attribute": {
      "kind": "http",
      "method": "DELETE",
      "path": "{mispHost}/attributes/delete/{attributeId}",
      "required": [
        "attributeId"
      ]
    },
    "create-event": {
      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/events/add",
      "bodyFrom": [
        "Event"
      ]
    },
    "get-event": {
      "kind": "http",
      "method": "GET",
      "path": "{mispHost}/events/view/{eventId}",
      "required": [
        "eventId"
      ]
