      "kind": "http",
      "method": "GET",
      "path": "{mispHost}/events"
    },
    "search-events": {
      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/events/restSearch"
    },
    "update-event": {
      "kind": "http",
      "method": "PUT",
      "path": "{mispHost}/events/edit/{eventId}",
      "required": [
        "eventId"
      ],
      "bodyFrom": [
        "Event"
      ]
    },
    "delete-event": {
      "kind": "http",
      "method": "DELETE",
      "path": "{mispHost}/events/delete/{eventId}",
      "required": [
        "eventId"
      ]
