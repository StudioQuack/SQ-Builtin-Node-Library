      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/events/addTag/{eventId}/{tagId}/local:{local}",
      "required": [
        "eventId",
        "tagId",
        "local"
      ]
    },
    "remove-event-tag": {
      "kind": "http",
      "method": "POST",
      "path": "{mispHost}/events/removeTag/{eventId}/{tagId}",
      "required": [
        "eventId",
