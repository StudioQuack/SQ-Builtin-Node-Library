{
  "baseUrl": "https://whimsical.com/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "board_get": {
      "kind": "http",
      "method": "POST",
      "path": "/files.get",
      "bodyFrom": [
        "id"
      ]
    },
    "board_list": {
      "kind": "http",
      "method": "POST",
      "path": "/files.list",
      "bodyFrom": [
        "parentId"
      ]
    },
    "users_get": {
      "kind": "http",
      "method": "POST",
      "path": "/users.get",
      "bodyFrom": [
        "id"
      ]
    },
    "teams_list": {
      "kind": "http",
      "method": "POST",
      "path": "/teams.list"
    },
    "comments_list": {
      "kind": "http",
      "method": "POST",
      "path": "/comments.list",
      "bodyFrom": [
        "itemId"
      ]
    }
  }
}
