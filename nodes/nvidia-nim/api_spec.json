{
  "baseUrl": "https://integrate.api.nvidia.com",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/chat/completions",
      "required": ["messages"],
      "bodyFrom": ["model", "messages", "tools", "tool_choice", "temperature", "top_p", "max_tokens", "stream", "stop", "seed", "frequency_penalty", "presence_penalty"],
      "stream": {
        "format": "openai-sse"
      }
    },
    "embeddings": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/embeddings",
      "required": ["input"],
      "bodyFrom": ["model", "input", "input_type", "encoding_format", "dimensions", "truncate", "user"]
    }
  }
}
