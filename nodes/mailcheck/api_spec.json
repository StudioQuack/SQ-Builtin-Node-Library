{
  "baseUrl": "https://api.usercheck.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "email.check": {
      "kind": "http",
      "method": "GET",
      "path": "/email/{email}",
      "required": ["email"]
    },
    "domain.check": {
      "kind": "http",
      "method": "GET",
      "path": "/domain/{domain}",
      "required": ["domain"]
    }
  }
}
