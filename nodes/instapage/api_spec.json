{
  "baseUrl": "https://api.instapage.com",
  "auth": {
    "type": "none"
  },
  "operations": {
    "trigger.listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "header_secret",
      "header": "authorization",
      "secretConfigKey": "webhook_secret",
      "headerConfigKey": "webhook_header_name"
    },
    "extract": {}
  }
}
