{
  "baseUrl": "https://api.clickup.com/api/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "task_create": {
      "kind": "http",
      "method": "POST",
      "path": "/list/{list_id}/task",
      "required": [
        "list_id"
      ],
      "bodyFrom": [
        "name",
        "description",
        "assignees",
        "priority",
        "due_date"
      ]
    },
    "task_get": {
      "kind": "http",
      "method": "GET",
      "path": "/task/{task_id}",
      "required": [
        "task_id"
      ]
    },
    "task_list": {
      "kind": "http",
      "method": "GET",
      "path": "/list/{list_id}/task",
      "required": [
        "list_id"
      ],
      "queryFrom": [
        "page",
        "include_closed"
      ]
    },
    "task_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/task/{task_id}",
      "required": [
        "task_id"
      ],
      "bodyFrom": [
        "name",
        "description",
        "status"
      ]
    },
    "task_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/task/{task_id}",
      "required": [
        "task_id"
      ]
    },
    "task_members": {
      "kind": "http",
      "method": "GET",
      "path": "/task/{task_id}/member",
      "required": [
        "task_id"
      ]
    },
    "task_custom_field": {
      "kind": "http",
      "method": "POST",
      "path": "/task/{task_id}/field/{field_id}",
      "required": [
        "task_id",
        "field_id"
      ],
      "bodyFrom": [
        "value"
      ]
    },
    "list_create": {
      "kind": "http",
      "method": "POST",
      "path": "/folder/{folder_id}/list",
      "required": [
        "folder_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "list_get": {
      "kind": "http",
      "method": "GET",
      "path": "/list/{list_id}",
      "required": [
        "list_id"
      ]
    },
    "list_list": {
      "kind": "http",
      "method": "GET",
      "path": "/folder/{folder_id}/list",
      "required": [
        "folder_id"
      ]
    },
    "list_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/list/{list_id}",
      "required": [
        "list_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "list_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/list/{list_id}",
      "required": [
        "list_id"
      ]
    },
    "folder_create": {
      "kind": "http",
      "method": "POST",
      "path": "/space/{space_id}/folder",
      "required": [
        "space_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "folder_get": {
      "kind": "http",
      "method": "GET",
      "path": "/folder/{folder_id}",
      "required": [
        "folder_id"
      ]
    },
    "folder_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/folder/{folder_id}",
      "required": [
        "folder_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "folder_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/folder/{folder_id}",
      "required": [
        "folder_id"
      ]
    },
    "comment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/task/{task_id}/comment",
      "required": [
        "task_id"
      ],
      "bodyFrom": [
        "comment_text",
        "notify_all"
      ]
    },
    "comment_get": {
      "kind": "http",
      "method": "GET",
      "path": "/task/{task_id}/comment",
      "required": [
        "task_id"
      ]
    },
    "comment_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/comment/{comment_id}",
      "required": [
        "comment_id"
      ],
      "bodyFrom": [
        "comment_text"
      ]
    },
    "comment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/comment/{comment_id}",
      "required": [
        "comment_id"
      ]
    },
    "checklist_create": {
      "kind": "http",
      "method": "POST",
      "path": "/task/{task_id}/checklist",
      "required": [
        "task_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "checklist_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/checklist/{checklist_id}",
      "required": [
        "checklist_id"
      ]
    },
    "checklist_item_create": {
      "kind": "http",
      "method": "POST",
      "path": "/checklist/{checklist_id}/checklist_item",
      "required": [
        "checklist_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "checklist_item_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/checklist/{checklist_id}/checklist_item/{checklist_item_id}",
      "required": [
        "checklist_id",
        "checklist_item_id"
      ],
      "bodyFrom": [
        "name",
        "resolved"
      ]
    },
    "goal_create": {
      "kind": "http",
      "method": "POST",
      "path": "/team/{team_id}/goal",
      "required": [
        "team_id"
      ],
      "bodyFrom": [
        "name",
        "owners",
        "multiple_owners",
        "color"
      ]
    },
    "goal_get": {
      "kind": "http",
      "method": "GET",
      "path": "/goal/{goal_id}",
      "required": [
        "goal_id"
      ]
    },
    "goal_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/goal/{goal_id}",
      "required": [
        "goal_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "goal_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/goal/{goal_id}",
      "required": [
        "goal_id"
      ]
    },
    "key_result_create": {
      "kind": "http",
      "method": "POST",
      "path": "/goal/{goal_id}/key_result",
      "required": [
        "goal_id"
      ],
      "bodyFrom": [
        "name",
        "type",
        "steps_start",
        "steps_end",
        "unit",
        "task_ids",
        "list_ids"
      ]
    },
    "key_result_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/key_result/{key_result_id}",
      "required": [
        "key_result_id"
      ]
    },
    "tag_add": {
      "kind": "http",
      "method": "POST",
      "path": "/task/{task_id}/tag/{tag_name}",
      "required": [
        "task_id",
        "tag_name"
      ]
    },
    "tag_remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/task/{task_id}/tag/{tag_name}",
      "required": [
        "task_id",
        "tag_name"
      ]
    },
    "dependency_create": {
      "kind": "http",
      "method": "POST",
      "path": "/task/{task_id}/dependency",
      "required": [
        "task_id"
      ],
      "bodyFrom": [
        "depends_on",
        "dependency_of"
      ]
    },
    "dependency_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/task/{task_id}/dependency",
      "required": [
        "task_id"
      ],
      "queryFrom": [
        "depends_on",
        "dependency_of"
      ]
    },
    "time_entry_create": {
      "kind": "http",
      "method": "POST",
      "path": "/team/{team_id}/time_entries",
      "required": [
        "team_id"
      ],
      "bodyFrom": [
        "tid",
        "start",
        "duration"
      ]
    },
    "time_entry_get": {
      "kind": "http",
      "method": "GET",
      "path": "/team/{team_id}/time_entries/{timer_id}",
      "required": [
        "team_id",
        "timer_id"
      ]
    },
    "time_entry_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/team/{team_id}/time_entries/{timer_id}",
      "required": [
        "team_id",
        "timer_id"
      ],
      "bodyFrom": [
        "duration"
      ]
    },
    "time_entry_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/team/{team_id}/time_entries/{timer_id}",
      "required": [
        "team_id",
        "timer_id"
      ]
    },
    "time_start": {
      "kind": "http",
      "method": "POST",
      "path": "/team/{team_id}/time_entries/start",
      "required": [
        "team_id"
      ],
      "bodyFrom": [
        "tid"
      ]
    },
    "time_stop": {
      "kind": "http",
      "method": "POST",
      "path": "/team/{team_id}/time_entries/stop",
      "required": [
        "team_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
