{
  "baseUrl": "https://api.deepgram.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Token ",
    "configKey": "api_key"
  },
  "operations": {
    "transcribe": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/listen",
      "required": [
        "url"
      ],
      "queryFrom": [
        "model",
        "language",
        "punctuate",
        "smart_format",
        "diarize",
        "diarize_model",
        "utterances",
        "paragraphs",
        "summarize",
        "sentiment",
        "topics",
        "intents",
        "detect_language",
        "multichannel",
        "channels",
        "encoding",
        "sample_rate",
        "callback",
        "callback_method",
        "tag",
        "keyterm"
      ],
      "bodyFrom": [
        "url",
        "callback"
      ]
    },
    "speak": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/speak",
      "required": [
        "text"
      ],
      "queryFrom": [
        "model",
        "encoding",
        "container",
        "sample_rate",
        "bit_rate",
        "speed",
        "callback",
        "callback_method"
      ],
      "bodyFrom": [
        "text"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
