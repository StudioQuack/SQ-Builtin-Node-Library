{
  "baseUrl": "{endpoint}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "auth_token"
  },
  "operations": {
    "query": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "operationName"
      ],
      "contentType": "application/json"
    },
    "mutate": {
      "kind": "http",
      "method": "POST",
      "path": "/",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables",
        "operationName"
      ],
      "contentType": "application/json"
    }
  }
}
