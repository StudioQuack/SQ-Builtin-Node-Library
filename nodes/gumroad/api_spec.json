{
  "baseUrl": "https://api.gumroad.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "access_token"
  },
  "operations": {
    "sale_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sales",
      "queryFrom": [
        "page",
        "after",
        "before",
        "email"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "GET",
      "path": "/products"
    },
    "subscriber_list": {
      "kind": "http",
      "method": "GET",
      "path": "/products/{product_id}/subscribers",
      "required": [
        "product_id"
      ],
      "queryFrom": [
        "page",
        "email"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
