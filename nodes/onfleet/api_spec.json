{
  "baseUrl": "https://onfleet.com/api/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "userKey": "",
    "basicKeyPosition": "username"
  },
  "operations": {
    "task_create": {
      "kind": "http",
      "method": "POST",
      "path": "/tasks",
      "required": [
        "destination"
      ],
      "bodyFrom": [
        "destination",
        "recipients",
        "notes",
        "completeAfter",
        "completeBefore",
        "pickupTask",
        "merchant",
        "executor",
        "quantity",
        "serviceTime",
        "autoAssign",
        "container",
        "metadata"
      ]
    },
    "task_get": {
      "kind": "http",
      "method": "GET",
      "path": "/tasks/{taskId}",
      "required": [
        "taskId"
      ]
    },
    "task_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/tasks/{taskId}",
      "required": [
        "taskId"
      ],
      "bodyFrom": [
        "notes",
        "completeAfter",
        "completeBefore",
        "pickupTask",
        "quantity",
        "serviceTime",
        "metadata"
      ]
    },
    "destination_create": {
      "kind": "http",
      "method": "POST",
      "path": "/destinations",
      "required": [
        "address"
      ],
      "bodyFrom": [
        "address",
        "notes"
      ]
    },
    "worker_list": {
      "kind": "http",
      "method": "GET",
      "path": "/workers",
      "queryFrom": [
        "states",
        "teams",
        "phones"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
