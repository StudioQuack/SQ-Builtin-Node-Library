{
  "baseUrl": "http://localhost:6333",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "collection.upsert": {
      "kind": "http",
      "method": "PUT",
      "path": "/collections/{collection}/points",
      "required": [
        "collection",
        "points"
      ],
      "bodyFrom": [
        "points"
      ]
    },
    "collection.search": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection}/points/query",
      "required": [
        "collection",
        "query"
      ],
      "bodyFrom": [
        "query",
        "limit",
        "filter",
        "with_payload",
        "with_vector"
      ]
    },
    "collection.get": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection}/points",
      "required": [
        "collection",
        "ids"
      ],
      "bodyFrom": [
        "ids",
        "with_payload",
        "with_vector"
      ]
    },
    "collection.scroll": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection}/points/scroll",
      "required": [
        "collection"
      ],
      "bodyFrom": [
        "limit",
        "offset",
        "filter",
        "with_payload",
        "with_vector"
      ]
    },
    "collection.delete": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection}/points/delete",
      "required": [
        "collection"
      ],
      "bodyFrom": [
        "points",
        "filter"
      ]
    }
  }
}
