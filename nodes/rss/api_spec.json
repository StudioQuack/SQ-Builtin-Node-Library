{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "read": {
      "kind": "http",
      "method": "GET",
      "path": "{host_and_path}",
      "required": [
        "host_and_path"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
