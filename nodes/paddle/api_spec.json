{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "operations": {
    "transaction_list": {
      "kind": "http",
      "method": "GET",
      "path": "/transactions",
      "queryFrom": [
        "after",
        "per_page",
        "status",
        "customer_id"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "GET",
      "path": "/products",
      "queryFrom": [
        "per_page",
        "status"
      ]
    },
    "subscription_get": {
      "kind": "http",
      "method": "GET",
      "path": "/subscriptions/{id}",
      "required": [
        "id"
      ]
    },
    "subscription_cancel": {
      "kind": "http",
      "method": "POST",
      "path": "/subscriptions/{id}/cancel",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "effective_from"
      ]
    },
    "customer_list": {
      "kind": "http",
      "method": "GET",
      "path": "/customers",
      "queryFrom": [
        "per_page",
        "email"
      ]
    },
    "discount_create": {
      "kind": "http",
      "method": "POST",
      "path": "/discounts",
      "bodyFrom": [
        "amount",
        "type",
        "description",
        "code",
        "enabled_for_checkout",
        "recur",
        "currency_code",
        "expires_at",
        "usage_limit"
      ],
      "required": [
        "amount",
        "type",
        "description"
      ]
    },
    "discount_list": {
      "kind": "http",
      "method": "GET",
      "path": "/discounts",
      "queryFrom": [
        "per_page"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
