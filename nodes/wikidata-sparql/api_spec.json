  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "sparql_query": {
      "kind": "http",
