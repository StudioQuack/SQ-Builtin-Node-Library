{
  "baseUrl": "https://app.hive.com/api/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "action_create": {
      "kind": "http",
      "method": "POST",
      "path": "/actions",
      "bodyFrom": [
        "title",
        "workspace",
        "projectId",
        "assignees",
        "description",
        "deadline",
        "labels",
        "priority"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "action_get": {
      "kind": "http",
      "method": "GET",
      "path": "/actions/{action_id}",
      "required": [
        "action_id"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "action_list": {
      "kind": "http",
      "method": "GET",
      "path": "/actions",
      "queryFrom": [
        "workspace",
        "projectId",
        "first",
        "after",
        "user_id"
      ]
    },
    "action_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/actions/{action_id}",
      "required": [
        "action_id"
      ],
      "bodyFrom": [
        "title",
        "status",
        "projectId",
        "description",
        "deadline",
        "assignees",
        "priority"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "action_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/actions/{action_id}",
      "required": [
        "action_id"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "project_create": {
      "kind": "http",
      "method": "POST",
      "path": "/projects",
      "bodyFrom": [
        "name",
        "workspace",
        "members"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{project_id}",
      "required": [
        "project_id"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "project_list": {
      "kind": "http",
      "method": "GET",
      "path": "/projects",
      "queryFrom": [
        "workspace",
        "first",
        "after",
        "user_id"
      ]
    },
    "project_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/projects/{project_id}",
      "required": [
        "project_id"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "message_create": {
      "kind": "http",
      "method": "POST",
      "path": "/messages",
      "bodyFrom": [
        "body",
        "workspace",
        "containerId",
        "mentions"
      ],
      "queryFrom": [
        "user_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
