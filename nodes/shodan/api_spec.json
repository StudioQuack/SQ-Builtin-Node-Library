{
  "baseUrl": "https://api.shodan.io",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "key"
  },
  "operations": {
    "host": {
      "kind": "http",
      "method": "GET",
      "path": "/shodan/host/{ip}",
      "required": [
        "ip"
      ],
      "queryFrom": [
        "history",
        "minify"
      ]
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/shodan/host/search",
      "required": [
        "query"
      ],
      "queryFrom": [
        "query",
        "q",
        "facets",
        "page",
        "minify",
        "fields"
      ]
    },
    "dns-resolve": {
      "kind": "http",
      "method": "GET",
      "path": "/dns/resolve",
      "required": [
        "hostnames"
      ],
      "queryFrom": [
        "hostnames"
      ]
    },
    "dns-reverse": {
      "kind": "http",
      "method": "GET",
      "path": "/dns/reverse",
      "required": [
        "ips"
      ],
      "queryFrom": [
        "ips"
      ]
    },
    "account-profile": {
      "kind": "http",
      "method": "GET",
      "path": "/account/profile"
    }
  }
}
