{
  "baseUrl": "https://api.doppler.com/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "doppler_token"
  },
  "operations": {
    "get-secret": {
      "kind": "http",
      "method": "GET",
      "path": "/configs/config/secret",
      "queryFrom": [
        "project",
        "config",
        "name"
      ],
      "required": [
        "name"
      ]
    },
    "list-secrets": {
      "kind": "http",
      "method": "GET",
      "path": "/configs/config/secrets",
      "queryFrom": [
        "project",
        "config",
        "secrets",
        "include_dynamic_secrets",
        "include_managed_secrets"
      ]
    },
    "update-secrets": {
      "kind": "http",
      "method": "POST",
      "path": "/configs/config/secrets",
      "bodyFrom": [
        "project",
        "config",
        "secrets",
        "change_requests"
      ]
    },
    "delete-secret": {
      "kind": "http",
      "method": "DELETE",
      "path": "/configs/config/secret",
      "queryFrom": [
        "project",
        "config",
        "name"
      ],
      "required": [
        "name"
      ]
    },
    "list-projects": {
      "kind": "http",
      "method": "GET",
      "path": "/projects",
      "queryFrom": [
        "page",
        "per_page"
      ]
    },
    "list-configs": {
      "kind": "http",
      "method": "GET",
      "path": "/configs",
      "queryFrom": [
        "project",
        "environment",
        "page",
        "per_page"
      ]
    },
    "download-config": {
      "kind": "http",
      "method": "GET",
      "path": "/configs/config/secrets/download",
      "queryFrom": [
        "project",
        "config",
        "format",
        "name_transformer"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
