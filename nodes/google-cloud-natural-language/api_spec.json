{
  "baseUrl": "https://language.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-goog-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "analyze_sentiment": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/documents:analyzeSentiment",
      "required": [],
      "bodyFrom": [
        "document",
        "encodingType"
      ]
    },
    "analyze_entities": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/documents:analyzeEntities",
      "required": [],
      "bodyFrom": [
        "document",
        "encodingType"
      ]
    },
    "classify": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/documents:classifyText",
      "required": [],
      "bodyFrom": [
        "type",
        "content",
        "languageCode",
        "gcsContentUri"
      ],
      "bodyMap": {
        "type": "document.type",
        "content": "document.content",
        "languageCode": "document.languageCode",
        "gcsContentUri": "document.gcsContentUri"
      }
    },
    "moderate_text": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/documents:moderateText",
      "required": [],
      "bodyFrom": [
        "document",
        "modelVersion"
      ]
    }
  }
}
