{
  "baseUrl": "https://api.dailymotion.com/v2",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "video_get": {
      "kind": "http",
      "method": "GET",
      "path": "/videos/{video_id}",
      "required": [
        "video_id"
      ],
      "queryFrom": [
        "fields"
      ]
    },
    "video_list": {
      "kind": "http",
      "method": "GET",
      "path": "/videos",
      "queryFrom": [
        "limit",
        "fields",
        "search",
        "sort"
      ]
    },
    "video_create": {
      "kind": "http",
      "method": "POST",
      "path": "/videos",
      "required": [
        "title",
        "visibility",
        "is_for_kids",
        "source.file_url"
      ],
      "bodyFrom": [
        "title",
        "channel",
        "published",
        "tags",
        "description",
        "language",
        "private",
        "visibility",
        "is_for_kids",
        "source.file_url"
      ],
      "bodyFormat": "form"
    },
    "channel_get": {
      "kind": "http",
      "method": "GET",
      "path": "/profiles/{profile_id}",
      "required": [
        "profile_id"
      ],
      "queryFrom": [
        "fields"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
