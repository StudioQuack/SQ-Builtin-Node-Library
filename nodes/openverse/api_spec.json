{
  "baseUrl": "https://api.openverse.org/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "search_images": {
      "kind": "http",
      "method": "GET",
      "path": "/images/",
      "required": [],
      "queryFrom": [
        "q",
        "license",
        "license_type",
        "page",
        "page_size"
      ]
    },
    "search_audio": {
      "kind": "http",
      "method": "GET",
      "path": "/audio/",
      "required": [],
      "queryFrom": [
        "q",
        "license",
        "license_type",
        "page",
        "page_size"
      ]
    },
    "thumbnail": {
      "kind": "http",
      "method": "GET",
      "path": "/images/{identifier}/thumb/",
      "required": [
        "identifier"
      ]
    }
  }
}
