{
  "baseUrl": "https://api.currentsapi.services/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/search",
      "required": [
        "keywords"
      ],
      "queryFrom": [
        "keywords",
        "language",
        "country",
        "category",
        "start_date",
        "end_date"
      ],
      "bodyFrom": []
    },
    "latest": {
      "kind": "http",
      "method": "GET",
      "path": "/latest-news",
      "required": [],
      "queryFrom": [
        "language",
        "country"
      ],
      "bodyFrom": []
    },
    "available_languages": {
      "kind": "http",
      "method": "GET",
      "path": "/available/languages",
      "required": [],
      "queryFrom": [],
      "bodyFrom": []
    },
    "available_regions": {
      "kind": "http",
      "method": "GET",
      "path": "/available/regions",
      "required": [],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
