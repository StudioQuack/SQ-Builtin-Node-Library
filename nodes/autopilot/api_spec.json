{
  "baseUrl": "https://api2.autopilothq.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "autopilotapikey",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "contact.upsert": {
      "kind": "http",
      "method": "POST",
      "path": "/contact",
      "required": [
        "contact"
      ],
      "bodyFrom": [
        "contact"
      ],
      "contentType": "application/json"
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/contact/{contact_id_or_email}",
      "required": [
        "contact_id_or_email"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts",
      "required": [],
      "queryFrom": [
        "bookmark"
      ]
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/contact/{contact_id_or_email}",
      "required": [
        "contact_id_or_email"
      ]
    },
    "list.create": {
      "kind": "http",
      "method": "POST",
      "path": "/list",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name"
      ],
      "contentType": "application/json"
    },
    "list.list": {
      "kind": "http",
      "method": "GET",
      "path": "/lists",
      "required": []
    },
    "list.add": {
      "kind": "http",
      "method": "POST",
      "path": "/list/{list_id}/contact/{contact_id_or_email}",
      "required": [
        "list_id",
        "contact_id_or_email"
      ]
    },
    "list.remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/list/{list_id}/contact/{contact_id_or_email}",
      "required": [
        "list_id",
        "contact_id_or_email"
      ]
    },
    "list.contains": {
      "kind": "http",
      "method": "GET",
      "path": "/list/{list_id}/contact/{contact_id_or_email}",
      "required": [
        "list_id",
        "contact_id_or_email"
      ]
    },
    "list.contacts": {
      "kind": "http",
      "method": "GET",
      "path": "/list/{list_id}",
      "required": [
        "list_id"
      ],
      "queryFrom": [
        "bookmark"
      ]
    },
    "journey.add": {
      "kind": "http",
      "method": "POST",
      "path": "/trigger/{trigger_id}/contact/{contact_id_or_email}",
      "required": [
        "trigger_id",
        "contact_id_or_email"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
