{
  "baseUrl": "https://adsapi.snapchat.com/v1",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "creative_create": {
      "kind": "http",
      "method": "POST",
      "path": "/adaccounts/{ad_account_id}/creatives",
      "bodyFrom": [
        "name",
        "type",
        "headline",
        "brand_name",
        "call_to_action",
        "top_snap_media_id",
        "shareable"
      ],
      "required": [
        "ad_account_id",
        "name"
      ],
      "contentType": "application/json"
    },
    "ad_get": {
      "kind": "http",
      "method": "GET",
      "path": "/ads/{ad_id}",
      "required": [
        "ad_id"
      ]
    },
    "stats_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{entity_type}/{entity_id}/stats",
      "queryFrom": [
        "granularity",
        "start_time",
        "end_time",
        "fields"
      ],
      "required": [
        "entity_type",
        "entity_id",
        "granularity"
      ]
    }
  }
}
