{
  "baseUrl": "http://localhost:7474",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "username",
    "configKey": "password"
  },
  "operations": {
    "cypher.run": {
      "method": "POST",
      "path": "/db/{database}/query/v2",
      "bodyFrom": [
        "statement",
        "parameters"
      ],
      "required": [
        "database",
        "statement"
      ],
      "kind": "http"
    }
  }
}
