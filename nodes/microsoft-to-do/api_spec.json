{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "task_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/todo/lists/{list_id}/tasks",
      "required": [
        "list_id"
      ],
      "bodyFrom": [
        "title",
        "body",
        "dueDateTime",
        "importance"
      ]
    },
    "task_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}",
      "required": [
        "list_id",
        "task_id"
      ]
    },
    "task_list": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists/{list_id}/tasks",
      "required": [
        "list_id"
      ]
    },
    "task_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}",
      "required": [
        "list_id",
        "task_id"
      ],
      "bodyFrom": [
        "title",
        "status",
        "body"
      ]
    },
    "task_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}",
      "required": [
        "list_id",
        "task_id"
      ]
    },
    "list_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/todo/lists",
      "bodyFrom": [
        "displayName"
      ]
    },
    "list_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists/{list_id}",
      "required": [
        "list_id"
      ]
    },
    "list_list": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists"
    },
    "list_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/me/todo/lists/{list_id}",
      "required": [
        "list_id"
      ],
      "bodyFrom": [
        "displayName"
      ]
    },
    "list_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/todo/lists/{list_id}",
      "required": [
        "list_id"
      ]
    },
    "linked_resource_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}/linkedResources",
      "required": [
        "list_id",
        "task_id"
      ],
      "bodyFrom": [
        "webUrl",
        "applicationName",
        "displayName"
      ]
    },
    "linked_resource_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}/linkedResources/{linked_id}",
      "required": [
        "list_id",
        "task_id",
        "linked_id"
      ]
    },
    "linked_resource_list": {
      "kind": "http",
      "method": "GET",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}/linkedResources",
      "required": [
        "list_id",
        "task_id"
      ]
    },
    "linked_resource_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}/linkedResources/{linked_id}",
      "required": [
        "list_id",
        "task_id",
        "linked_id"
      ],
      "bodyFrom": [
        "displayName",
        "webUrl"
      ]
    },
    "linked_resource_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/todo/lists/{list_id}/tasks/{task_id}/linkedResources/{linked_id}",
      "required": [
        "list_id",
        "task_id",
        "linked_id"
      ]
    }
  }
}
