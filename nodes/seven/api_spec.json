{
  "baseUrl": "https://gateway.seven.io/api",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/sms",
      "contentType": "application/json",
      "required": [
        "to",
        "text"
      ],
      "bodyFrom": [
        "to",
        "text",
        "from",
        "delay",
        "label",
        "foreign_id",
        "flash",
        "performance_tracking"
      ]
    },
    "voice-call": {
      "kind": "http",
      "method": "POST",
      "path": "/voice",
      "contentType": "application/json",
      "required": [
        "to",
        "text"
      ],
      "bodyFrom": [
        "to",
        "text",
        "from"
      ]
    }
  }
}
