{
  "baseUrl": "http://ip-api.com",
  "defaultTimeout": 15,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "lookup": {
      "kind": "http",
      "method": "GET",
      "path": "/json/{ip}",
      "required": [
        "ip"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": []
    },
    "batch": {
      "kind": "http",
      "method": "POST",
      "path": "/batch",
      "required": [
        "ips"
      ],
      "queryFrom": [
        "fields"
      ],
      "bodyFrom": [
        "ips"
      ],
      "bodyMap": {
        "ips": "$"
      }
    }
  }
}
