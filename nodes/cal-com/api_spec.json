{
  "baseUrl": "https://api.cal.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "cal-api-version": "2024-08-13"
  },
  "operations": {
    "create-booking": {
      "kind": "http",
      "method": "POST",
      "path": "/bookings",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2026-02-25"
      },
      "bodyFrom": [
        "start",
        "attendee",
        "eventTypeId",
        "eventTypeSlug",
        "username",
        "teamSlug",
        "organizationSlug",
        "usernames",
        "guests",
        "lengthInMinutes",
        "metadata",
        "bookingFieldsResponses",
        "leadEnrichmentOptOut"
      ]
    },
    "get-booking": {
      "kind": "http",
      "method": "GET",
      "path": "/bookings/{uid}",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2026-02-25"
      },
      "required": [
        "uid"
      ]
    },
    "list-bookings": {
      "kind": "http",
      "method": "GET",
      "path": "/bookings",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2026-05-01"
      },
      "queryFrom": [
        "status",
        "take",
        "skip"
      ]
    },
    "reschedule-booking": {
      "kind": "http",
      "method": "POST",
      "path": "/bookings/{uid}/reschedule",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2026-02-25"
      },
      "required": [
        "uid"
      ],
      "bodyFrom": [
        "start"
      ]
    },
    "cancel-booking": {
      "kind": "http",
      "method": "POST",
      "path": "/bookings/{uid}/cancel",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2026-02-25"
      },
      "required": [
        "uid"
      ],
      "bodyFrom": [
        "cancellationReason"
      ]
    },
    "list-event-types": {
      "kind": "http",
      "method": "GET",
      "path": "/event-types",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2024-06-14"
      }
    },
    "get-event-type": {
      "kind": "http",
      "method": "GET",
      "path": "/event-types/{id}",
      "contentType": "application/json",
      "extraHeaders": {
        "cal-api-version": "2024-06-14"
      },
      "required": [
        "id"
      ]
    }
  }
}
