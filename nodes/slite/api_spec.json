{
  "baseUrl": "https://api.slite.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-slite-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "doc_create": {
      "kind": "http",
      "method": "POST",
      "path": "/notes",
      "bodyFrom": [
        "title",
        "markdown",
        "html",
        "sliteml",
        "parentNoteId",
        "templateId",
        "listPosition"
      ]
    },
    "doc_get": {
      "kind": "http",
      "method": "GET",
      "path": "/notes/{noteId}",
      "required": [
        "noteId"
      ],
      "queryFrom": [
        "format",
        "css",
        "compact"
      ]
    },
    "doc_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/notes/{noteId}",
      "required": [
        "noteId"
      ],
      "bodyFrom": [
        "title",
        "markdown",
        "html",
        "sliteml",
        "listPosition"
      ]
    },
    "doc_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/notes/{noteId}",
      "required": [
        "noteId"
      ]
    },
    "doc_search": {
      "kind": "http",
      "method": "GET",
      "path": "/search-notes",
      "queryFrom": [
        "query"
      ]
    },
    "note_list": {
      "kind": "http",
      "method": "GET",
      "path": "/notes",
      "queryFrom": [
        "parentNoteId",
        "ownerId",
        "orderBy",
        "cursor"
      ]
    },
    "channel_list": {
      "kind": "http",
      "method": "GET",
      "path": "/notes",
      "queryFrom": [
        "parentNoteId",
        "ownerId",
        "orderBy",
        "cursor"
      ]
    },
    "account_me": {
      "kind": "http",
      "method": "GET",
      "path": "/me"
    }
  }
}
