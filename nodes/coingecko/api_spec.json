{
  "baseUrl": "https://api.coingecko.com/api/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-cg-demo-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "coin_list": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/list",
      "required": [],
      "queryFrom": [
        "include_platform"
      ],
      "bodyFrom": []
    },
    "coin_get": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "localization"
      ],
      "bodyFrom": []
    },
    "coin_price": {
      "kind": "http",
      "method": "GET",
      "path": "/simple/price",
      "required": [
        "ids",
        "vs_currencies"
      ],
      "queryFrom": [
        "ids",
        "vs_currencies",
        "include_24hr_change"
      ],
      "bodyFrom": []
    },
    "coin_markets": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/markets",
      "required": [
        "vs_currency"
      ],
      "queryFrom": [
        "vs_currency",
        "per_page",
        "page",
        "order"
      ],
      "bodyFrom": []
    },
    "coin_market_chart": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/{id}/market_chart",
      "required": [
        "id",
        "vs_currency",
        "days"
      ],
      "queryFrom": [
        "vs_currency",
        "days"
      ],
      "bodyFrom": []
    },
    "coin_ohlc": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/{id}/ohlc",
      "required": [
        "id",
        "vs_currency",
        "days"
      ],
      "queryFrom": [
        "vs_currency",
        "days"
      ],
      "bodyFrom": []
    },
    "coin_history": {
      "kind": "http",
      "method": "GET",
      "path": "/coins/{id}/history",
      "required": [
        "id",
        "date"
      ],
      "queryFrom": [
        "date"
      ],
      "bodyFrom": []
    }
  }
}
