{
    "baseUrl": "https://s3.{region}.amazonaws.com",
    "defaultTimeout": 60,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "s3",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "docs": "https://docs.aws.amazon.com/AmazonS3/latest/API/Welcome.html",
    "operations": {
        "bucket_create": {
            "kind": "http",
            "method": "PUT",
            "path": "/{bucket}",
            "required": [
                "bucket"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "bucket_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/{bucket}",
            "required": [
                "bucket"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "bucket_list": {
            "kind": "http",
            "method": "GET",
            "path": "/",
            "required": [],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "bucket_search": {
            "kind": "http",
            "method": "GET",
            "path": "/{bucket}",
            "required": [
                "bucket"
            ],
            "queryFrom": [
                "list-type",
                "prefix",
                "start-after",
                "max-keys"
            ],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "file_copy": {
            "kind": "http",
            "method": "PUT",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key",
                "from_path"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/xml",
            "extraHeaders": {
                "x-amz-copy-source": "{from_path}"
            }
        },
        "file_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key"
            ],
            "queryFrom": [
                "versionId"
            ],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "file_download": {
            "kind": "http",
            "method": "GET",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/octet-stream"
        },
        "file_list": {
            "kind": "http",
            "method": "GET",
            "path": "/{bucket}",
            "required": [
                "bucket"
            ],
            "queryFrom": [
                "list-type",
                "prefix",
                "delimiter",
                "max-keys",
                "continuation-token"
            ],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "file_upload": {
            "kind": "http",
            "method": "PUT",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key",
                "file"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "bodyFormat": "raw",
            "bodyParam": "file",
            "contentType": "application/octet-stream",
            "extraHeaders": {
                "x-amz-acl": "{acl}",
                "x-amz-storage-class": "{storage_class}",
                "x-amz-server-side-encryption": "{server_side_encryption}",
                "x-amz-tagging": "{tagging}",
                "Cache-Control": "{cache_control}",
                "Content-Disposition": "{content_disposition}",
                "Content-Encoding": "{content_encoding}"
            }
        },
        "folder_create": {
            "kind": "http",
            "method": "PUT",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/octet-stream"
        },
        "folder_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/{bucket}/{key}",
            "required": [
                "bucket",
                "key"
            ],
            "queryFrom": [],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "folder_list": {
            "kind": "http",
            "method": "GET",
            "path": "/{bucket}",
            "required": [
                "bucket"
            ],
            "queryFrom": [
                "list-type",
                "prefix",
                "delimiter"
            ],
            "bodyFrom": [],
            "contentType": "application/xml"
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
