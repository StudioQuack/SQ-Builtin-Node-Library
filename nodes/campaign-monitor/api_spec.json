{
  "baseUrl": "https://api.createsend.com/api/v3.3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "configKey": "api_key",
    "basicKeyPosition": "username"
  },
  "operations": {
    "subscriber.add": {
      "kind": "http",
      "method": "POST",
      "path": "/subscribers/{listId}.json",
      "required": [
        "listId"
      ],
      "bodyFrom": [
        "EmailAddress",
        "Name",
        "MobileNumber",
        "CustomFields",
        "Resubscribe",
        "ConsentToTrack",
        "ConsentToSendSms",
        "RestartSubscriptionBasedAutoresponders"
      ]
    },
    "subscriber.get": {
      "kind": "http",
      "method": "GET",
      "path": "/subscribers/{listId}.json",
      "required": [
        "listId",
        "email"
      ],
      "queryFrom": [
        "email"
      ]
    },
    "subscriber.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/subscribers/{listId}.json",
      "required": [
        "listId",
        "email"
      ],
      "queryFrom": [
        "email"
      ],
      "bodyFrom": [
        "EmailAddress",
        "Name",
        "MobileNumber",
        "CustomFields",
        "ConsentToTrack",
        "ConsentToSendSms"
      ]
    },
    "subscriber.unsubscribe": {
      "kind": "http",
      "method": "POST",
      "path": "/subscribers/{listId}/unsubscribe.json",
      "required": [
        "listId"
      ],
      "bodyFrom": [
        "EmailAddress"
      ]
    },
    "subscriber.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/subscribers/{listId}.json",
      "required": [
        "listId",
        "email"
      ],
      "queryFrom": [
        "email"
      ]
    },
    "list.create": {
      "kind": "http",
      "method": "POST",
      "path": "/lists/{clientId}.json",
      "required": [
        "clientId"
      ],
      "bodyFrom": [
        "Title",
        "UnsubscribeSetting",
        "ConfirmedOptIn"
      ]
    },
    "list.get": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/{listId}.json",
      "required": [
        "listId"
      ]
    },
    "campaign.create": {
      "kind": "http",
      "method": "POST",
      "path": "/campaigns/{clientId}.json",
      "required": [
        "clientId",
        "Name",
        "Subject",
        "FromName",
        "FromEmail",
        "ReplyTo",
        "HtmlUrl"
      ],
      "bodyFrom": [
        "Name",
        "Subject",
        "FromName",
        "FromEmail",
        "ReplyTo",
        "HtmlUrl",
        "ListIDs",
        "SegmentIDs"
      ]
    },
    "campaign.send": {
      "kind": "http",
      "method": "POST",
      "path": "/campaigns/{campaignId}/send.json",
      "required": [
        "campaignId"
      ],
      "bodyFrom": [
        "ConfirmationEmail",
        "SendDate"
      ]
    },
    "campaign.unsent": {
      "kind": "http",
      "method": "GET",
      "path": "/clients/{clientId}/drafts.json",
      "required": [
        "clientId"
      ]
    },
    "transactional.send": {
      "kind": "http",
      "method": "POST",
      "path": "/transactional/smartEmail/{smartEmailId}/send",
      "required": [
        "smartEmailId"
      ],
      "bodyFrom": [
        "To",
        "Data",
        "ConsentToTrack",
        "AddRecipientsToList",
        "CC",
        "BCC"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
