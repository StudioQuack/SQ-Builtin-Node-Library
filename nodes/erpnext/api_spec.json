{
  "baseUrl": "{base_url}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "token ",
    "configKey": "api_key"
  },
  "operations": {
    "resource_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/resource/{doctype}/{name}",
      "required": [
        "doctype",
        "name"
      ]
    },
    "resource_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/resource/{doctype}",
      "required": [
        "doctype"
      ],
      "queryFrom": [
        "fields",
        "filters",
        "or_filters",
        "limit_page_length",
        "limit_start",
        "order_by"
      ]
    },
    "resource_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/resource/{doctype}",
      "required": [
        "doctype",
        "doc"
      ],
      "bodyFrom": [
        "doc"
      ],
      "bodyMap": {
        "doc": "$"
      }
    },
    "resource_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/api/resource/{doctype}/{name}",
      "required": [
        "doctype",
        "name",
        "doc"
      ],
      "bodyFrom": [
        "doc"
      ],
      "bodyMap": {
        "doc": "$"
      }
    },
    "resource_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/api/resource/{doctype}/{name}",
      "required": [
        "doctype",
        "name"
      ]
    }
  }
}
