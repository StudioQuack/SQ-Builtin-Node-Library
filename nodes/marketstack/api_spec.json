{
  "baseUrl": "https://api.marketstack.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "access_key"
  },
  "operations": {
    "eod_list": {
      "kind": "http",
      "method": "GET",
      "path": "/eod",
      "required": [
        "symbols"
      ],
      "queryFrom": [
        "symbols",
        "date_from",
        "date_to",
        "limit",
        "offset"
      ],
      "bodyFrom": []
    },
    "exchange_get": {
      "kind": "http",
      "method": "GET",
      "path": "/exchanges/{mic}",
      "required": [
        "mic"
      ],
      "queryFrom": [],
      "bodyFrom": []
    },
    "ticker_get": {
      "kind": "http",
      "method": "GET",
      "path": "/tickers/{symbol}",
      "required": [
        "symbol"
      ],
      "queryFrom": [],
      "bodyFrom": []
    }
  }
}
