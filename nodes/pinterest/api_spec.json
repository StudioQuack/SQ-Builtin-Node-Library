{
  "baseUrl": "https://api.pinterest.com/v5",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "pin_create": {
      "kind": "http",
      "method": "POST",
      "path": "/pins",
      "required": [
        "board_id",
        "media_source"
      ],
      "bodyFrom": [
        "board_id",
        "board_section_id",
        "title",
        "description",
        "link",
        "alt_text",
        "media_source",
        "dominant_color"
      ]
    },
    "pin_get": {
      "kind": "http",
      "method": "GET",
      "path": "/pins/{pin_id}",
      "required": [
        "pin_id"
      ]
    },
    "board_create": {
      "kind": "http",
      "method": "POST",
      "path": "/boards",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "description",
        "privacy"
      ]
    },
    "board_list": {
      "kind": "http",
      "method": "GET",
      "path": "/boards",
      "queryFrom": [
        "page_size",
        "bookmark",
        "privacy"
      ]
    },
    "user_get": {
      "kind": "http",
      "method": "GET",
      "path": "/user_account"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
