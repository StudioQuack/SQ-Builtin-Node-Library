{
  "baseUrl": "https://translate.googleapis.com",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "translate": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/projects/{project}:translateText",
      "required": [
        "project",
        "contents",
        "targetLanguageCode"
      ],
      "bodyFrom": [
        "contents",
        "mimeType",
        "sourceLanguageCode",
        "targetLanguageCode",
        "model",
        "glossaryConfig",
        "labels",
        "transliterationConfig"
      ]
    },
    "detect": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/projects/{project}:detectLanguage",
      "required": [
        "project"
      ],
      "bodyFrom": [
        "content",
        "mimeType",
        "model"
      ]
    },
    "languages": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/projects/{project}/supportedLanguages",
      "required": [
        "project"
      ],
      "queryFrom": [
        "displayLanguageCode",
        "model"
      ]
    }
  }
}
