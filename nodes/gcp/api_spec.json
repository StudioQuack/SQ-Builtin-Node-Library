{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "object_get": {
      "kind": "http",
      "method": "GET",
      "path": "storage.googleapis.com/storage/v1/b/{bucket}/o/{object}",
      "required": [
        "bucket",
        "object"
      ],
      "queryFrom": [
        "alt"
      ]
    },
    "object_put": {
      "kind": "http",
      "method": "POST",
      "path": "storage.googleapis.com/upload/storage/v1/b/{bucket}/o",
      "required": [
        "bucket",
        "name",
        "file"
      ],
      "queryFrom": [
        "uploadType",
        "name",
        "contentType"
      ],
      "bodyFormat": "raw",
      "bodyParam": "file",
      "contentType": "application/octet-stream"
    },
    "object_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "storage.googleapis.com/storage/v1/b/{bucket}/o/{object}",
      "required": [
        "bucket",
        "object"
      ]
    },
    "object_list": {
      "kind": "http",
      "method": "GET",
      "path": "storage.googleapis.com/storage/v1/b/{bucket}/o",
      "required": [
        "bucket"
      ],
      "queryFrom": [
        "prefix",
        "pageToken"
      ]
    },
    "pubsub_publish": {
      "kind": "http",
      "method": "POST",
      "path": "pubsub.googleapis.com/v1/projects/{projectId}/topics/{topic}:publish",
      "required": [
        "projectId",
        "topic",
        "messages"
      ],
      "bodyFrom": [
        "messages"
      ]
    },
    "pubsub_pull": {
      "kind": "http",
      "method": "POST",
      "path": "pubsub.googleapis.com/v1/projects/{projectId}/subscriptions/{subscription}:pull",
      "required": [
        "projectId",
        "subscription",
        "maxMessages"
      ],
      "bodyFrom": [
        "maxMessages",
        "returnImmediately"
      ]
    },
    "run_invoke": {
      "kind": "http",
      "method": "POST",
      "path": "{service_host}",
      "required": [
        "service_host"
      ],
      "contentType": "application/json"
    },
    "functions_call": {
      "kind": "http",
      "method": "POST",
      "path": "cloudfunctions.googleapis.com/v1/projects/{projectId}/locations/{location}/functions/{function}:call",
      "required": [
        "projectId",
        "location",
        "function"
      ],
      "bodyFrom": [
        "data"
      ]
    },
    "compute_get": {
      "kind": "http",
      "method": "GET",
      "path": "compute.googleapis.com/compute/v1/projects/{projectId}/zones/{zone}/instances/{instance}",
      "required": [
        "projectId",
        "zone",
        "instance"
      ]
    },
    "gke_get": {
      "kind": "http",
      "method": "GET",
      "path": "container.googleapis.com/v1/projects/{projectId}/locations/{location}/clusters/{cluster}",
      "required": [
        "projectId",
        "location",
        "cluster"
      ]
    },
    "secretmanager_get": {
      "kind": "http",
      "method": "GET",
      "path": "secretmanager.googleapis.com/v1/projects/{projectId}/secrets/{secret}/versions/{version}:access",
      "required": [
        "projectId",
        "secret",
        "version"
      ]
    },
    "iam_get": {
      "kind": "http",
      "method": "GET",
      "path": "iam.googleapis.com/v1/projects/{projectId}/serviceAccounts/{email}",
      "required": [
        "projectId",
        "email"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
