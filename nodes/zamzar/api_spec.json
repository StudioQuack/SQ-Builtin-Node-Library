{
  "baseUrl": "https://api.zamzar.com/v1",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "Basic ",
    "configKey": "api_key",
    "userKey": "api_key"
  },
  "docs": "https://developers.zamzar.com/",
  "operations": {
    "job_create": {
      "kind": "http",
      "method": "POST",
      "path": "/jobs",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "source_file",
        "target_format",
        "source_url"
      ],
      "contentType": "application/json",
      "bodyFormat": "multipart"
    },
    "job_get": {
      "kind": "http",
      "method": "GET",
      "path": "/jobs/{job_id}",
      "required": [
        "job_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "file_download": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{id}/content",
      "required": [
        "id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "format_list": {
      "kind": "http",
      "method": "GET",
      "path": "/formats",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
