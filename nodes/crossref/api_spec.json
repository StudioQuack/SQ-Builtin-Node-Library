{
  "baseUrl": "https://api.crossref.org/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "works_search": {
      "kind": "http",
      "method": "GET",
      "path": "/works",
      "required": [],
      "queryFrom": [
        "query",
        "rows",
        "offset",
        "filter",
        "mailto",
        "cursor"
      ]
    },
    "work_get": {
      "kind": "http",
      "method": "GET",
      "path": "/works/{doi}",
      "required": [
        "doi"
      ],
      "queryFrom": [
        "mailto"
      ]
    },
    "funders": {
      "kind": "http",
      "method": "GET",
      "path": "/funders",
      "required": [],
      "queryFrom": [
        "query",
        "rows",
        "offset",
        "mailto"
      ]
    }
  }
}
