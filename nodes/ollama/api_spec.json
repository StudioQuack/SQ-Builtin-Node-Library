{
  "baseUrl": "{base_url}",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/api/chat",
      "required": [
        "messages"
      ],
      "bodyFrom": [
        "model",
        "messages",
        "tools",
        "format",
        "options",
        "stream",
        "think",
        "keep_alive"
      ],
      "stream": {
        "format": "ollama-ndjson"
      }
    },
    "generate": {
      "kind": "http",
      "method": "POST",
      "path": "/api/generate",
      "required": [
        "prompt"
      ],
      "bodyFrom": [
        "model",
        "prompt",
        "suffix",
        "images",
        "format",
        "options",
        "system",
        "stream",
        "raw",
        "keep_alive"
      ]
    },
    "embed": {
      "kind": "http",
      "method": "POST",
      "path": "/api/embed",
      "required": [
        "input"
      ],
      "bodyFrom": [
        "model",
        "input",
        "truncate",
        "options",
        "keep_alive"
      ]
    },
    "list_models": {
      "kind": "http",
      "method": "GET",
      "path": "/api/tags",
      "required": []
    },
    "pull": {
      "kind": "http",
      "method": "POST",
      "path": "/api/pull",
      "required": [
        "model"
      ],
      "bodyFrom": [
        "model",
        "insecure",
        "stream"
      ]
    }
  },
  "extraHeaders": {
    "Authorization": "Bearer {api_key}"
  }
}
