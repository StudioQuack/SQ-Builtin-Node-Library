{
  "baseUrl": "https://{region}",
  "placeholderDefaults": {
    "region": "api.intercom.io"
  },
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "Intercom-Version": "2.16"
  },
  "operations": {
    "contact.create": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts",
      "required": [],
      "bodyFrom": [
        "role",
        "email",
        "external_id",
        "name",
        "phone",
        "custom_attributes",
        "unsubscribed_from_emails"
      ]
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "/contacts",
      "required": [],
      "queryFrom": [
        "per_page",
        "starting_after"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/contacts/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "role",
        "email",
        "external_id",
        "name",
        "phone",
        "custom_attributes",
        "unsubscribed_from_emails"
      ]
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "company.create": {
      "kind": "http",
      "method": "POST",
      "path": "/companies",
      "required": [],
      "bodyFrom": [
        "company_id",
        "name",
        "custom_attributes"
      ]
    },
    "company.get": {
      "kind": "http",
      "method": "GET",
      "path": "/companies/{id}",
      "required": [
        "id"
      ]
    },
    "company.list": {
      "kind": "http",
      "method": "GET",
      "path": "/companies",
      "required": [],
      "queryFrom": [
        "page",
        "per_page"
      ]
    },
    "company.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/companies/{id}",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "company_id",
        "name",
        "custom_attributes"
      ]
    },
    "company.listUsers": {
      "kind": "http",
      "method": "GET",
      "path": "/companies/{id}/contacts",
      "required": [
        "id"
      ]
    },
    "conversation.create": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations",
      "required": [
        "from",
        "body"
      ],
      "bodyFrom": [
        "from",
        "body",
        "from_type",
        "from_id"
      ],
      "bodyMap": {
        "from_type": "from.type",
        "from_id": "from.id"
      }
    },
    "conversation.reply": {
      "kind": "http",
      "method": "POST",
      "path": "/conversations/{conversation_id}/reply",
      "required": [
        "conversation_id",
        "body"
      ],
      "bodyFrom": [
        "type",
        "admin_id",
        "body",
        "message_type"
      ]
    },
    "conversation.list": {
      "kind": "http",
      "method": "GET",
      "path": "/conversations",
      "required": [],
      "queryFrom": [
        "per_page",
        "starting_after"
      ]
    },
    "message.send": {
      "kind": "http",
      "method": "POST",
      "path": "/messages",
      "required": [
        "message_type",
        "body",
        "from",
        "to"
      ],
      "bodyFrom": [
        "message_type",
        "subject",
        "body",
        "from",
        "to",
        "from_type",
        "from_id",
        "to_type",
        "to_id"
      ],
      "bodyMap": {
        "from_type": "from.type",
        "from_id": "from.id",
        "to_type": "to.type",
        "to_id": "to.id"
      }
    },
    "tag.add": {
      "kind": "http",
      "method": "POST",
      "path": "/contacts/{contact_id}/tags",
      "required": [
        "contact_id",
        "id"
      ],
      "bodyFrom": [
        "id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
