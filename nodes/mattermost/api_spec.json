{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-channel": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/channels",
      "contentType": "application/json",
      "required": [
        "team_id",
        "name",
        "display_name",
        "type"
      ],
      "bodyFrom": [
        "team_id",
        "name",
        "display_name",
        "type"
      ]
    },
    "add-channel-member": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/channels/{channel_id}/members",
      "contentType": "application/json",
      "required": [
        "channel_id",
        "user_id"
      ],
      "bodyFrom": [
        "user_id"
      ]
    },
    "delete-channel": {
      "kind": "http",
      "method": "DELETE",
      "path": "{host}/api/v4/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "restore-channel": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/channels/{channel_id}/restore",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "search-channel": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/channels/search",
      "contentType": "application/json",
      "required": [
        "term"
      ],
      "bodyFrom": [
        "term",
        "team_id"
      ]
    },
    "get-channel-stats": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/channels/{channel_id}/stats",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "list-channel-members": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/channels/{channel_id}/members",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ]
    },
    "post-message": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/posts",
      "contentType": "application/json",
      "required": [
        "channel_id"
      ],
      "bodyFrom": [
        "channel_id",
        "message",
        "root_id"
      ]
    },
    "post-ephemeral": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/posts/ephemeral",
      "contentType": "application/json",
      "bodyFrom": [
        "user_id",
        "post"
      ]
    },
    "delete-post": {
      "kind": "http",
      "method": "DELETE",
      "path": "{host}/api/v4/posts/{post_id}",
      "contentType": "application/json",
      "required": [
        "post_id"
      ]
    },
    "add-reaction": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/reactions",
      "contentType": "application/json",
      "required": [
        "user_id",
        "post_id",
        "emoji_name"
      ],
      "bodyFrom": [
        "user_id",
        "post_id",
        "emoji_name"
      ]
    },
    "remove-reaction": {
      "kind": "http",
      "method": "DELETE",
      "path": "{host}/api/v4/users/{user_id}/posts/{post_id}/reactions/{emoji_name}",
      "contentType": "application/json",
      "required": [
        "user_id",
        "post_id",
        "emoji_name"
      ]
    },
    "list-reactions": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/posts/{post_id}/reactions",
      "contentType": "application/json",
      "required": [
        "post_id"
      ]
    },
    "create-user": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/users",
      "contentType": "application/json",
      "required": [
        "email",
        "username"
      ],
      "bodyFrom": [
        "email",
        "username",
        "password"
      ]
    },
    "deactivate-user": {
      "kind": "http",
      "method": "DELETE",
      "path": "{host}/api/v4/users/{user_id}",
      "contentType": "application/json",
      "required": [
        "user_id"
      ]
    },
    "list-users": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/users",
      "contentType": "application/json",
      "queryFrom": [
        "page",
        "per_page"
      ]
    },
    "get-user-by-email": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/users/email/{email}",
      "contentType": "application/json",
      "required": [
        "email"
      ]
    },
    "get-user": {
      "kind": "http",
      "method": "GET",
      "path": "{host}/api/v4/users/{user_id}",
      "contentType": "application/json",
      "required": [
        "user_id"
      ]
    },
    "invite-user": {
      "kind": "http",
      "method": "POST",
      "path": "{host}/api/v4/teams/{team_id}/invite/email",
      "contentType": "application/json",
      "required": [
        "team_id"
      ],
      "bodyFrom": [
        "emails"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
