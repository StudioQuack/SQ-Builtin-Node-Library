{
  "baseUrl": "https://api.fullstory.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "Basic ",
    "configKey": "apiKey"
  },
  "operations": {
    "user.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/users/{id}",
      "required": ["id"]
    },
    "user.search": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/users",
      "required": [],
      "queryFrom": ["email", "uid", "limit", "paginationToken"]
    },
    "session.search": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/sessions",
      "required": [],
      "queryFrom": ["uid", "email", "session_uid", "limit"]
    },
    "event.search": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/sessions/{sessionId}/events",
      "required": ["sessionId"],
      "queryFrom": ["limit"]
    }
  }
}
