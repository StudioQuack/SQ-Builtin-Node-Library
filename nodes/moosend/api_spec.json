{
  "baseUrl": "https://api.moosend.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "apikey"
  },
  "operations": {
    "subscriber.add": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/subscribers/{list_id}/subscribe.json",
      "required": [
        "list_id",
        "email"
      ],
      "bodyFrom": [
        "HasExternalDoubleOptIn",
        "CustomFields",
        "Tags",
        "email",
        "name",
        "has_external_double_opt_in",
        "custom_fields",
        "tags"
      ]
    },
    "subscriber.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/subscribers/{list_id}/find/{email}.json",
      "required": [
        "list_id",
        "email"
      ]
    },
    "subscriber.unsubscribe": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/subscribers/{list_id}/unsubscribe.json",
      "required": [
        "list_id",
        "email"
      ],
      "bodyFrom": [
        "email"
      ]
    },
    "subscriber.remove": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/subscribers/{list_id}/remove.json",
      "required": [
        "list_id",
        "email"
      ],
      "bodyFrom": [
        "email"
      ]
    },
    "list.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/lists/create.json",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "ConfirmationPage",
        "RedirectAfterUnsubscribePage",
        "Preferences",
        "name",
        "confirmation_page",
        "redirect_after_unsubscribe_page"
      ]
    },
    "list.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/lists/{list_id}/details.json",
      "required": [
        "list_id"
      ]
    },
    "campaign.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/campaigns/create.json",
      "required": [
        "name",
        "subject",
        "sender_email",
        "html_content",
        "mailing_list_id"
      ],
      "bodyFrom": [
        "Subject",
        "SenderEmail",
        "ReplyToEmail",
        "HtmlContent",
        "MailingListID",
        "ConfirmationTo",
        "name",
        "subject",
        "sender_email",
        "reply_to_email",
        "html_content",
        "mailing_list_id",
        "confirmation_to"
      ]
    },
    "campaign.send": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/campaigns/{campaign_id}/send.json",
      "required": [
        "campaign_id"
      ]
    },
    "campaign.get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/campaigns/{campaign_id}/view.json",
      "required": [
        "campaign_id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
