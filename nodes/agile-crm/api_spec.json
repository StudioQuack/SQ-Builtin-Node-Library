{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "rest_api_key",
    "userKey": "email"
  },
  "operations": {
    "contact.create": {
      "kind": "http",
      "method": "POST",
      "path": "{domain}.agilecrm.com/dev/api/contacts",
      "required": [
        "first_name"
      ],
      "bodyFrom": [
        "type",
        "first_name",
        "last_name",
        "email",
        "properties",
        "tags",
        "lead_score",
        "star_value"
      ],
      "contentType": "application/json"
    },
    "contact.get": {
      "kind": "http",
      "method": "GET",
      "path": "{domain}.agilecrm.com/dev/api/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "contact.list": {
      "kind": "http",
      "method": "GET",
      "path": "{domain}.agilecrm.com/dev/api/contacts",
      "required": [],
      "queryFrom": [
        "page_size",
        "cursor"
      ]
    },
    "contact.update": {
      "kind": "http",
      "method": "PUT",
      "path": "{domain}.agilecrm.com/dev/api/contacts/edit-properties",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "id",
        "properties",
        "tags"
      ],
      "contentType": "application/json"
    },
    "contact.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{domain}.agilecrm.com/dev/api/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "company.create": {
      "kind": "http",
      "method": "POST",
      "path": "{domain}.agilecrm.com/dev/api/contacts",
      "required": [
        "type"
      ],
      "bodyFrom": [
        "type",
        "properties",
        "star_value"
      ],
      "contentType": "application/json"
    },
    "company.get": {
      "kind": "http",
      "method": "GET",
      "path": "{domain}.agilecrm.com/dev/api/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "company.list": {
      "kind": "http",
      "method": "POST",
      "path": "{domain}.agilecrm.com/dev/api/contacts/companies/list",
      "required": [],
      "bodyFrom": [
        "page_size",
        "cursor",
        "global_sort_key"
      ],
      "contentType": "application/x-www-form-urlencoded"
    },
    "company.update": {
      "kind": "http",
      "method": "PUT",
      "path": "{domain}.agilecrm.com/dev/api/contacts/edit-properties",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "id",
        "properties"
      ],
      "contentType": "application/json"
    },
    "company.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{domain}.agilecrm.com/dev/api/contacts/{id}",
      "required": [
        "id"
      ]
    },
    "deal.create": {
      "kind": "http",
      "method": "POST",
      "path": "{domain}.agilecrm.com/dev/api/opportunity",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name",
        "contact_ids",
        "milestone",
        "expected_value",
        "probability",
        "close_date",
        "pipeline_id",
        "owner_id"
      ],
      "contentType": "application/json"
    },
    "deal.get": {
      "kind": "http",
      "method": "GET",
      "path": "{domain}.agilecrm.com/dev/api/opportunity/{id}",
      "required": [
        "id"
      ]
    },
    "deal.list": {
      "kind": "http",
      "method": "GET",
      "path": "{domain}.agilecrm.com/dev/api/opportunity",
      "required": [],
      "queryFrom": [
        "page_size",
        "cursor"
      ]
    },
    "deal.update": {
      "kind": "http",
      "method": "PUT",
      "path": "{domain}.agilecrm.com/dev/api/opportunity/partial-update",
      "required": [
        "id"
      ],
      "bodyFrom": [
        "id",
        "name",
        "milestone",
        "expected_value",
        "probability",
        "close_date",
        "contact_ids",
        "pipeline_id",
        "owner_id"
      ],
      "contentType": "application/json"
    },
    "deal.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "{domain}.agilecrm.com/dev/api/opportunity/{id}",
      "required": [
        "id"
      ]
    }
  }
}
