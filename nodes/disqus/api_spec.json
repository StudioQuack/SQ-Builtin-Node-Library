{
  "baseUrl": "https://disqus.com/api/3.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api_key"
  },
  "operations": {
    "post_list": {
      "kind": "http",
      "method": "GET",
      "path": "/posts/list.json",
      "queryFrom": ["forum", "thread", "limit"]
    },
    "post_create": {
      "kind": "http",
      "method": "POST",
      "path": "/posts/create.json",
      "required": ["message", "thread"],
      "bodyFrom": ["message", "thread", "author_name", "author_email", "parent"]
    },
    "thread_get": {
      "kind": "http",
      "method": "GET",
      "path": "/threads/details.json",
      "required": ["thread"],
      "queryFrom": ["thread", "forum"]
    },
    "forum_list": {
      "kind": "http",
      "method": "GET",
      "path": "/users/listForums.json",
      "queryFrom": ["user", "limit", "cursor", "order"]
    }
  }
}
