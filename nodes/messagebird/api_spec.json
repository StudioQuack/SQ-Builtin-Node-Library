{
  "baseUrl": "https://{platform_host}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_key"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/sms/messages",
      "contentType": "application/json",
      "required": [
        "to",
        "from",
        "text",
        "category"
      ],
      "bodyFrom": [
        "to",
        "from",
        "text",
        "category"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
