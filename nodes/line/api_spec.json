{
  "baseUrl": "https://api.line.me/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "channel_access_token"
  },
  "operations": {
    "push-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot/message/push",
      "contentType": "application/json",
      "required": [
        "to"
      ],
      "bodyFrom": [
        "to",
        "messages",
        "notificationDisabled"
      ]
    },
    "reply-message": {
      "kind": "http",
      "method": "POST",
      "path": "/bot/message/reply",
      "contentType": "application/json",
      "required": [
        "replyToken"
      ],
      "bodyFrom": [
        "replyToken",
        "messages",
        "notificationDisabled"
      ]
    },
    "multicast": {
      "kind": "http",
      "method": "POST",
      "path": "/bot/message/multicast",
      "contentType": "application/json",
      "required": [
        "to"
      ],
      "bodyFrom": [
        "to",
        "messages",
        "notificationDisabled"
      ]
    },
    "broadcast": {
      "kind": "http",
      "method": "POST",
      "path": "/bot/message/broadcast",
      "contentType": "application/json",
      "bodyFrom": [
        "messages",
        "notificationDisabled"
      ]
    },
    "get-profile": {
      "kind": "http",
      "method": "GET",
      "path": "/bot/profile/{userId}",
      "contentType": "application/json",
      "required": [
        "userId"
      ]
    },
    "get-content": {
      "kind": "http",
      "method": "GET",
      "path": "/bot/message/{messageId}/content",
      "contentType": "application/json",
      "required": [
        "messageId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
