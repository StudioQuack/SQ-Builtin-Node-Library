{
  "baseUrl": "https://rest.moceanapi.com/rest/2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "mocean-api-secret"
  },
  "operations": {
    "send-sms": {
      "kind": "http",
      "method": "POST",
      "path": "/sms",
      "contentType": "application/json",
      "required": [
        "mocean-to",
        "mocean-text"
      ],
      "queryFrom": [
        "mocean-api-key"
      ],
      "bodyFrom": [
        "mocean-from",
        "mocean-to",
        "mocean-text"
      ]
    },
    "send-voice": {
      "kind": "http",
      "method": "POST",
      "path": "/voice/dial",
      "contentType": "application/json",
      "required": [
        "mocean-to"
      ],
      "bodyFrom": [
        "mocean-from",
        "mocean-to",
        "mocean-command"
      ]
    }
  }
}
