{
  "baseUrl": "https://{account_id}.suitetalk.api.netsuite.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "record_get": {
      "kind": "http",
      "method": "GET",
      "path": "/services/rest/record/v1/{type}/{id}",
      "required": [
        "type",
        "id"
      ]
    },
    "record_create": {
      "kind": "http",
      "method": "POST",
      "path": "/services/rest/record/v1/{type}",
      "required": [
        "type",
        "record"
      ],
      "bodyFrom": [
        "record"
      ],
      "bodyMap": {
        "record": "$"
      }
    },
    "record_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/services/rest/record/v1/{type}/{id}",
      "required": [
        "type",
        "id",
        "record"
      ],
      "bodyFrom": [
        "record"
      ],
      "bodyMap": {
        "record": "$"
      }
    },
    "record_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/services/rest/record/v1/{type}/{id}",
      "required": [
        "type",
        "id"
      ]
    },
    "suiteql": {
      "kind": "http",
      "method": "POST",
      "path": "/services/rest/query/v1/suiteql",
      "bodyFrom": [
        "q",
        "params"
      ]
    }
  }
}
