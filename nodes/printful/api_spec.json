{
  "baseUrl": "https://api.printful.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_token"
  },
  "extraHeaders": {
    "X-PF-Store-Id": "{store_id}"
  },
  "operations": {
    "sync_product": {
      "kind": "http",
      "method": "POST",
      "baseUrl": "https://api.printful.com",
      "path": "/store/products",
      "bodyFrom": [
        "sync_product",
        "sync_variants"
      ],
      "required": [
        "sync_product"
      ]
    },
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "/orders",
      "bodyFrom": [
        "recipient",
        "order_items",
        "items",
        "external_id",
        "shipping"
      ],
      "required": [
        "recipient"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/orders/{id}",
      "required": [
        "id"
      ]
    },
    "file_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/files",
      "bodyFrom": [
        "url",
        "filename",
        "role"
      ],
      "required": [
        "url"
      ]
    },
    "shipping_rates": {
      "kind": "http",
      "method": "POST",
      "path": "/shipping-rates",
      "bodyFrom": [
        "recipient",
        "order_items",
        "items"
      ],
      "required": [
        "recipient"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
