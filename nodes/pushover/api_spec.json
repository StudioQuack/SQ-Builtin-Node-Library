{
  "baseUrl": "https://api.pushover.net/1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "token"
  },
  "operations": {
    "push": {
      "kind": "http",
      "method": "POST",
      "path": "/messages.json",
      "contentType": "application/json",
      "required": [
        "message"
      ],
      "queryFrom": [
        "token"
      ],
      "bodyFrom": [
        "token",
        "user",
        "message",
        "title",
        "priority",
        "retry",
        "expire",
        "sound",
        "device",
        "url"
      ]
    },
    "list-sounds": {
      "kind": "http",
      "method": "GET",
      "path": "/sounds.json",
      "contentType": "application/json",
      "queryFrom": [
        "token"
      ]
    }
  }
}
