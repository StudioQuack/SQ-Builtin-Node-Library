{
  "baseUrl": "{base_url}",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "docs": "https://developers.docusign.com/docs/esign-rest-api/",
  "operations": {
    "envelope_create_from_template": {
      "kind": "http",
      "method": "POST",
      "path": "/accounts/{account_id}/envelopes",
      "required": [
        "account_id",
        "template_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "templateId",
        "templateRoles",
        "status",
        "emailSubject",
        "template_id",
        "template_roles"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "template_id": "templateId",
        "template_roles": "templateRoles"
      }
    },
    "envelope_send": {
      "kind": "http",
      "method": "PUT",
      "path": "/accounts/{account_id}/envelopes/{envelope_id}",
      "required": [
        "account_id",
        "envelope_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "status"
      ],
      "contentType": "application/json"
    },
    "envelope_get": {
      "kind": "http",
      "method": "GET",
      "path": "/accounts/{account_id}/envelopes/{envelope_id}",
      "required": [
        "account_id",
        "envelope_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "envelope_void": {
      "kind": "http",
      "method": "PUT",
      "path": "/accounts/{account_id}/envelopes/{envelope_id}",
      "required": [
        "account_id",
        "envelope_id",
        "voided_reason"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "status",
        "voidedReason",
        "voided_reason"
      ],
      "contentType": "application/json",
      "bodyMap": {
        "voided_reason": "voidedReason"
      }
    },
    "document_download": {
      "kind": "http",
      "method": "GET",
      "path": "/accounts/{account_id}/envelopes/{envelope_id}/documents/{documentId}",
      "required": [
        "account_id",
        "envelope_id",
        "documentId"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "recipient_list": {
      "kind": "http",
      "method": "GET",
      "path": "/accounts/{account_id}/envelopes/{envelope_id}/recipients",
      "required": [
        "account_id",
        "envelope_id"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bulk_send": {
      "kind": "http",
      "method": "POST",
      "path": "/accounts/{account_id}/bulk_send_lists",
      "required": [
        "account_id"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "name",
        "bulkCopies"
      ],
      "contentType": "application/json"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
