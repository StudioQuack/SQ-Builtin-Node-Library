{
  "baseUrl": "{base_url}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none"
  },
  "operations": {
    "account_summary": {
      "kind": "http",
      "method": "GET",
      "path": "/portfolio/accounts"
    },
    "place_order": {
      "kind": "http",
      "method": "POST",
      "path": "/iserver/account/{accountId}/orders",
      "required": [
        "accountId"
      ],
      "bodyFrom": [
        "orders"
      ]
    },
    "cancel_order": {
      "kind": "http",
      "method": "DELETE",
      "path": "/iserver/account/{accountId}/order/{orderId}",
      "required": [
        "accountId",
        "orderId"
      ]
    },
    "positions": {
      "kind": "http",
      "method": "GET",
      "path": "/portfolio/{accountId}/positions/0",
      "required": [
        "accountId"
      ]
    },
    "market_data": {
      "kind": "http",
      "method": "GET",
      "path": "/iserver/marketdata/snapshot",
      "queryFrom": [
        "conids",
        "fields"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
