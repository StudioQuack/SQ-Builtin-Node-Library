{
  "baseUrl": "https://sdmx.oecd.org/public/rest/v2",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "dataflow_list": {
      "kind": "http",
      "method": "GET",
      "path": "/structure/dataflow/*/*/*",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "extraHeaders": {
        "Accept": "application/vnd.sdmx.structure+json;charset=utf-8;version=2.0.0"
      }
    },
    "data_get": {
      "kind": "http",
      "method": "GET",
      "path": "/data/dataflow/{agencyID}/{dataflowID}/{version}/{key}",
      "required": [
        "agencyID",
        "dataflowID",
        "version",
        "key"
      ],
      "queryFrom": [
        "time_period",
        "dimensionAtObservation",
        "attributes",
        "measures",
        "updatedAfter",
        "firstNObservations",
        "lastNObservations",
        "detail",
        "includeHistory",
        "asOf"
      ],
      "bodyFrom": [],
      "extraHeaders": {
        "Accept": "application/vnd.sdmx.data+json;charset=utf-8;version=2.0.0"
      },
      "queryMap": {
        "time_period": "c[TIME_PERIOD]"
      }
    }
  }
}
