{
  "baseUrl": "https://",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "execute-analyzer": {
      "kind": "http",
      "method": "POST",
      "path": "{cortexHost}/api/analyzer/{analyzerId}/run",
      "required": [
        "analyzerId"
      ],
      "queryFrom": [
        "force"
      ],
      "bodyFrom": [
        "data",
        "dataType",
        "tlp",
        "message",
        "parameters"
      ]
    },
    "get-job": {
      "kind": "http",
      "method": "GET",
      "path": "{cortexHost}/api/job/{jobId}",
      "required": [
        "jobId"
      ]
    },
    "get-job-report": {
      "kind": "http",
      "method": "GET",
      "path": "{cortexHost}/api/job/{jobId}/report",
      "required": [
        "jobId"
      ]
    },
    "execute-responder": {
      "kind": "http",
      "method": "POST",
      "path": "{cortexHost}/api/responder/{responderId}/run",
      "required": [
        "responderId"
      ],
      "bodyFrom": [
        "data",
        "dataType",
        "tlp",
        "pap",
        "message",
        "parameters"
      ]
    }
  }
}
