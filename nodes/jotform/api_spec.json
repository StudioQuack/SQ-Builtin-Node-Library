{
  "baseUrl": "https://{host}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "APIKEY",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/user/forms",
      "required": [],
      "queryFrom": ["offset", "limit", "filter", "orderby"]
    },
    "form.get": {
      "kind": "http",
      "method": "GET",
      "path": "/form/{form_id}",
      "required": ["form_id"]
    },
    "submission.list": {
      "kind": "http",
      "method": "GET",
      "path": "/form/{form_id}/submissions",
      "required": ["form_id"],
      "queryFrom": ["offset", "limit", "filter", "orderby"]
    },
    "submission.get": {
      "kind": "http",
      "method": "GET",
      "path": "/submission/{submission_id}",
      "required": ["submission_id"]
    },
    "submission.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/submission/{submission_id}",
      "required": ["submission_id"]
    },
    "report.list": {
      "kind": "http",
      "method": "GET",
      "path": "/form/{form_id}/reports",
      "required": ["form_id"]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
