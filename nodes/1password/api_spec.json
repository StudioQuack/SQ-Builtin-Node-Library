{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "connect_token"
  },
  "operations": {
    "list-vaults": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults",
      "required": [
        "connectHost"
      ],
      "queryFrom": [
        "filter"
      ]
    },
    "get-vault": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}",
      "required": [
        "connectHost",
        "vaultUuid"
      ]
    },
    "list-items": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items",
      "required": [
        "connectHost",
        "vaultUuid"
      ],
      "queryFrom": [
        "filter"
      ]
    },
    "get-item": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid"
      ]
    },
    "create-item": {
      "kind": "http",
      "method": "POST",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items",
      "required": [
        "connectHost",
        "vaultUuid"
      ],
      "bodyFrom": [
        "title",
        "category",
        "tags",
        "urls",
        "sections",
        "fields",
        "files",
        "vault"
      ]
    },
    "replace-item": {
      "kind": "http",
      "method": "PUT",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid"
      ],
      "bodyFrom": [
        "title",
        "category",
        "tags",
        "urls",
        "sections",
        "fields",
        "files",
        "vault"
      ]
    },
    "patch-item": {
      "kind": "http",
      "method": "PATCH",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid"
      ],
      "bodyFrom": [
        "patch"
      ],
      "bodyMap": {
        "patch": "$"
      },
      "contentType": "application/json-patch+json"
    },
    "delete-item": {
      "kind": "http",
      "method": "DELETE",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid"
      ]
    },
    "list-files": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}/files",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid"
      ],
      "queryFrom": [
        "inline_content"
      ]
    },
    "get-file": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}/files/{fileUuid}",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid",
        "fileUuid"
      ],
      "queryFrom": [
        "inline_content"
      ]
    },
    "get-file-content": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/vaults/{vaultUuid}/items/{itemUuid}/files/{fileUuid}/content",
      "required": [
        "connectHost",
        "vaultUuid",
        "itemUuid",
        "fileUuid"
      ]
    },
    "list-activity": {
      "kind": "http",
      "method": "GET",
      "path": "{connectHost}/v1/activity",
      "required": [
        "connectHost"
      ],
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
