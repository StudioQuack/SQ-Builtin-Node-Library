{
  "baseUrl": "https://api.api-ninjas.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "quotes": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/quotes",
      "required": [],
      "queryFrom": [
        "categories",
        "author",
        "limit"
      ]
    },
    "trivia": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/trivia",
      "required": [],
      "queryFrom": [
        "category",
        "limit"
      ]
    },
    "facts": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/facts",
      "required": [],
      "queryFrom": [
        "limit"
      ]
    },
    "jokes": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/jokes",
      "required": [],
      "queryFrom": [
        "limit"
      ]
    },
    "riddles": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/riddles",
      "required": [],
      "queryFrom": [
        "limit"
      ]
    },
    "bucketlist": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/bucketlist",
      "required": []
    }
  }
}
