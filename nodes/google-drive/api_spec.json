{
  "baseUrl": "https://www.googleapis.com/drive/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "copy": {
      "kind": "http",
      "method": "POST",
      "path": "/files/{fileId}/copy",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "supportsAllDrives"
      ],
      "bodyFrom": [
        "name",
        "parents",
        "description",
        "mimeType"
      ]
    },
    "create_from_text": {
      "kind": "http",
      "method": "POST",
      "path": "/files",
      "queryFrom": [
        "supportsAllDrives"
      ],
      "bodyFrom": [
        "name",
        "mimeType",
        "parents",
        "content"
      ]
    },
    "upload": {
      "kind": "http",
      "method": "POST",
      "path": "/files",
      "queryFrom": [
        "supportsAllDrives",
        "uploadType"
      ],
      "bodyFrom": [
        "name",
        "mimeType",
        "parents",
        "file"
      ]
    },
    "download": {
      "kind": "http",
      "method": "GET",
      "path": "/files/{fileId}",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "alt",
        "supportsAllDrives"
      ]
    },
    "update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/files/{fileId}",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "supportsAllDrives",
        "addParents",
        "removeParents"
      ],
      "bodyFrom": [
        "name",
        "description",
        "mimeType"
      ]
    },
    "delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/files/{fileId}",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "supportsAllDrives"
      ]
    },
    "move": {
      "kind": "http",
      "method": "PATCH",
      "path": "/files/{fileId}",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "addParents",
        "removeParents",
        "supportsAllDrives"
      ]
    },
    "share": {
      "kind": "http",
      "method": "POST",
      "path": "/files/{fileId}/permissions",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "supportsAllDrives",
        "sendNotificationEmail",
        "emailMessage"
      ],
      "bodyFrom": [
        "role",
        "type",
        "emailAddress",
        "domain"
      ]
    },
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/files",
      "queryFrom": [
        "q",
        "pageSize",
        "pageToken",
        "supportsAllDrives",
        "includeItemsFromAllDrives",
        "orderBy",
        "fields",
        "corpora",
        "driveId"
      ]
    },
    "create_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files",
      "queryFrom": [
        "supportsAllDrives"
      ],
      "bodyFrom": [
        "name",
        "mimeType",
        "parents"
      ]
    },
    "delete_folder": {
      "kind": "http",
      "method": "DELETE",
      "path": "/files/{fileId}",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "supportsAllDrives"
      ]
    },
    "share_folder": {
      "kind": "http",
      "method": "POST",
      "path": "/files/{fileId}/permissions",
      "required": [
        "fileId"
      ],
      "bodyFrom": [
        "role",
        "type",
        "emailAddress",
        "domain"
      ],
      "queryFrom": [
        "supportsAllDrives",
        "sendNotificationEmail",
        "emailMessage"
      ]
    },
    "create_shared_drive": {
      "kind": "http",
      "method": "POST",
      "path": "/drives",
      "queryFrom": [
        "requestId"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "get_shared_drive": {
      "kind": "http",
      "method": "GET",
      "path": "/drives/{driveId}",
      "required": [
        "driveId"
      ]
    },
    "list_shared_drives": {
      "kind": "http",
      "method": "GET",
      "path": "/drives",
      "queryFrom": [
        "pageSize",
        "pageToken"
      ]
    },
    "update_shared_drive": {
      "kind": "http",
      "method": "PATCH",
      "path": "/drives/{driveId}",
      "required": [
        "driveId"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "delete_shared_drive": {
      "kind": "http",
      "method": "DELETE",
      "path": "/drives/{driveId}",
      "required": [
        "driveId"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
