{
  "baseUrl": "https://s3.{region}.wasabisys.com",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "aws-sigv4",
    "configKey": "access_key",
    "secretKeyConfigKey": "secret_key"
  },
  "sigv4": {
    "service": "s3",
    "regionConfigKey": "region"
  },
  "docs": "https://docs.wasabi.com/docs/wasabi-api",
  "operations": {
    "bucket_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "bucket_list": {
      "kind": "http",
      "method": "GET",
      "path": "/",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_put": {
      "kind": "http",
      "method": "PUT",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key",
        "file"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/octet-stream",
      "bodyFormat": "raw",
      "bodyParam": "file"
    },
    "object_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/octet-stream"
    },
    "object_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{bucket}/{key}",
      "required": [
        "bucket",
        "key"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "object_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{bucket}",
      "required": [
        "bucket"
      ],
      "queryFrom": [
        "list-type",
        "prefix",
        "delimiter",
        "max-keys",
        "continuation-token",
        "start-after"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
