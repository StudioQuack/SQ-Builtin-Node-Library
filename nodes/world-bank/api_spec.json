{
  "baseUrl": "https://api.worldbank.org/v2",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "indicator_get": {
      "kind": "http",
      "method": "GET",
      "path": "/country/{country}/indicator/{indicator}?format=json",
      "required": [
        "country",
        "indicator"
      ],
      "queryFrom": [
        "date",
        "per_page",
        "page",
        "mrv"
      ],
      "bodyFrom": []
    },
    "country_list": {
      "kind": "http",
      "method": "GET",
      "path": "/country?format=json",
      "required": [],
      "queryFrom": [
        "per_page",
        "page",
        "region",
        "incomeLevel"
      ],
      "bodyFrom": []
    },
    "catalog_search": {
      "kind": "http",
      "method": "GET",
      "path": "/indicator?format=json",
      "required": [],
      "queryFrom": [
        "per_page",
        "page",
        "source"
      ],
      "bodyFrom": []
    }
  }
}
