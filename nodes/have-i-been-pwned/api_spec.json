{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "hibp-api-key",
    "prefix": "",
    "configKey": "hibp_api_key"
  },
  "operations": {
    "breached-account": {
      "kind": "http",
      "method": "GET",
      "path": "haveibeenpwned.com/api/v3/breachedAccount/{account}",
      "required": [
        "account"
      ],
      "queryFrom": [
        "truncateResponse",
        "includeUnverified",
        "domain"
      ]
    },
    "breached-domain": {
      "kind": "http",
      "method": "GET",
      "path": "haveibeenpwned.com/api/v3/breachedDomain/{domain}",
      "required": [
        "domain"
      ]
    },
    "paste-account": {
      "kind": "http",
      "method": "GET",
      "path": "haveibeenpwned.com/api/v3/pasteAccount/{account}",
      "required": [
        "account"
      ]
    },
    "pwned-password": {
      "kind": "http",
      "method": "GET",
      "path": "api.pwnedpasswords.com/range/{prefix}",
      "required": [
        "prefix"
      ],
      "queryFrom": [
        "mode"
      ]
    },
    "subscription-status": {
      "kind": "http",
      "method": "GET",
      "path": "haveibeenpwned.com/api/v3/subscription/status"
    },
    "breached-account-range": {
      "kind": "http",
      "method": "GET",
      "path": "haveibeenpwned.com/api/v3/breachedaccount/range/{prefix}",
      "required": [
        "prefix"
      ]
    }
  }
}
