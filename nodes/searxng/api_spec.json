{
  "baseUrl": "https://",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "{instance_host}/search?format=json",
      "required": [
        "instance_host",
        "q"
      ],
      "queryFrom": [
        "q",
        "language",
        "safesearch",
        "categories",
        "pageno"
      ],
      "bodyFrom": []
    }
  }
}
