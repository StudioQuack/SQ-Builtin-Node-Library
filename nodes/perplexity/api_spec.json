{
  "baseUrl": "https://api.perplexity.ai",
  "defaultTimeout": 300,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "chat": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/agent",
      "required": [],
      "bodyFrom": [
        "input",
        "messages",
        "instructions",
        "model",
        "models",
        "max_output_tokens",
        "max_tokens",
        "max_steps",
        "temperature",
        "top_p",
        "stream",
        "tools",
        "skills",
        "response_format",
        "reasoning",
        "language_preference",
        "previous_response_id",
        "background"
      ],
      "stream": {
        "format": "responses-sse"
      }
    },
    "search": {
      "kind": "http",
      "method": "POST",
      "path": "/search",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "max_results",
        "search_context_size",
        "max_tokens",
        "max_tokens_per_page",
        "country",
        "search_language_filter",
        "search_domain_filter",
        "search_recency_filter",
        "search_after_date_filter",
        "search_before_date_filter"
      ]
    }
  }
}
