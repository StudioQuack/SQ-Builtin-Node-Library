{
  "baseUrl": "https://api.webflow.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "site.list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites"
    },
    "item.list": {
      "kind": "http",
      "method": "GET",
      "path": "/collections/{collection_id}/items",
      "required": [
        "collection_id"
      ],
      "queryFrom": [
        "cmsLocaleId",
        "limit",
        "offset"
      ]
    },
    "item.get": {
      "kind": "http",
      "method": "GET",
      "path": "/collections/{collection_id}/items/{item_id}",
      "required": [
        "collection_id",
        "item_id"
      ]
    },
    "item.create": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection_id}/items",
      "required": [
        "collection_id",
        "fieldData"
      ],
      "bodyFrom": [
        "fieldData",
        "cmsLocaleId",
        "isArchived",
        "isDraft"
      ]
    },
    "item.update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/collections/{collection_id}/items/{item_id}",
      "required": [
        "collection_id",
        "item_id",
        "fieldData"
      ],
      "bodyFrom": [
        "fieldData",
        "cmsLocaleId"
      ]
    },
    "item.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/collections/{collection_id}/items/{item_id}",
      "required": [
        "collection_id",
        "item_id"
      ]
    },
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/forms",
      "required": [
        "site_id"
      ],
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "form.submission.list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/forms/{form_id}/submissions",
      "required": [
        "site_id",
        "form_id"
      ],
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "order.list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/orders",
      "required": [
        "site_id"
      ],
      "queryFrom": [
        "status",
        "limit",
        "offset"
      ]
    },
    "sku.list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/products",
      "required": [
        "site_id"
      ],
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "item_list": {
      "kind": "http",
      "method": "GET",
      "path": "/collections/{collection_id}/items",
      "required": [
        "collection_id"
      ],
      "queryFrom": [
        "cmsLocaleId",
        "limit",
        "offset"
      ]
    },
    "item_create": {
      "kind": "http",
      "method": "POST",
      "path": "/collections/{collection_id}/items",
      "required": [
        "collection_id",
        "fieldData"
      ],
      "bodyFrom": [
        "fieldData",
        "cmsLocaleId",
        "isArchived",
        "isDraft"
      ]
    },
    "item_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/collections/{collection_id}/items/{item_id}",
      "required": [
        "collection_id",
        "item_id",
        "fieldData"
      ],
      "bodyFrom": [
        "fieldData",
        "cmsLocaleId"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/orders",
      "required": [
        "site_id"
      ],
      "queryFrom": [
        "status",
        "limit",
        "offset"
      ]
    },
    "sku_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/products",
      "required": [
        "site_id"
      ],
      "queryFrom": [
        "limit",
        "offset"
      ]
    },
    "trigger.form": {
      "kind": "ingress"
    },
    "trigger.listen": {
      "kind": "ingress"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
