{
  "baseUrl": "https://openapi.etsy.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "x-api-key": "{keystring}:{shared_secret}"
  },
  "operations": {
    "listing_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/application/listings/{listing_id}",
      "required": [
        "listing_id"
      ],
      "queryFrom": [
        "includes"
      ]
    },
    "listing_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/application/shops/{shop_id}/listings",
      "queryFrom": [
        "state",
        "limit",
        "offset"
      ],
      "required": []
    },
    "listing_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v3/application/shops/{shop_id}/listings",
      "contentType": "application/x-www-form-urlencoded",
      "bodyFormat": "form",
      "required": [
        "quantity",
        "title",
        "description",
        "price",
        "who_made",
        "when_made",
        "taxonomy_id"
      ],
      "bodyFrom": [
        "quantity",
        "title",
        "description",
        "price",
        "who_made",
        "when_made",
        "taxonomy_id",
        "shipping_profile_id",
        "return_policy_id",
        "readiness_state_id",
        "type",
        "tags",
        "materials",
        "shop_section_id",
        "processing_min",
        "processing_max",
        "is_supply",
        "is_personalizable",
        "image_ids",
        "item_weight",
        "item_length",
        "item_width",
        "item_height",
        "item_weight_unit",
        "item_dimensions_unit"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/application/shops/{shop_id}/receipts",
      "queryFrom": [
        "limit",
        "offset",
        "min_created",
        "max_created"
      ]
    },
    "receipt_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/application/shops/{shop_id}/receipts/{receipt_id}",
      "required": [
        "receipt_id"
      ]
    },
    "shop_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v3/application/shops/{shop_id}"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
