{
  "baseUrl": "https://api.ngrok.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "extraHeaders": {
    "Ngrok-Version": "2"
  },
  "operations": {
    "tunnel_list": {
      "kind": "http",
      "method": "GET",
      "path": "/endpoints",
      "queryFrom": [
        "limit",
        "before_id"
      ]
    },
    "tunnel_get": {
      "kind": "http",
      "method": "GET",
      "path": "/endpoints/{id}",
      "required": [
        "id"
      ]
    },
    "edge_get": {
      "kind": "http",
      "method": "GET",
      "path": "/edges/{edge_type}/{id}",
      "required": [
        "edge_type",
        "id"
      ]
    },
    "reserved_domain_list": {
      "kind": "http",
      "method": "GET",
      "path": "/reserved_domains",
      "queryFrom": [
        "limit",
        "before_id"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
