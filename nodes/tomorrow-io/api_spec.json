{
  "baseUrl": "https://api.tomorrow.io/v4",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "apikey"
  },
  "operations": {
    "realtime": {
      "kind": "http",
      "method": "GET",
      "path": "/weather/realtime",
      "required": [
        "location"
      ],
      "queryFrom": [
        "location",
        "units"
      ],
      "bodyFrom": []
    },
    "forecast": {
      "kind": "http",
      "method": "GET",
      "path": "/weather/forecast",
      "required": [
        "location"
      ],
      "queryFrom": [
        "location",
        "units",
        "timesteps",
        "startTime",
        "endTime"
      ],
      "bodyFrom": []
    },
    "historical": {
      "kind": "http",
      "method": "GET",
      "path": "/weather/history/recent",
      "required": [
        "location"
      ],
      "queryFrom": [
        "location",
        "units",
        "timesteps",
        "startTime",
        "endTime"
      ],
      "bodyFrom": []
    },
    "timelines": {
      "kind": "http",
      "method": "GET",
      "path": "/timelines",
      "required": [
        "location"
      ],
      "queryFrom": [
        "location",
        "fields",
        "timesteps",
        "units",
        "startTime",
        "endTime",
        "timezone"
      ],
      "bodyFrom": []
    }
  }
}
