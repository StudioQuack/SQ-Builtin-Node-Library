{
  "baseUrl": "https://sentry.io/api/0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "auth_token"
  },
  "operations": {
    "event_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{org}/{project}/events/{event_id}/",
      "required": [
        "org",
        "project",
        "event_id"
      ]
    },
    "event_list": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{org}/{project}/events/",
      "required": [
        "org",
        "project"
      ],
      "queryFrom": [
        "cursor",
        "full"
      ]
    },
    "issue_get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizations/{org}/issues/{issue_id}/",
      "required": [
        "org",
        "issue_id"
      ]
    },
    "issue_list": {
      "kind": "http",
      "method": "GET",
      "path": "/organizations/{org}/issues/",
      "required": [
        "org"
      ],
      "queryFrom": [
        "query",
        "cursor",
        "project"
      ]
    },
    "issue_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/organizations/{org}/issues/{issue_id}/",
      "required": [
        "org",
        "issue_id"
      ],
      "bodyFrom": [
        "status",
        "assignedTo"
      ]
    },
    "issue_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/organizations/{org}/issues/{issue_id}/",
      "required": [
        "org",
        "issue_id"
      ]
    },
    "project_create": {
      "kind": "http",
      "method": "POST",
      "path": "/teams/{org}/{team_slug}/projects/",
      "required": [
        "org",
        "team_slug",
        "name"
      ],
      "bodyFrom": [
        "name",
        "slug"
      ]
    },
    "project_get": {
      "kind": "http",
      "method": "GET",
      "path": "/projects/{org}/{project}/",
      "required": [
        "org",
        "project"
      ]
    },
    "project_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/projects/{org}/{project}/",
      "required": [
        "org",
        "project"
      ],
      "bodyFrom": [
        "name",
        "slug",
        "platform"
      ]
    },
    "release_create": {
      "kind": "http",
      "method": "POST",
      "path": "/organizations/{org}/releases/",
      "required": [
        "org"
      ],
      "bodyFrom": [
        "version",
        "projects"
      ]
    },
    "release_get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizations/{org}/releases/{version}/",
      "required": [
        "org",
        "version"
      ]
    },
    "org_get": {
      "kind": "http",
      "method": "GET",
      "path": "/organizations/{org}/",
      "required": [
        "org"
      ]
    },
    "team_get": {
      "kind": "http",
      "method": "GET",
      "path": "/teams/{org}/{team_slug}/",
      "required": [
        "org",
        "team_slug"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
