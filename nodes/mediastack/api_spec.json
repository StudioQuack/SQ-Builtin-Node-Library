{
  "baseUrl": "https://api.mediastack.com/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "access_key"
  },
  "operations": {
    "live": {
      "kind": "http",
      "method": "GET",
      "path": "/news",
      "required": [],
      "queryFrom": [
        "keywords",
        "sources",
        "categories",
        "countries",
        "languages",
        "limit",
        "offset",
        "sort"
      ]
    },
    "historical": {
      "kind": "http",
      "method": "GET",
      "path": "/news",
      "required": [
        "date"
      ],
      "queryFrom": [
        "date",
        "keywords",
        "sources",
        "countries",
        "limit",
        "offset",
        "sort"
      ]
    },
    "sources": {
      "kind": "http",
      "method": "GET",
      "path": "/sources",
      "required": [],
      "queryFrom": [
        "search",
        "countries",
        "languages",
        "categories",
        "limit",
        "offset"
      ]
    }
  }
}
