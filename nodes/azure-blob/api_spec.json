{
  "baseUrl": "https://{account_name}.blob.core.windows.net",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "sas_token"
  },
  "docs": "https://learn.microsoft.com/en-us/rest/api/storageservices/blob-service-rest-api",
  "operations": {
    "blob_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/{container}/{blob}",
      "required": [
        "container",
        "blob"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json",
      "extraHeaders": {
        "x-ms-blob-type": "{blob_type}",
        "x-ms-blob-content-type": "{content_type}"
      }
    },
    "blob_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{container}/{blob}",
      "required": [
        "container",
        "blob"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "blob_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{container}/{blob}",
      "required": [
        "container",
        "blob"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "blob_list": {
      "kind": "http",
      "method": "GET",
      "path": "/{container}?restype=container&comp=list",
      "required": [
        "container"
      ],
      "queryFrom": [
        "prefix",
        "marker"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "container_create": {
      "kind": "http",
      "method": "PUT",
      "path": "/{container}?restype=container",
      "required": [
        "container"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "container_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/{container}?restype=container",
      "required": [
        "container"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "container_get": {
      "kind": "http",
      "method": "GET",
      "path": "/{container}?restype=container",
      "required": [
        "container"
      ],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "container_list": {
      "kind": "http",
      "method": "GET",
      "path": "/?comp=list",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [],
      "contentType": "application/json"
    }
  }
}
