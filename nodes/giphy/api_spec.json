{
  "baseUrl": "https://api.giphy.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/gifs/search",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "limit",
        "offset",
        "rating",
        "lang",
        "bundle"
      ]
    },
    "trending": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/gifs/trending",
      "required": [],
      "queryFrom": [
        "limit",
        "offset",
        "rating"
      ]
    },
    "translate": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/gifs/translate",
      "required": [
        "s"
      ],
      "queryFrom": [
        "s",
        "rating"
      ]
    },
    "random": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/gifs/random",
      "required": [],
      "queryFrom": [
        "tag",
        "rating"
      ]
    },
    "gif_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v1/gifs/{gif_id}",
      "required": [
        "gif_id"
      ]
    }
  }
}
