{
    "baseUrl": "https://graph.facebook.com/v26.0",
    "defaultTimeout": 30,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "access_token"
    },
    "operations": {
        "campaign.create": {
            "kind": "http",
            "method": "POST",
            "path": "/act_{ad_account_id}/campaigns",
            "required": [
                "ad_account_id",
                "name",
                "special_ad_categories"
            ],
            "bodyFrom": [
                "name",
                "objective",
                "status",
                "special_ad_categories",
                "buying_type"
            ]
        },
        "campaign.get": {
            "kind": "http",
            "method": "GET",
            "path": "/{id}",
            "required": [
                "id"
            ],
            "queryFrom": [
                "fields"
            ]
        },
        "campaign.list": {
            "kind": "http",
            "method": "GET",
            "path": "/act_{ad_account_id}/campaigns",
            "required": [
                "ad_account_id"
            ],
            "queryFrom": [
                "fields",
                "limit",
                "after"
            ]
        },
        "campaign.update": {
            "kind": "http",
            "method": "POST",
            "path": "/{id}",
            "required": [
                "id"
            ],
            "bodyFrom": [
                "name",
                "status"
            ]
        },
        "adset.create": {
            "kind": "http",
            "method": "POST",
            "path": "/act_{ad_account_id}/adsets",
            "required": [
                "ad_account_id",
                "name",
                "campaign_id",
                "billing_event",
                "optimization_goal",
                "targeting"
            ],
            "bodyFrom": [
                "name",
                "campaign_id",
                "daily_budget",
                "lifetime_budget",
                "billing_event",
                "optimization_goal",
                "targeting",
                "start_time",
                "status",
                "promoted_object"
            ]
        },
        "adset.get": {
            "kind": "http",
            "method": "GET",
            "path": "/{id}",
            "required": [
                "id"
            ],
            "queryFrom": [
                "fields"
            ]
        },
        "adset.list": {
            "kind": "http",
            "method": "GET",
            "path": "/act_{ad_account_id}/adsets",
            "required": [
                "ad_account_id"
            ],
            "queryFrom": [
                "fields",
                "limit",
                "after"
            ]
        },
        "ad.create": {
            "kind": "http",
            "method": "POST",
            "path": "/act_{ad_account_id}/ads",
            "required": [
                "ad_account_id",
                "name",
                "adset_id",
                "creative"
            ],
            "bodyFrom": [
                "name",
                "adset_id",
                "creative",
                "status"
            ]
        },
        "ad.get": {
            "kind": "http",
            "method": "GET",
            "path": "/{id}",
            "required": [
                "id"
            ],
            "queryFrom": [
                "fields"
            ]
        },
        "insights.get": {
            "kind": "http",
            "method": "GET",
            "path": "/{object_id}/insights",
            "required": [
                "object_id"
            ],
            "queryFrom": [
                "fields",
                "level",
                "limit"
            ]
        },
        "audience.create": {
            "kind": "http",
            "method": "POST",
            "path": "/act_{ad_account_id}/customaudiences",
            "required": [
                "ad_account_id",
                "name"
            ],
            "bodyFrom": [
                "name",
                "subtype",
                "description",
                "customer_file_source"
            ]
        },
        "leadForm.list": {
            "kind": "http",
            "method": "GET",
            "path": "/{page_id}/leadgen_forms",
            "required": [
                "page_id"
            ],
            "queryFrom": [
                "fields",
                "limit",
                "after"
            ]
        },
        "lead.get": {
            "kind": "http",
            "method": "GET",
            "path": "/{id}",
            "required": [
                "id"
            ],
            "queryFrom": [
                "fields"
            ]
        },
        "customConversion.create": {
            "kind": "http",
            "method": "POST",
            "path": "/act_{ad_account_id}/customconversions",
            "required": [
                "ad_account_id",
                "name",
                "event_source_id",
                "rule"
            ],
            "bodyFrom": [
                "name",
                "event_source_id",
                "rule"
            ]
        },
        "trigger.leadgen": {
            "kind": "ingress"
        },
        "trigger.listen": {
            "kind": "ingress"
        }
    }
}
