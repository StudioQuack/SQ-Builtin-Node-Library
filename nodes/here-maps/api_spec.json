{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "apiKey"
  },
  "operations": {
    "geocode": {
      "kind": "http",
      "method": "GET",
      "path": "geocode.search.hereapi.com/v1/geocode",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "limit",
        "lang"
      ],
      "bodyFrom": []
    },
    "reverse": {
      "kind": "http",
      "method": "GET",
      "path": "geocode.search.hereapi.com/v1/revgeocode",
      "required": [
        "at"
      ],
      "queryFrom": [
        "at",
        "lang"
      ],
      "bodyFrom": []
    },
    "discover": {
      "kind": "http",
      "method": "GET",
      "path": "discover.search.hereapi.com/v1/discover",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "at",
        "limit"
      ],
      "bodyFrom": []
    },
    "route": {
      "kind": "http",
      "method": "GET",
      "path": "router.hereapi.com/v8/routes",
      "required": [
        "origin",
        "destination"
      ],
      "queryFrom": [
        "transportMode",
        "origin",
        "destination",
        "return"
      ],
      "bodyFrom": []
    }
  }
}
