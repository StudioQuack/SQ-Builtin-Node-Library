{
    "baseUrl": "{install_url}",
    "defaultTimeout": 30,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "none",
        "configKey": "api_key"
    },
    "operations": {
        "subscriber.add": {
            "kind": "http",
            "method": "POST",
            "path": "/subscribe",
            "required": [
                "email"
            ],
            "bodyFrom": [
                "api_key",
                "email",
                "list",
                "name",
                "country",
                "ipaddress",
                "referrer",
                "gdpr",
                "silent",
                "custom_fields",
                "boolean"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        },
        "subscriber.unsubscribe": {
            "kind": "http",
            "method": "POST",
            "path": "/unsubscribe",
            "required": [
                "email"
            ],
            "bodyFrom": [
                "api_key",
                "email",
                "list",
                "boolean"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        },
        "subscriber.delete": {
            "kind": "http",
            "method": "POST",
            "path": "/api/subscribers/delete.php",
            "required": [
                "email"
            ],
            "bodyFrom": [
                "api_key",
                "email",
                "list_id"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        },
        "subscriber.status": {
            "kind": "http",
            "method": "POST",
            "path": "/api/subscribers/subscription-status.php",
            "required": [
                "email"
            ],
            "bodyFrom": [
                "api_key",
                "email",
                "list_id"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        },
        "subscriber.count": {
            "kind": "http",
            "method": "POST",
            "path": "/api/subscribers/active-subscriber-count.php",
            "required": [],
            "bodyFrom": [
                "api_key",
                "list_id"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        },
        "campaign.create": {
            "kind": "http",
            "method": "POST",
            "path": "/api/campaigns/create.php",
            "required": [
                "from_name",
                "from_email",
                "reply_to",
                "title",
                "subject",
                "html_text"
            ],
            "bodyFrom": [
                "api_key",
                "from_name",
                "from_email",
                "reply_to",
                "title",
                "subject",
                "html_text",
                "plain_text",
                "list_ids",
                "segment_ids",
                "exclude_list_ids",
                "exclude_segments_ids",
                "brand_id",
                "query_string",
                "track_opens",
                "track_clicks",
                "send_campaign",
                "schedule_date_time",
                "schedule_timezone"
            ],
            "contentType": "application/x-www-form-urlencoded",
            "bodyFormat": "form"
        }
    }
}
