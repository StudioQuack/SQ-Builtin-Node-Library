{
  "baseUrl": "https://campaign.api.bingads.microsoft.com/CampaignManagement/v13",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "extraHeaders": {
    "DeveloperToken": "{developer_token}",
    "CustomerId": "{customer_id}",
    "CustomerAccountId": "{account_id}"
  },
  "operations": {
    "campaign.get": {
      "kind": "http",
      "method": "POST",
      "path": "/Campaigns/QueryByIds",
      "required": [
        "account_id",
        "CampaignIds"
      ],
      "bodyFrom": [
        "account_id",
        "CampaignIds",
        "CampaignType",
        "ReturnAdditionalFields"
      ],
      "bodyMap": {
        "account_id": "AccountId"
      }
    },
    "campaign.list": {
      "kind": "http",
      "method": "POST",
      "path": "/Campaigns/QueryByAccountId",
      "required": [
        "account_id"
      ],
      "bodyFrom": [
        "account_id",
        "CampaignType",
        "ReturnAdditionalFields"
      ],
      "bodyMap": {
        "account_id": "AccountId"
      }
    },
    "campaign.mutate": {
      "kind": "http",
      "method": "POST",
      "path": "/Campaigns",
      "required": [
        "account_id",
        "Campaigns"
      ],
      "bodyFrom": [
        "account_id",
        "Campaigns"
      ],
      "bodyMap": {
        "account_id": "AccountId"
      }
    },
    "adGroup.list": {
      "kind": "http",
      "method": "POST",
      "path": "/AdGroups/QueryByCampaignId",
      "required": [
        "CampaignId"
      ],
      "bodyFrom": [
        "CampaignId",
        "ReturnAdditionalFields"
      ]
    },
    "ad.list": {
      "kind": "http",
      "method": "POST",
      "path": "/Ads/QueryByAdGroupId",
      "required": [
        "AdGroupId",
        "AdTypes"
      ],
      "bodyFrom": [
        "AdGroupId",
        "AdTypes",
        "ReturnAdditionalFields"
      ]
    },
    "report.submit": {
      "kind": "http",
      "method": "POST",
      "baseUrl": "https://reporting.api.bingads.microsoft.com/Reporting/v13",
      "path": "/GenerateReport/Submit",
      "required": [
        "ReportRequest"
      ],
      "bodyFrom": [
        "ReportRequest"
      ]
    },
    "report.poll": {
      "kind": "http",
      "method": "POST",
      "baseUrl": "https://reporting.api.bingads.microsoft.com/Reporting/v13",
      "path": "/GenerateReport/Poll",
      "required": [
        "ReportRequestId"
      ],
      "bodyFrom": [
        "ReportRequestId"
      ]
    },
    "conversion.upload": {
      "kind": "http",
      "method": "POST",
      "path": "/OfflineConversions/Apply",
      "required": [
        "OfflineConversions"
      ],
      "bodyFrom": [
        "OfflineConversions"
      ]
    },
    "audience.mutate": {
      "kind": "http",
      "method": "POST",
      "path": "/Audiences",
      "required": [
        "Audiences"
      ],
      "bodyFrom": [
        "Audiences"
      ]
    }
  }
}
