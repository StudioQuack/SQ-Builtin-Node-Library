{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "access_token"
  },
  "operations": {
    "transaction_list": {
      "kind": "http",
      "method": "GET",
      "path": "/transactions",
      "queryFrom": [
        "page_size",
        "start",
        "from_date",
        "to_date",
        "state"
      ]
    },
    "reimbursement_list": {
      "kind": "http",
      "method": "GET",
      "path": "/reimbursements",
      "queryFrom": [
        "page_size",
        "from_date",
        "to_date"
      ]
    },
    "vendor_create": {
      "kind": "http",
      "method": "POST",
      "path": "/vendors",
      "bodyFrom": [
        "name",
        "country",
        "email",
        "phone",
        "tax_id"
      ],
      "required": [
        "name"
      ]
    },
    "card_list": {
      "kind": "http",
      "method": "GET",
      "path": "/cards",
      "queryFrom": [
        "page_size",
        "user_id",
        "state"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
