{
  "baseUrl": "https://api.backblazeb2.com/b2api/v4",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "application_key"
  },
  "docs": "https://www.backblaze.com/apidocs/introduction-to-the-b2-native-api",
  "operations": {
    "bucket_list": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_list_buckets",
      "required": [],
      "queryFrom": [],
      "bodyFrom": [
        "accountId"
      ],
      "contentType": "application/json"
    },
    "bucket_create": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_create_bucket",
      "required": [
        "bucketName"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "accountId",
        "bucketName",
        "bucketType"
      ],
      "contentType": "application/json"
    },
    "file_upload": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_get_upload_url",
      "required": [
        "bucketId"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "bucketId"
      ],
      "contentType": "application/json"
    },
    "file_download": {
      "kind": "http",
      "method": "GET",
      "path": "/b2_download_file_by_id",
      "required": [
        "fileId"
      ],
      "queryFrom": [
        "fileId"
      ],
      "bodyFrom": [],
      "contentType": "application/json"
    },
    "file_delete": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_delete_file_version",
      "required": [
        "fileId",
        "fileName"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "fileId",
        "fileName"
      ],
      "contentType": "application/json"
    },
    "file_list": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_list_file_names",
      "required": [
        "bucketId"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "bucketId",
        "prefix",
        "maxFileCount"
      ],
      "contentType": "application/json"
    },
    "hide_file": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_hide_file",
      "required": [
        "bucketId",
        "fileName"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "bucketId",
        "fileName"
      ],
      "contentType": "application/json"
    },
    "get_download_auth": {
      "kind": "http",
      "method": "POST",
      "path": "/b2_get_download_authorization",
      "required": [
        "bucketId"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "bucketId",
        "fileNamePrefix",
        "validDurationInSeconds"
      ],
      "contentType": "application/json"
    }
  }
}
