{
  "baseUrl": "https://coda.io/apis/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_token"
  },
  "operations": {
    "row_insert": {
      "kind": "http",
      "method": "POST",
      "path": "/docs/{doc_id}/tables/{table_id}/rows",
      "required": [
        "doc_id",
        "table_id"
      ],
      "bodyFrom": [
        "rows"
      ]
    },
    "row_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{table_id}/rows/{row_id}",
      "required": [
        "doc_id",
        "table_id",
        "row_id"
      ]
    },
    "row_list": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{table_id}/rows",
      "required": [
        "doc_id",
        "table_id"
      ],
      "queryFrom": [
        "limit",
        "pageToken",
        "query"
      ]
    },
    "row_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/docs/{doc_id}/tables/{table_id}/rows/{row_id}",
      "required": [
        "doc_id",
        "table_id",
        "row_id"
      ]
    },
    "row_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/docs/{doc_id}/tables/{table_id}/rows/{row_id}",
      "required": [
        "doc_id",
        "table_id",
        "row_id"
      ],
      "bodyFrom": [
        "row"
      ]
    },
    "column_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{table_id}/columns/{column_id}",
      "required": [
        "doc_id",
        "table_id",
        "column_id"
      ]
    },
    "column_list": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{table_id}/columns",
      "required": [
        "doc_id",
        "table_id"
      ]
    },
    "control_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/controls/{control_id}",
      "required": [
        "doc_id",
        "control_id"
      ]
    },
    "formula_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/formulas/{formula_id}",
      "required": [
        "doc_id",
        "formula_id"
      ]
    },
    "view_get": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{view_id}",
      "required": [
        "doc_id",
        "view_id"
      ]
    },
    "view_list": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables",
      "required": [
        "doc_id"
      ],
      "queryFrom": [
        "tableTypes"
      ]
    },
    "view_rows": {
      "kind": "http",
      "method": "GET",
      "path": "/docs/{doc_id}/tables/{view_id}/rows",
      "required": [
        "doc_id",
        "view_id"
      ]
    },
    "push_button": {
      "kind": "http",
      "method": "POST",
      "path": "/docs/{doc_id}/tables/{table_id}/rows/{row_id}/buttons/{column_id}",
      "required": [
        "doc_id",
        "table_id",
        "row_id",
        "column_id"
      ]
    },
    "push_view_button": {
      "kind": "http",
      "method": "POST",
      "path": "/docs/{doc_id}/tables/{view_id}/rows/{row_id}/buttons/{column_id}",
      "required": [
        "doc_id",
        "view_id",
        "row_id",
        "column_id"
      ]
    }
  }
}
