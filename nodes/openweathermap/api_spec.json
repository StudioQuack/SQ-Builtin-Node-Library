{
  "baseUrl": "https://api.openweathermap.org",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "appid"
  },
  "operations": {
    "weather_current": {
      "kind": "http",
      "method": "GET",
      "path": "/data/2.5/weather",
      "required": [
        "lat",
        "lon"
      ],
      "queryFrom": [
        "lat",
        "lon",
        "units",
        "lang"
      ],
      "bodyFrom": []
    },
    "weather_forecast5": {
      "kind": "http",
      "method": "GET",
      "path": "/data/2.5/forecast",
      "required": [
        "lat",
        "lon"
      ],
      "queryFrom": [
        "lat",
        "lon",
        "units",
        "lang"
      ],
      "bodyFrom": []
    },
    "onecall": {
      "kind": "http",
      "method": "GET",
      "path": "/data/3.0/onecall",
      "required": [
        "lat",
        "lon"
      ],
      "queryFrom": [
        "lat",
        "lon",
        "units",
        "lang",
        "exclude"
      ],
      "bodyFrom": []
    },
    "geo_direct": {
      "kind": "http",
      "method": "GET",
      "path": "/geo/1.0/direct",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "limit"
      ],
      "bodyFrom": []
    }
  }
}
