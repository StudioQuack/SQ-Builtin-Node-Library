{
  "baseUrl": "https://api-b2b.backenster.com/b1/api/v3",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "translate": {
      "kind": "http",
      "method": "POST",
      "path": "/translate",
      "required": ["to", "data"],
      "bodyFrom": ["platform", "from", "to", "data", "translateMode", "enableTransliteration"]
    }
  }
}
