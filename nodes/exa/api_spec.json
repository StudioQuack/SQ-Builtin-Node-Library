{
  "baseUrl": "https://api.exa.ai",
  "defaultTimeout": 45,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "POST",
      "path": "/search",
      "required": [
        "query"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "query",
        "numResults",
        "type",
        "category",
        "includeDomains",
        "excludeDomains",
        "startPublishedDate",
        "endPublishedDate",
        "contents"
      ]
    },
    "find_similar": {
      "kind": "http",
      "method": "POST",
      "path": "/findSimilar",
      "required": [
        "url"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "url",
        "numResults",
        "excludeSourceDomain"
      ]
    },
    "contents": {
      "kind": "http",
      "method": "POST",
      "path": "/contents",
      "required": [
        "ids"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "ids",
        "text",
        "highlights",
        "summary"
      ]
    },
    "answer": {
      "kind": "http",
      "method": "POST",
      "path": "/answer",
      "required": [
        "query"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "query",
        "text"
      ]
    }
  }
}
