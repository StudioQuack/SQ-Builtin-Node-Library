{
  "baseUrl": "https://api.trello.com/1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "token"
  },
  "operations": {
    "board_create": {
      "kind": "http",
      "method": "POST",
      "path": "/boards",
      "required": [
        "name"
      ],
      "queryFrom": [
        "key",
        "name",
        "desc",
        "idOrganization"
      ]
    },
    "board_get": {
      "kind": "http",
      "method": "GET",
      "path": "/boards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "board_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/boards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "name",
        "desc",
        "closed"
      ]
    },
    "board_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/boards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "list_create": {
      "kind": "http",
      "method": "POST",
      "path": "/lists",
      "required": [
        "name",
        "idBoard"
      ],
      "queryFrom": [
        "key",
        "name",
        "idBoard",
        "pos"
      ]
    },
    "list_get": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "list_cards": {
      "kind": "http",
      "method": "GET",
      "path": "/lists/{id}/cards",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "list_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/lists/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "name",
        "closed"
      ]
    },
    "list_archive": {
      "kind": "http",
      "method": "PUT",
      "path": "/lists/{id}/closed",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "value"
      ]
    },
    "card_create": {
      "kind": "http",
      "method": "POST",
      "path": "/cards",
      "required": [
        "idList",
        "name"
      ],
      "queryFrom": [
        "key",
        "idList",
        "name",
        "desc",
        "due",
        "pos",
        "idMembers",
        "idLabels"
      ]
    },
    "card_get": {
      "kind": "http",
      "method": "GET",
      "path": "/cards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "card_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/cards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "name",
        "desc",
        "idList",
        "due",
        "closed",
        "pos",
        "idMembers"
      ]
    },
    "card_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/cards/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "comment_create": {
      "kind": "http",
      "method": "POST",
      "path": "/cards/{id}/actions/comments",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "text"
      ]
    },
    "comment_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/cards/{id}/actions/{idAction}/comments",
      "required": [
        "id",
        "idAction"
      ],
      "queryFrom": [
        "key",
        "text"
      ]
    },
    "comment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/cards/{id}/actions/{idAction}/comments",
      "required": [
        "id",
        "idAction"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "checklist_create": {
      "kind": "http",
      "method": "POST",
      "path": "/cards/{id}/checklists",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "name"
      ]
    },
    "checklist_get": {
      "kind": "http",
      "method": "GET",
      "path": "/checklists/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "checklist_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/checklists/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "label_create": {
      "kind": "http",
      "method": "POST",
      "path": "/boards/{id}/labels",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "name",
        "color"
      ]
    },
    "label_add": {
      "kind": "http",
      "method": "POST",
      "path": "/cards/{id}/idLabels",
      "required": [
        "id",
        "idLabel"
      ],
      "queryFrom": [
        "key",
        "idLabel",
        "value"
      ],
      "queryMap": {
        "idLabel": "value"
      }
    },
    "label_remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/cards/{id}/idLabels/{idLabel}",
      "required": [
        "id",
        "idLabel"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "attachment_add": {
      "kind": "http",
      "method": "POST",
      "path": "/cards/{id}/attachments",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "url",
        "name"
      ]
    },
    "attachment_list": {
      "kind": "http",
      "method": "GET",
      "path": "/cards/{id}/attachments",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "attachment_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/cards/{id}/attachments/{idAttachment}",
      "required": [
        "id",
        "idAttachment"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "member_add": {
      "kind": "http",
      "method": "PUT",
      "path": "/boards/{id}/members",
      "required": [
        "id"
      ],
      "queryFrom": [
        "key",
        "email",
        "type"
      ]
    },
    "member_remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/boards/{id}/members/{idMember}",
      "required": [
        "id",
        "idMember"
      ],
      "queryFrom": [
        "key"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
