{
  "baseUrl": "https://{api_region}",
  "placeholderDefaults": {
    "api_region": "api.opsgenie.com"
  },
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "Authorization",
    "prefix": "GenieKey ",
    "configKey": "api_key"
  },
  "operations": {
    "alert_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/alerts",
      "bodyFrom": [
        "message",
        "alias",
        "description",
        "priority",
        "responders",
        "visibleTo",
        "actions",
        "tags",
        "details",
        "entity",
        "source",
        "user",
        "note"
      ],
      "required": [
        "message"
      ]
    },
    "alert_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/alerts/{id}",
      "required": [
        "id"
      ],
      "queryFrom": [
        "identifierType"
      ]
    },
    "alert_ack": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/alerts/{id}/acknowledge",
      "required": [
        "id"
      ],
      "queryFrom": [
        "identifierType"
      ],
      "bodyFrom": [
        "note"
      ]
    },
    "alert_close": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/alerts/{id}/close",
      "required": [
        "id"
      ],
      "queryFrom": [
        "identifierType"
      ],
      "bodyFrom": [
        "note"
      ]
    },
    "alert_note": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/alerts/{id}/notes",
      "required": [
        "id",
        "note"
      ],
      "queryFrom": [
        "identifierType"
      ],
      "bodyFrom": [
        "note"
      ]
    },
    "incident_create": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/incidents/create",
      "bodyFrom": [
        "message",
        "description",
        "priority",
        "responders",
        "tags",
        "details",
        "note"
      ],
      "required": [
        "message"
      ]
    },
    "schedule_oncall": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/schedules/{id}/on-calls",
      "required": [
        "id"
      ]
    },
    "heartbeat_ping": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/heartbeats/{name}/ping",
      "required": [
        "name"
      ]
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
