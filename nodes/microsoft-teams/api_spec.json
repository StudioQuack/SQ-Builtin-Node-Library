{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "create-channel": {
      "kind": "http",
      "method": "POST",
      "path": "/teams/{team_id}/channels",
      "contentType": "application/json",
      "required": [
        "team_id",
        "displayName"
      ],
      "bodyFrom": [
        "displayName",
        "description",
        "membershipType"
      ]
    },
    "get-channel": {
      "kind": "http",
      "method": "GET",
      "path": "/teams/{team_id}/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "team_id",
        "channel_id"
      ]
    },
    "list-channels": {
      "kind": "http",
      "method": "GET",
      "path": "/teams/{team_id}/channels",
      "contentType": "application/json",
      "required": [
        "team_id"
      ]
    },
    "update-channel": {
      "kind": "http",
      "method": "PATCH",
      "path": "/teams/{team_id}/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "team_id",
        "channel_id"
      ],
      "bodyFrom": [
        "displayName",
        "description"
      ]
    },
    "delete-channel": {
      "kind": "http",
      "method": "DELETE",
      "path": "/teams/{team_id}/channels/{channel_id}",
      "contentType": "application/json",
      "required": [
        "team_id",
        "channel_id"
      ]
    },
    "create-channel-message": {
      "kind": "http",
      "method": "POST",
      "path": "/teams/{team_id}/channels/{channel_id}/messages",
      "contentType": "application/json",
      "required": [
        "team_id",
        "channel_id",
        "body"
      ],
      "bodyFrom": [
        "body",
        "subject"
      ]
    },
    "list-channel-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/teams/{team_id}/channels/{channel_id}/messages",
      "contentType": "application/json",
      "required": [
        "team_id",
        "channel_id"
      ],
      "queryFrom": [
        "$top"
      ]
    },
    "create-chat-message": {
      "kind": "http",
      "method": "POST",
      "path": "/chats/{chat_id}/messages",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "body"
      ],
      "bodyFrom": [
        "body"
      ]
    },
    "get-chat-message": {
      "kind": "http",
      "method": "GET",
      "path": "/chats/{chat_id}/messages/{message_id}",
      "contentType": "application/json",
      "required": [
        "chat_id",
        "message_id"
      ]
    },
    "list-chat-messages": {
      "kind": "http",
      "method": "GET",
      "path": "/chats/{chat_id}/messages",
      "contentType": "application/json",
      "required": [
        "chat_id"
      ],
      "queryFrom": [
        "$top"
      ]
    },
    "create-task": {
      "kind": "http",
      "method": "POST",
      "path": "/planner/tasks",
      "contentType": "application/json",
      "required": [
        "planId",
        "title"
      ],
      "bodyFrom": [
        "planId",
        "bucketId",
        "title",
        "assignments"
      ]
    },
    "get-task": {
      "kind": "http",
      "method": "GET",
      "path": "/planner/tasks/{id}",
      "contentType": "application/json",
      "required": [
        "id"
      ]
    },
    "list-tasks": {
      "kind": "http",
      "method": "GET",
      "path": "/planner/plans/{planId}/tasks",
      "contentType": "application/json",
      "required": [
        "planId"
      ]
    },
    "update-task": {
      "kind": "http",
      "method": "PATCH",
      "path": "/planner/tasks/{id}",
      "contentType": "application/json",
      "required": [
        "id",
        "if_match"
      ],
      "bodyFrom": [
        "title",
        "percentComplete",
        "assignments"
      ],
      "extraHeaders": {
        "If-Match": "{if_match}"
      }
    },
    "delete-task": {
      "kind": "http",
      "method": "DELETE",
      "path": "/planner/tasks/{id}",
      "contentType": "application/json",
      "required": [
        "id",
        "if_match"
      ],
      "extraHeaders": {
        "If-Match": "{if_match}"
      }
    },
    "send-and-wait": {
      "kind": "ingress"
    },
    "listen": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "query_challenge",
      "method": "ANY",
      "challengeParam": "validationToken",
      "responseContentType": "text/plain"
    },
    "verify": {
      "type": "body_field_secret",
      "bodyPath": "value[*].clientState",
      "secretConfigKey": "client_state"
    },
    "extract": {
      "itemsPath": "value[*]",
      "idempotencyPath": "resourceData.id",
      "fallbackIdempotencyPaths": [
        "subscriptionId"
      ],
      "correlationKeyPath": "resourceData.chatId",
      "fallbackCorrelationKeyPaths": [
        "resourceData.channelIdentity.channelId",
        "subscriptionId",
        "resource"
      ],
      "eventTypePath": "changeType",
      "fields": {
        "subscriptionId": "subscriptionId",
        "changeType": "changeType",
        "resource": "resource",
        "resourceId": "resourceData.id",
        "chatId": "resourceData.chatId",
        "channelId": "resourceData.channelIdentity.channelId",
        "tenantId": "tenantId"
      },
      "maxItems": 100
    },
    "sendAndWait": {
      "sendOperation": "create-channel-message",
      "fallbackSendOperation": "create-chat-message",
      "fallbackWhenPresent": "chat_id",
      "fallbackWhenBlank": "channel_id",
      "correlationKeyFrom": [
        "chat_id",
        "channel_id",
        "data.chatId",
        "data.channelIdentity.channelId",
        "data.id"
      ]
    }
  }
}
