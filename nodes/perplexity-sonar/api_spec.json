{
  "baseUrl": "https://api.perplexity.ai",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "search": {
      "kind": "http",
      "method": "POST",
      "path": "/search",
      "required": [
        "query"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "query",
        "max_results",
        "search_recency_filter",
        "search_domain_filter",
        "search_language_filter",
        "search_after_date_filter",
        "search_before_date_filter",
        "country",
        "max_tokens",
        "max_tokens_per_page"
      ]
    },
    "agent": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/agent",
      "required": [
        "input"
      ],
      "queryFrom": [],
      "bodyFrom": [
        "input",
        "instructions",
        "preset",
        "model",
        "models",
        "tools",
        "skills",
        "max_output_tokens",
        "max_steps",
        "temperature",
        "top_p",
        "stream",
        "response_format",
        "reasoning",
        "language_preference",
        "previous_response_id",
        "background"
      ]
    }
  }
}
