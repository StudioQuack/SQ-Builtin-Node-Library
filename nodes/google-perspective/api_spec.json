{
  "baseUrl": "https://commentanalyzer.googleapis.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-goog-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "analyze": {
      "kind": "http",
      "method": "POST",
      "path": "/v1alpha1/comments:analyze",
      "required": [
        "comment"
      ],
      "bodyFrom": [
        "comment",
        "requestedAttributes",
        "languages",
        "doNotStore",
        "spanAnnotations",
        "context",
        "sessionId",
        "communityId",
        "clientToken"
      ]
    }
  }
}
