{
  "baseUrl": "https://{environment}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "userKey": "public_key",
    "configKey": "private_key"
  },
  "operations": {
    "client_token_create": {
      "kind": "http",
      "method": "POST",
      "path": "/graphql",
      "bodyFrom": [
        "variables",
        "query",
        "paymentMethodId",
        "transactionId",
        "amount",
        "merchantAccountId",
        "customerId",
        "planId",
        "firstName",
        "lastName",
        "email"
      ],
      "bodyMap": {
        "paymentMethodId": "variables.paymentMethodId",
        "transactionId": "variables.transactionId",
        "amount": "variables.transaction.amount",
        "merchantAccountId": "variables.transaction.merchantAccountId",
        "customerId": "variables.customerId",
        "planId": "variables.subscription.planId",
        "firstName": "variables.customer.firstName",
        "lastName": "variables.customer.lastName",
        "email": "variables.customer.email"
      },
      "contentType": "application/json"
