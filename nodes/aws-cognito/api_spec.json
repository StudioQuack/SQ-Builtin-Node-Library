{
    "baseUrl": "https://cognito-idp.{region}.amazonaws.com",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "aws-sigv4",
        "configKey": "access_key_id",
        "secretKeyConfigKey": "secret_access_key"
    },
    "sigv4": {
        "service": "cognito-idp",
        "regionConfigKey": "region",
        "sessionTokenConfigKey": "session_token"
    },
    "operations": {
        "create-user": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username",
                "UserAttributes",
                "TemporaryPassword",
                "ForceAliasCreation",
                "MessageAction",
                "DesiredDeliveryMediums",
                "ClientMetadata",
                "ValidationData"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminCreateUser"
            }
        },
        "get-user": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminGetUser"
            }
        },
        "list-users": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Filter",
                "Limit",
                "PaginationToken",
                "AttributesToGet"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.ListUsers"
            }
        },
        "update-user": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username",
                "UserAttributes",
                "ClientMetadata"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminUpdateUserAttributes"
            }
        },
        "delete-user": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminDeleteUser"
            }
        },
        "add-user-to-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username",
                "GroupName"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminAddUserToGroup"
            }
        },
        "remove-user-from-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "Username",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Username",
                "GroupName"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.AdminRemoveUserFromGroup"
            }
        },
        "create-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "GroupName",
                "Description",
                "Precedence",
                "RoleArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.CreateGroup"
            }
        },
        "get-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "GroupName"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.GetGroup"
            }
        },
        "list-groups": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId"
            ],
            "bodyFrom": [
                "UserPoolId",
                "Limit",
                "NextToken"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.ListGroups"
            }
        },
        "update-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "GroupName",
                "Description",
                "Precedence",
                "RoleArn"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.UpdateGroup"
            }
        },
        "delete-group": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId",
                "GroupName"
            ],
            "bodyFrom": [
                "UserPoolId",
                "GroupName"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.DeleteGroup"
            }
        },
        "get-user-pool": {
            "kind": "http",
            "method": "POST",
            "path": "/",
            "required": [
                "UserPoolId"
            ],
            "bodyFrom": [
                "UserPoolId"
            ],
            "contentType": "application/x-amz-json-1.1",
            "extraHeaders": {
                "Content-Type": "application/x-amz-json-1.1",
                "X-Amz-Target": "AWSCognitoIdentityProviderService.DescribeUserPool"
            }
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
