{
  "baseUrl": "https://{api_host}",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms",
      "queryFrom": [
        "search",
        "page",
        "page_size",
        "workspace_id",
        "sort_by",
        "order_by"
      ]
    },
    "form.get": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}",
      "required": [
        "form_id"
      ]
    },
    "form.create": {
      "kind": "http",
      "method": "POST",
      "path": "/forms",
      "required": [
        "title"
      ],
      "bodyFrom": [
        "title",
        "type",
        "fields",
        "workspace",
        "theme",
        "hidden",
        "settings"
      ]
    },
    "response.list": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}/responses",
      "required": [
        "form_id"
      ],
      "queryFrom": [
        "page_size",
        "since",
        "until",
        "before",
        "after",
        "response_type",
        "query",
        "sort"
      ]
    },
    "response.get": {
      "kind": "http",
      "method": "GET",
      "path": "/forms/{form_id}/responses",
      "required": [
        "form_id",
        "included_response_ids"
      ],
      "queryFrom": [
        "included_response_ids",
        "page_size"
      ]
    },
    "webhook.register": {
      "kind": "http",
      "method": "PUT",
      "path": "/forms/{form_id}/webhooks/{tag}",
      "required": [
        "form_id",
        "tag",
        "url"
      ],
      "bodyFrom": [
        "url",
        "enabled",
        "secret",
        "verify_ssl",
        "form_response_partial"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
