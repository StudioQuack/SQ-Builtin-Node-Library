{
  "baseUrl": "https://external.api.recraft.ai",
  "defaultTimeout": 120,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "api_key"
  },
  "operations": {
    "generate": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/images/generations",
      "required": ["prompt"],
      "bodyFrom": ["prompt", "n", "model", "style", "style_id", "size", "negative_prompt", "random_seed", "response_format", "text_layout", "controls"]
    },
    "vectorize": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/images/vectorize",
      "required": [],
      "bodyFrom": ["file", "image_url", "response_format"],
      "contentType": "application/json"
    },
    "style": {
      "kind": "http",
      "method": "POST",
      "path": "/v1/styles",
      "required": [],
      "bodyFrom": ["style", "image_urls", "file1"]
    }
  }
}
