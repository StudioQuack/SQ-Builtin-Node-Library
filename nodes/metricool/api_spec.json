{
  "baseUrl": "https://app.metricool.com/api",
  "defaultTimeout": 30,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Mc-Auth",
    "prefix": "",
    "configKey": "api_token"
  },
  "operations": {
    "post_schedule": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/scheduler/posts",
      "required": [
        "text",
        "providers"
      ],
      "queryFrom": [
        "userId",
        "blogId"
      ],
      "bodyFrom": [
        "text",
        "publicationDate",
        "publication_date_time",
        "timezone",
        "providers",
        "draft",
        "auto_publish",
        "media_url"
      ]
    },
    "analytics_get": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/analytics/aggregation",
      "required": [
        "network",
        "metric",
        "from",
        "to"
      ],
      "queryFrom": [
        "network",
        "metric",
        "from",
        "to",
        "userId",
        "blogId",
        "timezone",
        "subject",
        "scope"
      ]
    },
    "inbox_list": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/inbox/conversations",
      "required": [
        "provider"
      ],
      "queryFrom": [
        "provider",
        "userId",
        "blogId"
      ]
    }
  }
}
