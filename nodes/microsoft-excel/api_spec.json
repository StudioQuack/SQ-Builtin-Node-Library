{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "table_append": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/workbook/tables/{table_id}/rows/add",
      "required": [
        "item_id",
        "table_id"
      ],
      "bodyFrom": [
        "values",
        "index"
      ]
    },
    "table_get_columns": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/tables/{table_id}/columns",
      "required": [
        "item_id",
        "table_id"
      ]
    },
    "table_get_rows": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/tables/{table_id}/rows",
      "required": [
        "item_id",
        "table_id"
      ]
    },
    "table_lookup": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/tables/{table_id}/range",
      "required": [
        "item_id",
        "table_id"
      ]
    },
    "workbook_add_sheet": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/workbook/worksheets",
      "required": [
        "item_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "workbook_list": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/worksheets",
      "required": [
        "item_id"
      ]
    },
    "workbook_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/drive/items/{item_id}",
      "required": [
        "item_id"
      ]
    },
    "worksheet_list": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/worksheets",
      "required": [
        "item_id"
      ]
    },
    "worksheet_get": {
      "kind": "http",
      "method": "GET",
      "path": "/me/drive/items/{item_id}/workbook/worksheets/{worksheet_id}",
      "required": [
        "item_id",
        "worksheet_id"
      ]
    },
    "worksheet_append": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/workbook/worksheets/{worksheet_id}/range(address='{address}')/insert",
      "required": [
        "item_id",
        "worksheet_id",
        "address"
      ],
      "bodyFrom": [
        "values",
        "shift"
      ]
    },
    "worksheet_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/me/drive/items/{item_id}/workbook/worksheets/{worksheet_id}/range(address='{address}')",
      "required": [
        "item_id",
        "worksheet_id",
        "address"
      ],
      "bodyFrom": [
        "values"
      ]
    },
    "worksheet_clear": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/workbook/worksheets/{worksheet_id}/range(address='{address}')/clear",
      "required": [
        "item_id",
        "worksheet_id",
        "address"
      ],
      "bodyFrom": [
        "applyTo"
      ]
    },
    "worksheet_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/drive/items/{item_id}/workbook/worksheets/{worksheet_id}",
      "required": [
        "item_id",
        "worksheet_id"
      ]
    },
    "table_create": {
      "kind": "http",
      "method": "POST",
      "path": "/me/drive/items/{item_id}/workbook/tables/add",
      "required": [
        "item_id"
      ],
      "bodyFrom": [
        "address",
        "hasHeaders"
      ]
    },
    "table_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/me/drive/items/{item_id}/workbook/tables/{table_id}",
      "required": [
        "item_id",
        "table_id"
      ]
    }
  }
}
