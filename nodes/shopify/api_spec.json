{
  "baseUrl": "https://",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Shopify-Access-Token",
    "prefix": "",
    "configKey": "access_token"
  },
  "operations": {
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "order_delete": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "order_list": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "order_update": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "product_create": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "product_delete": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "product_get": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "product_list": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "product_update": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "customer_get": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "inventory_adjust": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "fulfillment_create": {
      "kind": "http",
      "method": "POST",
      "path": "{shop}.myshopify.com/admin/api/{api_version}/graphql.json",
      "required": [
        "query"
      ],
      "bodyFrom": [
        "query",
        "variables"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  },
  "ingress": {
    "handshake": {
      "type": "none"
    },
    "verify": {
      "type": "hmac_sha256_base64",
      "header": "x-shopify-hmac-sha256",
      "secretConfigKey": "webhook_secret"
    },
    "extract": {
      "idempotencyHeader": "x-shopify-webhook-id",
      "idempotencyPath": "id",
      "correlationKeyPath": "id",
      "fallbackCorrelationKeyPaths": [
        "order_number",
        "email"
      ],
      "eventTypeHeader": "x-shopify-topic",
      "fields": {
        "id": "id",
        "email": "email",
        "name": "name",
        "totalPrice": "total_price",
        "financialStatus": "financial_status"
      }
    }
  }
}
