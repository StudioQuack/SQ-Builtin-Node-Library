{
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "file_download": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/drive/items/{item_id}/content",
      "required": [
        "site_id",
        "item_id"
      ]
    },
    "file_upload": {
      "kind": "http",
      "method": "PUT",
      "path": "/sites/{site_id}/drive/root:/{filename}:/content",
      "required": [
        "site_id",
        "filename",
        "file"
      ],
      "bodyFormat": "raw",
      "bodyParam": "file"
    },
    "file_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/sites/{site_id}/drive/items/{item_id}",
      "required": [
        "site_id",
        "item_id"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "item_create": {
      "kind": "http",
      "method": "POST",
      "path": "/sites/{site_id}/lists/{list_id}/items",
      "required": [
        "site_id",
        "list_id"
      ],
      "bodyFrom": [
        "fields"
      ]
    },
    "item_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/lists/{list_id}/items/{item_id}",
      "required": [
        "site_id",
        "list_id",
        "item_id"
      ],
      "queryFrom": [
        "$expand",
        "$select"
      ]
    },
    "item_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/lists/{list_id}/items",
      "required": [
        "site_id",
        "list_id"
      ],
      "queryFrom": [
        "$top",
        "$skiptoken",
        "$expand",
        "$select",
        "$filter"
      ]
    },
    "item_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/sites/{site_id}/lists/{list_id}/items/{item_id}",
      "required": [
        "site_id",
        "list_id",
        "item_id"
      ],
      "bodyFrom": [
        "fields"
      ]
    },
    "item_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/sites/{site_id}/lists/{list_id}/items/{item_id}",
      "required": [
        "site_id",
        "list_id",
        "item_id"
      ]
    },
    "list_get": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/lists/{list_id}",
      "required": [
        "site_id",
        "list_id"
      ]
    },
    "list_list": {
      "kind": "http",
      "method": "GET",
      "path": "/sites/{site_id}/lists",
      "required": [
        "site_id"
      ]
    }
  }
}
