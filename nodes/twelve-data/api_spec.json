{
  "baseUrl": "https://api.twelvedata.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "query",
    "header": "Authorization",
    "prefix": "",
    "configKey": "apikey"
  },
  "operations": {
    "quote": {
      "kind": "http",
      "method": "GET",
      "path": "/quote",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "interval",
        "timezone",
        "dp"
      ],
      "bodyFrom": []
    },
    "time_series": {
      "kind": "http",
      "method": "GET",
      "path": "/time_series",
      "required": [
        "symbol",
        "interval"
      ],
      "queryFrom": [
        "symbol",
        "interval",
        "outputsize",
        "start_date",
        "end_date",
        "timezone",
        "format",
        "dp"
      ],
      "bodyFrom": []
    },
    "eod": {
      "kind": "http",
      "method": "GET",
      "path": "/eod",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "date"
      ],
      "bodyFrom": []
    },
    "fx_rate": {
      "kind": "http",
      "method": "GET",
      "path": "/exchange_rate",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "timezone"
      ],
      "bodyFrom": []
    },
    "crypto_quote": {
      "kind": "http",
      "method": "GET",
      "path": "/quote",
      "required": [
        "symbol"
      ],
      "queryFrom": [
        "symbol",
        "interval",
        "timezone",
        "dp"
      ],
      "bodyFrom": []
    }
  }
}
