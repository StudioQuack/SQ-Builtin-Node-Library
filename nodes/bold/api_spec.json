{
  "baseUrl": "https://api.boldcommerce.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_token"
  },
  "extraHeaders": {
    "Bold-API-Version-Date": "{api_version_date}"
  },
  "operations": {
    "subscription_get": {
      "kind": "http",
      "method": "GET",
      "path": "/subscriptions/v1/shops/{shop}/subscriptions/{subscription_id}",
      "required": [
        "subscription_id"
      ],
      "queryFrom": [
        "expand"
      ]
    },
    "subscription_update": {
      "kind": "http",
      "method": "PATCH",
      "path": "/subscriptions/v1/shops/{shop}/subscriptions/{subscription_id}",
      "required": [
        "subscription_id"
      ],
      "bodyFrom": [
        "subscription_status",
        "next_order_datetime",
        "note",
        "order_note",
        "payment_method_token"
      ],
      "bodyMap": {
        "subscription_status": "subscription.subscription_status",
        "next_order_datetime": "subscription.next_order_datetime",
        "note": "subscription.note",
        "order_note": "subscription.order_note",
        "payment_method_token": "subscription.payment_method_token"
      },
      "contentType": "application/json"
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
