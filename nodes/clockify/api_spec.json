{
    "baseUrl": "https://{region_host}/api/v1",
    "defaultTimeout": 25,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "header",
        "header": "X-Api-Key",
        "prefix": "",
        "configKey": "api_key"
    },
    "operations": {
        "project_create": {
            "kind": "http",
            "method": "POST",
            "path": "/workspaces/{workspace_id}/projects",
            "required": [
                "workspace_id"
            ],
            "bodyFrom": [
                "name",
                "clientId",
                "billable",
                "color",
                "isPublic"
            ]
        },
        "project_get": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/projects/{project_id}",
            "required": [
                "workspace_id",
                "project_id"
            ]
        },
        "project_list": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/projects",
            "required": [
                "workspace_id"
            ],
            "queryFrom": [
                "page",
                "page-size"
            ]
        },
        "project_update": {
            "kind": "http",
            "method": "PUT",
            "path": "/workspaces/{workspace_id}/projects/{project_id}",
            "required": [
                "workspace_id",
                "project_id"
            ],
            "bodyFrom": [
                "name",
                "archived"
            ]
        },
        "project_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/workspaces/{workspace_id}/projects/{project_id}",
            "required": [
                "workspace_id",
                "project_id"
            ]
        },
        "tag_create": {
            "kind": "http",
            "method": "POST",
            "path": "/workspaces/{workspace_id}/tags",
            "required": [
                "workspace_id"
            ],
            "bodyFrom": [
                "name"
            ]
        },
        "tag_list": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/tags",
            "required": [
                "workspace_id"
            ]
        },
        "tag_update": {
            "kind": "http",
            "method": "PUT",
            "path": "/workspaces/{workspace_id}/tags/{tag_id}",
            "required": [
                "workspace_id",
                "tag_id"
            ],
            "bodyFrom": [
                "name"
            ]
        },
        "tag_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/workspaces/{workspace_id}/tags/{tag_id}",
            "required": [
                "workspace_id",
                "tag_id"
            ]
        },
        "task_create": {
            "kind": "http",
            "method": "POST",
            "path": "/workspaces/{workspace_id}/projects/{project_id}/tasks",
            "required": [
                "workspace_id",
                "project_id"
            ],
            "bodyFrom": [
                "name"
            ]
        },
        "task_get": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/projects/{project_id}/tasks/{task_id}",
            "required": [
                "workspace_id",
                "project_id",
                "task_id"
            ]
        },
        "task_list": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/projects/{project_id}/tasks",
            "required": [
                "workspace_id",
                "project_id"
            ]
        },
        "task_update": {
            "kind": "http",
            "method": "PUT",
            "path": "/workspaces/{workspace_id}/projects/{project_id}/tasks/{task_id}",
            "required": [
                "workspace_id",
                "project_id",
                "task_id"
            ],
            "bodyFrom": [
                "name"
            ]
        },
        "task_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/workspaces/{workspace_id}/projects/{project_id}/tasks/{task_id}",
            "required": [
                "workspace_id",
                "project_id",
                "task_id"
            ]
        },
        "time_entry_create": {
            "kind": "http",
            "method": "POST",
            "path": "/workspaces/{workspace_id}/time-entries",
            "required": [
                "workspace_id"
            ],
            "bodyFrom": [
                "start",
                "end",
                "description",
                "projectId",
                "taskId",
                "billable",
                "tagIds"
            ]
        },
        "time_entry_get": {
            "kind": "http",
            "method": "GET",
            "path": "/workspaces/{workspace_id}/time-entries/{id}",
            "required": [
                "workspace_id",
                "id"
            ]
        },
        "time_entry_update": {
            "kind": "http",
            "method": "PUT",
            "path": "/workspaces/{workspace_id}/time-entries/{id}",
            "required": [
                "workspace_id",
                "id"
            ],
            "bodyFrom": [
                "start",
                "end",
                "description",
                "projectId",
                "taskId",
                "billable",
                "tagIds"
            ]
        },
        "time_entry_delete": {
            "kind": "http",
            "method": "DELETE",
            "path": "/workspaces/{workspace_id}/time-entries/{id}",
            "required": [
                "workspace_id",
                "id"
            ]
        },
        "listen": {
            "kind": "ingress"
        }
    }
}
