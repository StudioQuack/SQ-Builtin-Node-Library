{
  "baseUrl": "https://{api_host}/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "app_api_key"
  },
  "operations": {
    "customer.get": {
      "kind": "http",
      "method": "GET",
      "path": "/customers/{identifier}/attributes",
      "required": [
        "identifier"
      ]
    },
    "customer.list": {
      "kind": "http",
      "method": "GET",
      "path": "/customers",
      "required": [
        "email"
      ],
      "queryFrom": [
        "email"
      ]
    },
    "customer.search": {
      "kind": "http",
      "method": "POST",
      "path": "/customers",
      "required": [
        "filter"
      ],
      "queryFrom": [
        "start",
        "limit"
      ],
      "bodyFrom": [
        "filter"
      ]
    },
    "customer.segments": {
      "kind": "http",
      "method": "GET",
      "path": "/customers/{identifier}/segments",
      "required": [
        "identifier"
      ]
    },
    "campaign.list": {
      "kind": "http",
      "method": "GET",
      "path": "/campaigns"
    },
    "campaign.get": {
      "kind": "http",
      "method": "GET",
      "path": "/campaigns/{campaign_id}",
      "required": [
        "campaign_id"
      ]
    },
    "campaign.metrics": {
      "kind": "http",
      "method": "GET",
      "path": "/campaigns/{campaign_id}/metrics",
      "required": [
        "campaign_id"
      ],
      "queryFrom": [
        "period"
      ]
    },
    "segment.list": {
      "kind": "http",
      "method": "GET",
      "path": "/segments"
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  },
  "placeholderDefaults": {
    "api_host": "api.customer.io"
  }
}
