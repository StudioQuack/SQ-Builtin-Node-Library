{
  "baseUrl": "https://api.tumblr.com/v2",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer ",
    "configKey": "access_token"
  },
  "operations": {
    "post_create": {
      "kind": "http",
      "method": "POST",
      "path": "/blog/{blog_identifier}/posts",
      "bodyFrom": [
        "content",
        "layout",
        "tags",
        "state"
      ],
      "required": [
        "blog_identifier",
        "content"
      ]
    },
    "post_get": {
      "kind": "http",
      "method": "GET",
      "path": "/blog/{blog_identifier}/posts/{post_id}",
      "queryFrom": [],
      "required": [
        "blog_identifier",
        "post_id"
      ]
    },
    "blog_info": {
      "kind": "http",
      "method": "GET",
      "path": "/blog/{blog_identifier}/info",
      "required": [
        "blog_identifier"
      ]
    },
    "user_dashboard": {
      "kind": "http",
      "method": "GET",
      "path": "/user/dashboard",
      "queryFrom": [
        "limit",
        "offset",
        "type",
        "since_id"
      ],
      "required": []
    }
  }
}
