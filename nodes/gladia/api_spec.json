{
  "baseUrl": "https://api.gladia.io",
  "defaultTimeout": 60,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "x-gladia-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "pre_recorded": {
      "kind": "http",
      "method": "POST",
      "path": "/v2/pre-recorded",
      "required": ["audio_url"],
      "bodyFrom": ["audio_url", "model", "language_config", "diarization", "diarization_config", "translation", "translation_config", "subtitles", "sentences", "punctuation_enhanced", "callback", "callback_config", "custom_metadata"]
    },
    "get_transcript": {
      "kind": "http",
      "method": "GET",
      "path": "/v2/pre-recorded/{id}",
      "required": ["id"]
    },
    "live": {
      "kind": "ingress"
    }
  }
}
