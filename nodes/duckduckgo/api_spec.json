{
  "baseUrl": "https://api.duckduckgo.com",
  "defaultTimeout": 20,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "none",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "instant_answer": {
      "kind": "http",
      "method": "GET",
      "path": "/?format=json&t=studioquack",
      "required": [
        "q"
      ],
      "queryFrom": [
        "q",
        "no_html",
        "no_redirect",
        "skip_disambig"
      ],
      "bodyFrom": []
    }
  }
}
