{
    "baseUrl": "https://api.linkedin.com",
    "defaultTimeout": 30,
    "timeoutConfigKey": "timeout_seconds",
    "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "configKey": "access_token"
    },
    "extraHeaders": {
        "Linkedin-Version": "202608",
        "X-Restli-Protocol-Version": "2.0.0"
    },
    "operations": {
        "post_create": {
            "kind": "http",
            "method": "POST",
            "path": "/rest/posts",
            "required": [
                "commentary",
                "author"
            ],
            "bodyFrom": [
                "author",
                "commentary",
                "visibility",
                "lifecycleState",
                "distribution"
            ]
        },
        "post_get": {
            "kind": "http",
            "method": "GET",
            "path": "/rest/posts/{post_urn}",
            "required": [
                "post_urn"
            ]
        },
        "image_upload": {
            "kind": "http",
            "method": "POST",
            "path": "/rest/images?action=initializeUpload",
            "required": [
                "media"
            ],
            "bodyFrom": [
                "author",
                "media"
            ]
        },
        "organization_get": {
            "kind": "http",
            "method": "GET",
            "path": "/rest/organizations/{organization_id}",
            "required": [
                "organization_id"
            ]
        },
        "member_get": {
            "kind": "http",
            "method": "GET",
            "path": "/v2/userinfo"
        },
        "trigger": {
            "kind": "ingress"
        }
    }
}
