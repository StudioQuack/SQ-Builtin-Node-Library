{
  "baseUrl": "https://api.track.toggl.com/api/v9",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "basic",
    "header": "Authorization",
    "prefix": "",
    "configKey": "api_token_password",
    "userKey": "api_token"
  },
  "operations": {
    "time_entry_create": {
      "kind": "http",
      "method": "POST",
      "path": "/workspaces/{workspace_id}/time_entries",
      "required": [
        "workspace_id"
      ],
      "bodyFrom": [
        "description",
        "start",
        "stop",
        "duration",
        "project_id",
        "created_with",
        "billable",
        "tags",
        "tag_ids",
        "workspace_id"
      ]
    },
    "time_entry_get": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces/{workspace_id}/time_entries/{time_entry_id}",
      "required": [
        "workspace_id",
        "time_entry_id"
      ]
    },
    "time_entry_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/workspaces/{workspace_id}/time_entries/{time_entry_id}",
      "required": [
        "workspace_id",
        "time_entry_id"
      ],
      "bodyFrom": [
        "description",
        "start",
        "stop",
        "duration",
        "project_id",
        "created_with",
        "billable",
        "tags",
        "tag_ids",
        "workspace_id"
      ]
    },
    "time_entry_delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/workspaces/{workspace_id}/time_entries/{time_entry_id}",
      "required": [
        "workspace_id",
        "time_entry_id"
      ]
    },
    "time_entry_start": {
      "kind": "http",
      "method": "POST",
      "path": "/workspaces/{workspace_id}/time_entries",
      "required": [
        "workspace_id"
      ],
      "bodyFrom": [
        "description",
        "start",
        "stop",
        "duration",
        "project_id",
        "created_with",
        "billable",
        "tags",
        "tag_ids",
        "workspace_id"
      ]
    },
    "time_entry_stop": {
      "kind": "http",
      "method": "PATCH",
      "path": "/workspaces/{workspace_id}/time_entries/{time_entry_id}/stop",
      "required": [
        "workspace_id",
        "time_entry_id"
      ]
    },
    "project_list": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces/{workspace_id}/projects",
      "required": [
        "workspace_id"
      ]
    },
    "client_list": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces/{workspace_id}/clients",
      "required": [
        "workspace_id"
      ]
    },
    "workspace_list": {
      "kind": "http",
      "method": "GET",
      "path": "/workspaces"
    },
    "listen": {
      "kind": "ingress"
    }
  }
}
