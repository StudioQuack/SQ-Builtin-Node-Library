{
  "baseUrl": "https://api.kit.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Kit-Api-Key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "subscriber.addToForm": {
      "kind": "http",
      "method": "POST",
      "path": "/v4/forms/{form_id}/subscribers",
      "required": [
        "form_id",
        "email_address"
      ],
      "bodyFrom": [
        "email_address",
        "first_name",
        "fields",
        "state"
      ]
    },
    "subscriber.addToSequence": {
      "kind": "http",
      "method": "POST",
      "path": "/v4/sequences/{sequence_id}/subscribers",
      "required": [
        "sequence_id"
      ],
      "bodyFrom": [
        "email_address",
        "subscriber_id"
      ]
    },
    "subscriber.tag.add": {
      "kind": "http",
      "method": "POST",
      "path": "/v4/tags/{tag_id}/subscribers",
      "required": [
        "tag_id"
      ],
      "bodyFrom": [
        "email_address",
        "subscriber_id"
      ]
    },
    "subscriber.tag.remove": {
      "kind": "http",
      "method": "DELETE",
      "path": "/v4/tags/{tag_id}/subscribers/{subscriber_id}",
      "queryFrom": [
        "email_address"
      ],
      "required": [
        "tag_id",
        "subscriber_id"
      ]
    },
    "subscriber.listByForm": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/forms/{form_id}/subscribers",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": [
        "form_id"
      ]
    },
    "subscriber.listBySequence": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/sequences/{sequence_id}/subscribers",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": [
        "sequence_id"
      ]
    },
    "subscriber.listByTag": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/tags/{tag_id}/subscribers",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": [
        "tag_id"
      ]
    },
    "form.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/forms",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": []
    },
    "sequence.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/sequences",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": []
    },
    "tag.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v4/tags",
      "required": [
        "name"
      ],
      "bodyFrom": [
        "name"
      ]
    },
    "tag.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/tags",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": []
    },
    "customField.create": {
      "kind": "http",
      "method": "POST",
      "path": "/v4/custom_fields",
      "required": [
        "label"
      ],
      "bodyFrom": [
        "label"
      ]
    },
    "customField.list": {
      "kind": "http",
      "method": "GET",
      "path": "/v4/custom_fields",
      "queryFrom": [
        "after",
        "before",
        "per_page"
      ],
      "required": []
    },
    "customField.update": {
      "kind": "http",
      "method": "PUT",
      "path": "/v4/custom_fields/{custom_field_id}",
      "required": [
        "custom_field_id"
      ],
      "bodyFrom": [
        "label"
      ]
    },
    "customField.delete": {
      "kind": "http",
      "method": "DELETE",
      "path": "/v4/custom_fields/{custom_field_id}",
      "required": [
        "custom_field_id"
      ]
    },
    "trigger.listen": {
      "kind": "ingress"
    }
  }
}
