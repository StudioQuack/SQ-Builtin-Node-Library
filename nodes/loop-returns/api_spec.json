{
  "baseUrl": "https://api.loopreturns.com/api/v1",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "X-Authorization",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "return_list": {
      "kind": "http",
      "method": "GET",
      "path": "/warehouse/return/list",
      "queryFrom": [
        "from",
        "to",
        "page"
      ]
    },
    "return_get": {
      "kind": "http",
      "method": "GET",
      "path": "/warehouse/return/details",
      "queryFrom": [
        "return_id",
        "order_id",
        "order_name"
      ]
    },
    "return_process": {
      "kind": "http",
      "method": "POST",
      "path": "/warehouse/return/{id}/process",
      "required": [
        "id"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
