{
  "baseUrl": "https://api.aftership.com/tracking/2026-07",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "header",
    "header": "as-api-key",
    "prefix": "",
    "configKey": "api_key"
  },
  "operations": {
    "tracking_create": {
      "kind": "http",
      "method": "POST",
      "path": "/trackings",
      "bodyFrom": [
        "tracking_number",
        "slug",
        "slug_group",
        "title",
        "order_id"
      ]
    },
    "tracking_get": {
      "kind": "http",
      "method": "GET",
      "path": "/trackings/{id}",
      "required": [
        "id"
      ]
    },
    "tracking_update": {
      "kind": "http",
      "method": "PUT",
      "path": "/trackings/{id}",
      "required": [
        "id"
      ]
    },
    "courier_detect": {
      "kind": "http",
      "method": "POST",
      "path": "/couriers/detect",
      "bodyFrom": [
        "tracking_number"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
