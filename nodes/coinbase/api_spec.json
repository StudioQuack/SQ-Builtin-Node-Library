{
  "baseUrl": "https://api.coinbase.com",
  "defaultTimeout": 25,
  "timeoutConfigKey": "timeout_seconds",
  "auth": {
    "type": "bearer",
    "configKey": "api_key"
  },
  "operations": {
    "account_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/brokerage/accounts"
    },
    "transaction_list": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/brokerage/orders/historical/fills",
      "queryFrom": [
        "product_id",
        "limit"
      ]
    },
    "order_create": {
      "kind": "http",
      "method": "POST",
      "path": "/api/v3/brokerage/orders",
      "bodyFrom": [
        "client_order_id",
        "product_id",
        "side",
        "order_configuration"
      ]
    },
    "order_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/brokerage/orders/historical/{id}",
      "required": [
        "id"
      ]
    },
    "price_get": {
      "kind": "http",
      "method": "GET",
      "path": "/api/v3/brokerage/market/products/{product_id}",
      "required": [
        "product_id"
      ]
    },
    "trigger": {
      "kind": "ingress"
    }
  }
}
